<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hardware="clr-namespace:xyz.Client.Presentation.Controls.ThreeD;assembly=xyz.Client.Presentation"
      x:Name="PipeScene" Width="850" Height="440" Background="{StaticResource DarkSurfaceBackground}">
    <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="*" />
        <RowDefinition Height="38" />
    </Grid.RowDefinitions>
    <TextBlock Margin="24,17,24,0" Text="Arm + DIW / SC1 管路" FontSize="{StaticResource Size18}" Foreground="{StaticResource DarkPrimaryText}" />
    <Viewport3D Grid.Row="1" x:Name="SceneViewport" IsHitTestVisible="False">
        <Viewport3D.Camera>
            <OrthographicCamera Position="3.1,3,4.8" LookDirection="-2,-2.2,-4.8" UpDirection="0,1,0" Width="3.6" />
        </Viewport3D.Camera>
        <ModelVisual3D>
            <ModelVisual3D.Content>
                <Model3DGroup>
                    <AmbientLight Color="#707070" />
                    <DirectionalLight Color="#C0C0C0" Direction="-1,-3,-2" />
                </Model3DGroup>
            </ModelVisual3D.Content>
        </ModelVisual3D>
        <hardware:LiftVisual3D x:Name="Lift" IsRaised="{Binding DataContext.LiftIsRaised, ElementName=PipeScene, Mode=OneWay}" />
        <hardware:ArmVisual3D x:Name="Arm" Angle="{Binding DataContext.ArmAngle, ElementName=PipeScene, Mode=OneWay}">
            <hardware:ArmVisual3D.Transform>
                <Transform3DGroup>
                    <!-- Arm 回转座底面至原点的安装偏移（默认 Thickness × 1.5）。 -->
                    <TranslateTransform3D OffsetY="0.1275" />
                    <TranslateTransform3D OffsetY="{Binding MountHeight, ElementName=Lift, Mode=OneWay}" />
                </Transform3DGroup>
            </hardware:ArmVisual3D.Transform>
            <hardware:ArmVisual3D.Attachments>
                <hardware:FluidPipeVisual3D x:Name="DiwPipe"
                    IsFlowing="{Binding DataContext.DiwIsFlowing, ElementName=PipeScene, Mode=OneWay}"
                    Length="{Binding Length, ElementName=Arm, Mode=OneWay}"
                    BodyColor="{StaticResource DarkHardwareBodyColor}"
                    HighlightColor="{Binding Color, Source={StaticResource DarkAccent}, Mode=OneWay}">
                    <hardware:FluidPipeVisual3D.Transform>
                        <TranslateTransform3D OffsetY="0.1" OffsetZ="-0.075" />
                    </hardware:FluidPipeVisual3D.Transform>
                </hardware:FluidPipeVisual3D>
                <hardware:FluidPipeVisual3D x:Name="Sc1Pipe"
                    IsFlowing="{Binding DataContext.Sc1IsFlowing, ElementName=PipeScene, Mode=OneWay}"
                    Length="{Binding Length, ElementName=Arm, Mode=OneWay}"
                    BodyColor="{StaticResource DarkHardwareBodyColor}"
                    HighlightColor="{Binding Color, Source={StaticResource DarkAccent}, Mode=OneWay}">
                    <hardware:FluidPipeVisual3D.Transform>
                        <TranslateTransform3D OffsetY="0.1" OffsetZ="0.075" />
                    </hardware:FluidPipeVisual3D.Transform>
                </hardware:FluidPipeVisual3D>
            </hardware:ArmVisual3D.Attachments>
        </hardware:ArmVisual3D>
    </Viewport3D>
    <TextBlock Grid.Row="2" Margin="24,6,24,0" FontSize="{StaticResource Size13}" Foreground="{StaticResource DarkDisabledText}">
        <Run Text="DIW：" /><Run Text="{Binding DiwIsFlowing}" /><Run Text="    SC1：" /><Run Text="{Binding Sc1IsFlowing}" />
        <Run Text="    ·    管路挂载在 Arm 上，独立控制出液" />
    </TextBlock>
</Grid>
