<UserControl x:Class="CdsAssemblyPreview.HardwareCatalogPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:CdsAssemblyPreview" xmlns:fluid="clr-namespace:xyz.Client.Presentation.Controls.Fluid;assembly=xyz.Client.Presentation" xmlns:controls="clr-namespace:xyz.Client.Presentation.Controls;assembly=xyz.Client.Presentation">
 <Grid Margin="22" Background="{DynamicResource DarkWindowBackground}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18">
   <StackPanel><TextBlock Text="{DynamicResource hw.title}" FontSize="{DynamicResource Size24}" FontWeight="SemiBold"/>
    <TextBlock Text="{DynamicResource hw.subtitle}" Style="{DynamicResource PreviewMutedTextStyle}" Margin="0,7,0,0"/></StackPanel>
   <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource DarkAccentSoft}" CornerRadius="6" Padding="14,8">
    <TextBlock Text="{DynamicResource hw.sample}" Foreground="{DynamicResource DarkAccent}"/></Border>
  </Grid>
  <Border Grid.Row="1" Style="{DynamicResource PreviewCardStyle}" Padding="12,10" Margin="0,0,0,14">
   <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
     <TextBlock Text="{Binding Count}" Style="{DynamicResource PreviewCountStyle}"/><TextBlock Text="{DynamicResource hw.count}" Style="{DynamicResource PreviewCountLabelStyle}"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal">
     <TextBlock Text="{DynamicResource hw.category}" VerticalAlignment="Center" Margin="0,0,10,0"/>
     <ComboBox x:Name="GroupPicker" ItemsSource="{Binding Groups}" SelectedItem="{Binding Group}" DisplayMemberPath="Title" Width="160" Style="{DynamicResource ToolbarComboBoxStyle}"/>
     <TextBlock Text="{DynamicResource hw.search}" VerticalAlignment="Center" Margin="8,0,10,0"/>
     <controls:InputTextBox DataType="Text" Value="{Binding Query}" Width="210" Style="{DynamicResource ToolbarTextBoxStyle}" Margin="0" ToolTip="{DynamicResource hw.search_tip}"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl x:Name="Cards" ItemsSource="{Binding ItemsView}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Button Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=local:HardwareCatalogPage}}" CommandParameter="{Binding}" Style="{DynamicResource HardwareCardButtonStyle}">
       <StackPanel><Grid Margin="0,0,0,5"><TextBlock Text="{Binding Definition.Title}" FontSize="{DynamicResource Size16}" FontWeight="SemiBold" Margin="0,0,32,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Definition.Title}"/>
        <TextBlock Text="{Binding Definition.Tag}" HorizontalAlignment="Right" Foreground="{DynamicResource DarkDisabledText}" FontSize="{DynamicResource Size12}"/></Grid>
        <TextBlock Text="{Binding Definition.GroupTitle}" Style="{DynamicResource PreviewMutedTextStyle}" FontSize="{DynamicResource Size12}"/>
        <fluid:HardwareVisual Width="216" Height="138" Kind="{Binding Definition.Kind}" State="{Binding State}" Reading="{Binding Reading}" Target="{Binding Target}" Unit="{Binding Unit}" IsSelected="{Binding IsSelected}"/>
        <TextBlock Text="{Binding StateText}" Style="{DynamicResource HardwareStateTextStyle}" HorizontalAlignment="Center"/>
       </StackPanel>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
   <Border Grid.Column="2" Style="{DynamicResource PreviewCardStyle}" Padding="14">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="{Binding Selected.Definition.Title}" FontSize="{DynamicResource Size20}" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Selected.Definition.Description}" TextWrapping="Wrap" Style="{DynamicResource PreviewMutedTextStyle}" Margin="0,8,0,10"/></StackPanel>
     <Border Grid.Row="1" Style="{DynamicResource PreviewCardStyle}" Background="{DynamicResource DarkWindowBackground}">
      <Viewbox Stretch="Uniform"><Canvas x:Name="DemoStage" Width="280" Height="220" Background="Transparent" ClipToBounds="True" Focusable="True"
          PreviewMouseLeftButtonDown="OnDemoDown" MouseMove="OnDemoMove" PreviewMouseLeftButtonUp="OnDemoUp" LostMouseCapture="OnDemoLostCapture">
       <fluid:HardwareVisual x:Name="DemoVisual" Canvas.Left="{Binding Selected.X}" Canvas.Top="{Binding Selected.Y}" Width="{Binding Selected.SymbolWidth}" Height="{Binding Selected.SymbolHeight}"
           Kind="{Binding Selected.Definition.Kind}" State="{Binding Selected.State}" Reading="{Binding Selected.Reading}" Target="{Binding Selected.Target}" Unit="{Binding Selected.Unit}" IsSelected="True" RenderTransformOrigin="0.5,0.5">
        <fluid:HardwareVisual.RenderTransform><RotateTransform Angle="{Binding Selected.Angle}"/></fluid:HardwareVisual.RenderTransform>
       </fluid:HardwareVisual>
      </Canvas></Viewbox>
     </Border>
     <TextBlock Grid.Row="2" Text="{DynamicResource hw.move_tip}" Style="{DynamicResource PreviewMutedTextStyle}" FontSize="{DynamicResource Size12}" Margin="0,8,0,10" TextWrapping="Wrap"/>
     <TabControl x:Name="DetailsTabs" Grid.Row="3" Style="{DynamicResource PreviewInspectorStyle}">
      <TabItem Header="{DynamicResource hw.tab.values}" Style="{DynamicResource PreviewInspectorTabStyle}">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="2,14,8,8">
        <StackPanel Style="{DynamicResource HardwareReadingPanelStyle}">
         <TextBlock Text="{DynamicResource hw.reading}" Margin="0,0,0,6"/>
         <controls:InputTextBox x:Name="ReadingInput" DataType="Decimal" Value="{Binding Selected.Reading}" Minimum="{Binding Selected.Definition.Minimum}" Maximum="{Binding Selected.Definition.Maximum}" Style="{DynamicResource ToolbarTextBoxStyle}" Margin="0,0,0,12"/>
         <TextBlock Text="{DynamicResource hw.unit}" Margin="0,0,0,6"/>
         <controls:InputTextBox DataType="Text" Value="{Binding Selected.Unit}" Style="{DynamicResource ToolbarTextBoxStyle}" Margin="0,0,0,12"/>
        </StackPanel>
        <StackPanel Style="{DynamicResource HardwareTargetPanelStyle}">
         <TextBlock Text="{DynamicResource hw.target}" Margin="0,0,0,6"/>
         <controls:InputTextBox x:Name="TargetInput" DataType="Decimal" Value="{Binding Selected.Target}" Minimum="{Binding Selected.Definition.Minimum}" Maximum="{Binding Selected.Definition.Maximum}" Style="{DynamicResource ToolbarTextBoxStyle}" Margin="0,0,0,12"/>
        </StackPanel>
        <TextBlock Text="{Binding Selected.StateText}" Style="{DynamicResource HardwareSelectedStateTextStyle}" Margin="0,0,0,10"/>
        <UniformGrid Columns="2">
         <Button x:Name="ActiveButton" Content="{Binding Selected.ActiveText}" Command="{Binding StateCommand}" CommandParameter="{x:Static fluid:HardwareState.Active}" Style="{DynamicResource ToolbarOutlinedButtonStyle}"/>
         <Button Content="{Binding Selected.StopText}" Command="{Binding StateCommand}" CommandParameter="{x:Static fluid:HardwareState.Stopped}" Style="{DynamicResource ToolbarOutlinedButtonStyle}"/>
         <Button x:Name="FaultButton" Content="{DynamicResource hw.state.fault}" Command="{Binding StateCommand}" CommandParameter="{x:Static fluid:HardwareState.Fault}" Style="{DynamicResource HardwareFaultButtonStyle}"/>
         <Button x:Name="UnknownButton" Content="{DynamicResource hw.state.unknown}" Command="{Binding StateCommand}" CommandParameter="{x:Static fluid:HardwareState.Unknown}" Style="{DynamicResource ToolbarOutlinedButtonStyle}"/>
        </UniformGrid>
        <Button Content="{DynamicResource hw.reset}" Command="{Binding ResetCommand}" Style="{DynamicResource ToolbarOutlinedButtonStyle}" Margin="0,10,0,0"/>
       </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource hw.tab.appearance}" Style="{DynamicResource PreviewInspectorTabStyle}">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="2,14,8,8">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="X" Margin="0,0,0,6"/><controls:InputTextBox DataType="Decimal" Value="{Binding Selected.X}" Minimum="0" Maximum="{Binding Selected.MaxX}" Style="{DynamicResource ToolbarTextBoxStyle}" Margin="0"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Y" Margin="0,0,0,6"/><controls:InputTextBox DataType="Decimal" Value="{Binding Selected.Y}" Minimum="0" Maximum="{Binding Selected.MaxY}" Style="{DynamicResource ToolbarTextBoxStyle}" Margin="0"/></StackPanel>
        </Grid>
        <TextBlock Text="{DynamicResource cdsp.parameter.Width}" Margin="0,12,0,6"/><controls:InputTextBox x:Name="SymbolWidthInput" DataType="Decimal" Value="{Binding Selected.SymbolWidth}" Minimum="80" Maximum="260" Style="{DynamicResource ToolbarTextBoxStyle}" Margin="0"/>
        <TextBlock Text="{DynamicResource cdsp.parameter.Height}" Margin="0,12,0,6"/><controls:InputTextBox DataType="Decimal" Value="{Binding Selected.SymbolHeight}" Minimum="80" Maximum="180" Style="{DynamicResource ToolbarTextBoxStyle}" Margin="0"/>
        <TextBlock Text="{DynamicResource cdsp.parameter.Angle}" Margin="0,12,0,6"/><controls:InputTextBox x:Name="SymbolAngleInput" DataType="Decimal" Value="{Binding Selected.Angle}" Minimum="-360" Maximum="360" Style="{DynamicResource ToolbarTextBoxStyle}" Margin="0"/>
       </StackPanel></ScrollViewer>
      </TabItem>
     </TabControl>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
