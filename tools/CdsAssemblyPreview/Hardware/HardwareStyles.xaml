<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CdsAssemblyPreview" xmlns:fluid="clr-namespace:xyz.Client.Presentation.Controls.Fluid;assembly=xyz.Client.Presentation">
 <Style x:Key="HardwareShellTabsStyle" TargetType="TabControl" BasedOn="{StaticResource PreviewInspectorStyle}">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid Background="{TemplateBinding Background}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TabPanel IsItemsHost="True" Margin="22,10,22,0"/><ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
  </Grid></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="HardwareCardButtonStyle" TargetType="Button">
  <Setter Property="Width" Value="250"/><Setter Property="Height" Value="230"/><Setter Property="Margin" Value="0,0,12,12"/><Setter Property="Padding" Value="14,12"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource DarkPrimaryText}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Card" Background="{DynamicResource DarkSurfaceBackground}" BorderBrush="{DynamicResource DarkBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource DarkAccent}"/></Trigger>
    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource DarkAccent}"/><Setter TargetName="Card" Property="Background" Value="{DynamicResource DarkAccentSoft}"/></DataTrigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="HardwareStateTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PreviewMutedTextStyle}">
  <Setter Property="FontSize" Value="{DynamicResource Size12}"/><Style.Triggers>
   <DataTrigger Binding="{Binding State}" Value="{x:Static fluid:HardwareState.Active}"><Setter Property="Foreground" Value="{DynamicResource DarkSignalLampOn}"/></DataTrigger>
   <DataTrigger Binding="{Binding State}" Value="{x:Static fluid:HardwareState.Fault}"><Setter Property="Foreground" Value="{DynamicResource DarkAlarmStatus}"/></DataTrigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="HardwareSelectedStateTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PreviewMutedTextStyle}">
  <Setter Property="FontSize" Value="{DynamicResource Size14}"/><Style.Triggers>
   <DataTrigger Binding="{Binding Selected.State}" Value="{x:Static fluid:HardwareState.Active}"><Setter Property="Foreground" Value="{DynamicResource DarkSignalLampOn}"/></DataTrigger>
   <DataTrigger Binding="{Binding Selected.State}" Value="{x:Static fluid:HardwareState.Fault}"><Setter Property="Foreground" Value="{DynamicResource DarkAlarmStatus}"/></DataTrigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="HardwareReadingPanelStyle" TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
  <Style.Triggers><DataTrigger Binding="{Binding Selected.Definition.HasReading}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
 </Style>
 <Style x:Key="HardwareTargetPanelStyle" TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
  <Style.Triggers><DataTrigger Binding="{Binding Selected.Definition.HasTarget}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
 </Style>
 <Style x:Key="HardwareFaultButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarOutlinedButtonStyle}">
  <Style.Triggers><DataTrigger Binding="{Binding Selected.IsDi}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
 </Style>
 <Style x:Key="PipelineProcessPanelStyle" TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
  <Style.Triggers><DataTrigger Binding="{Binding IsProcessSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
 </Style>
 <Style x:Key="PipelineHeaterPanelStyle" TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
  <Style.Triggers><DataTrigger Binding="{Binding Selected.Kind}" Value="Heater"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
 </Style>
 <Style x:Key="PipelineFlowTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PreviewMutedTextStyle}">
  <Setter Property="Text" Value="{DynamicResource pipeline.no_flow}"/>
  <Style.Triggers><DataTrigger Binding="{Binding IsFlowing}" Value="True"><Setter Property="Text" Value="{DynamicResource pipeline.flowing}"/><Setter Property="Foreground" Value="{DynamicResource DarkAccent}"/></DataTrigger></Style.Triggers>
 </Style>
 <Style x:Key="PipelineStateTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PreviewMutedTextStyle}">
  <Style.Triggers>
   <DataTrigger Binding="{Binding SelectedHardware.State}" Value="{x:Static fluid:HardwareState.Active}"><Setter Property="Foreground" Value="{DynamicResource DarkSignalLampOn}"/></DataTrigger>
   <DataTrigger Binding="{Binding SelectedHardware.State}" Value="{x:Static fluid:HardwareState.Fault}"><Setter Property="Foreground" Value="{DynamicResource DarkAlarmStatus}"/></DataTrigger>
  </Style.Triggers>
 </Style>
</ResourceDictionary>
