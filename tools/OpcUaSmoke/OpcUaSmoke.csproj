<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\xyz.Core\Service\xyz.Elements\xyz.Elements.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 冒烟共用的容器：元件照树进容器、换单例时重建（宿主里是 ASP.NET 自己的容器） -->
