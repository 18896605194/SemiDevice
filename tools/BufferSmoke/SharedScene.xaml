<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hardware="clr-namespace:xyz.Client.Presentation.Controls.ThreeD;assembly=xyz.Client.Presentation"
      x:Name="Host" Width="360" Height="320">
    <Viewport3D>
        <Viewport3D.Camera>
            <OrthographicCamera Position="3,3,6" LookDirection="-3,-2,-6" UpDirection="0,1,0" Width="5" />
        </Viewport3D.Camera>
        <ModelVisual3D>
            <ModelVisual3D.Content>
                <AmbientLight Color="{StaticResource DarkHardwareAmbientLightColor}" />
            </ModelVisual3D.Content>
        </ModelVisual3D>
        <hardware:BufferVisual3D x:Name="SharedRack"
                                FirstSlot="{Binding DataContext.FirstSlot, ElementName=Host}"
                                SlotCount="{Binding DataContext.SlotCount, ElementName=Host}"
                                Wafers="{Binding DataContext.Wafers, ElementName=Host}">
            <hardware:BufferVisual3D.Transform>
                <TranslateTransform3D OffsetX="0.2" />
            </hardware:BufferVisual3D.Transform>
        </hardware:BufferVisual3D>
    </Viewport3D>
</Grid>
