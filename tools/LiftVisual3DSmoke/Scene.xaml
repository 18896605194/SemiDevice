<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hardware="clr-namespace:xyz.Client.Presentation.Controls.ThreeD;assembly=xyz.Client.Presentation"
      x:Name="LiftScene" Width="320" Height="420" Background="{StaticResource DarkSurfaceBackground}">
    <Grid.RowDefinitions>
        <RowDefinition Height="72" />
        <RowDefinition Height="*" />
        <RowDefinition Height="40" />
    </Grid.RowDefinitions>
    <StackPanel Margin="22,18,22,0">
        <TextBlock Text="Lift 升降气缸" FontSize="{StaticResource Size18}" Foreground="{StaticResource DarkPrimaryText}" />
        <TextBlock x:Name="StateTitle" Margin="0,6,0,0" Text="下位 · 静止"
                   FontSize="{StaticResource Size13}" Foreground="{StaticResource DarkDisabledText}" />
    </StackPanel>
    <Viewport3D Grid.Row="1" x:Name="Viewport" IsHitTestVisible="False">
        <Viewport3D.Camera>
            <OrthographicCamera Position="2.4,2.3,4" LookDirection="-2.4,-1.45,-4"
                                UpDirection="0,1,0" Width="1.85" />
        </Viewport3D.Camera>
        <ModelVisual3D>
            <ModelVisual3D.Content>
                <Model3DGroup>
                    <AmbientLight Color="#707070" />
                    <DirectionalLight Color="#C0C0C0" Direction="-1,-3,-2" />
                </Model3DGroup>
            </ModelVisual3D.Content>
        </ModelVisual3D>
        <hardware:LiftVisual3D x:Name="Lift"
            IsRaised="{Binding DataContext.IsRaised, ElementName=LiftScene, Mode=OneWay}"
            BodyColor="{StaticResource DarkHardwareBodyColor}"
            HighlightColor="{Binding Color, Source={StaticResource DarkAccent}, Mode=OneWay}" />
    </Viewport3D>
    <TextBlock Grid.Row="2" Margin="22,8,22,0" FontSize="{StaticResource Size12}" Foreground="{StaticResource DarkDisabledText}">
        <Run Text="外部仅绑定 IsRaised：" /><Run Text="{Binding IsRaised, Mode=OneWay}" />
    </TextBlock>
</Grid>
