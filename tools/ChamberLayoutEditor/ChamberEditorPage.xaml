<UserControl x:Class="ChamberLayoutEditor.ChamberEditorPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ChamberLayoutEditor"
 xmlns:controls="clr-namespace:xyz.Client.Presentation.Controls;assembly=xyz.Client.Presentation"
 Background="{DynamicResource DarkWindowBackground}" Foreground="{DynamicResource DarkPrimaryText}">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,14">
   <StackPanel>
    <TextBlock Text="{DynamicResource chambereditor.title}" FontSize="{DynamicResource Size22}" FontWeight="SemiBold"/>
    <TextBlock Margin="0,5,0,0" Text="{Binding Document.ComponentRoot}" Foreground="{DynamicResource DarkSecondaryText}"/>
   </StackPanel>
   <TextBlock Text="{DynamicResource chambereditor.offline}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource DarkSecondaryText}"/>
  </DockPanel>
  <Border Grid.Row="1" Style="{DynamicResource ToolbarBorderStyle}" Margin="0,0,0,12">
   <WrapPanel>
    <StackPanel x:Name="FileActions" Orientation="Horizontal">
     <Button Content="{DynamicResource chambereditor.import}" Click="OnImportMachine" Style="{DynamicResource ToolbarButtonStyle}"/>
     <Button Content="{DynamicResource chambereditor.open}" Click="OnOpen" Style="{DynamicResource ToolbarOutlinedButtonStyle}"/>
     <Button Content="{DynamicResource chambereditor.save}" Click="OnSave" Style="{DynamicResource ToolbarButtonStyle}"/>
    </StackPanel>
    <Button Content="{DynamicResource chambereditor.undo}" Command="{Binding UndoCommand}" Style="{DynamicResource ToolbarOutlinedButtonStyle}"/>
    <Button Content="{DynamicResource chambereditor.redo}" Command="{Binding RedoCommand}" Style="{DynamicResource ToolbarOutlinedButtonStyle}"/>
    <CheckBox Content="{DynamicResource chambereditor.snap}" IsChecked="{Binding Snap}" Margin="8,0,16,0" VerticalAlignment="Center"/>
    <CheckBox Content="{DynamicResource chambereditor.preview}" IsChecked="{Binding IsPreview}" VerticalAlignment="Center"/>
   </WrapPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
   <Border Style="{DynamicResource ZoneBorderStyle}">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="14">
      <TextBlock Text="{DynamicResource chambereditor.components}" FontWeight="SemiBold" FontSize="{DynamicResource Size16}"/>
      <TextBlock Text="{DynamicResource chambereditor.components_tip}" Foreground="{DynamicResource DarkSecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <ComboBox x:Name="ChamberPicker" DisplayMemberPath="ComponentRoot" SelectionChanged="OnChamberChanged" Margin="0,10,0,0" Visibility="Collapsed"/>
     </StackPanel>
     <Expander Header="{DynamicResource chambereditor.base_size}" DockPanel.Dock="Bottom" Margin="12" IsExpanded="True">
      <StackPanel IsEnabled="{Binding IsEditing}" Margin="0,8,0,0">
       <TextBlock Text="{DynamicResource chambereditor.base_length}"/><controls:InputTextBox DataType="Decimal" Minimum="1" Maximum="20" Value="{Binding Document.BaseLength}" Margin="0,4,0,8"/>
       <TextBlock Text="{DynamicResource chambereditor.base_width}"/><controls:InputTextBox DataType="Decimal" Minimum="1" Maximum="20" Value="{Binding Document.BaseWidth}" Margin="0,4,0,8"/>
       <TextBlock Text="{DynamicResource chambereditor.base_thickness}"/><controls:InputTextBox DataType="Decimal" Minimum="0.01" Maximum="3" Value="{Binding Document.BaseThickness}" Margin="0,4,0,0"/>
      </StackPanel>
     </Expander>
     <ListBox ItemsSource="{Binding Parts}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0" Margin="6">
      <ListBox.ItemTemplate><DataTemplate>
       <StackPanel Margin="6,9"><TextBlock Text="{Binding Id}" FontWeight="SemiBold"/><TextBlock Text="{Binding KindTitle}" Foreground="{DynamicResource DarkSecondaryText}" Margin="0,5,0,0" FontSize="{DynamicResource Size12}"/></StackPanel>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <Border Grid.Column="2" Style="{DynamicResource ZoneBorderStyle}">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="14,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
       <TextBlock Text="{DynamicResource chambereditor.view}" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <ComboBox x:Name="ViewPicker" SelectedIndex="0" SelectionChanged="OnViewChanged" Width="110" Style="{DynamicResource ToolbarComboBoxStyle}" Margin="0,0,10,0">
        <ComboBoxItem Tag="Perspective" Content="{DynamicResource chambereditor.view.Perspective}"/>
        <ComboBoxItem Tag="Top" Content="{DynamicResource chambereditor.view.Top}"/>
        <ComboBoxItem Tag="Front" Content="{DynamicResource chambereditor.view.Front}"/>
        <ComboBoxItem Tag="Back" Content="{DynamicResource chambereditor.view.Back}"/>
        <ComboBoxItem Tag="Left" Content="{DynamicResource chambereditor.view.Left}"/>
        <ComboBoxItem Tag="Right" Content="{DynamicResource chambereditor.view.Right}"/>
       </ComboBox>
       <Button Content="{DynamicResource chambereditor.default_view}" Click="OnDefaultView" Style="{DynamicResource ToolbarOutlinedButtonStyle}"/>
      </StackPanel>
      <TextBlock Text="{DynamicResource chambereditor.scene}" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </DockPanel>
     <local:ChamberLayoutScene x:Name="Scene" Grid.Row="1" MinHeight="280"/>
     <TextBlock Grid.Row="2" Margin="14,10" Text="{DynamicResource chambereditor.gesture_tip}" Foreground="{DynamicResource DarkSecondaryText}" TextWrapping="Wrap" FontSize="{DynamicResource Size12}"/>
    </Grid>
   </Border>
   <Border Grid.Column="4" Style="{DynamicResource ZoneBorderStyle}">
    <TabControl SelectedIndex="{Binding SelectedInspectorTab, Mode=TwoWay}" Margin="8" Background="Transparent" BorderThickness="0">
     <TabItem Header="{DynamicResource chambereditor.placement_tab}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel IsEnabled="{Binding IsEditing}" Margin="8,16,8,8">
        <TextBlock Text="{Binding Selected.Component}" Foreground="{DynamicResource DarkSecondaryText}" Margin="0,0,0,18"/>
        <TextBlock Text="{DynamicResource chambereditor.x}"/><controls:InputTextBox DataType="Decimal" Minimum="-9" Maximum="9" Value="{Binding Selected.X}" Margin="0,6,0,12"/>
        <TextBlock Text="{DynamicResource chambereditor.y}"/><controls:InputTextBox DataType="Decimal" Minimum="-3" Maximum="3" Value="{Binding Selected.Y}" Margin="0,6,0,12"/>
        <TextBlock Text="{DynamicResource chambereditor.z}"/><controls:InputTextBox DataType="Decimal" Minimum="-9" Maximum="9" Value="{Binding Selected.Z}" Margin="0,6,0,12"/>
        <TextBlock Text="{DynamicResource chambereditor.yaw}"/><controls:InputTextBox DataType="Decimal" Minimum="-360" Maximum="360" Value="{Binding Selected.Yaw}" Margin="0,6,0,12"/>
        <Button Content="{DynamicResource chambereditor.rotate}" Command="{Binding RotateCommand}" Style="{DynamicResource ToolbarOutlinedButtonStyle}" Margin="0,0,0,16"/>
        <TextBlock Text="{DynamicResource chambereditor.home_angle}"/><controls:InputTextBox DataType="Decimal" Minimum="-360" Maximum="360" Value="{Binding Selected.HomeAngle}" IsEnabled="{Binding Selected.IsArm}" Margin="0,6,0,16"/>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
     <TabItem Header="{DynamicResource chambereditor.dimensions_tab}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel IsEnabled="{Binding IsEditing}" Margin="8,16,8,8">
        <TextBlock Text="{Binding Selected.Component}" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="{DynamicResource chambereditor.size_units}" Foreground="{DynamicResource DarkSecondaryText}" TextWrapping="Wrap" Margin="0,0,0,14"/>
        <CheckBox Content="{DynamicResource chambereditor.auto_length}" IsChecked="{Binding Selected.AutoLength}" Margin="0,0,0,16"
         Visibility="{Binding Selected.IsArm, Converter={x:Static local:ChamberEditorPage.BooleanVisibility}}"/>
        <ItemsControl ItemsSource="{Binding Selected.Dimensions}">
         <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12">
          <TextBlock Text="{Binding Title}"/>
          <controls:InputTextBox DataType="Decimal" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}" IsEnabled="{Binding IsEditable}" Margin="0,6,0,0"/>
         </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
     <TabItem Header="{DynamicResource chambereditor.motion}">
      <StackPanel IsEnabled="{Binding IsPreview}" Margin="8,16,8,8">
       <TextBlock Text="{DynamicResource chambereditor.reach}"/>
       <Slider Value="{Binding Reach}" Minimum="0" Maximum="1" TickFrequency="0.05" Margin="0,10,0,8"/>
       <StackPanel Orientation="Horizontal"><Button Content="{DynamicResource chambereditor.home}" Command="{Binding HomeCommand}" Style="{DynamicResource ToolbarOutlinedButtonStyle}"/><Button Content="{DynamicResource chambereditor.center}" Command="{Binding CenterCommand}" Style="{DynamicResource ToolbarOutlinedButtonStyle}"/></StackPanel>
       <CheckBox Content="{DynamicResource chambereditor.lift}" IsChecked="{Binding Lift}" Margin="0,14,0,0"/>
       <CheckBox Content="{DynamicResource chambereditor.spray}" IsChecked="{Binding Spray}" Margin="0,14,0,0"/>
       <CheckBox Content="{DynamicResource chambereditor.spin}" IsChecked="{Binding Spin}" Margin="0,14,0,0"/>
      </StackPanel>
     </TabItem>
    </TabControl>
   </Border>
  </Grid>
  <DockPanel Grid.Row="3" Margin="0,12,0,0">
   <StackPanel><TextBlock Text="{Binding Error}" Foreground="{DynamicResource DarkAlarmStatus}" TextWrapping="Wrap"/><TextBlock Text="{Binding Warning}" Foreground="{DynamicResource DarkSecondaryText}" TextWrapping="Wrap"/></StackPanel>
   <TextBlock x:Name="FileStatus" HorizontalAlignment="Right" Foreground="{DynamicResource DarkSecondaryText}"/>
  </DockPanel>
 </Grid>
</UserControl>
