<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hardware="clr-namespace:xyz.Client.Presentation.Controls.ThreeD;assembly=xyz.Client.Presentation"
      x:Name="ArmScene" Width="760" Height="340" Background="{StaticResource DarkSurfaceBackground}">
    <Grid.RowDefinitions>
        <RowDefinition Height="56" />
        <RowDefinition Height="*" />
        <RowDefinition Height="40" />
    </Grid.RowDefinitions>
    <StackPanel Margin="24,16,24,0" Orientation="Horizontal">
        <TextBlock Text="Arm 摆臂" FontSize="{StaticResource Size18}" Foreground="{StaticResource DarkPrimaryText}" />
        <TextBlock x:Name="StateTitle" Margin="18,3,0,0" Text="静止 · 默认材质"
                   FontSize="{StaticResource Size13}" Foreground="{StaticResource DarkDisabledText}" />
    </StackPanel>
    <Viewport3D Grid.Row="1" x:Name="Viewport" IsHitTestVisible="False">
        <Viewport3D.Camera>
            <OrthographicCamera Position="3.1,2.6,4.8" LookDirection="-2,-2.6,-4.8"
                                UpDirection="0,1,0" Width="3.5" />
        </Viewport3D.Camera>
        <ModelVisual3D>
            <ModelVisual3D.Content>
                <Model3DGroup>
                    <AmbientLight Color="#707070" />
                    <DirectionalLight Color="#C0C0C0" Direction="-1,-3,-2" />
                </Model3DGroup>
            </ModelVisual3D.Content>
        </ModelVisual3D>
        <hardware:ArmVisual3D x:Name="Arm"
            Angle="{Binding DataContext.Angle, ElementName=ArmScene, Mode=OneWay}"
            IsMoving="{Binding DataContext.IsMoving, ElementName=ArmScene, Mode=OneWay}"
            BodyColor="{StaticResource DarkHardwareBodyColor}"
            HighlightColor="{Binding Color, Source={StaticResource DarkAccent}, Mode=OneWay}" />
    </Viewport3D>
    <TextBlock Grid.Row="2" Margin="24,8,24,0" FontSize="{StaticResource Size12}" Foreground="{StaticResource DarkDisabledText}">
        <Run Text="当前角度：" /><Run Text="{Binding Angle, Mode=OneWay}" /><Run Text="°    ·    外部状态绑定" />
    </TextBlock>
</Grid>
