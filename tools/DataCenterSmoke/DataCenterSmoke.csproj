<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 数据曲线导出要连客户端那半一起测（写 xlsx、进度弹框），所以带 WPF -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\xyz.Core\Service\xyz.Service\xyz.Service.csproj" />
    <ProjectReference Include="..\..\xyz.Core\Client\xyz.Client.DataCenter\xyz.Client.DataCenter.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 冒烟共用的容器：元件照树进容器、换单例时重建（宿主里是 ASP.NET 自己的容器） -->
    <Compile Include="..\SmokeShared\SmokeIoc.cs" Link="SmokeIoc.cs" />
    <Compile Include="..\SmokeShared\SmokeEvents.cs" Link="SmokeEvents.cs" />
    <!-- 直接调服务时带上请求头（操作人） -->
    <Compile Include="..\SmokeShared\SmokeCall.cs" Link="SmokeCall.cs" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>
</Project>
