<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hardware="clr-namespace:xyz.Client.Presentation.Controls.ThreeD;assembly=xyz.Client.Presentation"
      x:Name="BaseScene" Width="580" Height="410" Background="{StaticResource DarkSurfaceBackground}">
    <Grid.RowDefinitions>
        <RowDefinition Height="55" />
        <RowDefinition Height="*" />
        <RowDefinition Height="30" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="StateTitle" Margin="22,16,22,0" Text="Door · 下位关闭"
               FontSize="{StaticResource Size18}" Foreground="{StaticResource DarkPrimaryText}" />
    <Viewport3D Grid.Row="1" x:Name="Viewport" IsHitTestVisible="False">
        <Viewport3D.Camera>
            <OrthographicCamera Position="5,5.2,7" LookDirection="-5,-4.85,-7" UpDirection="0,1,0" Width="7.5" />
        </Viewport3D.Camera>
        <ModelVisual3D>
            <ModelVisual3D.Content>
                <Model3DGroup>
                    <AmbientLight Color="#707070" />
                    <DirectionalLight Color="#C0C0C0" Direction="-1,-3,-2" />
                </Model3DGroup>
            </ModelVisual3D.Content>
        </ModelVisual3D>

            <hardware:ChamberBaseVisual3D x:Name="Base"
                Length="5.6"
                Width="4.4"
                Thickness="0.12">
                <hardware:ChamberBaseVisual3D.Attachments>
                    <hardware:DoorVisual3D x:Name="Door"
                        IsOpen="{Binding DataContext.IsOpen, ElementName=BaseScene, Mode=OneWay}">
                        <hardware:DoorVisual3D.Transform>
                            <TranslateTransform3D OffsetX="-0.5" OffsetZ="2.3" />
                        </hardware:DoorVisual3D.Transform>
                    </hardware:DoorVisual3D>
                    <hardware:BowlVisual3D x:Name="Bowl">
                        <hardware:BowlVisual3D.Transform>
                            <TranslateTransform3D OffsetX="-0.5" />
                        </hardware:BowlVisual3D.Transform>
                    </hardware:BowlVisual3D>
                    <hardware:HomeCupVisual3D x:Name="HomeCup">
                        <hardware:HomeCupVisual3D.Transform>
                            <TranslateTransform3D OffsetX="1.55" OffsetZ="1.1" />
                        </hardware:HomeCupVisual3D.Transform>
                    </hardware:HomeCupVisual3D>
                    <hardware:LiftVisual3D x:Name="Lift">
                        <hardware:LiftVisual3D.Transform>
                            <TranslateTransform3D OffsetX="1.45" OffsetZ="-1.25" />
                        </hardware:LiftVisual3D.Transform>
                    </hardware:LiftVisual3D>
                    <hardware:ArmVisual3D x:Name="Arm" Angle="-146">
                        <hardware:ArmVisual3D.Transform>
                            <Transform3DGroup>
                                <TranslateTransform3D OffsetX="1.45" OffsetY="0.1275" OffsetZ="-1.25" />
                                <TranslateTransform3D OffsetY="{Binding MountHeight, ElementName=Lift, Mode=OneWay}" />
                            </Transform3DGroup>
                        </hardware:ArmVisual3D.Transform>
                        <hardware:ArmVisual3D.Attachments>
                            <hardware:FluidPipeVisual3D x:Name="Pipe" Length="{Binding Length, ElementName=Arm, Mode=OneWay}" StreamLength="0">
                                <hardware:FluidPipeVisual3D.Transform>
                                    <TranslateTransform3D OffsetY="0.1" OffsetZ="-0.075" />
                                </hardware:FluidPipeVisual3D.Transform>
                            </hardware:FluidPipeVisual3D>
                        </hardware:ArmVisual3D.Attachments>
                    </hardware:ArmVisual3D>
                </hardware:ChamberBaseVisual3D.Attachments>
            </hardware:ChamberBaseVisual3D>
    </Viewport3D>
    <TextBlock Grid.Row="2" Margin="22,3,22,0" Text="前侧升降门 · 上升打开 / 下降关闭（示意）"
               FontSize="{StaticResource Size12}" Foreground="{StaticResource DarkDisabledText}" />
</Grid>



