<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:xyz.Client.Presentation.Controls;assembly=xyz.Client.Presentation"
      xmlns:hardware="clr-namespace:xyz.Client.Presentation.Controls.ThreeD;assembly=xyz.Client.Presentation"
      x:Name="DiskScene" Width="680" Height="350" Background="{StaticResource DarkSurfaceBackground}">
    <Grid.RowDefinitions>
        <RowDefinition Height="55" />
        <RowDefinition Height="*" />
        <RowDefinition Height="35" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
    <TextBlock Margin="22,17,0,0" Text="现有二维 Wafer" FontSize="{StaticResource Size18}" Foreground="{StaticResource DarkPrimaryText}" />
    <TextBlock Grid.Column="1" Margin="22,17,0,0" Text="DiskVisual3D" FontSize="{StaticResource Size18}" Foreground="{StaticResource DarkPrimaryText}" />
    <controls:Wafer x:Name="FlatDisk" Grid.Row="1" Width="210" Height="210" Data="{Binding Wafer}" />
    <Viewport3D Grid.Row="1" Grid.Column="1" x:Name="Viewport" ClipToBounds="True">
        <Viewport3D.Camera>
            <OrthographicCamera Position="2.2,3.4,4" LookDirection="-2.2,-3.4,-4" UpDirection="0,1,0" Width="3.5" />
        </Viewport3D.Camera>
        <ModelVisual3D>
            <ModelVisual3D.Content>
                <Model3DGroup>
                    <AmbientLight Color="#707070" />
                    <DirectionalLight Color="#C0C0C0" Direction="-1,-3,-2" />
                </Model3DGroup>
            </ModelVisual3D.Content>
        </ModelVisual3D>
        <hardware:ChamberBaseVisual3D x:Name="Base" Length="3.3" Width="3.3" Thickness="0.08">
            <hardware:ChamberBaseVisual3D.Attachments>
                <hardware:DiskVisual3D x:Name="Disk"
                    Data="{Binding DataContext.Wafer, ElementName=DiskScene, Mode=OneWay}"
                    RotationSpeed="{Binding DataContext.Speed, ElementName=DiskScene, Mode=OneWay}">
                    <hardware:DiskVisual3D.Transform><TranslateTransform3D OffsetY="0.05" /></hardware:DiskVisual3D.Transform>
                </hardware:DiskVisual3D>
            </hardware:ChamberBaseVisual3D.Attachments>
        </hardware:ChamberBaseVisual3D>
    </Viewport3D>
    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="22,6,0,0" Text="共用片数据和状态色 · 三维盘保留建片 / 删片交互"
               FontSize="{StaticResource Size12}" Foreground="{StaticResource DarkDisabledText}" />
</Grid>
