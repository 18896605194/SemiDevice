<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hardware="clr-namespace:xyz.Client.Presentation.Controls.ThreeD;assembly=xyz.Client.Presentation"
      x:Name="HomeScene" Width="360" Height="370" Background="{StaticResource DarkSurfaceBackground}">
    <Grid.RowDefinitions>
        <RowDefinition Height="65" />
        <RowDefinition Height="*" />
        <RowDefinition Height="35" />
    </Grid.RowDefinitions>
    <StackPanel Margin="22,16,22,0">
        <TextBlock Text="HomeCup" FontSize="{StaticResource Size18}" Foreground="{StaticResource DarkPrimaryText}" />
        <TextBlock x:Name="StateTitle" Margin="0,5,0,0" Text="待机" FontSize="{StaticResource Size13}" Foreground="{StaticResource DarkDisabledText}" />
    </StackPanel>
    <Viewport3D Grid.Row="1" x:Name="Viewport" IsHitTestVisible="False">
        <Viewport3D.Camera>
            <OrthographicCamera Position="1.4,1.7,2.4" LookDirection="-1.4,-1.37,-2.4" UpDirection="0,1,0" Width="1.25" />
        </Viewport3D.Camera>
        <ModelVisual3D>
            <ModelVisual3D.Content>
                <Model3DGroup>
                    <AmbientLight Color="#707070" />
                    <DirectionalLight Color="#C0C0C0" Direction="-1,-3,-2" />
                </Model3DGroup>
            </ModelVisual3D.Content>
        </ModelVisual3D>
        <hardware:HomeCupVisual3D x:Name="HomeCup"
            IsDraining="{Binding DataContext.IsDraining, ElementName=HomeScene, Mode=OneWay}"
            Radius="{Binding DataContext.Radius, ElementName=HomeScene, Mode=OneWay}"
            Height="{Binding DataContext.Height, ElementName=HomeScene, Mode=OneWay}"
            BodyColor="{StaticResource DarkHardwareBodyColor}"
            HighlightColor="{Binding Color, Source={StaticResource DarkAccent}, Mode=OneWay}" />
    </Viewport3D>
    <TextBlock Grid.Row="2" Margin="22,5,22,0" Text="敞口接液 · 底部贯通排液口"
               FontSize="{StaticResource Size12}" Foreground="{StaticResource DarkDisabledText}" />
</Grid>
