<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="ToolbarTextBoxStyle" TargetType="TextBox">
  <Setter Property="MinHeight" Value="34"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Padding" Value="8,4"/>
  <Setter Property="FontSize" Value="{DynamicResource Size14}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Foreground" Value="{DynamicResource DarkPrimaryText}"/><Setter Property="Background" Value="{DynamicResource DarkControlBackground}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource DarkBorderBrush}"/>
 </Style>
 <Style x:Key="SignalLampTextStyle" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource DarkPrimaryText}"/><Setter Property="FontSize" Value="{DynamicResource Size12}"/><Setter Property="Margin" Value="6,0,0,0"/>
 </Style>
 <Style x:Key="SignalLampBorderStyle" TargetType="Border">
  <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="CornerRadius" Value="7"/>
  <Setter Property="Background" Value="{DynamicResource DarkDisabledText}"/>
  <Style.Triggers>
   <Trigger Property="Tag" Value="On"><Setter Property="Background" Value="{DynamicResource DarkSignalLampOn}"/></Trigger>
   <Trigger Property="Tag" Value="Alarm"><Setter Property="Background" Value="{DynamicResource DarkAlarmStatus}"/></Trigger>
   <Trigger Property="Tag" Value="Unknown"><Setter Property="Background" Value="{DynamicResource DarkSignalLampUnknown}"/></Trigger>
  </Style.Triggers>
 </Style>
</ResourceDictionary>
