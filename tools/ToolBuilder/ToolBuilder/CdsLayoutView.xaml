<UserControl x:Class="ToolBuilder.CdsLayoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F3F6FB" Padding="10,7">
            <TextBlock Text="{Binding Description}" ToolTip="{Binding FilePath}" Foreground="#63738C" TextWrapping="Wrap" FontSize="12" />
        </Border>
        <ContentControl Content="{Binding Editor}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </DockPanel>
</UserControl>
