<Window x:Class="ToolBuilder.ElementPicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加元件或分组" Width="1080" Height="750" MinWidth="860" MinHeight="600" WindowStartupLocation="CenterOwner">
    <Grid Margin="22" Background="#F4F6FA">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="添加元件或分组" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ParentPath, StringFormat=添加到：{0}}" FontSize="14" Foreground="#235CCC" Margin="0,7,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#DDE4EF" BorderThickness="1" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Button x:Name="SourcesButton" Content="元件来源…" Click="ShowSourcesClick" HorizontalAlignment="Right" />
                        <TextBlock Text="选择节点类别" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <DockPanel>
                            <ComboBox x:Name="CategoryBox" DockPanel.Dock="Right" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Width="100" Margin="8,0,0,0"/>
                            <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsElement, Converter={StaticResource BoolVisibility}}" ToolTip="搜索元件名称、用途或 Type"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Summary}" Foreground="#728099" Margin="0,8,0,10"/>
                    </StackPanel>
                    <Grid>
                    <TextBlock Text="分组无需选择元件类型。点击「添加分组」即可创建。" TextWrapping="Wrap" Foreground="#63738C" Margin="20" VerticalAlignment="Center" TextAlignment="Center" Visibility="{Binding IsGroup, Converter={StaticResource BoolVisibility}}"/>
                    <DataGrid ItemsSource="{Binding FilteredElements}" SelectedItem="{Binding SelectedElement}" IsReadOnly="True" RowHeight="72" Visibility="{Binding IsElement, Converter={StaticResource BoolVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="分类" Binding="{Binding Category}" Width="65"/>
                            <DataGridTemplateColumn Header="元件 / 用途" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="0,5">
                                            <TextBlock Text="{Binding ShortName}" FontWeight="SemiBold" FontSize="14" TextAlignment="Center"/>
                                            <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" Foreground="#63738C" Margin="0,4,0,0" TextAlignment="Center" ToolTip="{Binding Description}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Background="White" Padding="24" Margin="0,32,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap" Foreground="#63738C" VerticalAlignment="Center" TextAlignment="Center" />
                    </Border>
                    </Grid>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#DDE4EF" BorderThickness="1" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="节点说明" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding SelectedDescription}" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,14"/>
                        <TextBlock Text="{Binding SelectedType}" Foreground="#63738C" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"/>
                        <TextBlock Text="配置项与默认值" FontWeight="SemiBold" Margin="0,8,0,10" Visibility="{Binding IsElement, Converter={StaticResource BoolVisibility}}"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding SelectedAssembly}" TextWrapping="Wrap" Foreground="#728099" FontSize="10" Margin="0,10,0,0"/>
                    <DataGrid ItemsSource="{Binding SelectedProperties}" IsReadOnly="True" RowHeight="48" Visibility="{Binding IsElement, Converter={StaticResource BoolVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="参数" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="默认值" Binding="{Binding DefaultValue}" Width="95"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="#DDE4EF" BorderThickness="1" Padding="16" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="添加后可在主界面修改 Name 和参数。" Foreground="#63738C" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}" Background="#235CCC" Foreground="White" BorderBrush="#235CCC" Padding="20,10"/>
                    <Button Content="取消" IsCancel="True" Padding="16,10"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
