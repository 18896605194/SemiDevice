<Window x:Class="ToolBuilder.SourcesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="元件来源" Width="820" Height="490" MinWidth="650" MinHeight="380" WindowStartupLocation="CenterOwner">
    <Grid Margin="22" Background="#F4F6FA">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="元件来源" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding CatalogSummary}" Foreground="#63738C" Margin="0,7,0,15"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="添加目录…" Command="{Binding AddDirectoryCommand}"/>
            <Button Content="添加 DLL…" Command="{Binding AddDllCommand}"/>
            <Button Content="重新加载" Command="{Binding ReloadCommand}"/>
            <Button Content="移除选中来源" Command="{Binding RemoveSourceCommand}"/>
        </StackPanel>
        <ListBox Grid.Row="2" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" BorderBrush="#DDE4EF" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" ToolTip="{Binding}" Padding="8,12"/></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="完成" IsCancel="True" Padding="20,8" Margin="12,0,0,0"/>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#63738C"/>
        </DockPanel>
    </Grid>
</Window>
