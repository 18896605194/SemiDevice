<Window x:Class="ToolBuilder.OptionsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选项" Width="460" Height="520" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <!-- 配方字段里下拉的选项：一行一个，从上到下就是工艺配方页下拉里的先后；确定后用英文逗号连起来写回表格那一格（也可以不用这个窗口，直接在格子里输入） -->
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="一行一个选项，从上到下就是下拉里的先后。摆臂、药液要跟 machine.xml 里写的一样：腔体下面摆臂的名字、喷嘴的 Chemical。" Foreground="#728099" TextWrapping="Wrap" Margin="0,4,0,12"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="添加" Command="{Binding AddCommand}"/>
                <Button Content="删除" Command="{Binding DeleteCommand}"/>
                <Button Content="上移" Command="{Binding UpCommand}"/>
                <Button Content="下移" Command="{Binding DownCommand}"/>
            </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="确定" IsDefault="True" Click="Ok"/>
            <Button Content="取消" IsCancel="True"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="选项" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Style="{StaticResource GridEditorText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
