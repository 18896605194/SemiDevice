<Window x:Class="ToolBuilder.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ToolBuilder"
        Title="{Binding Title}" Width="1440" Height="940" MinWidth="1120" MinHeight="720" WindowStartupLocation="CenterScreen"
        Closing="WindowClosing">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}"/>
    </Window.InputBindings>
    <Grid Background="#F4F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#15243E" Style="{StaticResource WorkspaceHeaderStyle}">
            <Grid>
                <StackPanel>
                    <TextBlock Text="ToolBuilder" Foreground="White" FontWeight="Bold" FontSize="23"/>
                    <TextBlock Text="设备配置与管路布局编辑" Foreground="#AFBFD8" Margin="0,3,0,0" Style="{StaticResource WorkspaceDetailStyle}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="TreeToggle" Content="收起元件树" Click="ToggleTreeClick" />
                    <Button Content="打开 machine.xml…" Command="{Binding OpenCommand}"/>
                    <Button Content="元件来源…" Click="ShowSourcesClick" ToolTip="{Binding CatalogSummary}"/>
                    <Button Content="保存" Command="{Binding SaveCommand}" Background="#2463EB" Foreground="White" BorderBrush="#2463EB"/>
                    <Button Content="另存为…" Command="{Binding SaveAsCommand}"/>
                    <Button Content="校验配置" Command="{Binding ValidateCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E6EF" BorderThickness="0,0,0,1" Style="{StaticResource WorkspaceFileStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding FilePath}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                    <TextBlock Text="{Binding ConfigDirectory, StringFormat=配置目录：{0}}" Foreground="#728099" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Style="{StaticResource WorkspaceDetailStyle}"/>
                </StackPanel>
                <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                    <Button Content="打开" DockPanel.Dock="Right" Command="{Binding RecentCommand}" Margin="7,0,0,0"/>
                    <ComboBox ItemsSource="{Binding RecentFiles}" SelectedItem="{Binding SelectedRecent}" ToolTip="最近打开的 machine.xml 文件"/>
                </DockPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Style="{StaticResource WorkspaceBodyStyle}">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="TreeColumn" Width="320" MinWidth="220"/><ColumnDefinition x:Name="SplitterColumn" Width="12"/><ColumnDefinition Width="*" MinWidth="660"/></Grid.ColumnDefinitions>
            <Border x:Name="TreePanel" Grid.Column="0" Background="White" BorderBrush="#DDE4EF" BorderThickness="1" Padding="6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="4,4,4,8">
                        <TextBlock Text="machine.xml 根目录" FontWeight="SemiBold" Margin="4,0,0,6" />
                        <WrapPanel>
                            <Button x:Name="AddRootButton" Content="＋ 根元件" Command="{Binding AddRootCommand}" ToolTip="在 machine.xml 最外层添加元件" />
                            <Button x:Name="AddRootGroupButton" Content="＋ 根分组" Command="{Binding AddRootGroupCommand}" ToolTip="在 machine.xml 最外层添加分组" />
                        </WrapPanel>
                    </StackPanel>
                        <TreeView x:Name="ConfigTree" ItemsSource="{Binding Roots}" BorderThickness="0" SelectedItemChanged="TreeSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                            <TreeView.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="添加根元件…" Command="{Binding AddRootCommand}"/>
                                    <MenuItem Header="添加根分组…" Command="{Binding AddRootGroupCommand}"/>
                                </ContextMenu>
                            </TreeView.ContextMenu>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="TreeItemRightClick"/>
                                    <EventSetter Event="Selected" Handler="TreeItemSelected"/>
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="添加子元件…" Command="{Binding AddChildCommand}"/>
                                                <MenuItem Header="添加分组…" Command="{Binding AddGroupCommand}"/>
                                                <Separator/>
                                                <MenuItem Header="复制当前元件" Command="{Binding DuplicateCommand}"/>
                                                <MenuItem Header="删除当前元件" Command="{Binding DeleteCommand}"/>
                                                <Separator/>
                                                <MenuItem Header="添加根元件…" Command="{Binding AddRootCommand}"/>
                                                <MenuItem Header="添加根分组…" Command="{Binding AddRootGroupCommand}"/>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TreeViewItem">
                                                <StackPanel>
                                                    <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0" CornerRadius="4" Margin="0,2" Padding="3,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <ToggleButton x:Name="Expander" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Width="22" Height="24" Focusable="False" VerticalAlignment="Center">
                                                                <ToggleButton.Template>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border Background="Transparent"><Path x:Name="Arrow" Data="M 0 0 L 5 5 L 0 10" Stroke="#5C6D87" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/></Border>
                                                                        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </ToggleButton.Template>
                                                            </ToggleButton>
                                                            <ContentPresenter Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch"/>
                                                        </Grid>
                                                    </Border>
                                                    <ItemsPresenter x:Name="ChildrenPresenter" Margin="22,0,0,0"/>
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ChildrenPresenter" Property="Visibility" Value="Collapsed"/></Trigger>
                                                    <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
                                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#DFEBFF"/><Setter TargetName="Row" Property="BorderBrush" Value="#235CCC"/></Trigger>
                                                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Row" Property="Background" Value="#F1F5FB"/></MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type local:NodeModel}" ItemsSource="{Binding Children}">
                                    <Grid>
                                        <Grid.ToolTip><StackPanel MaxWidth="420"><TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Grid.ToolTip>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Background="{Binding BadgeColor}" CornerRadius="4" VerticalAlignment="Center" Padding="5,3" Margin="0,0,9,0">
                                            <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" MaxWidth="150" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="12" Foreground="#63738C" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent"/>
            <Border Grid.Column="2" Background="White" BorderBrush="#DDE4EF" BorderThickness="1" Style="{StaticResource WorkspaceEditorStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel x:Name="SelectionHeading" Margin="0,0,0,14" Style="{StaticResource WorkspaceDetailStyle}">
                        <Button DockPanel.Dock="Right" Content="{Binding AddChildLabel}" Command="{Binding AddChildCommand}" Background="#235CCC" Foreground="White" BorderBrush="#235CCC" Padding="16,10" VerticalAlignment="Top" Margin="20,0,0,0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectionPath}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SelectionDescription}" Foreground="#63738C" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EditorPage}" Value="CdsLayout">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EditorPage}" Value="ChamberLayout">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="110"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="节点名称 (Name)" Foreground="#728099" Margin="0,0,0,4"/>
                            <TextBox x:Name="NodeNameEditor" Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="初始化顺序" Foreground="#728099" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Selected.InitOrder, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" ToolTip="空或 0 使用元件默认顺序；正整数越小越先初始化"/>
                        </StackPanel>
                        <TextBlock Grid.Column="6" Text="{Binding Selected.Category}" FontWeight="SemiBold" Foreground="{Binding Selected.BadgeColor}" VerticalAlignment="Bottom" Height="34" Padding="0,7,0,0"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Type" Foreground="#728099" Margin="0,0,0,4" ToolTip="选择或填写元件类型；留空表示分组"/>
                            <ComboBox IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Key" ItemsSource="{Binding Elements}"
                                      Text="{Binding SelectedType, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" ToolTip="{Binding SelectedType}" MaxDropDownHeight="420">
                                <ComboBox.ItemTemplate><DataTemplate><StackPanel Margin="4,5"><TextBlock Text="{Binding Display}" FontSize="14"/><TextBlock Text="{Binding Key}" FontSize="11" Foreground="#63738C" Margin="0,3,0,0"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TabControl x:Name="EditorTabs" Grid.Row="2" BorderBrush="#E0E6EF">
                        <TabItem x:Name="ChamberLayoutTab" Header="腔体布局" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="{Binding CanEditChamberLayout, Converter={StaticResource BoolVisibility}}" IsSelected="{Binding EditorPage, Converter={StaticResource PageSelection}, ConverterParameter=ChamberLayout, Mode=TwoWay}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding ChamberLayoutError}" Style="{StaticResource NonEmptyTextStyle}" Margin="10,5" Foreground="#B42318" TextWrapping="Wrap"/>
                                <ContentControl Content="{Binding ChamberEditor}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="CdsLayoutTab" Header="CDS 布局" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="{Binding CanEditCdsLayout, Converter={StaticResource BoolVisibility}}" IsSelected="{Binding EditorPage, Converter={StaticResource PageSelection}, ConverterParameter=CdsLayout, Mode=TwoWay}">
                            <Grid>
                                <local:CdsLayoutView DataContext="{Binding CurrentCdsLayout}" />
                                <TextBlock Text="{Binding LayoutError}" TextWrapping="Wrap" Foreground="#B42318" Margin="15" VerticalAlignment="Top" IsHitTestVisible="False" />
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="ParametersTab" Header="元件参数" IsSelected="{Binding EditorPage, Converter={StaticResource PageSelection}, ConverterParameter=Parameters, Mode=TwoWay}">
                            <DockPanel Margin="12">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="添加参数" Command="{Binding AddValueCommand}"/>
                                    <Button Content="清除覆盖 / 删除参数" Command="{Binding ClearValueCommand}"/>
                                    <TextBlock Text="默认值仅在编辑后写入 XML" Foreground="#728099" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <Grid>
                                <TextBlock Text="{Binding ParametersSummary}" Foreground="#63738C" TextWrapping="Wrap" Margin="20" VerticalAlignment="Top">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasFields}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <DataGrid x:Name="FieldsGrid" ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField}" RowHeight="70" Visibility="{Binding HasFields, Converter={StaticResource BoolVisibility}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="分组" Binding="{Binding Group}" IsReadOnly="True" Width="85"/>
                                        <DataGridTemplateColumn Header="参数" Width="185">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                                                        <TextBlock FontSize="10" Foreground="#728099" TextAlignment="Center"><Run Text="{Binding TypeLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Required, Mode=OneWay}"/><Run Text="{Binding Origin, Mode=OneWay}"/></TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="设定值" Width="200">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                        <Grid Margin="0,5">
                                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Error}" VerticalAlignment="Center">
                                                            <TextBox.Style>
                                                                <Style TargetType="TextBox" BasedOn="{StaticResource GridEditorText}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers><DataTrigger Binding="{Binding HasChoices}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </TextBox.Style>
                                                        </TextBox>
                                                        <ComboBox ItemsSource="{Binding Choices}" IsEditable="True" IsTextSearchEnabled="False" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Error}" VerticalAlignment="Center">
                                                            <ComboBox.Style>
                                                                <Style TargetType="ComboBox" BasedOn="{StaticResource GridEditorCombo}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers><DataTrigger Binding="{Binding HasEditableChoices}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </ComboBox.Style>
                                                        </ComboBox>
                                                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="False"
                                                                  Visibility="{Binding IsBoolean, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding Error}" Style="{StaticResource GridEditorCombo}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="默认值" Binding="{Binding DefaultValue}" IsReadOnly="True" Width="85"/>
                                        <DataGridTemplateColumn Header="说明" Width="*" MinWidth="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center" ToolTip="{Binding Description}"/></DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                </Grid>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="RecipeFieldsTab" Header="配方字段" Visibility="{Binding CanEditRecipeFields, Converter={StaticResource BoolVisibility}}" IsSelected="{Binding EditorPage, Converter={StaticResource PageSelection}, ConverterParameter=RecipeFields, Mode=TwoWay}">
                            <!-- 工艺配方的字段表：一行一个字段 = 工艺配方页上的一列，从上到下就是从左到右；时间（Seconds）那一行锁着 -->
                            <DockPanel Margin="12">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="工艺配方每一步的字段：一行就是工艺配方页上的一列，从上到下就是从左到右。时间（Seconds）是步骤时长，锁着不能删。collection 的选项按腔体的 Type 分开写，一种 Type 一列（Type 是腔体元件参数里的 Type）；配方头选了哪种 Type，步骤里的下拉就列哪一列。选项用英文逗号隔开直接输入，也可以点 … 一行一个地编辑。" Foreground="#728099" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="添加字段" Command="{Binding AddRecipeFieldCommand}"/>
                                        <Button Content="删除字段" Command="{Binding DeleteRecipeFieldCommand}"/>
                                        <Button Content="上移" Command="{Binding RecipeFieldUpCommand}"/>
                                        <Button Content="下移" Command="{Binding RecipeFieldDownCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                                <DataGrid x:Name="RecipeFieldsGrid" ItemsSource="{Binding RecipeFieldRows}" SelectedItem="{Binding SelectedRecipeField}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="字段名" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}" Style="{StaticResource GridEditorText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="中文名" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GridEditorText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="英文名" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding TextEn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GridEditorText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="类型" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.RecipeFieldTypes, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding Type}" IsEnabled="{Binding IsEditable}" Style="{StaticResource GridEditorCombo}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="单位" Width="68"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNumber}" Style="{StaticResource GridEditorText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="下限" Width="64"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Min, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNumber}" Style="{StaticResource GridEditorText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="上限" Width="64"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Max, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNumber}" Style="{StaticResource GridEditorText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="小数位" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Decimals, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsDouble}" Style="{StaticResource GridEditorText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="默认值" Width="85" CellTemplate="{StaticResource RecipeDefaultEditor}" />
                                        <!-- 选项列（一种腔体 Type 一列）由窗口按 RecipeOptionTypes 插在这里 -->
                                        <DataGridTemplateColumn Header="必填" Width="85" CellTemplate="{StaticResource RecipeRequiredEditor}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="RecipeHeadTab" Header="配方头" Visibility="{Binding CanEditRecipeHead, Converter={StaticResource BoolVisibility}}" IsSelected="{Binding EditorPage, Converter={StaticResource PageSelection}, ConverterParameter=RecipeHead, Mode=TwoWay}">
                            <!-- 工艺配方的配方头字段表：一行一项 = 配方页配方头里的一项（左边名字、右边值）；固定的几项锁着，程序算的只显示 -->
                            <DockPanel Margin="12">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="配方头：一行就是工艺配方页配方头里的一项（左边名字、右边值），从上到下就是先后。前面几行固定（锁着：字段名、类型不能改、不能删，中文名、英文名和先后能改）；&quot;自动&quot;的由程序填，页面上只显示。自己加的行都是在页面上填的。Type 的选项不用写：就是腔体元件参数里配的 Type。" Foreground="#728099" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="添加字段" Command="{Binding AddRecipeFieldCommand}"/>
                                        <Button Content="删除字段" Command="{Binding DeleteRecipeFieldCommand}"/>
                                        <Button Content="上移" Command="{Binding RecipeFieldUpCommand}"/>
                                        <Button Content="下移" Command="{Binding RecipeFieldDownCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                                <DataGrid x:Name="RecipeHeadGrid" ItemsSource="{Binding RecipeFieldRows}" SelectedItem="{Binding SelectedRecipeField}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="字段名" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}" Style="{StaticResource GridEditorText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="中文名" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GridEditorText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="英文名" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding TextEn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GridEditorText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="类型" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.RecipeFieldTypes, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding Type}" IsEnabled="{Binding IsEditable}" Style="{StaticResource GridEditorCombo}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="单位" Width="68"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNumber}" Style="{StaticResource GridEditorText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="下限" Width="64"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Min, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNumber}" Style="{StaticResource GridEditorText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="上限" Width="64"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Max, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNumber}" Style="{StaticResource GridEditorText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="小数位" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Decimals, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsDouble}" Style="{StaticResource GridEditorText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="默认值" Width="85" CellTemplate="{StaticResource RecipeDefaultEditor}" />
                                        <DataGridTemplateColumn Header="值从哪来" Width="*" MinWidth="260"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid>
                                            <TextBlock Text="{Binding SourceText}" Style="{StaticResource GridCellText}" Visibility="{Binding ShowsSourceText, Converter={StaticResource BoolVisibility}}"/>
                                            <DockPanel Visibility="{Binding HasOptions, Converter={StaticResource BoolVisibility}}"><Button DockPanel.Dock="Right" Content="…" Width="30" MinWidth="30" Margin="4,0,0,0" Padding="0" Click="EditHeadOptionsClick"/><TextBox Text="{Binding OptionCells[0].Text, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Style="{StaticResource GridEditorText}"/></DockPanel>
                                        </Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="必填" Width="85" CellTemplate="{StaticResource RecipeRequiredEditor}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="AlarmsTab" Header="报警覆盖" Visibility="{Binding HasAlarmOverrides, Converter={StaticResource BoolVisibility}}" IsSelected="{Binding EditorPage, Converter={StaticResource PageSelection}, ConverterParameter=Alarms, Mode=TwoWay}">
                            <DockPanel Margin="12">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="编辑当前节点的 Alarm 子节点；是否生效取决于对应元件的实现。" Foreground="#728099" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal"><Button Content="添加" Command="{Binding AddAlarmCommand}"/><Button Content="删除" Command="{Binding DeleteAlarmCommand}"/></StackPanel>
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding Alarms}" SelectedItem="{Binding SelectedAlarm}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="报警名称" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GridEditorText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="等级 Level" Width="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Level, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GridEditorText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="ValidationTab" Header="校验结果" IsSelected="{Binding EditorPage, Converter={StaticResource PageSelection}, ConverterParameter=Validation, Mode=TwoWay}">
                            <DockPanel Margin="12">
                                <TextBlock DockPanel.Dock="Top" Text="双击一条结果定位到配置节点。元件未加载时保留原值，并显示提示。" Foreground="#728099" Margin="0,0,0,10"/>
                                <DataGrid ItemsSource="{Binding Issues}" IsReadOnly="True" MouseDoubleClick="IssueDoubleClick" RowHeight="80">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="级别" Binding="{Binding Severity}" Width="70"/>
                                        <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="路径" Binding="{Binding Path}" Width="220"/>
                                        <DataGridTemplateColumn Header="说明" Width="*">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Message}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Padding="0,8"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="XmlTab" Header="XML 对照" IsSelected="{Binding EditorPage, Converter={StaticResource PageSelection}, ConverterParameter=Xml, Mode=TwoWay}">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="打开 / 上次保存的内容" Foreground="#728099" Margin="0,0,0,8"/>
                                <TextBlock Grid.Column="2" Text="当前内容（只读预览）" Foreground="#728099" Margin="0,0,0,8"/>
                                <TextBox Grid.Row="1" Text="{Binding OriginalPreview, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding XmlPreview, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                    <Border Grid.Row="3" Background="#F0F5FF" Padding="10,8" Margin="0,12,0,0" Style="{StaticResource WorkspaceDetailStyle}">
                        <TextBlock Text="machine.xml 在后端启动时装配。保存前校验并备份；运行中可调的 EC 参数仍在原 EC 设置页管理。" Foreground="#5270A4" FontSize="11" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="White" BorderBrush="#E0E6EF" BorderThickness="0,1,0,0" Padding="20,9">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="Ctrl+O 打开  ·  Ctrl+S 保存" Foreground="#728099" FontSize="11"/>
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" Margin="0,0,15,0" ToolTip="{Binding Status}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
