<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hardware="clr-namespace:xyz.Client.Presentation.Controls.ThreeD;assembly=xyz.Client.Presentation"
      x:Name="BowlScene" Width="400" Height="340" Background="{StaticResource DarkSurfaceBackground}">
    <Grid.RowDefinitions>
        <RowDefinition Height="70" />
        <RowDefinition Height="*" />
        <RowDefinition Height="35" />
    </Grid.RowDefinitions>
    <StackPanel Margin="20,16,20,0">
        <TextBlock FontSize="{StaticResource Size18}" Foreground="{StaticResource DarkPrimaryText}">
            <Run Text="Bowl · " /><Run Text="{Binding HeightLevel}" /><Run Text=" 级" />
        </TextBlock>
        <TextBlock Margin="0,5,0,0" Text="薄壁结构 · 三级高度" FontSize="{StaticResource Size13}" Foreground="{StaticResource DarkDisabledText}" />
    </StackPanel>
    <Viewport3D x:Name="Viewport" Grid.Row="1" IsHitTestVisible="False">
        <Viewport3D.Camera>
            <OrthographicCamera Position="3,3.4,5" LookDirection="-3,-3,-5" UpDirection="0,1,0" Width="4.1" />
        </Viewport3D.Camera>
        <ModelVisual3D>
            <ModelVisual3D.Content>
                <Model3DGroup>
                    <AmbientLight Color="#707070" />
                    <DirectionalLight Color="#C0C0C0" Direction="-1,-3,-2" />
                </Model3DGroup>
            </ModelVisual3D.Content>
        </ModelVisual3D>
        <hardware:BowlVisual3D x:Name="Bowl"
            HeightLevel="{Binding DataContext.HeightLevel, ElementName=BowlScene, Mode=OneWay}"
            IsRaised="{Binding DataContext.IsRaised, ElementName=BowlScene, Mode=OneWay}"
            BodyColor="{StaticResource DarkHardwareBodyColor}"
            HighlightColor="{Binding Color, Source={StaticResource DarkAccent}, Mode=OneWay}" />
    </Viewport3D>
    <TextBlock Grid.Row="2" Margin="20,4,20,0" Text="高度等级与升降状态独立绑定"
               FontSize="{StaticResource Size12}" Foreground="{StaticResource DarkDisabledText}" />
</Grid>
