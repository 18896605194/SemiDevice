<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:threeD="clr-namespace:xyz.Client.Presentation.Controls.ThreeD;assembly=xyz.Client.Presentation"
      x:Name="SceneHost"
      Background="{DynamicResource DarkControlBackground}">
    <Viewport3D x:Name="Viewport">
        <Viewport3D.Camera>
            <OrthographicCamera Position="-3,3.7,9" LookDirection="3,-2.6,-9" UpDirection="0,1,0" Width="6.4" />
        </Viewport3D.Camera>
        <ModelVisual3D>
            <ModelVisual3D.Content>
                <Model3DGroup>
                    <AmbientLight Color="#808080" />
                    <DirectionalLight Color="#EEEEEE" Direction="1,-2,-3" />
                </Model3DGroup>
            </ModelVisual3D.Content>
        </ModelVisual3D>
        <threeD:FluidRouteVisual3D
            x:Name="Pipe"
            Path="{Binding DataContext.Route, ElementName=SceneHost, Mode=OneWay}"
            PipeRadius="{Binding DataContext.Radius, ElementName=SceneHost, Mode=OneWay}"
            WallThickness="0.022"
            BendRadius="0.34"
            FluidCoreRatio="0.58"
            WallOpacity="0.18"
            FlowColor="{Binding DataContext.WaterColor, ElementName=SceneHost, Mode=OneWay}"
            IsFlowing="{Binding DataContext.Flowing, ElementName=SceneHost, Mode=OneWay}"
            FlowSpeed="0.55" />
    </Viewport3D>
</Grid>
