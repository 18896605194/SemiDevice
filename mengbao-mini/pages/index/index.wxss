.page-root {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #FFF6EC;
  display: flex;
  flex-direction: column;
}
.hd {
  flex: none;
  background: linear-gradient(135deg, #8FA8F5, #7EC8E3);
  padding: 20rpx 28rpx 16rpx;
  color: #fff;
  position: relative;
}
.hd .t1 { font-size: 34rpx; font-weight: 800; }
.hd .t2 { font-size: 24rpx; opacity: .95; margin-top: 8rpx; }
.live {
  background: rgba(255, 255, 255, .28);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  font-weight: 700;
  margin-left: 12rpx;
}
.starChip {
  position: absolute; right: 28rpx; top: 26rpx;
  background: rgba(0, 0, 0, .2);
  border-radius: 999rpx; padding: 8rpx 20rpx;
  font-size: 24rpx; font-weight: 800;
}

/* 关卡条 */
.chips {
  flex: none;
  white-space: nowrap;
  padding: 14rpx 24rpx 0;
  box-sizing: border-box;
}
.chip {
  display: inline-flex; flex-direction: column; align-items: center;
  border-radius: 24rpx; padding: 12rpx 20rpx;
  font-size: 24rpx; font-weight: 800;
  background: #F3E9DE; color: #9C8A7E;
  line-height: 1.35; margin-right: 12rpx;
}
.chip.on {
  background: linear-gradient(180deg, #FF9FB1, #F56F88);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(245, 111, 136, .35);
}
.chip.ok { background: #fff; color: #4A3B32; box-shadow: 0 4rpx 12rpx rgba(74, 59, 50, .08); }
.chip.hard { background: #2A2E4A; color: #fff; }
.chip.hard.on {
  background: linear-gradient(180deg, #FF6B8A, #E8455E);
  box-shadow: 0 8rpx 20rpx rgba(232, 69, 94, .4);
}
.chip .st { display: block; font-size: 20rpx; letter-spacing: 2rpx; color: #F0B020; margin-top: 2rpx; }
.chip.on .st { color: #FFE9A8; }
.chip.hard .st { color: #FF9EAE; }

.barrow {
  flex: none;
  display: flex; align-items: center; gap: 14rpx;
  padding: 12rpx 24rpx 0;
}
.lvName { font-size: 30rpx; font-weight: 800; color: #4A3B32; }
.prog {
  font-size: 26rpx; font-weight: 800; color: #F56F88;
  background: #FFE3EA; border-radius: 999rpx; padding: 6rpx 18rpx;
}
.singBtn {
  background: #2A2E4A; color: #FFE9A8;
  border-radius: 999rpx; padding: 8rpx 18rpx;
  font-size: 24rpx; font-weight: 800; white-space: nowrap;
}
.singBtn.on {
  background: linear-gradient(180deg, #FFD97A, #F0B020);
  color: #6B4A00;
  animation: pulse 1s infinite;
}
@keyframes pulse { 50% { transform: scale(1.08); } }
.streak {
  margin-left: auto;
  background: #E9EFFF; color: #5A6FD4;
  border-radius: 999rpx; padding: 8rpx 18rpx;
  font-size: 24rpx; font-weight: 800;
  opacity: 0; transition: .2s;
}
.streak.on { opacity: 1; }

/* 场地（px 与 JS 布局保持一致；flex 自适应剩余高度，防止真机底部被裁） */
#field {
  position: relative;
  flex: 1 1 auto;
  min-height: 150px;
  margin: 8rpx 20rpx 0;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #EEF3FF, #FDF6FF);
  overflow: hidden;
}
#field.singing { background: linear-gradient(180deg, #FFF3D6, #FDF0FF); }
#tower { position: absolute; left: 0; top: 0; right: 0; bottom: 0; transition: transform .22s ease; }
.blk { position: absolute; height: 26px; border-radius: 8px; box-shadow: inset 0 -5px 0 rgba(0, 0, 0, .08); }
.blk.moving { z-index: 6; }
.blk.sing::after { content: "🎤"; position: absolute; right: -26px; top: -6px; font-size: 16px; }
.blk.slice { opacity: .95; animation: sl .45s ease-in forwards; z-index: 8; }
@keyframes sl { to { transform: translateY(160px) rotate(70deg); opacity: 0; } }

#kara {
  position: absolute; top: 8px; left: 50%; transform: translateX(-50%);
  background: rgba(30, 28, 50, .85); color: #FFD97A;
  border-radius: 999rpx; padding: 10px 18px;
  font-size: 14px; font-weight: 800; white-space: nowrap;
  z-index: 26; display: none; letter-spacing: 1px;
  box-shadow: 0 6px 16px rgba(0, 0, 0, .25);
  transition: transform .12s;
  flex-direction: column; align-items: center;
}
#kara.show { display: flex; }
#kara.beat { transform: translateX(-50%) scale(1.1); }
#kara .tag { display: block; font-size: 10px; color: #9FDCF2; letter-spacing: 2px; margin-bottom: 2px; }

#hint {
  position: absolute; left: 50%; top: 42%; transform: translate(-50%, -50%);
  background: rgba(30, 28, 50, .8); color: #fff;
  font-size: 14px; font-weight: 700;
  padding: 12px 18px; border-radius: 14px;
  text-align: center; line-height: 1.7;
  z-index: 20; transition: .4s; white-space: nowrap;
}
#hint .hl { display: block; color: #FFD97A; }
#hint.hide { opacity: 0; }

.floot {
  position: absolute; left: 50%; top: 90px;
  font-size: 17px; font-weight: 800; color: #F0B020;
  z-index: 30; animation: fl .9s ease-out forwards;
  text-shadow: 0 2px 6px rgba(0, 0, 0, .15);
}
@keyframes fl { from { transform: translateX(-50%); } to { transform: translateX(-50%) translateY(-60px); opacity: 0; } }
#field.shake { animation: shk .35s; }
@keyframes shk { 25% { transform: translateX(-7px); } 50% { transform: translateX(6px); } 75% { transform: translateX(-3px); } }

.stat { flex: none; display: flex; gap: 14rpx; padding: 12rpx 20rpx 0; }
.stat .s {
  flex: 1; background: #fff; border-radius: 24rpx;
  padding: 14rpx 8rpx; text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(74, 59, 50, .07);
}
.stat .s b { display: block; font-size: 34rpx; color: #4A3B32; }
.stat .s text { font-size: 22rpx; color: #9C8A7E; font-weight: 700; }

.meta {
  flex: none;
  display: flex; gap: 14rpx;
  padding: 12rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));
}
.meta .mb {
  flex: 1; background: #FFF3D6; color: #8A5A00;
  border-radius: 999rpx; padding: 18rpx 0;
  text-align: center; font-size: 26rpx; font-weight: 800;
}
.meta .mb:active { transform: scale(.95); }

/* 弹层 */
.ov {
  position: absolute; inset: 0;
  background: rgba(74, 59, 50, .55);
  display: flex; align-items: center; justify-content: center;
  z-index: 50; opacity: 0; pointer-events: none;
  transition: .2s; padding: 0 40rpx;
}
.ov.on { opacity: 1; pointer-events: auto; }
.card {
  width: 100%; background: #FFF6EC; border-radius: 40rpx;
  padding: 44rpx 34rpx 32rpx; text-align: center;
  transform: scale(.85); transition: .2s;
}
.ov.on .card { transform: scale(1); }
.card .em { font-size: 88rpx; line-height: 1; }
.card .ct { font-size: 38rpx; font-weight: 800; margin-top: 12rpx; }
.card .cp { font-size: 26rpx; color: #8B7B6E; margin-top: 16rpx; line-height: 1.7; }
.num { color: #F56F88; font-weight: 800; }
.bigstars { font-size: 68rpx; letter-spacing: 12rpx; margin-top: 12rpx; color: #F0B020; }
.record {
  background: #FFF3D6; border-radius: 24rpx; padding: 16rpx;
  margin-top: 16rpx; font-size: 28rpx; font-weight: 800; color: #8A5A00;
}
.record.red { background: #FFE3EA; color: #E8455E; }
.record.secret { background: #2A2E4A; color: #FFE9A8; font-size: 26rpx; line-height: 1.7; }
.btns { display: flex; gap: 16rpx; margin-top: 28rpx; }
.btn {
  flex: 1; padding: 24rpx 0; border-radius: 999rpx;
  font-size: 28rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
}
.btn.p {
  background: linear-gradient(180deg, #FF9FB1, #F56F88); color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(245, 111, 136, .35);
}
.btn.g { background: #fff; color: #4A3B32; box-shadow: 0 4rpx 16rpx rgba(74, 59, 50, .1); }
.btn:active { transform: scale(.95); }

.rank {
  margin-top: 20rpx; background: #fff;
  border-radius: 28rpx; padding: 18rpx 24rpx;
  text-align: left; font-size: 26rpx;
}
.rank .r {
  display: flex; justify-content: space-between;
  padding: 12rpx 0; border-bottom: 1rpx solid #F5EDE4;
}
.rank .r:last-child { border: none; }
.rank .me { color: #F56F88; font-weight: 800; }

/* toast / 彩带 */
.toast-box {
  position: absolute; left: 0; right: 0; top: 40%;
  display: flex; flex-direction: column; align-items: center;
  z-index: 45; pointer-events: none;
}
.toast {
  background: rgba(30, 28, 50, .95); color: #fff;
  font-size: 26rpx; font-weight: 700;
  padding: 22rpx 32rpx; border-radius: 28rpx;
  max-width: 86%; text-align: center; line-height: 1.55;
  animation: toastIn .25s ease;
}
@keyframes toastIn { from { transform: scale(.7); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.confetti { position: absolute; inset: 0; pointer-events: none; overflow: hidden; z-index: 60; }
.cf {
  position: absolute; top: -20rpx; width: 16rpx; height: 24rpx; border-radius: 4rpx;
  animation: cf linear forwards;
}
@keyframes cf { to { transform: translateY(2400rpx) rotate(660deg); opacity: .85; } }
