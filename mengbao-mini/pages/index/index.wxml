<view class="page-root">
  <view class="hd">
    <view class="t1">叠塔闯关</view>
    <view class="t2">👆 点屏幕落块，齐边通关<text class="live">{{live}} 人在闯关</text></view>
    <view class="starChip">⭐ 总星 {{starTotal}}</view>
  </view>

  <scroll-view scroll-x class="chips" enable-flex>
    <view class="chip {{c.cls}}" wx:for="{{chips}}" wx:for-item="c" wx:key="id" data-idx="{{index}}" bindtap="onChip">
      <text>第{{c.n}}关</text>
      <text class="st">{{c.st}}</text>
    </view>
  </scroll-view>

  <view class="barrow">
    <view class="lvName">{{lvName}}</view>
    <view class="prog">{{prog}}</view>
    <view class="streak {{streakOn?'on':''}}">{{streakTxt}}</view>
  </view>

  <view id="field" class="{{shake?'shake':''}} {{singing?'singing':''}}" bindtap="onFieldTap">
    <view id="tower" style="transform:translateY({{cam}}px)">
      <view class="blk {{b.cls}}" wx:for="{{blocks}}" wx:for-item="b" wx:key="id"
        style="left:{{b.x}}px;bottom:{{b.y}}px;width:{{b.w}}px;background:{{b.c}}"></view>
      <view class="blk moving {{moverSing?'sing':''}}" wx:if="{{moverOn}}"
        style="left:{{moverLeft}}px;bottom:{{moverBottom}}px;width:{{moverW}}px;background:{{moverC}};box-shadow:{{moverShadow}}"></view>
    </view>
    <view id="kara" class="{{karaShow?'show':''}} {{karaBeat?'beat':''}}">
      <text class="tag">♪ {{karaSong}} · 伴奏已就位</text>
      <text>{{karaLine}}</text>
    </view>
    <view id="hint" class="{{hintHide?'hide':''}}">👆 点任意位置落下
      <text class="hl">对得越齐，塔越稳</text>
    </view>
    <view class="floot" wx:if="{{fxShow}}">{{fxText}}</view>
  </view>

  <view class="stat">
    <view class="s"><b>{{sPerf}}</b><text>本关完美</text></view>
    <view class="s"><b>{{sBest}}</b><text>本关纪录(层)</text></view>
    <view class="s"><b>{{sGap}}</b><text>距通关</text></view>
  </view>

  <view class="meta">
    <view class="mb" bindtap="onRank">🏆 闯关榜</view>
    <view class="mb" bindtap="onReset">🔄 重置进度</view>
  </view>

  <!-- 失败 -->
  <view class="ov {{lose.show?'on':''}}">
    <view class="card">
      <view class="em">{{lose.em}}</view>
      <view class="ct">{{lose.t}}</view>
      <view class="cp">第 <text class="num">{{lose.cur}}</text> 关 · 叠了 <text class="num">{{lose.curL}}</text> / <text class="num">{{lose.tgt}}</text> 层 · 完美 <text class="num">{{lose.perf}}</text> 次</view>
      <view class="record {{lose.gapCls}}">{{lose.gap}}</view>
      <view class="btns">
        <view class="btn p" bindtap="onRetry">🔥 再来一次</view>
        <view class="btn g" bindtap="onRank">看榜</view>
      </view>
    </view>
  </view>

  <!-- 通关 -->
  <view class="ov {{win.show?'on':''}}">
    <view class="card">
      <view class="em">{{win.em}}</view>
      <view class="ct">{{win.t}}</view>
      <view class="bigstars">{{win.stars}}</view>
      <view class="cp">完美 <text class="num">{{win.perf}}</text> 次</view>
      <view class="record red" wx:if="{{win.bragShow}}">{{win.brag}}</view>
      <view class="btns">
        <view class="btn p" bindtap="onNext">{{win.nextTxt}}</view>
        <view class="btn g" bindtap="onAgain">{{win.againTxt}}</view>
      </view>
    </view>
  </view>

  <!-- 榜 -->
  <view class="ov {{rank.show?'on':''}}">
    <view class="card">
      <view class="em">🏆</view>
      <view class="ct">今日闯关榜</view>
      <view class="rank">
        <view class="r"><text>🥇 大河向东流（杭州）</text><text>6关 · 16★</text></view>
        <view class="r"><text>🥈 稳如老狗（深圳）</text><text>6关 · 14★</text></view>
        <view class="r"><text>🥉 全网前5%·硬核玩家</text><text>3关 · 7★</text></view>
        <view class="r me"><text>你（当前进度）</text><text>{{rank.me}}</text></view>
        <view class="r"><text>好友·小林</text><text>卡在第 2 关 ×47 次</text></view>
      </view>
      <view class="btns">
        <view class="btn p" bindtap="onRankClose">继续闯关</view>
      </view>
    </view>
  </view>

  <view class="toast-box">
    <view class="toast {{toast.gold?'gold':''}}" wx:if="{{toast.show}}">{{toast.text}}</view>
  </view>

  <view class="confetti" wx:if="{{confetti.length}}">
    <view class="cf" wx:for="{{confetti}}" wx:for-item="c" wx:key="id"
      style="left:{{c.left}}%;background:{{c.color}};animation-duration:{{c.dur}}s;animation-delay:{{c.delay}}s"></view>
  </view>
</view>
