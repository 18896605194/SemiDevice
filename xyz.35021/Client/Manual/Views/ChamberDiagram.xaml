<UserControl x:Class="xyz._35021.Client.Manual.Views.ChamberDiagram"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
 <Grid Background="{DynamicResource DarkControlBackground}">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ContentControl x:Name="DiagramHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <Border Grid.Row="1" Style="{DynamicResource ToolbarBorderStyle}">
   <StackPanel Orientation="Horizontal">
    <Button Content="{DynamicResource m35021.chamber.default_view}" Click="OnDefaultView" Style="{DynamicResource ToolbarOutlinedButtonStyle}"/>
    <Button Content="{DynamicResource m35021.chamber.top_view}" Click="OnTopView" Style="{DynamicResource ToolbarOutlinedButtonStyle}"/>
    <Button Content="{DynamicResource m35021.chamber.reload_layout}" Command="{Binding ReloadLayoutCommand}" Style="{DynamicResource ToolbarOutlinedButtonStyle}"/>
   </StackPanel>
  </Border>
  <TextBlock x:Name="DiagramError" Grid.Row="2" Style="{DynamicResource m35021.ChamberLayoutStatusStyle}"/>
 </Grid>
</UserControl>
