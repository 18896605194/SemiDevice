<UserControl x:Class="xyz._35021.Client.Manual.Views.ChamberManualView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:manual="clr-namespace:xyz.Client.Manual.Views;assembly=xyz.Client.Manual" xmlns:views="clr-namespace:xyz._35021.Client.Manual.Views">
 <manual:ChamberManualControl ViewModel="{Binding}">
  <manual:ChamberManualControl.SceneTemplate>
   <DataTemplate>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <views:ChamberDiagram DiagramXaml="{Binding DiagramXaml}"/>
     <TextBlock Grid.Row="1" Text="{Binding LayoutStatus}" Style="{DynamicResource m35021.ChamberLayoutStatusStyle}"/>
    </Grid>
   </DataTemplate>
  </manual:ChamberManualControl.SceneTemplate>
 </manual:ChamberManualControl>
</UserControl>
