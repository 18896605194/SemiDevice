<UserControl
    x:Class="xyz._35021.Client.Manual.Views.TransferView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:xyz.Client.Presentation.Controls;assembly=xyz.Client.Presentation"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:vm="clr-namespace:xyz._35021.Client.Manual.ViewModels">

    <!--  Transfer 调度界面：搬运地图，站点卡片围着机械手摆  -->
    <materialDesign:Card Margin="8" Style="{DynamicResource DefaultCardStyle}">
        <Viewbox Stretch="Uniform">
            <Canvas Width="{x:Static vm:TransferViewModel.MapWidth}" Height="{x:Static vm:TransferViewModel.MapHeight}">
                <ItemsControl
                    Width="{x:Static vm:TransferViewModel.MapWidth}"
                    Height="{x:Static vm:TransferViewModel.MapHeight}"
                    ItemsSource="{Binding Stations}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="{x:Static vm:TransferViewModel.StationWidth}"
                                Height="{x:Static vm:TransferViewModel.StationHeight}"
                                Background="{DynamicResource DarkSurfaceBackground}"
                                BorderBrush="{DynamicResource DarkBorderBrush}"
                                BorderThickness="2"
                                CornerRadius="12">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource Size20}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource DarkPrimaryText}"
                                    Text="{Binding Name}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  机械手：只绑目标姿态与手臂数据，运动顺序（收回 → 转向 → 伸出）由控件自己排  -->
                <controls:Robot
                    Canvas.Left="{Binding RobotLeft}"
                    Canvas.Top="{Binding RobotTop}"
                    Width="{x:Static vm:TransferViewModel.RobotSize}"
                    Height="{x:Static vm:TransferViewModel.RobotSize}"
                    ArmCount="{Binding ArmCount}"
                    ArmType="Linear"
                    Arms="{Binding Arms}"
                    Rotation="{Binding Rotation}"
                    Status="{Binding RobotStatus}" />
            </Canvas>
        </Viewbox>
    </materialDesign:Card>
</UserControl>
