<UserControl
    x:Class="xyz._35021.Client.Manual.Views.TransferView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:xyz.Client.Presentation.Controls;assembly=xyz.Client.Presentation"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!--  Transfer 调度界面：只做显示，机械手去哪、朝哪由后端按 sc.xml 站点表推过来  -->
    <materialDesign:Card Margin="8" Style="{DynamicResource DefaultCardStyle}">
        <!--  机械手：不设宽高，铺满外框并按短边等比缩放；绑显示模型，运动顺序由控件自己排  -->
        <controls:Robot
            ArmCount="{Binding Robot.ArmCount}"
            ArmType="Linear"
            Arms="{Binding Robot.Arms}"
            Rotation="{Binding Robot.Rotation}"
            Status="{Binding Robot.Status}"
            Travel="{Binding Robot.Travel}" />
    </materialDesign:Card>
</UserControl>
