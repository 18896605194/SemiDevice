<UserControl x:Class="xyz._35021.Client.Manual.Views.RobotManualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:manual="clr-namespace:xyz.Client.Manual.Views;assembly=xyz.Client.Manual"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!--  35021 Robot 手动界面：1 个铺满整行，2 个左右各半；再多按行换列。  -->
    <ItemsControl ItemsSource="{Binding Robots}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <!--  Rows 固定 1，Columns 跟条目数走：1 个整宽，2 个左右  -->
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <manual:RobotManualControl ModuleName="{Binding}" />
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
