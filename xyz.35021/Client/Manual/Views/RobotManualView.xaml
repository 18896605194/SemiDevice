<UserControl x:Class="xyz._35021.Client.Manual.Views.RobotManualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:manual="clr-namespace:xyz.Client.Manual.Views;assembly=xyz.Client.Manual"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!--  35021 Robot 手动界面：固定 2 列（最多 2 个 Robot），有几个就从左到右填，空位留白。  -->
    <ItemsControl ItemsSource="{Binding Robots}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Columns="2" Rows="1" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <manual:RobotManualControl ModuleName="{Binding}" />
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
