<UserControl x:Class="xyz._35021.Client.Presentation.Controls.ChamberView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
 <Grid Background="{DynamicResource DarkControlBackground}">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Viewport3D x:Name="Viewport" ClipToBounds="True"/>
  <Border Grid.Row="1" Style="{DynamicResource ToolbarBorderStyle}">
   <StackPanel Orientation="Horizontal">
    <Button Content="{DynamicResource m35021.chamber.default_view}" Click="OnDefaultView" Style="{DynamicResource ToolbarOutlinedButtonStyle}"/>
    <Button Content="{DynamicResource m35021.chamber.top_view}" Click="OnTopView" Style="{DynamicResource ToolbarOutlinedButtonStyle}"/>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
