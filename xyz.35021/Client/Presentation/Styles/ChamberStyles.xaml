<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:xyz._35021.Client.Presentation.Controls">
 <Style x:Key="m35021.ChamberLayoutStatusStyle" TargetType="TextBlock">
  <Setter Property="Margin" Value="10,4"/><Setter Property="TextWrapping" Value="Wrap"/>
  <Setter Property="Foreground" Value="{DynamicResource DarkAlarmStatus}"/>
  <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
 </Style>
 <DataTemplate x:Key="m35021.ChamberSceneTemplate">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <controls:ChamberView Snapshot="{Binding Snapshot}" Layout="{Binding Layout}" Wafer="{Binding Model.Wafer}" VisualCatalog="{Binding VisualCatalog}"/>
   <Button Grid.Row="1" Content="{DynamicResource m35021.chamber.reload_layout}" Command="{Binding ReloadLayoutCommand}"
           Style="{DynamicResource ToolbarOutlinedButtonStyle}" HorizontalAlignment="Right" Margin="8,4"/>
   <TextBlock Grid.Row="2" Text="{Binding LayoutStatus}" Style="{StaticResource m35021.ChamberLayoutStatusStyle}"/>
  </Grid>
 </DataTemplate>
</ResourceDictionary>
