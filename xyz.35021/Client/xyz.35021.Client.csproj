<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- 机型引用平台（允许）；平台不引用本工程，靠运行时扫描 Modules\<机型> 加载。 -->
    <ProjectReference Include="..\..\xyz.Core\Client\Common\xyz.Client.Modules\xyz.Client.Modules.csproj" />
    <ProjectReference Include="..\..\xyz.Core\Client\Common\xyz.Client.DataModels\xyz.Client.DataModels.csproj" />
    <ProjectReference Include="Manual\xyz.35021.Client.Manual.csproj" />
    <ProjectReference Include="Presentation\xyz.35021.Client.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Manual、Presentation 是子目录里的独立项目，排除其源文件 -->
    <Compile Remove="Manual\**" />
    <Page Remove="Manual\**" />
    <Compile Remove="Presentation\**" />
    <Page Remove="Presentation\**" />
    <None Remove="Presentation\**" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>xyz._35021.Client</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 插件要能独立部署：把 NuGet 依赖也拷进输出，部署时整份拷进壳的 Modules\35021。 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- 编译完自动部署进客户端壳的 Modules\35021（等同 tools\deploy-module.ps1 -Target Client），F5 跑的就是刚改的机型代码。
       壳的输出目录 TFM 写死 net10.0-windows：壳升级 TFM 时这里一起改。 -->
  <Target Name="DeployToShell" AfterTargets="Build">
    <ItemGroup>
      <ModuleOutput Include="$(OutDir)*.dll;$(OutDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(ModuleOutput)"
          DestinationFolder="$(MSBuildThisFileDirectory)..\..\xyz.Core\Client\xyz.Client\bin\$(Configuration)\net10.0-windows\Modules\35021"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
