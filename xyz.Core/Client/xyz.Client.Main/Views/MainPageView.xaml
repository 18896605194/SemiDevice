<UserControl
    x:Class="xyz.Client.Main.Views.MainPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:xyz.Client.Presentation.Controls;assembly=xyz.Client.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="920"
    d:DesignWidth="1980"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource DarkWindowBackground}">
        <!--  三块：左 系统操作（平台固定）| 中 整机调度（可替换：机型按 ClientViewKeys.MainDispatch 注册自己的）| 右 LoadPort（sc.xml 配几个就几个页签）  -->
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="590" />
            </Grid.ColumnDefinitions>

            <!--  ① 系统操作：系统状态（色块徽标）、当前模式、报警条数，下面 Auto / Manual / Stop / Reset 两行两列；块只有内容那么高  -->
            <Border
                Grid.Column="0"
                VerticalAlignment="Top"
                Style="{DynamicResource ZoneBorderStyle}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{DynamicResource ZoneHeaderBorderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{DynamicResource ZoneTitleBarBorderStyle}" />
                            <TextBlock Style="{DynamicResource ZoneTitleTextStyle}" Text="{DynamicResource main.system}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="14,12,14,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Style="{DynamicResource FormLabelTextStyle}"
                                Text="{DynamicResource main.system_state}" />
                            <controls:ModuleStateBadge
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="{Binding SystemStateText}"
                                Tone="{Binding SystemStateTone}" />

                            <TextBlock
                                Grid.Row="2"
                                Style="{DynamicResource FormLabelTextStyle}"
                                Text="{DynamicResource main.mode}" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{DynamicResource FormValueTextStyle}"
                                Text="{Binding ModeText}" />

                            <TextBlock
                                Grid.Row="3"
                                Style="{DynamicResource FormLabelTextStyle}"
                                Text="{DynamicResource main.alarms}" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Style="{DynamicResource AlarmCountTextStyle}"
                                Tag="{Binding HasAlarms}"
                                Text="{Binding AlarmCount}" />
                        </Grid>

                        <!--  Stop 是整机停止（中止所有在做的动作），用红色  -->
                        <UniformGrid
                            Margin="-3,10,-3,0"
                            Columns="2">
                            <Button
                                Command="{Binding AutoCommand}"
                                Content="{DynamicResource main.auto}"
                                Style="{DynamicResource CompactButtonStyle}"
                                ToolTip="{DynamicResource main.auto_tip}" />
                            <Button
                                Command="{Binding ManualCommand}"
                                Content="{DynamicResource main.manual}"
                                Style="{DynamicResource CompactButtonStyle}"
                                ToolTip="{DynamicResource main.manual_tip}" />
                            <Button
                                Command="{Binding StopCommand}"
                                Content="{DynamicResource main.stop}"
                                Style="{DynamicResource CompactDangerButtonStyle}"
                                ToolTip="{DynamicResource main.stop_tip}" />
                            <Button
                                Command="{Binding ResetCommand}"
                                Content="{DynamicResource main.reset}"
                                Style="{DynamicResource CompactButtonStyle}"
                                ToolTip="{DynamicResource main.reset_tip}" />
                        </UniformGrid>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--  ② 整机调度：内容由代码后置按 ClientViewKeys.MainDispatch 从 DI 取（平台默认 DispatchView，机型可以顶掉）  -->
            <Border Grid.Column="2" Style="{DynamicResource ZoneBorderStyle}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{DynamicResource ZoneHeaderBorderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{DynamicResource ZoneTitleBarBorderStyle}" />
                            <TextBlock Style="{DynamicResource ZoneTitleTextStyle}" Text="{DynamicResource main.dispatch}" />
                        </StackPanel>
                    </Border>
                    <ContentControl
                        x:Name="DispatchHost"
                        Margin="12"
                        Focusable="False" />
                </DockPanel>
            </Border>

            <!--  ③ LoadPort：一个 LoadPort 一个页签；页签下面是选中那个的载具、LotID、Sequence、创建 / 启动 Job、槽位表（大号在上）  -->
            <Border Grid.Column="4" Style="{DynamicResource ZoneBorderStyle}">
                <Grid>
                    <DockPanel Style="{DynamicResource ShowWhenTagTrueStyle}" Tag="{Binding HasLoadPorts}">
                        <Border
                            Padding="0"
                            DockPanel.Dock="Top"
                            Style="{DynamicResource ZoneHeaderBorderStyle}">
                            <ListBox
                                ItemContainerStyle="{DynamicResource UnderlineTabListBoxItemStyle}"
                                ItemsSource="{Binding LoadPorts}"
                                SelectedItem="{Binding SelectedLoadPort}"
                                Style="{DynamicResource UnderlineTabListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Grid Margin="14,10,14,12" DataContext="{Binding SelectedLoadPort}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  载具 | 槽图认定到哪一步 | 槽数  -->
                            <StackPanel
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal">
                                <TextBlock Style="{DynamicResource FormLabelTextStyle}" Text="{DynamicResource main.carrier}" />
                                <TextBlock Style="{DynamicResource FormValueTextStyle}" Text="{Binding CarrierText}" />
                                <Border Margin="18,7" Style="{DynamicResource ToolbarSeparatorBorderStyle}" />
                                <TextBlock Style="{DynamicResource MapStatusTextStyle}" Tag="{Binding MapStatus}" />
                                <Border Margin="18,7" Style="{DynamicResource ToolbarSeparatorBorderStyle}" />
                                <TextBlock Style="{DynamicResource FormLabelTextStyle}" Text="{DynamicResource main.slots}" />
                                <TextBlock Style="{DynamicResource FormValueTextStyle}" Text="{Binding SlotCount}" />
                            </StackPanel>

                            <TextBlock
                                Grid.Row="2"
                                Style="{DynamicResource FormLabelTextStyle}"
                                Text="{DynamicResource main.lot_id}" />
                            <controls:InputTextBox
                                Grid.Row="2"
                                Grid.Column="1"
                                DataType="Text"
                                Style="{DynamicResource ToolbarTextBoxStyle}"
                                Value="{Binding LotId}" />

                            <!--  整篮的 Sequence：一选就给所有能做的片套上；单独改用表里的 ⊕  -->
                            <TextBlock
                                Grid.Row="4"
                                Style="{DynamicResource FormLabelTextStyle}"
                                Text="{DynamicResource main.sequence}" />
                            <controls:PickerBox
                                Grid.Row="4"
                                Grid.Column="1"
                                ItemsSource="{Binding DataContext.SequenceOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                PickerTitle="{DynamicResource main.pick_sequence}"
                                Placeholder="{DynamicResource main.sequence_hint}"
                                Style="{DynamicResource ToolbarPickerBoxStyle}"
                                Value="{Binding Sequence}">
                                <controls:PickerBox.Columns>
                                    <controls:PickerColumn
                                        HeaderKey="recipe.sequence.index"
                                        Path="No"
                                        Width="80" />
                                    <controls:PickerColumn HeaderKey="recipe.sequence.name" Path="Name" />
                                </controls:PickerBox.Columns>
                            </controls:PickerBox>

                            <!--  Job 和按 Job 自动调度还没做：两个按钮先灰着，悬停说明  -->
                            <UniformGrid
                                Grid.Row="6"
                                Grid.ColumnSpan="2"
                                Margin="-4"
                                Columns="2">
                                <Button
                                    Content="{DynamicResource main.create_job}"
                                    IsEnabled="False"
                                    Style="{DynamicResource DefaultButtonStyle}"
                                    ToolTip="{DynamicResource main.job_pending_tip}"
                                    ToolTipService.ShowOnDisabled="True" />
                                <Button
                                    Content="{DynamicResource main.start_job}"
                                    IsEnabled="False"
                                    Style="{DynamicResource SuccessButtonStyle}"
                                    ToolTip="{DynamicResource main.job_pending_tip}"
                                    ToolTipService.ShowOnDisabled="True" />
                            </UniformGrid>

                            <!--  槽位表：25 槽一屏放得下；能做的片才有 ⊕ ⊖（空槽、交叉片、叠片没有）  -->
                            <Border
                                Grid.Row="8"
                                Grid.ColumnSpan="2"
                                Style="{DynamicResource ListPaneBorderStyle}">
                                <DataGrid
                                    CellStyle="{DynamicResource DefaultDataGridCellStyle}"
                                    ItemsSource="{Binding Slots}"
                                    RowHeight="24"
                                    Style="{DynamicResource DenseDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="64"
                                            Binding="{Binding SlotText, Mode=OneWay}"
                                            ElementStyle="{DynamicResource DenseDataGridTextStyle}"
                                            Header="{DynamicResource main.col.slot}" />
                                        <DataGridTextColumn
                                            Width="*"
                                            Binding="{Binding WaferId, Mode=OneWay}"
                                            ElementStyle="{DynamicResource DenseDataGridTextStyle}"
                                            Header="{DynamicResource main.col.wafer}" />
                                        <DataGridTemplateColumn Width="96" Header="{DynamicResource main.col.state}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{DynamicResource JobWaferStateDataGridTextStyle}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn
                                            Width="1.3*"
                                            Binding="{Binding Sequence, Mode=OneWay}"
                                            ElementStyle="{DynamicResource DenseDataGridTextStyle}"
                                            Header="{DynamicResource main.col.sequence}" />
                                        <DataGridTemplateColumn Width="64">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel
                                                        HorizontalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Style="{DynamicResource ShowWhenTagTrueStyle}"
                                                        Tag="{Binding CanAssign}">
                                                        <Button
                                                            Command="{Binding DataContext.PickSlotSequenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{DynamicResource RowIconButtonStyle}"
                                                            ToolTip="{DynamicResource main.add_sequence_tip}">
                                                            <materialDesign:PackIcon
                                                                Width="18"
                                                                Height="18"
                                                                Kind="PlusCircleOutline" />
                                                        </Button>
                                                        <Button
                                                            Margin="4,0,0,0"
                                                            Command="{Binding DataContext.ClearSlotSequenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{DynamicResource RowIconButtonStyle}"
                                                            ToolTip="{DynamicResource main.clear_sequence_tip}">
                                                            <materialDesign:PackIcon
                                                                Width="18"
                                                                Height="18"
                                                                Kind="MinusCircleOutline" />
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </DockPanel>

                    <!--  没有 LoadPort（启动时没连上后端，或 sc.xml 没配）：没有页签可选  -->
                    <TextBlock
                        Margin="24"
                        Style="{DynamicResource CenterNullHintTextStyle}"
                        Tag="{Binding SelectedLoadPort}"
                        Text="{DynamicResource main.no_loadport}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
