<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Info"
      internalLogFile="${basedir}/Log/internal-nlog.txt">

  <targets>
    <!-- 客户端日志：exe 同目录 Log\client-yyyy-MM-dd.log，超过 20MB 自动归档，最多留 10 个 -->
    <target xsi:type="File"
            name="file"
            fileName="${basedir}/Log/client-${shortdate}.log"
            layout="${longdate} [${level}] ${message}"
            encoding="utf-8"
            archiveAboveSize="20971520"
            maxArchiveFiles="10" />
  </targets>

  <rules>
    <logger name="*" minlevel="Debug" maxlevel="Error" writeTo="file" />
  </rules>
</nlog>
