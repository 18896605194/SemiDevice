<?xml version="1.0" encoding="utf-8"?>
<!--
  客户端日志：exe 同目录 Log\client-yyyy-MM-dd.log，一天一个、超过 20MB 拆。
  异步写：界面线程只放进队列就返回，不被磁盘卡住；退出、崩溃时写完（ClientLog.Shutdown / Flush）。
  留几天不在这里配：连上后端时按后端日志组件的 KeepDays 设（所以 autoReload 关着，热加载会把它冲掉）。
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="false"
      throwExceptions="false"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/Log/internal-nlog.txt">

  <targets async="true">
    <target xsi:type="File"
            name="file"
            fileName="${basedir}/Log/client-${shortdate}.log"
            layout="${longdate} [${level}] ${message}"
            encoding="utf-8"
            archiveAboveSize="20971520" />
  </targets>

  <rules>
    <logger name="*" minlevel="Debug" maxlevel="Error" writeTo="file" />
  </rules>
</nlog>
