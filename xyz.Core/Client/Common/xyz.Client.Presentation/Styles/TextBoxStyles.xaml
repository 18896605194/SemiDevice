<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:xyz.Client.Presentation.Controls">

    <Style
        x:Key="DefaultTextBoxStyle"
        BasedOn="{StaticResource MaterialDesignOutlinedTextBox}"
        TargetType="TextBox">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size14}" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="Background" Value="{StaticResource DarkControlBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource DarkPrimaryText}" />
    </Style>

    <Style
        x:Key="LargeTextBoxStyle"
        BasedOn="{StaticResource DefaultTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="FontSize" Value="{StaticResource Size20}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkAccent}" />
    </Style>

    <!--  工具栏里的输入（关键字……）：跟工具栏按钮同高（34），上下不留外边距  -->
    <Style
        x:Key="ToolbarTextBoxStyle"
        BasedOn="{StaticResource DefaultTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!--  参数行里的紧凑输入（如手动页槽位）：跟分段选择、下拉同一行高  -->
    <Style
        x:Key="CompactTextBoxStyle"
        BasedOn="{StaticResource DefaultTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
    </Style>


    <!--  公共选择框（PickerBox）的三档高，跟输入框一样：默认 40、工具栏 34、紧凑 28（字小一号）；宽度在用的地方设  -->
    <Style x:Key="DefaultPickerBoxStyle" TargetType="controls:PickerBox">
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="{StaticResource Size14}" />
    </Style>

    <Style
        x:Key="ToolbarPickerBoxStyle"
        BasedOn="{StaticResource DefaultPickerBoxStyle}"
        TargetType="controls:PickerBox">
        <Setter Property="Height" Value="34" />
    </Style>

    <Style
        x:Key="CompactPickerBoxStyle"
        BasedOn="{StaticResource DefaultPickerBoxStyle}"
        TargetType="controls:PickerBox">
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
    </Style>

</ResourceDictionary>
