<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ==================== 基础色 ====================  -->
    <SolidColorBrush x:Key="White" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Black" Color="#000000" />
    <SolidColorBrush x:Key="Transparent" Color="#00000000" />
    <SolidColorBrush x:Key="Gray" Color="#808080" />

    <!--  ==================== 主题色 ====================  -->
    <SolidColorBrush x:Key="PrimaryAccent" Color="#29A3FF" />
    <SolidColorBrush x:Key="PrimaryForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryBackground" Color="#272A33" />
    <SolidColorBrush x:Key="SecondaryForeground" Color="#AAAAAA" />
    <SolidColorBrush x:Key="DarkBackground" Color="#555555" />

    <!--  ==================== 功能色 ====================  -->
    <SolidColorBrush x:Key="RedDanger" Color="#FF0000" />
    <SolidColorBrush x:Key="OrangeWarning" Color="#FFA500" />
    <SolidColorBrush x:Key="GreenHealthy" Color="#008000" />
    <SolidColorBrush x:Key="BlueInfo" Color="#0000FF" />
    <SolidColorBrush x:Key="GreenSuccess" Color="#52C41A" />
    <SolidColorBrush x:Key="ErrorBorder" Color="#CF0E43" />
    <SolidColorBrush x:Key="ErrorForeground" Color="#FF6B6B" />
    <SolidColorBrush x:Key="ErrorBackground" Color="#FFB6C1" />
    <SolidColorBrush x:Key="DisabledBackground" Color="#4169E1" />

    <!--  ==================== Tab 样式 ====================  -->
    <SolidColorBrush x:Key="TabSelectedBackground" Color="#5D6985" />
    <SolidColorBrush x:Key="TabMouseOverBackground" Color="#5D6985" />
    <SolidColorBrush x:Key="TabDisEnabledBackground" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="TabDisEnabledBorderBrush" Color="#FFD9D9D9" />
    <SolidColorBrush x:Key="TabContentColor" Color="#FFD9D9D9" />
    <SolidColorBrush x:Key="DefaultButtonBackground" Color="#FFD9D9D9" />

    <!--  ==================== 控件通用 ====================  -->
    <SolidColorBrush x:Key="DefaultTextBoxBackGround" Color="#00000000" />
    <SolidColorBrush x:Key="DefaultBorderBrush" Color="#CCCCCC" />
    <SolidColorBrush x:Key="AccentBlue" Color="#5B9BD5" />
    <SolidColorBrush x:Key="AccentBlueDark" Color="#0078D4" />

    <!--  ==================== Button ====================  -->
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#5D6985" />
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#343D50" />

    <!--  ==================== DataGrid / ListBox ====================  -->
    <SolidColorBrush x:Key="DataGridBackground" Color="#272A33" />
    <SolidColorBrush x:Key="CardBackground" Color="#5D6579" />
    <SolidColorBrush x:Key="CardBorder" Color="#5D6579" />
    <SolidColorBrush x:Key="ItemHoverBackground" Color="#A3B0D1" />
    <SolidColorBrush x:Key="ItemSelectedBackground" Color="#404859" />

    <!--  ==================== Tree ====================  -->
    <SolidColorBrush x:Key="TreeBackground" Color="#1F2937" />
    <SolidColorBrush x:Key="TreeItemForeground" Color="#E2E8F0" />
    <SolidColorBrush x:Key="TreeItemSecondaryForeground" Color="#94A3B8" />
    <SolidColorBrush x:Key="TreeItemSelectedBackground" Color="#334155" />
    <SolidColorBrush x:Key="TreeItemHoverBackground" Color="#28354B" />
    <SolidColorBrush x:Key="TreeItemBorderBrush" Color="#3E4A5C" />
    <SolidColorBrush x:Key="TreeItemExpandedBackground" Color="#404859" />
    <SolidColorBrush x:Key="TreeItemExpandedBorder" Color="#475569" />

    <!--  ==================== CheckBox ====================  -->
    <SolidColorBrush x:Key="CheckBoxCheckBackground" Color="#3B82F6" />
    <SolidColorBrush x:Key="CheckBoxCheckBorder" Color="#2563EB" />

    <!--  ==================== RadioButton ====================  -->
    <SolidColorBrush x:Key="RadioButtonBackground" Color="#333333" />

    <!--  ==================== Dialog ====================  -->
    <SolidColorBrush x:Key="DialogBackground" Color="#272A33" />

    <!--  ==================== 设置选中色 ====================  -->
    <SolidColorBrush x:Key="SettingSelectColor" Color="#334155" />

    <!--  ==================== CUP 控件 ====================  -->
    <SolidColorBrush x:Key="CUPFill" Color="#ADF1CC" />
    <SolidColorBrush x:Key="CUPPartFill" Color="#C4C7CE" />

    <!--  ==================== ToggleSwitch ====================  -->
    <SolidColorBrush x:Key="ToggleActiveFill" Color="#2B8FFF" />

    <!--  ==================== Pipe ====================  -->
    <SolidColorBrush x:Key="GreenLight" Color="#90EE90" />
    <SolidColorBrush x:Key="GreenDark" Color="#006400" />
    <Color x:Key="GreenLightColor">#90EE90</Color>
    <Color x:Key="GreenDarkColor">#006400</Color>

    <SolidColorBrush x:Key="WaferProcessComplete" Color="Green" />
    <SolidColorBrush x:Key="WaferError" Color="Red" />
    <LinearGradientBrush x:Key="WaferInProcess" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#66EEEE" />
        <GradientStop Offset="1.0" Color="#0ED6D6" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WaferRcmComplete" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#B85CE9" />
        <GradientStop Offset="1.0" Color="#901ECD" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WaferIdleNojob" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#3F4453" />
        <GradientStop Offset="1.0" Color="#FFFFFF" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="WaferIdleJob" Color="#86EFAC" />

    <SolidColorBrush x:Key="WaferSoaking" Color="#38BDF8" />
    <SolidColorBrush x:Key="WaferTransfer" Color="#FACC15" />
    <SolidColorBrush x:Key="WaferCrossed" Color="#F59E0B" />
    <SolidColorBrush x:Key="WaferDouble" Color="#EC4899" />

</ResourceDictionary>
