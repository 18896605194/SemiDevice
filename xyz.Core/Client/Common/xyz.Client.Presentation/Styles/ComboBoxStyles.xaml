<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Style
        x:Key="DefaultComboBoxStyle"
        BasedOn="{StaticResource MaterialDesignOutlinedComboBox}"
        TargetType="ComboBox">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size14}" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="Background" Value="{StaticResource DarkControlBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="materialDesign:HintAssist.Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="materialDesign:HintAssist.HintOpacity" Value="1" />
    </Style>

    <Style
        x:Key="LargeComboBoxStyle"
        BasedOn="{StaticResource DefaultComboBoxStyle}"
        TargetType="ComboBox">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="FontSize" Value="{StaticResource Size20}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkAccent}" />
    </Style>

    <!--  工具栏里的下拉（级别、显示范围……）：跟工具栏按钮同高（34），上下不留外边距  -->
    <Style
        x:Key="ToolbarComboBoxStyle"
        BasedOn="{StaticResource DefaultComboBoxStyle}"
        TargetType="ComboBox">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!--  工艺步骤表格里的下拉格（按字段表生成，比如摆臂、药液、方式）：就是工具栏下拉（34 高），多一条 Tag=True 时红框（这一格选的不对）；
          提示字只在没选时显示在框里，选了就不再浮到框上面（表格里每格上方有列名，不用再标一遍）  -->
    <Style
        x:Key="StepComboBoxStyle"
        BasedOn="{StaticResource ToolbarComboBoxStyle}"
        TargetType="ComboBox">
        <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource DarkAlarmStatus}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  时间里的"时""分"下拉（DateTimePicker 日期框右边那两个，只用在工具栏里）：跟日期框同高，窄一点，下拉列表限高、滚着选  -->
    <Style
        x:Key="TimePartComboBoxStyle"
        BasedOn="{StaticResource ToolbarComboBoxStyle}"
        TargetType="ComboBox">
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MaxDropDownHeight" Value="320" />
    </Style>

    <!--  参数行里的紧凑下拉（如手动页选站点）：跟分段选择、输入同一行高  -->
    <Style
        x:Key="CompactComboBoxStyle"
        BasedOn="{StaticResource DefaultComboBoxStyle}"
        TargetType="ComboBox">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
    </Style>

</ResourceDictionary>
