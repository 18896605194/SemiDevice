<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SurfaceCardBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="18" />
        <Setter Property="Background" Value="{StaticResource DarkSurfaceVariantBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="HeaderBarBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="24,14" />
        <Setter Property="Background" Value="{StaticResource DarkSurfaceBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkAccent}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>

    <Style
        x:Key="ToolbarBorderStyle"
        BasedOn="{StaticResource SurfaceCardBorderStyle}"
        TargetType="Border">
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="TableHeaderBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Background" Value="{StaticResource DarkControlBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="TableRowBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DarkSurfaceBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="StatusDotBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource DarkDisabledText}" />
        <Setter Property="CornerRadius" Value="8" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{StaticResource DarkRunningStatus}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="ConnectionStatusDotBorderStyle"
        BasedOn="{StaticResource StatusDotBorderStyle}"
        TargetType="Border">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="CornerRadius" Value="9" />
    </Style>

    <Style x:Key="StatusFieldBorderStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Background" Value="{StaticResource DarkControlBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource DarkRunningStatus}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="LargeStatusDotBorderStyle"
        BasedOn="{StaticResource StatusDotBorderStyle}"
        TargetType="Border">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

</ResourceDictionary>
