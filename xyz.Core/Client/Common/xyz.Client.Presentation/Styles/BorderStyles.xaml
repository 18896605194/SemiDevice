<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SurfaceCardBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="18" />
        <Setter Property="Background" Value="{StaticResource DarkSurfaceVariantBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="HeaderBarBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="24,14" />
        <Setter Property="Background" Value="{StaticResource DarkSurfaceBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkAccent}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>

    <!--  页面顶上那一条工具栏：上下只留一点边，里面的控件用 Toolbar* 那套矮样式（34 高），整条不占地方  -->
    <Style
        x:Key="ToolbarBorderStyle"
        BasedOn="{StaticResource SurfaceCardBorderStyle}"
        TargetType="Border">
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!--  趋势图的悬停数值框：鼠标对准的那一刻，每条线一行（颜色、点名、值）  -->
    <Style x:Key="ChartHoverCardBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Background" Value="{StaticResource DarkChartHoverBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource Size13}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource DarkPrimaryText}" />
    </Style>

    <!--  趋势图中键框选时拖出来的框  -->
    <Style x:Key="ChartZoomBoxBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DarkChartZoomFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkAccent}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="TableHeaderBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Background" Value="{StaticResource DarkControlBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="TableRowBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DarkSurfaceBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="StatusDotBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource DarkDisabledText}" />
        <Setter Property="CornerRadius" Value="8" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{StaticResource DarkRunningStatus}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="ConnectionStatusDotBorderStyle"
        BasedOn="{StaticResource StatusDotBorderStyle}"
        TargetType="Border">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="CornerRadius" Value="9" />
    </Style>

    <Style x:Key="StatusFieldBorderStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Background" Value="{StaticResource DarkControlBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource DarkRunningStatus}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  卡片内分段的横线：一张卡里上下几段内容之间用它隔开（不拆成几张卡）  -->
    <Style x:Key="SectionDividerBorderStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,14" />
        <Setter Property="Background" Value="{StaticResource DarkBorderBrush}" />
    </Style>

    <!--  查询结果小面板（如手动页轴位表）：浅底细边圆角，里面按"标签 / 数值"两列排  -->
    <Style x:Key="ReadoutBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DarkControlBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <!--  主窗口的通栏（顶栏、底部导航）：贴满左右，不做成浮起的圆角卡片  -->
    <Style x:Key="ShellBarBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
    </Style>

    <!--  顶栏信息块（时间、当前用户）：深一档的底、细边圆角，上下两块一样宽，跟顶栏的日志 / 报警下拉框同高对齐  -->
    <Style x:Key="TopBarInfoBorderStyle" TargetType="Border">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{StaticResource DarkSurfaceBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!--  底部导航里一级菜单和二级页面之间的分隔：强调色竖光条，中间亮、两头渐隐，带一圈光晕（颜色同 DarkAccent）  -->
    <Style x:Key="SubNavDividerBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="16,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#0042A5F5" />
                    <GradientStop Offset="0.5" Color="#FF42A5F5" />
                    <GradientStop Offset="1" Color="#0042A5F5" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="12"
                    Opacity="0.9"
                    ShadowDepth="0"
                    Color="#42A5F5" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--  底部导航的二级页面托盘：下沉的深色圆角槽，里面放二级页面按钮（分段按钮的样子）  -->
    <Style x:Key="SubNavTrayBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource DarkControlBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
    </Style>

    <Style
        x:Key="LargeStatusDotBorderStyle"
        BasedOn="{StaticResource StatusDotBorderStyle}"
        TargetType="Border">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!--  列表、表格的底框（如账单调整页的位置列表、槽位表）：深底细边，里面的内容自己滚动  -->
    <Style x:Key="ListPaneBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DarkSurfaceBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <!--  底框顶上的标题条（如槽位表上面那一条：位置名、状态、几槽几片）  -->
    <Style x:Key="PaneCaptionBorderStyle" TargetType="Border">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{StaticResource DarkControlBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!--  两栏之间的圆形图标（如账单调整页源、目标两栏中间的箭头）  -->
    <Style x:Key="RoundIconBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource DarkControlBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource DarkAccent}" />
    </Style>

    <!--  页内确认层：Tag=True 时盖住整页（半透明黑，挡住后面的点击），确认框（DialogCardBorderStyle）居中浮在上面  -->
    <Style x:Key="PageOverlayBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DarkOverlayBackground}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  确认框：浮在确认层上的卡片  -->
    <Style x:Key="DialogCardBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="560" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource DarkControlBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!--  确认框里"要改的是什么"那一块：深底细边（片号大字，下面是从哪到哪）  -->
    <Style x:Key="DialogSummaryBorderStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,16,0,0" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Background" Value="{StaticResource DarkSurfaceBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!--  晶圆色条（如账单调整页槽位表的"晶圆"列、工具栏的颜色说明）。Tag 是片的色调：
          Idle 未处理 / InProcess 工艺中 / Completed 已完成 / Error 失败或中止 / Crossed 交叉片 / Double 叠片 / Dummy 陪片 / Unknown 状态不明；
          其他值（Empty）是空槽，画虚线框。用 Rectangle 是因为空槽要虚线，Border 画不了  -->
    <Style x:Key="WaferBarStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="10" />
        <Setter Property="RadiusX" Value="5" />
        <Setter Property="RadiusY" Value="5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeDashArray" Value="3 2" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Idle">
                <Setter Property="Fill" Value="{DynamicResource WaferIdleNojob}" />
                <Setter Property="Stroke" Value="{x:Null}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="InProcess">
                <Setter Property="Fill" Value="{DynamicResource WaferInProcess}" />
                <Setter Property="Stroke" Value="{x:Null}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Completed">
                <Setter Property="Fill" Value="{DynamicResource WaferProcessComplete}" />
                <Setter Property="Stroke" Value="{x:Null}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Error">
                <Setter Property="Fill" Value="{DynamicResource WaferError}" />
                <Setter Property="Stroke" Value="{x:Null}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Crossed">
                <Setter Property="Fill" Value="{DynamicResource WaferCrossed}" />
                <Setter Property="Stroke" Value="{x:Null}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Double">
                <Setter Property="Fill" Value="{DynamicResource WaferDouble}" />
                <Setter Property="Stroke" Value="{x:Null}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Dummy">
                <Setter Property="Fill" Value="{DynamicResource WaferDummy}" />
                <Setter Property="Stroke" Value="{x:Null}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Unknown">
                <Setter Property="Fill" Value="{DynamicResource Gray}" />
                <Setter Property="Stroke" Value="{x:Null}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  颜色说明里的小色条：比表格里的短一些  -->
    <Style
        x:Key="WaferLegendBarStyle"
        BasedOn="{StaticResource WaferBarStyle}"
        TargetType="Rectangle">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="8" />
        <Setter Property="RadiusX" Value="4" />
        <Setter Property="RadiusY" Value="4" />
        <Setter Property="Margin" Value="14,0,0,0" />
    </Style>

    <!--  通用：Tag=True 才显示的一块（如确认框里只有移动时才有的"→ 目标"）  -->
    <Style x:Key="ShowWhenTagTrueStyle" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
