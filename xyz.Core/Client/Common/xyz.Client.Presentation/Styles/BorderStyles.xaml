<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SurfaceCardBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="18" />
        <Setter Property="Background" Value="{StaticResource DarkSurfaceVariantBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="HeaderBarBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="24,14" />
        <Setter Property="Background" Value="{StaticResource DarkSurfaceBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkAccent}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>

    <!--  页面顶上那一条工具栏：上下只留一点边，里面的控件用 Toolbar* 那套矮样式（34 高），整条不占地方  -->
    <Style
        x:Key="ToolbarBorderStyle"
        BasedOn="{StaticResource SurfaceCardBorderStyle}"
        TargetType="Border">
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!--  趋势图的悬停数值框：鼠标对准的那一刻，每条线一行（颜色、点名、值）  -->
    <Style x:Key="ChartHoverCardBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Background" Value="{StaticResource DarkChartHoverBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource Size13}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource DarkPrimaryText}" />
    </Style>

    <!--  趋势图中键框选时拖出来的框  -->
    <Style x:Key="ChartZoomBoxBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DarkChartZoomFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkAccent}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="TableHeaderBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Background" Value="{StaticResource DarkControlBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="TableRowBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DarkSurfaceBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="StatusDotBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource DarkDisabledText}" />
        <Setter Property="CornerRadius" Value="8" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{StaticResource DarkRunningStatus}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="ConnectionStatusDotBorderStyle"
        BasedOn="{StaticResource StatusDotBorderStyle}"
        TargetType="Border">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="CornerRadius" Value="9" />
    </Style>

    <Style x:Key="StatusFieldBorderStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Background" Value="{StaticResource DarkControlBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource DarkRunningStatus}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  卡片内分段的横线：一张卡里上下几段内容之间用它隔开（不拆成几张卡）  -->
    <Style x:Key="SectionDividerBorderStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,14" />
        <Setter Property="Background" Value="{StaticResource DarkBorderBrush}" />
    </Style>

    <!--  查询结果小面板（如手动页轴位表）：浅底细边圆角，里面按"标签 / 数值"两列排  -->
    <Style x:Key="ReadoutBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DarkControlBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <!--  主窗口的通栏（顶栏、底部导航）：贴满左右，不做成浮起的圆角卡片  -->
    <Style x:Key="ShellBarBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
    </Style>

    <!--  顶栏信息块（时间、当前用户）：不要底框，只占位跟顶栏的日志 / 报警下拉框同高对齐  -->
    <Style x:Key="TopBarInfoBorderStyle" TargetType="Border">
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!--  底部导航里一级菜单和二级页面之间的分隔：强调色竖光条，中间亮、两头渐隐，带一圈光晕（颜色同 DarkAccent）  -->
    <Style x:Key="SubNavDividerBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="16,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#0042A5F5" />
                    <GradientStop Offset="0.5" Color="#FF42A5F5" />
                    <GradientStop Offset="1" Color="#0042A5F5" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="12"
                    Opacity="0.9"
                    ShadowDepth="0"
                    Color="#42A5F5" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--  底部导航的二级页面托盘：下沉的深色圆角槽，里面放二级页面按钮（分段按钮的样子）  -->
    <Style x:Key="SubNavTrayBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource DarkControlBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
    </Style>

    <Style
        x:Key="LargeStatusDotBorderStyle"
        BasedOn="{StaticResource StatusDotBorderStyle}"
        TargetType="Border">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

</ResourceDictionary>
