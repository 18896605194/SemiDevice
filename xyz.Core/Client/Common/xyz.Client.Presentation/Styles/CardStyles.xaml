<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Style x:Key="DefaultCardStyle" TargetType="materialDesign:Card">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Background" Value="{StaticResource DarkSurfaceVariantBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="UniformCornerRadius" Value="8" />
        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1" />
    </Style>


    <!--  弹窗卡片（公共选择弹窗）：深底、细边、圆角 6，带阴影浮在主窗口上  -->
    <Style
        x:Key="DialogCardStyle"
        BasedOn="{StaticResource DefaultCardStyle}"
        TargetType="materialDesign:Card">
        <Setter Property="Padding" Value="24" />
        <Setter Property="Background" Value="{StaticResource DarkControlBackground}" />
        <Setter Property="UniformCornerRadius" Value="6" />
        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp16" />
    </Style>

</ResourceDictionary>
