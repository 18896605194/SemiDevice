<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DefaultDataGridTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size14}" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
    </Style>

    <Style x:Key="DefaultDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size14}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="Background" Value="{StaticResource DarkControlBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>

    <Style x:Key="DefaultDataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
                <Setter Property="Background" Value="{StaticResource DarkAccentPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="DefaultDataGridStyle"
        BasedOn="{StaticResource MaterialDesignDataGrid}"
        TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="RowHeight" Value="46" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="Background" Value="{StaticResource DarkSurfaceBackground}" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="RowBackground" Value="{StaticResource DarkSurfaceBackground}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource DarkSurfaceVariantBackground}" />
        <Setter Property="FontSize" Value="{StaticResource Size14}" />
        <Setter Property="CellStyle" Value="{StaticResource DefaultDataGridCellStyle}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource DefaultDataGridColumnHeaderStyle}" />
    </Style>

    <!--  紧凑表格：行矮、字小，用于日志、报警这类一屏要看很多行的列表  -->
    <Style
        x:Key="CompactDataGridStyle"
        BasedOn="{StaticResource DefaultDataGridStyle}"
        TargetType="DataGrid">
        <Setter Property="RowHeight" Value="32" />
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
    </Style>

    <!--  长文本单元格：一行显示，超长省略，鼠标悬停看全文  -->
    <Style
        x:Key="EllipsisDataGridTextStyle"
        BasedOn="{StaticResource DefaultDataGridTextStyle}"
        TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>

    <!--  日志级别单元格（行数据要有 Level 属性）：Debug 灰、Warn 黄、Error 红  -->
    <Style
        x:Key="LogLevelDataGridTextStyle"
        BasedOn="{StaticResource DefaultDataGridTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="Debug">
                <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Warn">
                <Setter Property="Foreground" Value="{StaticResource DarkWarningStatus}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Error">
                <Setter Property="Foreground" Value="{StaticResource DarkAlarmStatus}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  报警等级单元格（行数据要有 Level 属性）：Warn 黄、Alarm1/Alarm2 橙、Fatal 红  -->
    <Style
        x:Key="AlarmLevelDataGridTextStyle"
        BasedOn="{StaticResource DefaultDataGridTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="Warn">
                <Setter Property="Foreground" Value="{StaticResource DarkWarningStatus}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Alarm1">
                <Setter Property="Foreground" Value="{StaticResource DarkAlarmIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Alarm2">
                <Setter Property="Foreground" Value="{StaticResource DarkAlarmIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Fatal">
                <Setter Property="Foreground" Value="{StaticResource DarkAlarmStatus}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
