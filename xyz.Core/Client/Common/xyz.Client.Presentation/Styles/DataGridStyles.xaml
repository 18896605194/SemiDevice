<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:xyz.Client.Presentation.Helpers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Style x:Key="DefaultDataGridTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size14}" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
    </Style>

    <Style x:Key="DefaultDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size14}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="Background" Value="{StaticResource DarkControlBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>

    <Style x:Key="DefaultDataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
                <Setter Property="Background" Value="{StaticResource DarkAccentPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="DefaultDataGridStyle"
        BasedOn="{StaticResource MaterialDesignDataGrid}"
        TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="RowHeight" Value="46" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="Background" Value="{StaticResource DarkSurfaceBackground}" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="RowBackground" Value="{StaticResource DarkSurfaceBackground}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource DarkSurfaceVariantBackground}" />
        <Setter Property="FontSize" Value="{StaticResource Size14}" />
        <Setter Property="CellStyle" Value="{StaticResource DefaultDataGridCellStyle}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource DefaultDataGridColumnHeaderStyle}" />
        <!--  有星号列时各列铺满可视宽度：页面启动时先建好、后挂进窗口，DataGrid 会把列宽算成最小值又补不回来，
              表头和内容的字全被裁掉（见 DataGridColumnFill）  -->
        <Setter Property="helpers:DataGridColumnFill.IsEnabled" Value="True" />
    </Style>

    <!--  紧凑表格：行矮、字小，用于日志、报警这类一屏要看很多行的列表  -->
    <Style
        x:Key="CompactDataGridStyle"
        BasedOn="{StaticResource DefaultDataGridStyle}"
        TargetType="DataGrid">
        <Setter Property="RowHeight" Value="32" />
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
        <!--  Material 单元格默认上下各留 8 的内边距，32 高的行只剩 16 给内容：下划线、g/y/p 的下半截、行里的小按钮都会被裁。
              上下清零（内容本来就垂直居中），左右保持 16 不动  -->
        <Setter Property="materialDesign:DataGridAssist.CellPadding" Value="16,0" />
    </Style>

    <!--  矮表头（配 DenseDataGridStyle）：左右边距也收一些  -->
    <Style
        x:Key="CompactDataGridColumnHeaderStyle"
        BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}"
        TargetType="DataGridColumnHeader">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
    </Style>

    <!--  密表格：行更矮、表头也矮、格子左右只留 4（配 DenseDataGridTextStyle 再留 4），不带外框（外面套 ListPaneBorderStyle）；
          一屏要放下整篮 25 槽、几列挤在一栏里的地方用（如账单调整页的槽位表、调整记录）。
          先后由数据定（槽位表 LoadPort 大号在上、记录新的在上），不让点表头排序，表头也就不用给排序箭头留位置  -->
    <Style
        x:Key="DenseDataGridStyle"
        BasedOn="{StaticResource CompactDataGridStyle}"
        TargetType="DataGrid">
        <Setter Property="RowHeight" Value="27" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CanUserSortColumns" Value="False" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource CompactDataGridColumnHeaderStyle}" />
        <Setter Property="materialDesign:DataGridAssist.CellPadding" Value="4,0" />
        <!--  Material 的表头模板按这个附加属性留边（上下左右都是），表头样式里的 Padding 管不到；上下 8 正好是原来的表头高度  -->
        <Setter Property="materialDesign:DataGridAssist.ColumnHeaderPadding" Value="8,8" />
    </Style>

    <!--  长文本单元格：一行显示，超长省略，鼠标悬停看全文  -->
    <Style
        x:Key="EllipsisDataGridTextStyle"
        BasedOn="{StaticResource DefaultDataGridTextStyle}"
        TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>

    <!--  密表格（DenseDataGridStyle）的单元格：小一号、左右只留 4，超长省略、悬停看全文  -->
    <Style
        x:Key="DenseDataGridTextStyle"
        BasedOn="{StaticResource EllipsisDataGridTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
    </Style>

    <!--  日志级别单元格（行数据要有 Level 属性）：Debug 灰、Warn 黄、Error 红  -->
    <Style
        x:Key="LogLevelDataGridTextStyle"
        BasedOn="{StaticResource DefaultDataGridTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="Debug">
                <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Warn">
                <Setter Property="Foreground" Value="{StaticResource DarkWarningStatus}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Error">
                <Setter Property="Foreground" Value="{StaticResource DarkAlarmStatus}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  可点选的行（行数据要有 IsPickable 属性）：能选的手形光标；不能选的点不中（如账单调整页源栏的空槽、目标栏有片的槽）  -->
    <Style
        x:Key="PickDataGridRowStyle"
        BasedOn="{StaticResource MaterialDesignDataGridRow}"
        TargetType="DataGridRow">
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPickable}" Value="False">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Cursor" Value="Arrow" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  配 PickDataGridRowStyle 用的单元格：不能选的行字变灰  -->
    <Style
        x:Key="PickDataGridCellStyle"
        BasedOn="{StaticResource DefaultDataGridCellStyle}"
        TargetType="DataGridCell">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPickable}" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  刚加进来的行（行数据要有 IsFresh 属性）淡强调底，比如账单调整页刚做完的那条调整记录  -->
    <Style
        x:Key="FreshDataGridCellStyle"
        BasedOn="{StaticResource DefaultDataGridCellStyle}"
        TargetType="DataGridCell">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFresh}" Value="True">
                <Setter Property="Background" Value="{StaticResource DarkAccentSoft}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  账单调整记录的"操作"单元格（行数据要有 Action 属性）：Move 移动（强调色）、Delete 删除（红）、Create 新建（绿）  -->
    <Style
        x:Key="LedgerActionDataGridTextStyle"
        BasedOn="{StaticResource DenseDataGridTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Text" Value="{Binding Action}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Action}" Value="Move">
                <Setter Property="Text" Value="{DynamicResource setting.ledger.action.Move}" />
                <Setter Property="Foreground" Value="{StaticResource DarkAccent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Action}" Value="Delete">
                <Setter Property="Text" Value="{DynamicResource setting.ledger.action.Delete}" />
                <Setter Property="Foreground" Value="{StaticResource DarkAlarmStatus}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Action}" Value="Create">
                <Setter Property="Text" Value="{DynamicResource setting.ledger.action.Create}" />
                <Setter Property="Foreground" Value="{StaticResource DarkRunningStatus}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  报警等级单元格（行数据要有 Level 属性）：Warn 黄、Alarm1/Alarm2 橙、Fatal 红  -->
    <Style
        x:Key="AlarmLevelDataGridTextStyle"
        BasedOn="{StaticResource DefaultDataGridTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="Warn">
                <Setter Property="Foreground" Value="{StaticResource DarkWarningStatus}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Alarm1">
                <Setter Property="Foreground" Value="{StaticResource DarkAlarmIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Alarm2">
                <Setter Property="Foreground" Value="{StaticResource DarkAlarmIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Fatal">
                <Setter Property="Foreground" Value="{StaticResource DarkAlarmStatus}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>


    <!--  块里、框里的表格（如流程配方页左边的列表、公共选择弹窗的列表）：不带外框（外面已经有边了），行 32，不能点表头排序。
          用的地方还要在 DataGrid 上直接写 CellStyle，见流程配方页  -->
    <Style
        x:Key="ZoneDataGridStyle"
        BasedOn="{StaticResource CompactDataGridStyle}"
        TargetType="DataGrid">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CanUserSortColumns" Value="False" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource CompactDataGridColumnHeaderStyle}" />
        <!--  Material 的表头按这个附加属性留边，表头样式里的 Padding 管不到；左右 8 跟单元格里的字（左边距 8）对齐，上下 10 是 Material 原样  -->
        <Setter Property="materialDesign:DataGridAssist.ColumnHeaderPadding" Value="8,10" />
    </Style>

    <!--  流程配方列表的编号列（行数据要有 IsUsed）：没用的编号灰字  -->
    <Style
        x:Key="SlotIndexDataGridTextStyle"
        BasedOn="{StaticResource DefaultDataGridTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsUsed}" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
