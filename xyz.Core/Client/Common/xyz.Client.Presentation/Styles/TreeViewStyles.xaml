<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DefaultTreeViewStyle" TargetType="TreeView">
        <Setter Property="Padding" Value="4,8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!--  勾选树的节点（数据曲线的信号树）：行矮一些；展开、显示跟着节点模型的 IsExpanded / IsShown 走（搜索过滤时藏掉不匹配的）  -->
    <Style
        x:Key="CheckTreeViewItemStyle"
        BasedOn="{StaticResource MaterialDesignTreeViewItem}"
        TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="FontSize" Value="{StaticResource Size14}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsShown}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  导航树的节点（EC 设置页左边的组件树）：点哪个节点右边就列哪个；选中、展开跟着节点模型的 IsSelected / IsExpanded 走  -->
    <Style
        x:Key="NavTreeViewItemStyle"
        BasedOn="{StaticResource MaterialDesignTreeViewItem}"
        TargetType="TreeViewItem">
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="FontSize" Value="{StaticResource Size14}" />
    </Style>

    <Style x:Key="DefaultTreeViewItemStyle" TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="True" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource DarkAccentPressed}" />
                <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
