<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:xyz.Client.Presentation.Converters"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ItemsPanelTemplate x:Key="HorizontalListBoxItemsPanelTemplate">
        <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <Style
        x:Key="NavigationListBoxStyle"
        BasedOn="{StaticResource MaterialDesignListBox}"
        TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <!--  底部导航一级菜单：图标 + 名字  -->
    <DataTemplate x:Key="BottomNavItemTemplate">
        <StackPanel Orientation="Horizontal">
            <materialDesign:PackIcon
                Width="20"
                Height="20"
                VerticalAlignment="Center"
                Kind="{Binding Code, Converter={x:Static converters:MenuIconConverter.Instance}}" />
            <!--  Name 是壳按菜单编码从语言包取好的 menu.{Code}  -->
            <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                FontSize="{StaticResource Size14}"
                FontWeight="SemiBold"
                Text="{Binding Name}" />
        </StackPanel>
    </DataTemplate>

    <!--  底部导航一级菜单项：等宽标签；选中 = 顶部一条强调色指示线 + 强调色文字，悬停微微提亮，没有焦点虚线框  -->
    <Style x:Key="BottomNavListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Width" Value="150" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                        <Border
                            x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6" />
                        <Border
                            x:Name="Indicator"
                            Height="3"
                            Margin="20,0"
                            VerticalAlignment="Top"
                            Background="{StaticResource DarkAccent}"
                            CornerRadius="0,0,2,2"
                            Visibility="Collapsed" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#0FFFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#1F42A5F5" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource DarkAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  可点选的竖列表（如账单调整页的位置列表）：透明底无边（外面套 ListPaneBorderStyle），只竖向滚动  -->
    <Style
        x:Key="PickListBoxStyle"
        BasedOn="{StaticResource MaterialDesignListBox}"
        TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <!--  可点选列表的一项：一行 34 高、内容铺满；悬停微微提亮，选中实心强调色  -->
    <Style x:Key="PickListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="10,0,6,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size14}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="Chrome"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DarkHoverBackground}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DarkAccentPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  底部导航二级页面（跟在一级菜单后面）  -->
    <DataTemplate x:Key="SubNavItemTemplate">
        <TextBlock
            VerticalAlignment="Center"
            FontSize="{StaticResource Size14}"
            Text="{Binding Name}" />
    </DataTemplate>

    <!--  底部导航二级页面：放在托盘里的分段按钮；其它页 = 灰字，悬停提亮；当前页 = 实心强调色白字。
          宽度按"IO 下 8 项（Safety + 7 个模块）一行放得下"定的，再加宽最右边的会被挤出窗口  -->
    <Style x:Key="SubNavListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="Chrome"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="18">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#14FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DarkAccentPressed}" />
                            <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--  流程步骤的一行（行数据要有 HasError）：至少 54 高；悬停微微提亮，选中淡强调底、左边一道强调色竖条；
          有问题整行淡红底；行间一道细线  -->
    <Style x:Key="StepListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="54" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="FontSize" Value="{StaticResource Size14}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border
                            x:Name="Back"
                            Background="Transparent"
                            BorderBrush="{StaticResource DarkBorderBrush}"
                            BorderThickness="0,0,0,1" />
                        <Border
                            x:Name="ErrorTint"
                            Margin="0,0,0,1"
                            Background="{StaticResource DarkAlarmStatus}"
                            Opacity="0.12"
                            Visibility="Collapsed" />
                        <Border
                            x:Name="SelectBar"
                            Width="3"
                            Margin="0,0,0,1"
                            HorizontalAlignment="Left"
                            Background="{StaticResource DarkAccent}"
                            Visibility="Collapsed" />
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{StaticResource DarkHoverBackground}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter TargetName="ErrorTint" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{StaticResource DarkAccentSoft}" />
                            <Setter TargetName="SelectBar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  下划线页签（腔体手动页的轴页签）：一排字，选中的蓝字 + 底下一条蓝线，鼠标移上去变亮；ListBox 套 UnderlineTabListBoxStyle  -->
    <Style
        x:Key="UnderlineTabListBoxStyle"
        BasedOn="{StaticResource MaterialDesignListBox}"
        TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemsPanel" Value="{StaticResource HorizontalListBoxItemsPanelTemplate}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="UnderlineTabListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
        <Setter Property="FontSize" Value="{StaticResource Size15}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                        <Border
                            x:Name="Underline"
                            Height="2"
                            VerticalAlignment="Bottom"
                            Background="{StaticResource DarkAccent}"
                            Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource DarkAccent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
