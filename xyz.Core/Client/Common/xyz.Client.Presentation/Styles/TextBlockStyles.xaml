<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Size28}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Size20}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,8,24,8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size22}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="FieldValueTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size22}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ColumnHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size14}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="StatusLabelTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size16}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ConnectionStatusTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size20}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
        <Setter Property="Text" Value="OFFLINE" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DarkRunningStatus}" />
                <Setter Property="Text" Value="ONLINE" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusValueTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size22}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DarkRunningStatus}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  顶栏信息块里的主值（时间、用户名）：数字等宽，秒跳动时不晃  -->
    <Style x:Key="TopBarValueTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!--  顶栏信息块里的附注（日期）：小一号、灰一点  -->
    <Style x:Key="TopBarCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size10}" />
        <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!--  报警等级文字（数据要有 Level 属性）：Warn 黄、Alarm1/Alarm2 橙、Fatal 红  -->
    <Style x:Key="AlarmLevelTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="Warn">
                <Setter Property="Foreground" Value="{StaticResource DarkWarningStatus}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Alarm1">
                <Setter Property="Foreground" Value="{StaticResource DarkAlarmIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Alarm2">
                <Setter Property="Foreground" Value="{StaticResource DarkAlarmIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Fatal">
                <Setter Property="Foreground" Value="{StaticResource DarkAlarmStatus}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  区域正中的一句提示：灰字、不挡鼠标  -->
    <Style x:Key="CenterHintTextStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size16}" />
        <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!--  趋势图悬停数值框的第一行：时刻，小字、灰  -->
    <Style x:Key="ChartHoverTimeTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="FontSize" Value="{StaticResource Size12}" />
        <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
    </Style>

    <!--  列表、树里名字后面的附注（点位地址、单位）：小一号、灰  -->
    <Style x:Key="ItemDetailTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size12}" />
        <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
    </Style>

    <Style x:Key="NullContentHintTextStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  卡片里一栏的标题（如账单调整页的"源""目标""调整记录"）  -->
    <Style x:Key="PanelTitleTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size16}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
    </Style>

    <!--  分组列表的组名（如账单调整页位置列表的"机械手""LoadPort""腔体"）：小字、灰  -->
    <Style x:Key="ListGroupHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="12,10,12,4" />
        <Setter Property="FontSize" Value="{StaticResource Size12}" />
        <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
    </Style>

    <!--  确认框里的主角（如要调整的片号）：大一号、加粗  -->
    <Style x:Key="DialogSubjectTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Size20}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!--  账单调整页正中的一句提示：Tag 是页面状态——Offline 没连上后端 / Disabled 晶圆账没开 / NoLocations 没有能放片的位置；
          其他（Ready 有账、Loading 正在拉）不显示  -->
    <Style
        x:Key="LedgerPageHintTextStyle"
        BasedOn="{StaticResource CenterHintTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Offline">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Text" Value="{DynamicResource setting.ledger.offline}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Disabled">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Text" Value="{DynamicResource wafer.ledger_disabled}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="NoLocations">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Text" Value="{DynamicResource setting.ledger.no_locations}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  账单调整页确认框的标题：Tag 是要做的事（Move 移动 / Delete 删除 / Create 新建）  -->
    <Style x:Key="LedgerDialogTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Size18}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Move">
                <Setter Property="Text" Value="{DynamicResource setting.ledger.confirm_move_title}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Delete">
                <Setter Property="Text" Value="{DynamicResource setting.ledger.confirm_delete_title}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Create">
                <Setter Property="Text" Value="{DynamicResource setting.ledger.confirm_create_title}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  账单调整页确认框的说明：灰字、自动换行；删账（Tag=Delete）换成警告黄的那一句；Tag=Create 是补账的说明  -->
    <Style x:Key="LedgerDialogHintTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,14,0,0" />
        <Setter Property="FontSize" Value="{StaticResource Size14}" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Move">
                <Setter Property="Text" Value="{DynamicResource setting.ledger.move_hint}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Delete">
                <Setter Property="Text" Value="{DynamicResource setting.ledger.delete_hint}" />
                <Setter Property="Foreground" Value="{StaticResource DarkWarningStatus}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Create">
                <Setter Property="Text" Value="{DynamicResource setting.ledger.create_hint}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>


    <!--  块标题条里的标题（如流程配方页"流程配方""基本信息""流程步骤""路线预览"）  -->
    <Style x:Key="ZoneTitleTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size15}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
    </Style>

    <!--  块标题条里的红字（如流程步骤检查没过的地方）：一行放不下就省略，悬停看全文；没有字时什么都不显示  -->
    <Style x:Key="ZoneErrorTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="16,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size12}" />
        <Setter Property="Foreground" Value="{StaticResource DarkAlarmStatus}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="ToolTip" Value="{x:Null}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  一组只读字段的小标题（如基本信息里的"创建人""修改时间"）：小字、灰  -->
    <Style x:Key="MetaLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Size12}" />
        <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
    </Style>

    <!--  只读字段的值：正文大小，数字等宽，放不下省略  -->
    <Style x:Key="MetaValueTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,3,8,0" />
        <Setter Property="FontSize" Value="{StaticResource Size14}" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!--  确认框里的说明：灰字、自动换行；没有字时不占地方（如流程配方页新建框没有说明）  -->
    <Style x:Key="DialogMessageTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,14,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  确认框里后端拒了的原因：红字、自动换行；没有时不占地方  -->
    <Style
        x:Key="DialogErrorTextStyle"
        BasedOn="{StaticResource DialogMessageTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="Foreground" Value="{StaticResource DarkAlarmStatus}" />
    </Style>

    <!--  行里的红字提示（如流程步骤"至少勾一个 Chamber"）  -->
    <Style x:Key="RowErrorTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size12}" />
        <Setter Property="Foreground" Value="{StaticResource DarkAlarmStatus}" />
    </Style>

    <!--  路线预览一列上面的步号：小字、灰  -->
    <Style x:Key="RouteNumberTextStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
        <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
    </Style>

    <!--  路线预览一列下面的工艺配方名：强调色小字；Tag=True（没选）时红字  -->
    <Style x:Key="RouteRecipeTextStyle" TargetType="TextBlock">
        <Setter Property="Height" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size12}" />
        <Setter Property="Foreground" Value="{StaticResource DarkAccent}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DarkAlarmStatus}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  正中的一句提示，Tag=True 才显示（如流程配方页没连上后端、没装流程配方库时）  -->
    <Style
        x:Key="CenterTagHintTextStyle"
        BasedOn="{StaticResource CenterHintTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  正中的一句提示，Tag 为 null 才显示（如流程配方页选中空编号时步骤区的"新建以后在这里编辑步骤"）  -->
    <Style
        x:Key="CenterNullHintTextStyle"
        BasedOn="{StaticResource CenterHintTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
