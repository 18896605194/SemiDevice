<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Size28}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Size20}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,8,24,8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size22}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="FieldValueTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size22}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ColumnHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size14}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="StatusLabelTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size16}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ConnectionStatusTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size20}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
        <Setter Property="Text" Value="OFFLINE" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DarkRunningStatus}" />
                <Setter Property="Text" Value="ONLINE" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusValueTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size22}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DarkRunningStatus}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  顶栏信息块里的主值（时间、用户名）：数字等宽，秒跳动时不晃  -->
    <Style x:Key="TopBarValueTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!--  顶栏信息块里的附注（日期）：小一号、灰一点  -->
    <Style x:Key="TopBarCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size10}" />
        <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!--  报警等级文字（数据要有 Level 属性）：Warn 黄、Alarm1/Alarm2 橙、Fatal 红  -->
    <Style x:Key="AlarmLevelTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="Warn">
                <Setter Property="Foreground" Value="{StaticResource DarkWarningStatus}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Alarm1">
                <Setter Property="Foreground" Value="{StaticResource DarkAlarmIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Alarm2">
                <Setter Property="Foreground" Value="{StaticResource DarkAlarmIcon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Fatal">
                <Setter Property="Foreground" Value="{StaticResource DarkAlarmStatus}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NullContentHintTextStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
