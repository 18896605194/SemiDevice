<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Style
        x:Key="DefaultButtonStyle"
        BasedOn="{StaticResource MaterialDesignRaisedButton}"
        TargetType="Button">
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Background" Value="{StaticResource DarkAccentPressed}" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkAccentPressed}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{StaticResource Size14}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style
        x:Key="DangerButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DarkAlarmStatus}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkAlarmStatus}" />
    </Style>

    <!--  工具栏按钮（页面顶上那一条工具栏里的查询、今天、暂停、创建……）：跟工具栏里的输入框、下拉同高（34），按钮之间留 8  -->
    <Style
        x:Key="ToolbarButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <Style
        x:Key="ToolbarDangerButtonStyle"
        BasedOn="{StaticResource ToolbarButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DarkAlarmStatus}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkAlarmStatus}" />
    </Style>

    <!--  图角上的小图标按钮（趋势图右上角的放大）：圆形、透明底，浮在图上不挡曲线  -->
    <Style
        x:Key="ChartCornerButtonStyle"
        BasedOn="{StaticResource MaterialDesignIconButton}"
        TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource DarkChartAxisText}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!--  紧凑按钮：多行按钮区（如 LoadPort 手动操作）用，比默认按钮矮一档  -->
    <Style
        x:Key="CompactButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
    </Style>

    <Style
        x:Key="CompactSuccessButtonStyle"
        BasedOn="{StaticResource CompactButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DarkRunningStatus}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkRunningStatus}" />
    </Style>

    <Style
        x:Key="CompactDangerButtonStyle"
        BasedOn="{StaticResource CompactButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DarkAlarmStatus}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkAlarmStatus}" />
    </Style>

    <!--  行内小按钮（如机械手参数框里使能那一行的 ON / OFF）：描边、矮小，不抢主按钮  -->
    <Style
        x:Key="MiniButtonStyle"
        BasedOn="{StaticResource MaterialDesignOutlinedButton}"
        TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="{StaticResource Size12}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4" />
    </Style>

    <!--  分段选择组（如手动页选手臂）：一排互斥小块，选中填强调色；配 CompactSegmentItemStyle 用  -->
    <Style
        x:Key="CompactSegmentListBoxStyle"
        BasedOn="{StaticResource MaterialDesignListBox}"
        TargetType="ListBox">
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="{StaticResource DarkControlBackground}" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <!--  分段选择块：选中实心强调色，块与块之间一条细线  -->
    <Style x:Key="CompactSegmentItemStyle" TargetType="ListBoxItem">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="Chrome"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{StaticResource DarkBorderBrush}"
                        BorderThickness="0,0,1,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#14FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DarkAccent}" />
                            <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="SuccessButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DarkRunningStatus}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkRunningStatus}" />
    </Style>

    <Style
        x:Key="LargeActionButtonStyle"
        BasedOn="{StaticResource MaterialDesignRaisedButton}"
        TargetType="Button">
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FontSize" Value="{StaticResource Size28}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="PrimaryLargeActionButtonStyle"
        BasedOn="{StaticResource LargeActionButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DarkAccentPressed}" />
    </Style>

    <Style
        x:Key="SuccessLargeActionButtonStyle"
        BasedOn="{StaticResource LargeActionButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DarkRunningStatus}" />
    </Style>

    <!--  顶栏右上角竖排的小按钮（注销、关蜂鸣器）：描边；三个按钮一样宽高，竖排正好占满顶栏两行  -->
    <Style
        x:Key="TopBarStackButtonStyle"
        BasedOn="{StaticResource MaterialDesignOutlinedButton}"
        TargetType="Button">
        <Setter Property="Width" Value="104" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4" />
    </Style>

    <!--  竖排按钮里的主操作（整机复位）：实心强调色；Tag=True（有报警）时变红提醒  -->
    <Style
        x:Key="TopBarStackAccentButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Width" Value="104" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{StaticResource DarkAlarmStatus}" />
                <Setter Property="BorderBrush" Value="{StaticResource DarkAlarmStatus}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
