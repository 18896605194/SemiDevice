<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Style
        x:Key="DefaultButtonStyle"
        BasedOn="{StaticResource MaterialDesignRaisedButton}"
        TargetType="Button">
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Background" Value="{StaticResource DarkAccentPressed}" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkAccentPressed}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{StaticResource Size14}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style
        x:Key="DangerButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DarkAlarmStatus}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkAlarmStatus}" />
    </Style>

    <!--  工具栏按钮（页面顶上那一条工具栏里的查询、今天、暂停、创建……）：跟工具栏里的输入框、下拉同高（34），按钮之间留 8  -->
    <Style
        x:Key="ToolbarButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <Style
        x:Key="ToolbarDangerButtonStyle"
        BasedOn="{StaticResource ToolbarButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DarkAlarmStatus}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkAlarmStatus}" />
    </Style>

    <!--  工具栏里的次要按钮（清除选择、取消……）：描边、透明底，跟工具栏按钮同高  -->
    <Style
        x:Key="ToolbarOutlinedButtonStyle"
        BasedOn="{StaticResource MaterialDesignOutlinedButton}"
        TargetType="Button">
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="{StaticResource Size14}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4" />
    </Style>

    <!--  账单调整页确认框的确认按钮：Tag 是要做的事——Move 强调色"确认移动"，Create 强调色"确认新建"，Delete 红色"确认删除"  -->
    <Style
        x:Key="LedgerConfirmButtonStyle"
        BasedOn="{StaticResource ToolbarButtonStyle}"
        TargetType="Button">
        <Setter Property="Margin" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Move">
                <Setter Property="Content" Value="{DynamicResource setting.ledger.confirm_move}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Delete">
                <Setter Property="Content" Value="{DynamicResource setting.ledger.confirm_delete}" />
                <Setter Property="Background" Value="{StaticResource DarkAlarmStatus}" />
                <Setter Property="BorderBrush" Value="{StaticResource DarkAlarmStatus}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Create">
                <Setter Property="Content" Value="{DynamicResource setting.ledger.confirm_create}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  图角上的小图标按钮（趋势图右上角的放大）：圆形、透明底，浮在图上不挡曲线  -->
    <Style
        x:Key="ChartCornerButtonStyle"
        BasedOn="{StaticResource MaterialDesignIconButton}"
        TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource DarkChartAxisText}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!--  三维图左下角的视角按钮（左转、右转、复位、俯视）：描边、透明底、矮一档，浮在图上不抢眼  -->
    <Style
        x:Key="SceneViewButtonStyle"
        BasedOn="{StaticResource ToolbarOutlinedButtonStyle}"
        TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!--  紧凑按钮：多行按钮区（如 LoadPort 手动操作）用，比默认按钮矮一档  -->
    <Style
        x:Key="CompactButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
    </Style>

    <Style
        x:Key="CompactSuccessButtonStyle"
        BasedOn="{StaticResource CompactButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DarkRunningStatus}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkRunningStatus}" />
    </Style>

    <Style
        x:Key="CompactDangerButtonStyle"
        BasedOn="{StaticResource CompactButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DarkAlarmStatus}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkAlarmStatus}" />
    </Style>

    <!--  行内小按钮（如机械手参数框里使能那一行的 ON / OFF）：描边、矮小，不抢主按钮  -->
    <Style
        x:Key="MiniButtonStyle"
        BasedOn="{StaticResource MaterialDesignOutlinedButton}"
        TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="{StaticResource Size12}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4" />
    </Style>

    <!--  分段选择组（如手动页选手臂）：一排互斥小块，选中填强调色；配 CompactSegmentItemStyle 用  -->
    <Style
        x:Key="CompactSegmentListBoxStyle"
        BasedOn="{StaticResource MaterialDesignListBox}"
        TargetType="ListBox">
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="{StaticResource DarkControlBackground}" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <!--  分段选择块：选中实心强调色，块与块之间一条细线  -->
    <Style x:Key="CompactSegmentItemStyle" TargetType="ListBoxItem">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="Chrome"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{StaticResource DarkBorderBrush}"
                        BorderThickness="0,0,1,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#14FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DarkAccent}" />
                            <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="SuccessButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DarkRunningStatus}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkRunningStatus}" />
    </Style>

    <Style
        x:Key="LargeActionButtonStyle"
        BasedOn="{StaticResource MaterialDesignRaisedButton}"
        TargetType="Button">
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FontSize" Value="{StaticResource Size28}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="PrimaryLargeActionButtonStyle"
        BasedOn="{StaticResource LargeActionButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DarkAccentPressed}" />
    </Style>

    <Style
        x:Key="SuccessLargeActionButtonStyle"
        BasedOn="{StaticResource LargeActionButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DarkRunningStatus}" />
    </Style>

    <!--  顶栏右上角竖排的三个按钮（注销、复位、关蜂鸣器）：一样宽高、控件底色细边，图标和字靠左；竖排正好占满顶栏两行  -->
    <Style
        x:Key="TopBarStackButtonStyle"
        BasedOn="{StaticResource MaterialDesignOutlinedButton}"
        TargetType="Button">
        <Setter Property="Width" Value="120" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="Background" Value="{StaticResource DarkControlBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4" />
    </Style>

    <!--  竖排按钮里的整机复位：平时跟另外两个一样；Tag=True（有报警）时整块变红提醒  -->
    <Style
        x:Key="TopBarStackAccentButtonStyle"
        BasedOn="{StaticResource TopBarStackButtonStyle}"
        TargetType="Button">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{StaticResource DarkAlarmStatus}" />
                <Setter Property="BorderBrush" Value="{StaticResource DarkAlarmStatus}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  块标题条上的按钮（如流程配方页的新建、重命名、删除、添加）：描边、矮一档（30），按钮之间留 6  -->
    <Style
        x:Key="ZoneHeaderButtonStyle"
        BasedOn="{StaticResource ToolbarOutlinedButtonStyle}"
        TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!--  块标题条上的主按钮（如流程配方页流程步骤标题条最右的保存）：实心强调色，跟描边按钮同高  -->
    <Style
        x:Key="ZoneHeaderPrimaryButtonStyle"
        BasedOn="{StaticResource ToolbarButtonStyle}"
        TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
    </Style>

    <!--  确认框的确认按钮：Tag=True（删除、放弃修改这种收不回来的）红色，否则强调色  -->
    <Style
        x:Key="DialogConfirmButtonStyle"
        BasedOn="{StaticResource ToolbarButtonStyle}"
        TargetType="Button">
        <Setter Property="Margin" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{StaticResource DarkAlarmStatus}" />
                <Setter Property="BorderBrush" Value="{StaticResource DarkAlarmStatus}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  勾选块（如流程步骤里一步可去的站点）：圆角胶囊；勾上淡强调底、强调色边、前面一个勾，没勾描边灰字  -->
    <Style x:Key="StationChipToggleStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0,4,8,4" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="{StaticResource Size14}" />
        <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="16">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <materialDesign:PackIcon
                                x:Name="Mark"
                                Width="16"
                                Height="16"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource DarkAccent}"
                                Kind="Check"
                                Visibility="Collapsed" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
                            <Setter Property="Background" Value="{StaticResource DarkHoverBackground}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            <Setter Property="Padding" Value="10,0,14,0" />
                            <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
                            <Setter Property="Background" Value="{StaticResource DarkAccentSoft}" />
                            <Setter Property="BorderBrush" Value="{StaticResource DarkAccent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  选择框（PickerBox）右边的"…"按钮：贴在框里，左边一道竖线隔开；悬停提亮、图标变强调色。不抢焦点，点了直接弹选择弹窗  -->
    <Style x:Key="PickerBoxButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="Background" Value="{StaticResource DarkSurfaceVariantBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="0,3,3,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DarkControlBackground}" />
                <Setter Property="Foreground" Value="{StaticResource DarkAccent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DarkDisabledText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
