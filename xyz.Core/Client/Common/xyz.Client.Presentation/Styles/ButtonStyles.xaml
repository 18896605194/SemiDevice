<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Style
        x:Key="DefaultButtonStyle"
        BasedOn="{StaticResource MaterialDesignRaisedButton}"
        TargetType="Button">
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Background" Value="{StaticResource DarkAccentPressed}" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkAccentPressed}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{StaticResource Size14}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style
        x:Key="DangerButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DarkAlarmStatus}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkAlarmStatus}" />
    </Style>

    <!--  紧凑按钮：多行按钮区（如 LoadPort 手动操作）用，比默认按钮矮一档  -->
    <Style
        x:Key="CompactButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
    </Style>

    <Style
        x:Key="CompactSuccessButtonStyle"
        BasedOn="{StaticResource CompactButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DarkRunningStatus}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkRunningStatus}" />
    </Style>

    <Style
        x:Key="CompactDangerButtonStyle"
        BasedOn="{StaticResource CompactButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DarkAlarmStatus}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkAlarmStatus}" />
    </Style>

    <Style
        x:Key="SuccessButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DarkRunningStatus}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkRunningStatus}" />
    </Style>

    <Style
        x:Key="LargeActionButtonStyle"
        BasedOn="{StaticResource MaterialDesignRaisedButton}"
        TargetType="Button">
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FontSize" Value="{StaticResource Size28}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="PrimaryLargeActionButtonStyle"
        BasedOn="{StaticResource LargeActionButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DarkAccentPressed}" />
    </Style>

    <Style
        x:Key="SuccessLargeActionButtonStyle"
        BasedOn="{StaticResource LargeActionButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DarkRunningStatus}" />
    </Style>

    <!--  顶栏右上角竖排的小按钮（注销、关蜂鸣器）：描边；三个按钮一样宽高，竖排正好占满顶栏两行  -->
    <Style
        x:Key="TopBarStackButtonStyle"
        BasedOn="{StaticResource MaterialDesignOutlinedButton}"
        TargetType="Button">
        <Setter Property="Width" Value="104" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DarkPrimaryText}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4" />
    </Style>

    <!--  竖排按钮里的主操作（整机复位）：实心强调色；Tag=True（有报警）时变红提醒  -->
    <Style
        x:Key="TopBarStackAccentButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Width" Value="104" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="{StaticResource Size13}" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{StaticResource DarkAlarmStatus}" />
                <Setter Property="BorderBrush" Value="{StaticResource DarkAlarmStatus}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
