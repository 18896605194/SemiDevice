<UserControl
    x:Class="xyz.Client.Presentation.Controls.Foup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:xyz.Client.Presentation.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="280"
    d:DesignWidth="240"
    HorizontalContentAlignment="Stretch"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    VerticalContentAlignment="Stretch"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/DarkColors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DrawingBrush
                x:Key="WaferGridBrush"
                TileMode="Tile"
                Viewport="0,0,12,12"
                ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                    <GeometryDrawing Brush="{StaticResource DarkSurfaceVariantBackground}">
                        <GeometryDrawing.Pen>
                            <Pen Brush="{StaticResource DarkDisabledText}" Thickness="1" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="12,0" />
                                <LineGeometry StartPoint="0,0" EndPoint="0,12" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </ResourceDictionary>
    </UserControl.Resources>

    <Viewbox
        HorizontalAlignment="Stretch"
        Stretch="Uniform"
        StretchDirection="Both"
        VerticalAlignment="Stretch">
        <Grid Width="240" Height="280">
            <Border
                Width="188"
                Height="230"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource DarkControlBackground}"
                BorderBrush="{DynamicResource DarkDisabledText}"
                BorderThickness="4"
                CornerRadius="22" />
            <Border
                Width="150"
                Height="178"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource DarkSurfaceBackground}"
                BorderBrush="{DynamicResource DarkPrimaryText}"
                BorderThickness="4"
                CornerRadius="18" />
            <local:Wafer
                Width="116"
                Height="116"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="{DynamicResource DarkDisabledText}"
                BorderThickness="3"
                FillColor="{StaticResource WaferGridBrush}"
                IsDiskVisible="True" />
            <Border
                Width="138"
                Height="38"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{DynamicResource DarkSurfaceVariantBackground}"
                BorderBrush="{DynamicResource DarkDisabledText}"
                BorderThickness="3"
                CornerRadius="5" />
            <Border
                Width="92"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="{DynamicResource DarkSurfaceVariantBackground}"
                BorderBrush="{DynamicResource DarkDisabledText}"
                BorderThickness="3"
                CornerRadius="4" />
            <Border
                Width="18"
                Height="80"
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{DynamicResource DarkSurfaceVariantBackground}"
                BorderBrush="{DynamicResource DarkDisabledText}"
                BorderThickness="3"
                CornerRadius="3" />
            <Border
                Width="18"
                Height="80"
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="{DynamicResource DarkSurfaceVariantBackground}"
                BorderBrush="{DynamicResource DarkDisabledText}"
                BorderThickness="3"
                CornerRadius="3" />
        </Grid>
    </Viewbox>
</UserControl>
