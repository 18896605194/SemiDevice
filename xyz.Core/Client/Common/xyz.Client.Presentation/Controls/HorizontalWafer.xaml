<UserControl
    x:Class="xyz.Client.Presentation.Controls.HorizontalWafer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:xyz.Client.Presentation.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:xyz.Client.Presentation.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="24"
    d:DesignWidth="120"
    Background="{DynamicResource Transparent}"
    BorderBrush="{DynamicResource DarkBorderBrush}"
    BorderThickness="1"
    FontSize="{DynamicResource Size10}"
    Foreground="{DynamicResource DarkPrimaryText}"
    HorizontalContentAlignment="Stretch"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    VerticalContentAlignment="Stretch"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/Color.xaml" />
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/DarkColors.xaml" />
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/FontSize.xaml" />
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/ContextMenuStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        x:Name="rootGrid"
        Background="Transparent"
        ContextMenuOpening="OnContextMenuOpening">
        <Grid.ContextMenu>
            <ContextMenu Style="{StaticResource DefaultContextMenuStyle}">
                <MenuItem
                    x:Name="createMenuItem"
                    Command="{Binding CreateCommand}"
                    CommandParameter="{Binding CommandParameter}"
                    Header="Create"
                    IsEnabled="{Binding CreateEnable}"
                    Style="{StaticResource DefaultMenuItemStyle}" />
                <MenuItem
                    x:Name="deleteMenuItem"
                    Command="{Binding DeleteCommand}"
                    CommandParameter="{Binding CommandParameter}"
                    Header="Delete"
                    IsEnabled="{Binding DeleteEnable}"
                    Style="{StaticResource DefaultMenuItemStyle}" />
            </ContextMenu>
        </Grid.ContextMenu>

        <Border CornerRadius="3">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}}" />
                    <Setter Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}}" />
                    <Setter Property="BorderThickness" Value="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Data, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}, Converter={x:Static converters:ObjectNotNullToBooleanConverter.Instance}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Gray}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Data.State, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}}" Value="IdleNojob">
                            <Setter Property="Background" Value="{DynamicResource WaferIdleNojob}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Data.State, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}}" Value="IdleHasjob">
                            <Setter Property="Background" Value="{DynamicResource WaferIdleJob}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Data.State, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}}" Value="Process">
                            <Setter Property="Background" Value="{DynamicResource WaferInProcess}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Data.State, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}}" Value="Completed">
                            <Setter Property="Background" Value="{DynamicResource WaferProcessComplete}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Data.State, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}}" Value="Error">
                            <Setter Property="Background" Value="{DynamicResource WaferError}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Data.State, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}}" Value="RcmCompleted">
                            <Setter Property="Background" Value="{DynamicResource WaferRcmComplete}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Data.State, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}}" Value="Soaking">
                            <Setter Property="Background" Value="{DynamicResource WaferSoaking}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Data.State, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}}" Value="Transfer">
                            <Setter Property="Background" Value="{DynamicResource WaferTransfer}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Data.State, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}}" Value="Crossed">
                            <Setter Property="Background" Value="{DynamicResource WaferCrossed}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Data.State, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}}" Value="Double">
                            <Setter Property="Background" Value="{DynamicResource WaferDouble}" />
                        </DataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Data, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}, Converter={x:Static converters:ObjectNotNullToBooleanConverter.Instance}}" Value="False" />
                                <Condition Binding="{Binding CreateCommand, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}, Converter={x:Static converters:ObjectNotNullToBooleanConverter.Instance}}" Value="True" />
                                <Condition Binding="{Binding CreateEnable, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="BorderBrush" Value="{DynamicResource DarkAccent}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Data, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}, Converter={x:Static converters:ObjectNotNullToBooleanConverter.Instance}}" Value="True" />
                                <Condition Binding="{Binding DeleteCommand, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}, Converter={x:Static converters:ObjectNotNullToBooleanConverter.Instance}}" Value="True" />
                                <Condition Binding="{Binding DeleteEnable, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="BorderBrush" Value="{DynamicResource DarkAccent}" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Viewbox
                Margin="6,2"
                Stretch="Uniform"
                StretchDirection="Both">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}}"
                    FontWeight="SemiBold"
                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding Label, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Label, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}}" Value="">
                                    <Setter Property="Text" Value="{Binding Data.LpSlot, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Label, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}}" Value="{x:Null}">
                                    <Setter Property="Text" Value="{Binding Data.LpSlot, RelativeSource={RelativeSource AncestorType=local:HorizontalWafer}}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Viewbox>
        </Border>
    </Grid>
</UserControl>
