<UserControl
    x:Class="xyz.Client.Presentation.Controls.DispatchMap"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:xyz.Client.Presentation.Controls">

    <!--  调度图：一台机械手在中间，站点卡片按机械手站点表里的方向（sc.xml Direction）摆在上、下、左、右，
          LoadPort 画花篮卡片、腔体和其他站点画单片卡片；片在哪都一样大（卡片圆片直径 = 机械手叉上的片）。
          一排放不下时这一排整体缩小（只缩不放），不裁掉站点。
          DataContext（DispatchMapViewModel）由代码后置挂在 Root 上，不动控件自身的 DataContext  -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  北  -->
        <Viewbox
            Grid.Row="0"
            Grid.ColumnSpan="3"
            Margin="0,0,0,8"
            HorizontalAlignment="Center"
            Stretch="Uniform"
            StretchDirection="DownOnly">
            <ItemsControl ItemsSource="{Binding Robot.NorthStations}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:StationCard
                            Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=local:DispatchMap}}"
                            Height="{Binding CardHeight, RelativeSource={RelativeSource AncestorType=local:DispatchMap}}"
                            Margin="6,0"
                            DiskSize="{Binding DiskSize, RelativeSource={RelativeSource AncestorType=local:DispatchMap}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Viewbox>

        <!--  西  -->
        <Viewbox
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            Stretch="Uniform"
            StretchDirection="DownOnly">
            <ItemsControl ItemsSource="{Binding Robot.WestStations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:StationCard
                            Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=local:DispatchMap}}"
                            Height="{Binding CardHeight, RelativeSource={RelativeSource AncestorType=local:DispatchMap}}"
                            Margin="0,6"
                            DiskSize="{Binding DiskSize, RelativeSource={RelativeSource AncestorType=local:DispatchMap}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Viewbox>

        <!--  机械手：Robot 控件按 400 设计，画多高由 RobotHeight 定，卡片圆片跟着它算  -->
        <Viewbox
            Grid.Row="1"
            Grid.Column="1"
            Height="{Binding RobotHeight, RelativeSource={RelativeSource AncestorType=local:DispatchMap}}"
            Stretch="Uniform">
            <local:Robot
                ArmCount="{Binding Robot.ArmCount}"
                ArmType="Linear"
                Arms="{Binding Robot.Arms}"
                Rotation="{Binding Robot.Direction}"
                Travel="{Binding Robot.Y}" />
        </Viewbox>

        <!--  东  -->
        <Viewbox
            Grid.Row="1"
            Grid.Column="2"
            Margin="8,0,0,0"
            VerticalAlignment="Center"
            Stretch="Uniform"
            StretchDirection="DownOnly">
            <ItemsControl ItemsSource="{Binding Robot.EastStations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:StationCard
                            Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=local:DispatchMap}}"
                            Height="{Binding CardHeight, RelativeSource={RelativeSource AncestorType=local:DispatchMap}}"
                            Margin="0,6"
                            DiskSize="{Binding DiskSize, RelativeSource={RelativeSource AncestorType=local:DispatchMap}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Viewbox>

        <!--  南  -->
        <Viewbox
            Grid.Row="2"
            Grid.ColumnSpan="3"
            Margin="0,8,0,0"
            HorizontalAlignment="Center"
            Stretch="Uniform"
            StretchDirection="DownOnly">
            <ItemsControl ItemsSource="{Binding Robot.SouthStations}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:StationCard
                            Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=local:DispatchMap}}"
                            Height="{Binding CardHeight, RelativeSource={RelativeSource AncestorType=local:DispatchMap}}"
                            Margin="6,0"
                            DiskSize="{Binding DiskSize, RelativeSource={RelativeSource AncestorType=local:DispatchMap}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Viewbox>
    </Grid>
</UserControl>
