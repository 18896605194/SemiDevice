<UserControl
    x:Class="xyz.Client.Presentation.Controls.StationCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:xyz.Client.Presentation.Controls">

    <!--  调度图上的一个站点（DataContext = RobotStationModel）：LoadPort 画花篮卡片，腔体和其他站点画单片卡片；宽高由调度图给。
          用模板切而不是两张卡片叠着切显隐：只建用得上的那一张  -->
    <ContentControl Content="{Binding}" Focusable="False">
        <ContentControl.Style>
            <Style TargetType="ContentControl">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <local:ChamberInfoCard
                                CreateEnable="False"
                                DeleteEnable="False"
                                DiskSize="{Binding DiskSize, RelativeSource={RelativeSource AncestorType=local:StationCard}}"
                                Number="{Binding NumberText}"
                                Recipe="{Binding Recipe}"
                                StateText="{Binding StateText}"
                                StateTone="{Binding StateTone}"
                                Title="{Binding Title}"
                                Wafer="{Binding Wafer}" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="LoadPort">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <local:LoadPortInfoCard
                                        Alarm="{Binding HasDeviceAlarm}"
                                        AutoMode="{Binding IsAutoMode}"
                                        CreateEnable="False"
                                        DeleteEnable="False"
                                        DiskSize="{Binding DiskSize, RelativeSource={RelativeSource AncestorType=local:StationCard}}"
                                        IsConnected="{Binding IsConnected}"
                                        Number="{Binding NumberText}"
                                        Placed="{Binding IsPlaced}"
                                        Present="{Binding IsPresent}"
                                        SlotCount="{Binding SlotCount}"
                                        StateText="{Binding StateText}"
                                        StateTone="{Binding StateTone}"
                                        Title="{Binding Title}"
                                        Wafers="{Binding Wafers}" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ContentControl.Style>
    </ContentControl>
</UserControl>
