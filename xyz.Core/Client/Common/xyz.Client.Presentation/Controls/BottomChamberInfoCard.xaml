<UserControl
    x:Class="xyz.Client.Presentation.Controls.BottomChamberInfoCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:xyz.Client.Presentation.Controls"
    xmlns:converters="clr-namespace:xyz.Client.Presentation.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:xyz.Client.Presentation.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    d:DesignHeight="560"
    d:DesignWidth="1000"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/Color.xaml" />
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/DarkColors.xaml" />
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/FontSize.xaml" />
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/BorderStyles.xaml" />
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/TextBlockStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Viewbox
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Stretch="Uniform"
        StretchDirection="Both">
        <Border
            Width="1000"
            Height="560"
            Padding="0"
            Background="{DynamicResource DarkSurfaceVariantBackground}"
            BorderBrush="{DynamicResource DarkDisabledText}"
            BorderThickness="2"
            CornerRadius="16">
            <DockPanel LastChildFill="True">

                <Border
                    Height="96"
                    Padding="32,0"
                    BorderThickness="0,2,0,0"
                    CornerRadius="0,0,14,14"
                    DockPanel.Dock="Bottom"
                    Style="{DynamicResource HeaderBarBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Style="{DynamicResource LargeStatusDotBorderStyle}"
                            Tag="{Binding StatusOn, RelativeSource={RelativeSource AncestorType=local:BottomChamberInfoCard}}" />

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{DynamicResource PageTitleTextStyle}"
                            Text="{Binding Title, RelativeSource={RelativeSource AncestorType=local:BottomChamberInfoCard}}" />

                        <Border
                            Grid.Column="2"
                            Margin="32,0,0,0"
                            Padding="18,8"
                            VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource DarkSurfaceBackground}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource DarkRunningStatus}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                    <Setter Property="CornerRadius" Value="6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecipeState, RelativeSource={RelativeSource AncestorType=local:BottomChamberInfoCard}}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RecipeState, RelativeSource={RelativeSource AncestorType=local:BottomChamberInfoCard}}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="{DynamicResource Size18}"
                                FontWeight="Bold"
                                Foreground="{DynamicResource DarkRunningStatus}"
                                Text="{Binding RecipeState, RelativeSource={RelativeSource AncestorType=local:BottomChamberInfoCard}}" />
                        </Border>

                        <TextBlock
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            Style="{DynamicResource ConnectionStatusTextStyle}"
                            Tag="{Binding StatusOn, RelativeSource={RelativeSource AncestorType=local:BottomChamberInfoCard}}"
                            Text="{Binding IsOnline, RelativeSource={RelativeSource AncestorType=local:BottomChamberInfoCard}}" />
                    </Grid>
                </Border>

                <Grid Margin="28,28,28,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56*" />
                        <ColumnDefinition Width="44*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="0"
                        Background="{DynamicResource DarkSurfaceBackground}"
                        BorderBrush="{DynamicResource DarkBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44*" />
                                <ColumnDefinition Width="56*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                Style="{DynamicResource TableRowBorderStyle}" />
                            <Border
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Style="{DynamicResource TableRowBorderStyle}" />
                            <Border
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Style="{DynamicResource TableRowBorderStyle}" />
                            <Border
                                Grid.Row="3"
                                Grid.ColumnSpan="2"
                                Style="{DynamicResource TableRowBorderStyle}" />
                            <Border
                                Grid.Row="4"
                                Grid.ColumnSpan="2"
                                Style="{DynamicResource TableRowBorderStyle}" />
                            <Border
                                Grid.Row="5"
                                Grid.ColumnSpan="2"
                                BorderThickness="0"
                                Style="{DynamicResource TableRowBorderStyle}" />

                            <Border
                                Grid.RowSpan="6"
                                Grid.Column="0"
                                Width="1"
                                HorizontalAlignment="Right"
                                Panel.ZIndex="1"
                                Background="{DynamicResource DarkBorderBrush}" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="24,0"
                                Foreground="{DynamicResource DarkDisabledText}"
                                Style="{DynamicResource FieldLabelTextStyle}"
                                Text="State" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="28,0"
                                Style="{DynamicResource FieldValueTextStyle}"
                                Text="{Binding State, RelativeSource={RelativeSource AncestorType=local:BottomChamberInfoCard}}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="24,0"
                                Foreground="{DynamicResource DarkDisabledText}"
                                Style="{DynamicResource FieldLabelTextStyle}"
                                Text="Recipe" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="28,0"
                                Style="{DynamicResource FieldValueTextStyle}"
                                Text="{Binding Recipe, RelativeSource={RelativeSource AncestorType=local:BottomChamberInfoCard}}" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="24,0"
                                Foreground="{DynamicResource DarkDisabledText}"
                                Style="{DynamicResource FieldLabelTextStyle}"
                                Text="Step" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="28,0"
                                Style="{DynamicResource FieldValueTextStyle}"
                                Text="{Binding Step, RelativeSource={RelativeSource AncestorType=local:BottomChamberInfoCard}}" />

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Margin="24,0"
                                Foreground="{DynamicResource DarkDisabledText}"
                                Style="{DynamicResource FieldLabelTextStyle}"
                                Text="StepTime" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="28,0"
                                Style="{DynamicResource FieldValueTextStyle}"
                                Text="{Binding StepTime, RelativeSource={RelativeSource AncestorType=local:BottomChamberInfoCard}}" />

                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                Margin="24,0"
                                Foreground="{DynamicResource DarkDisabledText}"
                                Style="{DynamicResource FieldLabelTextStyle}"
                                Text="RecipeTime" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                Margin="28,0"
                                Style="{DynamicResource FieldValueTextStyle}"
                                Text="{Binding RecipeTime, RelativeSource={RelativeSource AncestorType=local:BottomChamberInfoCard}}" />

                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="0"
                                Margin="24,0"
                                Foreground="{DynamicResource DarkDisabledText}"
                                Style="{DynamicResource FieldLabelTextStyle}"
                                Text="Shutter" />
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="1"
                                Margin="28,0"
                                Style="{DynamicResource FieldValueTextStyle}"
                                Text="{Binding ShutterState, RelativeSource={RelativeSource AncestorType=local:BottomChamberInfoCard}}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" Margin="30,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <controls:Wafer
                            Grid.Row="0"
                            Margin="34,0,34,10"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            BorderBrush="{DynamicResource DarkDisabledText}"
                            BorderThickness="2"
                            CommandParameter="{Binding Title, RelativeSource={RelativeSource AncestorType=local:BottomChamberInfoCard}}"
                            CreateCommand="{Binding CreateCommand, RelativeSource={RelativeSource AncestorType=local:BottomChamberInfoCard}}"
                            CreateEnable="{Binding CreateEnable, RelativeSource={RelativeSource AncestorType=local:BottomChamberInfoCard}}"
                            Data="{Binding Wafer, RelativeSource={RelativeSource AncestorType=local:BottomChamberInfoCard}}"
                            DeleteCommand="{Binding DeleteCommand, RelativeSource={RelativeSource AncestorType=local:BottomChamberInfoCard}}"
                            DeleteEnable="{Binding DeleteEnable, RelativeSource={RelativeSource AncestorType=local:BottomChamberInfoCard}}"
                            RotationSpeed="{Binding RotationSpeed, RelativeSource={RelativeSource AncestorType=local:BottomChamberInfoCard}}" />


                    </Grid>
                </Grid>
            </DockPanel>
        </Border>
    </Viewbox>
</UserControl>

