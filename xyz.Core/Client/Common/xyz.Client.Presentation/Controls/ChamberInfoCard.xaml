<UserControl
    x:Class="xyz.Client.Presentation.Controls.ChamberInfoCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:xyz.Client.Presentation.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:xyz.Client.Presentation.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    d:DesignHeight="233"
    d:DesignWidth="280"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/Color.xaml" />
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/DarkColors.xaml" />
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/FontSize.xaml" />
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/BorderStyles.xaml" />
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/TextBlockStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  圆片：不要 UserControl 默认模板的方框，只留圆（跟 Robot 控件叉上的片一样）  -->
            <ControlTemplate x:Key="DiskWaferTemplate" TargetType="local:Wafer">
                <ContentPresenter />
            </ControlTemplate>

            <!--  字段：标签灰色常规、右对齐贴着值，值白色加粗，一行一项  -->
            <Style x:Key="CardFieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,2,8,2" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="{DynamicResource Size13}" />
                <Setter Property="Foreground" Value="{DynamicResource DarkDisabledText}" />
            </Style>
            <Style x:Key="CardFieldValueStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="{DynamicResource Size14}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource DarkPrimaryText}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  近方形卡片，按真实字号排版、随给定尺寸伸缩；不整卡套 Viewbox 缩放（卡片给小了字会跟着缩到看不清）  -->
    <Border
        Background="{DynamicResource DarkSurfaceVariantBackground}"
        BorderBrush="{DynamicResource DarkDisabledText}"
        BorderThickness="2"
        CornerRadius="12">
        <DockPanel LastChildFill="True">

            <!--  标题栏：状态点 / 站点号 / 名称 …… 状态徽标（缩小版）/ 在线  -->
            <Border
                Height="40"
                Padding="12,0"
                CornerRadius="10,10,0,0"
                DockPanel.Dock="Top"
                Style="{DynamicResource HeaderBarBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        Style="{DynamicResource StatusDotBorderStyle}"
                        Tag="{Binding StatusOn, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}" />

                    <!--  站点号角标：没给就不显示  -->
                    <Border
                        Grid.Column="1"
                        Margin="0,0,8,0"
                        Padding="6,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource PrimaryAccent}"
                        CornerRadius="7">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Number, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Number, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            FontSize="{DynamicResource Size14}"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding Number, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}" />
                    </Border>

                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource Size18}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource DarkPrimaryText}"
                        Text="{Binding Title, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}"
                        TextTrimming="CharacterEllipsis" />

                    <local:ModuleStateBadge
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        IsCompact="True"
                        Text="{Binding StateText, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}"
                        Tone="{Binding StateTone, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}" />

                    <TextBlock
                        Grid.Column="4"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource Size13}"
                        Style="{DynamicResource ConnectionStatusTextStyle}"
                        Tag="{Binding StatusOn, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}"
                        Text="{Binding IsOnline, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}" />
                </Grid>
            </Border>

            <!--  主体：左五行字段，右圆片（直径 DiskSize，跟机械手叉上的片一样大；下面配方状态）  -->
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <controls:Wafer
                        Width="{Binding DiskSize, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}"
                        Height="{Binding DiskSize, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}"
                        BorderBrush="{DynamicResource DarkDisabledText}"
                        BorderThickness="2"
                        FillColor="{DynamicResource DarkSurfaceBackground}"
                        IsDiskVisible="True"
                        Template="{StaticResource DiskWaferTemplate}"
                        CommandParameter="{Binding Title, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}"
                        CreateCommand="{Binding CreateCommand, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}"
                        CreateEnable="{Binding CreateEnable, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}"
                        Data="{Binding Wafer, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}"
                        DeleteCommand="{Binding DeleteCommand, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}"
                        DeleteEnable="{Binding DeleteEnable, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}"
                        RotationSpeed="{Binding RotationSpeed, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}" />

                    <!--  配方状态：没有就不显示  -->
                    <Border
                        Margin="0,8,0,0"
                        Padding="6,1"
                        HorizontalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource DarkSurfaceBackground}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource DarkRunningStatus}" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecipeState, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RecipeState, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            FontSize="{DynamicResource Size13}"
                            FontWeight="Bold"
                            Foreground="{DynamicResource DarkRunningStatus}"
                            Text="{Binding RecipeState, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}" />
                    </Border>
                </StackPanel>

                <Grid
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--  状态不在这儿：标题行右侧的缩小版状态徽标  -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Style="{StaticResource CardFieldLabelStyle}"
                        Text="{DynamicResource chambercard.recipe}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource CardFieldValueStyle}"
                        Text="{Binding Recipe, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}" />

                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource CardFieldLabelStyle}"
                        Text="{DynamicResource chambercard.step}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource CardFieldValueStyle}"
                        Text="{Binding Step, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}" />

                    <TextBlock
                        Grid.Row="2"
                        Style="{StaticResource CardFieldLabelStyle}"
                        Text="{DynamicResource chambercard.shutter}" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource CardFieldValueStyle}"
                        Text="{Binding ShutterState, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}" />

                    <TextBlock
                        Grid.Row="3"
                        Style="{StaticResource CardFieldLabelStyle}"
                        Text="{DynamicResource chambercard.step_time}" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        Style="{StaticResource CardFieldValueStyle}"
                        Text="{Binding StepTime, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}" />

                    <TextBlock
                        Grid.Row="4"
                        Style="{StaticResource CardFieldLabelStyle}"
                        Text="{DynamicResource chambercard.recipe_time}" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        Style="{StaticResource CardFieldValueStyle}"
                        Text="{Binding RecipeTime, RelativeSource={RelativeSource AncestorType=local:ChamberInfoCard}}" />
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
