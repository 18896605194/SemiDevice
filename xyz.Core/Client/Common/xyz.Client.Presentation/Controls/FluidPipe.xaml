<UserControl x:Class="xyz.Client.Presentation.Controls.FluidPipe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:threeD="clr-namespace:xyz.Client.Presentation.Controls.ThreeD"
             Focusable="False"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <Grid Background="Transparent">
        <Viewport3D x:Name="PipeViewport"
                    IsHitTestVisible="False"
                    SizeChanged="OnViewportSizeChanged">
            <Viewport3D.Camera>
                <OrthographicCamera x:Name="PipeCamera"
                                    Position="0,0,10"
                                    LookDirection="0,0,-1"
                                    UpDirection="0,1,0"
                                    NearPlaneDistance="0.01"
                                    FarPlaneDistance="100" />
            </Viewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="#808080" />
                        <DirectionalLight Color="#EEEEEE" Direction="1,-2,-3" />
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
            <threeD:FluidRouteVisual3D x:Name="PipeModel" />
        </Viewport3D>
    </Grid>
</UserControl>
