<UserControl
    x:Class="xyz.Client.Presentation.Controls.ModuleStateBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:xyz.Client.Presentation.Models"
    x:Name="Root">

    <!--  模块状态徽标：整条按色调上底色（就绪绿 / 动作中蓝 / 中止中黄 / 报错红 / 未初始化灰），状态字居中，一眼看出模块能不能用。
          所有模块的状态显示都用它；色调由各模块显示模型的 StateTone 给，控件不认状态码。
          IsCompact：同一个样式的缩小版（矮一截、字小、宽度随字），放在小卡片标题行里。  -->
    <Border>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="{DynamicResource DarkInactiveStatus}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                        <Setter Property="Height" Value="22" />
                        <Setter Property="CornerRadius" Value="4" />
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="MinWidth" Value="56" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone, ElementName=Root}" Value="{x:Static models:ModuleStateTone.Busy}">
                        <Setter Property="Background" Value="{DynamicResource DarkCommunicationStatus}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone, ElementName=Root}" Value="{x:Static models:ModuleStateTone.Ready}">
                        <Setter Property="Background" Value="{DynamicResource DarkRunningStatus}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone, ElementName=Root}" Value="{x:Static models:ModuleStateTone.Warning}">
                        <Setter Property="Background" Value="{DynamicResource DarkWarningStatus}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone, ElementName=Root}" Value="{x:Static models:ModuleStateTone.Alarm}">
                        <Setter Property="Background" Value="{DynamicResource DarkAlarmStatus}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontWeight="Bold"
            Text="{Binding Text, ElementName=Root}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="FontSize" Value="{DynamicResource Size18}" />
                    <Setter Property="Foreground" Value="{DynamicResource DarkPrimaryText}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                            <Setter Property="FontSize" Value="{DynamicResource Size12}" />
                        </DataTrigger>
                        <!--  黄底配深色字  -->
                        <DataTrigger Binding="{Binding Tone, ElementName=Root}" Value="{x:Static models:ModuleStateTone.Warning}">
                            <Setter Property="Foreground" Value="{DynamicResource DarkSurfaceBackground}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Border>
</UserControl>
