<UserControl
    x:Class="xyz.Client.Presentation.Controls.Buffer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:xyz.Client.Presentation.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    MinWidth="220"
    MinHeight="280"
    Focusable="False"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/BufferStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="{DynamicResource DarkSurfaceVariantBackground}"
            BorderBrush="{DynamicResource DarkDisabledText}" BorderThickness="2" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Height="44" Padding="12,0" CornerRadius="10,10,0,0" Style="{DynamicResource HeaderBarBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="{DynamicResource Size18}"
                               FontWeight="SemiBold" Foreground="{DynamicResource DarkPrimaryText}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <local:ModuleStateBadge Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                            IsCompact="True" Text="{Binding StateText, ElementName=Root}"
                                            Tone="{Binding StateTone, ElementName=Root}" Style="{StaticResource BufferStateBadgeStyle}" />
                    <StackPanel Grid.Column="2" Margin="10,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" Margin="0,0,5,0" CornerRadius="4" Style="{StaticResource BufferModeDotStyle}" />
                        <TextBlock Style="{StaticResource BufferModeTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Background="{DynamicResource DarkControlBackground}">
                <local:BufferView x:Name="Scene" FirstSlot="{Binding FirstSlot, ElementName=Root}"
                                  SlotCount="{Binding SlotCount, ElementName=Root}"
                                  Wafers="{Binding Wafers, ElementName=Root}" />
                <TextBlock Margin="12,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                           Style="{DynamicResource MetaLabelTextStyle}" Text="{DynamicResource buffer.rack}" />
                <TextBlock Margin="0,10,12,0" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"
                           Style="{DynamicResource MetaLabelTextStyle}">
                    <Run Text="{Binding WaferCount, ElementName=Root, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding SlotCount, ElementName=Root}" />
                </TextBlock>
            </Grid>
            <Border Grid.Row="2" Style="{DynamicResource SceneToolStripBorderStyle}" CornerRadius="0,0,10,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="DefaultViewButton" Click="OnDefaultViewClick" Style="{DynamicResource SceneToolButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CubeOutline" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource scene.default_view}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BackViewButton" Click="OnBackViewClick" Style="{DynamicResource SceneToolButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Rotate3dVariant" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource scene.back_view}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
