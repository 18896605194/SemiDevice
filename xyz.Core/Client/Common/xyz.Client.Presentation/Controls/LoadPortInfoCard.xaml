<UserControl
    x:Class="xyz.Client.Presentation.Controls.LoadPortInfoCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:xyz.Client.Presentation.Controls"
    xmlns:converters="clr-namespace:xyz.Client.Presentation.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:xyz.Client.Presentation.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    d:DesignHeight="233"
    d:DesignWidth="280"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/Color.xaml" />
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/DarkColors.xaml" />
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/FontSize.xaml" />
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/BorderStyles.xaml" />
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/TextBlockStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  底栏信号灯：圆点 + 短标签，对齐手动页 LoadPortManualControl 的六灯  -->
            <Style x:Key="LampDotStyle" TargetType="Ellipse">
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="10" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Fill" Value="#555" />
            </Style>

            <!--  圆片：不要 UserControl 默认模板的方框，只留圆（跟 Robot 控件叉上的片一样）  -->
            <ControlTemplate x:Key="DiskWaferTemplate" TargetType="local:Wafer">
                <ContentPresenter />
            </ControlTemplate>

            <!--  花篮一槽一条细线：空槽暗线，有片按片的状态上色（颜色同 HorizontalWafer）  -->
            <Style x:Key="SlotLineStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource DarkBorderBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Wafer, Converter={x:Static converters:ObjectNotNullToBooleanConverter.Instance}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Gray}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Wafer.State}" Value="IdleNojob">
                        <Setter Property="Background" Value="{DynamicResource WaferIdleNojob}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Wafer.State}" Value="IdleHasjob">
                        <Setter Property="Background" Value="{DynamicResource WaferIdleJob}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Wafer.State}" Value="Process">
                        <Setter Property="Background" Value="{DynamicResource WaferInProcess}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Wafer.State}" Value="Completed">
                        <Setter Property="Background" Value="{DynamicResource WaferProcessComplete}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Wafer.State}" Value="Error">
                        <Setter Property="Background" Value="{DynamicResource WaferError}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Wafer.State}" Value="RcmCompleted">
                        <Setter Property="Background" Value="{DynamicResource WaferRcmComplete}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Wafer.State}" Value="Soaking">
                        <Setter Property="Background" Value="{DynamicResource WaferSoaking}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Wafer.State}" Value="Transfer">
                        <Setter Property="Background" Value="{DynamicResource WaferTransfer}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Wafer.State}" Value="Crossed">
                        <Setter Property="Background" Value="{DynamicResource WaferCrossed}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Wafer.State}" Value="Double">
                        <Setter Property="Background" Value="{DynamicResource WaferDouble}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="LampLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="4,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="{DynamicResource Size12}" />
                <Setter Property="Foreground" Value="{DynamicResource DarkSecondaryText}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  近方形卡片，按真实字号排版、随给定尺寸伸缩；不整卡套 Viewbox 缩放（卡片给小了字会跟着缩到看不清）  -->
    <Border
        Background="{DynamicResource DarkSurfaceVariantBackground}"
        BorderBrush="{DynamicResource DarkDisabledText}"
        BorderThickness="2"
        CornerRadius="12">
        <DockPanel LastChildFill="True">

            <!--  底栏（朝外）：第一行 站点号 / 名称 …… 状态徽标（缩小版）/ 在线；下面六灯两行三列  -->
            <Border
                Padding="12,6"
                BorderThickness="0,2,0,0"
                CornerRadius="0,0,10,10"
                DockPanel.Dock="Bottom"
                Style="{DynamicResource HeaderBarBorderStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  站点号角标：没给就不显示  -->
                        <Border
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            Padding="6,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource PrimaryAccent}"
                            CornerRadius="7">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Number, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Number, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="{DynamicResource Size14}"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="{Binding Number, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}" />
                        </Border>

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource Size18}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource DarkPrimaryText}"
                            Text="{Binding Title, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}"
                            TextTrimming="CharacterEllipsis" />

                        <local:ModuleStateBadge
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            IsCompact="True"
                            Text="{Binding StateText, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}"
                            Tone="{Binding StateTone, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}" />

                        <TextBlock
                            Grid.Column="3"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource Size13}"
                            Style="{DynamicResource ConnectionStatusTextStyle}"
                            Text="{Binding IsOnline, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}" />
                    </Grid>

                    <UniformGrid
                        Margin="0,4,0,0"
                        Columns="3"
                        Rows="2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style BasedOn="{StaticResource LampDotStyle}" TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource GreenHealthy}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Style="{StaticResource LampLabelStyle}" Text="{DynamicResource lpmanual.comm}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style BasedOn="{StaticResource LampDotStyle}" TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Present, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource PrimaryAccent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Style="{StaticResource LampLabelStyle}" Text="{DynamicResource lpmanual.present}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style BasedOn="{StaticResource LampDotStyle}" TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Placed, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource GreenHealthy}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Style="{StaticResource LampLabelStyle}" Text="{DynamicResource lpmanual.placed}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style BasedOn="{StaticResource LampDotStyle}" TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Alarm, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource DarkAlarmStatus}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Style="{StaticResource LampLabelStyle}" Text="{DynamicResource lpmanual.alarm}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style BasedOn="{StaticResource LampDotStyle}" TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AutoMode, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource GreenHealthy}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Style="{StaticResource LampLabelStyle}" Text="{DynamicResource lpmanual.auto}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style BasedOn="{StaticResource LampDotStyle}" TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AutoMode, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}" Value="False">
                                                <Setter Property="Fill" Value="{DynamicResource DarkWarningStatus}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Style="{StaticResource LampLabelStyle}" Text="{DynamicResource lpmanual.manual}" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!--  主体：左花篮（槽数跟 sc 的 SlotCount，25 在上、1 在下，一槽一条细线），右圆片（直径 DiskSize，跟机械手叉上的片一样大）+ 槽数  -->
            <Grid Margin="12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="6"
                    Background="{DynamicResource DarkSurfaceBackground}"
                    BorderBrush="{DynamicResource DarkBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <DockPanel>
                        <!--  只标首尾两个槽号：线太细，逐条标写不下  -->
                        <Grid Margin="0,0,6,0" DockPanel.Dock="Left">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SlotCount, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <TextBlock
                                VerticalAlignment="Top"
                                FontSize="{DynamicResource Size12}"
                                Foreground="{DynamicResource DarkDisabledText}"
                                Text="{Binding SlotCount, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                FontSize="{DynamicResource Size12}"
                                Foreground="{DynamicResource DarkDisabledText}"
                                Text="1" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Slots, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,1"
                                        CornerRadius="1"
                                        Style="{StaticResource SlotLineStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">
                    <controls:Wafer
                        Width="{Binding DiskSize, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}"
                        Height="{Binding DiskSize, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}"
                        BorderBrush="{DynamicResource DarkDisabledText}"
                        BorderThickness="2"
                        FillColor="{DynamicResource DarkSurfaceBackground}"
                        IsDiskVisible="True"
                        Template="{StaticResource DiskWaferTemplate}"
                        CommandParameter="{Binding Title, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}"
                        CreateCommand="{Binding CreateCommand, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}"
                        CreateEnable="{Binding CreateEnable, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}"
                        Data="{Binding Wafer, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}"
                        DeleteCommand="{Binding DeleteCommand, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}"
                        DeleteEnable="{Binding DeleteEnable, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}"
                        RotationSpeed="{Binding RotationSpeed, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}" />

                    <StackPanel
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Bottom"
                            FontSize="{DynamicResource Size16}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource DarkPrimaryText}"
                            Text="{Binding SlotCount, RelativeSource={RelativeSource AncestorType=local:LoadPortInfoCard}}" />
                        <TextBlock
                            Margin="4,0,0,1"
                            VerticalAlignment="Bottom"
                            FontSize="{DynamicResource Size12}"
                            Foreground="{DynamicResource DarkDisabledText}"
                            Text="{DynamicResource lpmanual.slots}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
