<UserControl
    x:Class="xyz.Client.Presentation.Controls.ThreeD.ChamberScene"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:xyz.Client.Presentation.Controls.ThreeD"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!--  腔体三维图：灯光、相机、底座写在这儿；Bowl、旋转盘、门、各条摆臂由代码按 Parts（sc 里配了什么）搭到底座上  -->
    <!--  三维对象不在逻辑树里，灯光颜色用 StaticResource 在加载时取 token  -->
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Viewport3D
            x:Name="Viewport"
            ClipToBounds="True"
            LostMouseCapture="OnViewportLostMouseCapture"
            MouseLeftButtonDown="OnViewportMouseLeftButtonDown"
            MouseLeftButtonUp="OnViewportMouseLeftButtonUp"
            MouseMove="OnViewportMouseMove"
            MouseWheel="OnViewportMouseWheel">
            <Viewport3D.Camera>
                <OrthographicCamera x:Name="Camera" UpDirection="0,1,0" />
            </Viewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="{StaticResource DarkHardwareAmbientLightColor}" />
                        <DirectionalLight Direction="-1,-3,-2" Color="{StaticResource DarkHardwareKeyLightColor}" />
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
            <local:ChamberBaseVisual3D
                x:Name="Base"
                Length="5.8"
                Thickness="0.12"
                Width="4.6" />
        </Viewport3D>

        <!--  视角工具栏（图下面一条）：默认视角、俯视；在图上左键拖动旋转，滚轮缩放。
             回到默认的那个不叫"复位"，免得跟整腔操作、轴上的复位（设备清错）重名点错  -->
        <Border Grid.Row="1" Style="{DynamicResource SceneToolbarBorderStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Click="OnDefaultViewClick" Style="{DynamicResource SceneToolButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Kind="CubeOutline" />
                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource chamberscene.default_view}" />
                    </StackPanel>
                </Button>
                <Border Style="{DynamicResource ToolbarSeparatorBorderStyle}" />
                <Button Click="OnTopViewClick" Style="{DynamicResource SceneToolButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Kind="EyeOutline" />
                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource chamberscene.top_view}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
