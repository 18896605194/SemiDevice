<UserControl
    x:Class="xyz.Client.Presentation.Controls.Chamber"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:xyz.Client.Presentation.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="400"
    d:DesignWidth="400"
    HorizontalContentAlignment="Stretch"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    VerticalContentAlignment="Stretch"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/Color.xaml" />
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/DarkColors.xaml" />
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/FontSize.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  圆片：不要 UserControl 默认模板的方框，只留圆  -->
            <ControlTemplate x:Key="DiskWaferTemplate" TargetType="local:Wafer">
                <ContentPresenter />
            </ControlTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  俯视：腔体外壳 → 腔杯（外沿 + 内沿）→ 片位上的圆片；整体等比缩放，占满给定的方形区域  -->
    <Viewbox
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Stretch="Uniform"
        StretchDirection="Both">
        <Grid Width="400" Height="400">
            <Border
                Background="{DynamicResource DarkSurfaceVariantBackground}"
                BorderBrush="{DynamicResource DarkDisabledText}"
                BorderThickness="2"
                CornerRadius="28" />

            <Ellipse
                Width="340"
                Height="340"
                Fill="{DynamicResource DarkSurfaceBackground}"
                Stroke="{DynamicResource DarkBorderBrush}"
                StrokeThickness="6" />
            <Ellipse
                Width="304"
                Height="304"
                Stroke="{DynamicResource DarkBorderBrush}"
                StrokeThickness="1" />

            <!--  片位横排：一般 1 个片位就是正中一整片；空片位画成空盘  -->
            <ItemsControl
                Width="272"
                Height="272"
                ItemsSource="{Binding Slots, RelativeSource={RelativeSource AncestorType=local:Chamber}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:Wafer
                            Margin="4"
                            BorderBrush="{DynamicResource DarkDisabledText}"
                            BorderThickness="2"
                            CreateEnable="False"
                            Data="{Binding Wafer}"
                            DeleteEnable="False"
                            FillColor="{DynamicResource DarkControlBackground}"
                            IsDiskVisible="True"
                            Template="{StaticResource DiskWaferTemplate}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Viewbox>
</UserControl>
