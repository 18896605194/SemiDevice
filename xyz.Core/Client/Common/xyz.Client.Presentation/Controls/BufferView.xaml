<UserControl x:Class="xyz.Client.Presentation.Controls.BufferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
             MinWidth="120" MinHeight="120" Focusable="False">
    <Grid Background="Transparent">
        <Viewport3D x:Name="Viewport" ClipToBounds="True"
                    SizeChanged="OnViewportSizeChanged"
                    PreviewMouseLeftButtonDown="OnViewportMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="OnViewportMouseLeftButtonUp"
                    MouseMove="OnViewportMouseMove" LostMouseCapture="OnViewportLostMouseCapture"
                    PreviewMouseWheel="OnViewportMouseWheel">
            <Viewport3D.Camera>
                <OrthographicCamera x:Name="Camera" UpDirection="0,1,0" NearPlaneDistance="0.01" FarPlaneDistance="100" />
            </Viewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="{StaticResource DarkHardwareAmbientLightColor}" />
                        <DirectionalLight Direction="5,-8,-7" Color="{StaticResource DarkHardwareKeyLightColor}" />
                        <DirectionalLight Direction="-3,-2,-8" Color="{StaticResource DarkHardwareFillLightColor}" />
                        <DirectionalLight Direction="-5,-4,3" Color="{StaticResource DarkHardwareFillLightColor}" />
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>
    </Grid>
</UserControl>
