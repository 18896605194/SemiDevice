<UserControl x:Class="xyz.Client.Presentation.Controls.LogBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!--  日志下拉框：收起时显示最新一条，展开显示队列消费出来的历史。顶栏一行 32 高，框压到 30（去掉样式里的最小高度和上下外边距）  -->
    <ComboBox
        MinWidth="520"
        Height="30"
        MinHeight="30"
        Margin="0"
        MaxDropDownHeight="420"
        VerticalAlignment="Center"
        ItemsSource="{Binding Logs}"
        SelectedItem="{Binding SelectedLog, Mode=OneWay}"
        Style="{DynamicResource DefaultComboBoxStyle}">
        <ComboBox.ItemTemplate>
            <DataTemplate>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource Size12}"
                        Foreground="{DynamicResource DarkSecondaryText}"
                        Text="{Binding TimeText}" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource Size12}"
                        Foreground="{DynamicResource DarkSecondaryText}"
                        Text="{Binding SourceText}" />
                    <!--  等级后面的模块、消息跟等级同色：Warn 一行黄、Error 一行红  -->
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource Size12}"
                        Style="{DynamicResource LogLevelTextStyle}"
                        Text="{Binding Level}" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource Size12}"
                        Style="{DynamicResource LogLevelTextStyle}"
                        Text="{Binding Module}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource Size12}"
                        Style="{DynamicResource LogMessageTextStyle}"
                        Text="{Binding Message}" />
                </StackPanel>
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </ComboBox>
</UserControl>
