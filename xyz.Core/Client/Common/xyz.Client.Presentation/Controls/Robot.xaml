<UserControl
    x:Class="xyz.Client.Presentation.Controls.Robot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:xyz.Client.Presentation.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="400"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/Color.xaml" />
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/DarkColors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  叉上的片：不要 UserControl 默认模板的方框边框，片的轮廓仍由 Wafer 自己按 BorderBrush 画  -->
            <ControlTemplate x:Key="ArmWaferTemplate" TargetType="local:Wafer">
                <ContentPresenter />
            </ControlTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  只有机械手本体：背景透明、不裁剪，手臂伸出与平移可以画到控件范围之外；绘制层由代码插入  -->
    <Grid x:Name="StageHost" />
</UserControl>
