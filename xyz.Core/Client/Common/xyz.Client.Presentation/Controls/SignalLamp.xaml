<UserControl
    x:Class="xyz.Client.Presentation.Controls.SignalLamp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  信号灯：一盏灯 + 名字，对一个 DI 信号；灯色由代码按 IsActive、IsAlarm 写进 Tag  -->
    <StackPanel Orientation="Horizontal">
        <Border x:Name="Lamp" Style="{DynamicResource SignalLampBorderStyle}" />
        <TextBlock x:Name="NameText" Style="{DynamicResource SignalLampTextStyle}" />
    </StackPanel>
</UserControl>
