<UserControl
    x:Class="xyz.Client.Presentation.Controls.Wafer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:xyz.Client.Presentation.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:xyz.Client.Presentation.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="100"
    d:DesignWidth="100"
    HorizontalContentAlignment="Stretch"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    VerticalContentAlignment="Stretch"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/Color.xaml" />
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/DarkColors.xaml" />
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/FontSize.xaml" />
                <ResourceDictionary Source="/xyz.Client.Presentation;component/Styles/ContextMenuStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Data, RelativeSource={RelativeSource Self}}" Value="{x:Null}" />
                        <Condition Binding="{Binding CreateCommand, RelativeSource={RelativeSource Self}}" Value="{x:Null}" />
                        <Condition Binding="{Binding IsDiskVisible, RelativeSource={RelativeSource Self}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Viewbox
        HorizontalAlignment="Stretch"
        Stretch="Uniform"
        StretchDirection="Both"
        VerticalAlignment="Stretch">
        <Grid
            x:Name="rootGrid"
            Width="100"
            Height="100"
            Background="Transparent"
            ContextMenuOpening="OnContextMenuOpening"
            RenderTransformOrigin="0.5,0.5">
            <Grid.ContextMenu>
                <ContextMenu Style="{StaticResource DefaultContextMenuStyle}">
                    <MenuItem
                        x:Name="createMenuItem"
                        Command="{Binding CreateCommand}"
                        CommandParameter="{Binding CommandParameter}"
                        Header="Create"
                        IsEnabled="{Binding CreateEnable}"
                        Style="{StaticResource DefaultMenuItemStyle}" />
                    <MenuItem
                        x:Name="deleteMenuItem"
                        Command="{Binding DeleteCommand}"
                        CommandParameter="{Binding CommandParameter}"
                        Header="Delete"
                        IsEnabled="{Binding DeleteEnable}"
                        Style="{StaticResource DefaultMenuItemStyle}" />
                </ContextMenu>
            </Grid.ContextMenu>
            <Ellipse
                x:Name="diskEllipse"
                Margin="2"
                Stroke="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=local:Wafer}}"
                StrokeThickness="{Binding BorderThickness.Left, RelativeSource={RelativeSource AncestorType=local:Wafer}}">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{Binding FillColor, RelativeSource={RelativeSource AncestorType=local:Wafer}}" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Data, RelativeSource={RelativeSource AncestorType=local:Wafer}}" Value="{x:Null}" />
                                    <Condition Binding="{Binding IsDiskVisible, RelativeSource={RelativeSource AncestorType=local:Wafer}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding Data.State, RelativeSource={RelativeSource AncestorType=local:Wafer}}" Value="IdleNojob">
                                <Setter Property="Fill" Value="{DynamicResource WaferIdleNojob}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Data.State, RelativeSource={RelativeSource AncestorType=local:Wafer}}" Value="IdleHasjob">
                                <Setter Property="Fill" Value="{DynamicResource WaferIdleJob}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Data.State, RelativeSource={RelativeSource AncestorType=local:Wafer}}" Value="Process">
                                <Setter Property="Fill" Value="{DynamicResource WaferInProcess}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Data.State, RelativeSource={RelativeSource AncestorType=local:Wafer}}" Value="Completed">
                                <Setter Property="Fill" Value="{DynamicResource WaferProcessComplete}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Data.State, RelativeSource={RelativeSource AncestorType=local:Wafer}}" Value="Error">
                                <Setter Property="Fill" Value="{DynamicResource WaferError}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Data.State, RelativeSource={RelativeSource AncestorType=local:Wafer}}" Value="RcmCompleted">
                                <Setter Property="Fill" Value="{DynamicResource WaferRcmComplete}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Data.State, RelativeSource={RelativeSource AncestorType=local:Wafer}}" Value="Soaking">
                                <Setter Property="Fill" Value="{DynamicResource WaferSoaking}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Data.State, RelativeSource={RelativeSource AncestorType=local:Wafer}}" Value="Transfer">
                                <Setter Property="Fill" Value="{DynamicResource WaferTransfer}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Data.State, RelativeSource={RelativeSource AncestorType=local:Wafer}}" Value="Crossed">
                                <Setter Property="Fill" Value="{DynamicResource WaferCrossed}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Data.State, RelativeSource={RelativeSource AncestorType=local:Wafer}}" Value="Double">
                                <Setter Property="Fill" Value="{DynamicResource WaferDouble}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Panel.ZIndex="1"
                FontSize="{StaticResource Size10}"
                FontWeight="Bold"
                Foreground="Black"
                Text="{Binding Path=Data.LpSlot, RelativeSource={RelativeSource AncestorType=local:Wafer}}" />

            <Ellipse
                Margin="2"
                Panel.ZIndex="2"
                Fill="Transparent">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Stroke" Value="Transparent" />
                        <Setter Property="StrokeThickness" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CreateCommand, RelativeSource={RelativeSource AncestorType=local:Wafer}}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding Data, RelativeSource={RelativeSource AncestorType=local:Wafer}, Converter={x:Static converters:ObjectNotNullToBooleanConverter.Instance}}" Value="False" />
                                    <Condition Binding="{Binding CreateEnable, RelativeSource={RelativeSource AncestorType=local:Wafer}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Stroke" Value="Black" />
                                <Setter Property="StrokeThickness" Value="1" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding Data, RelativeSource={RelativeSource AncestorType=local:Wafer}, Converter={x:Static converters:ObjectNotNullToBooleanConverter.Instance}}" Value="True" />
                                    <Condition Binding="{Binding DeleteEnable, RelativeSource={RelativeSource AncestorType=local:Wafer}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Stroke" Value="Black" />
                                <Setter Property="StrokeThickness" Value="1" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>

            <Grid.RenderTransform>
                <RotateTransform x:Name="rotateTransform" />
            </Grid.RenderTransform>
        </Grid>
    </Viewbox>
</UserControl>
