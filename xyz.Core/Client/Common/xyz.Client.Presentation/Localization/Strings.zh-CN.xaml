    <sys:String x:Key="alarmview.text">报警内容</sys:String>
    <sys:String x:Key="alarmview.category">分类</sys:String>
    <sys:String x:Key="alarmview.solution">处理建议</sys:String>
    <sys:String x:Key="alarmview.action">动作</sys:String>
    <sys:String x:Key="alarmview.duration">持续</sys:String>
    <sys:String x:Key="alarmview.keyword_hint">关键字（来源 / 代码 / 内容）</sys:String>
    <sys:String x:Key="alarmview.action.raised">报出</sys:String>
    <sys:String x:Key="alarmview.action.cleared">清除</sys:String>

    <!-- 设置页（用户、角色） -->
    <sys:String x:Key="setting.user.name">用户名</sys:String>
    <sys:String x:Key="setting.user.real_name">姓名</sys:String>
    <sys:String x:Key="setting.user.role">角色</sys:String>
    <sys:String x:Key="setting.user.role_select">所属角色</sys:String>
    <sys:String x:Key="setting.user.create">创建用户</sys:String>
    <sys:String x:Key="setting.user.exists">用户名已存在，请更换后重试</sys:String>
    <sys:String x:Key="setting.role.name">角色名称</sys:String>
