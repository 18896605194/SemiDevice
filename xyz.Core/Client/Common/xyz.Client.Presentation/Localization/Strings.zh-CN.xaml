    <sys:String x:Key="robotmanual.field_arm">手臂</sys:String>
    <sys:String x:Key="robotmanual.field_station">站点</sys:String>
    <sys:String x:Key="robotmanual.field_slot">槽位</sys:String>
    <sys:String x:Key="robotmanual.pick_place">取放</sys:String>
