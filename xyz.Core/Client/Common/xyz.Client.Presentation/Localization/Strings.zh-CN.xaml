    <sys:String x:Key="lpmanual.online_mode">在线模式：</sys:String>
    <sys:String x:Key="lpmanual.online">在线</sys:String>
    <sys:String x:Key="lpmanual.offline">下线</sys:String>
    <sys:String x:Key="lpmanual.carrier_id">载具 ID：</sys:String>

    <!-- Robot 手动页 -->
    <sys:String x:Key="robotmanual.comm">通讯</sys:String>
    <sys:String x:Key="robotmanual.comm_tip">驱动连接</sys:String>
    <sys:String x:Key="robotmanual.servo">伺服</sys:String>
    <sys:String x:Key="robotmanual.servo_tip">伺服上使能（PowerOn）</sys:String>
    <sys:String x:Key="robotmanual.arm_tip">手指上有片亮</sys:String>
    <sys:String x:Key="robotmanual.alarm">报警</sys:String>
    <sys:String x:Key="robotmanual.alarm_tip">设备当前报错</sys:String>
    <sys:String x:Key="robotmanual.online_tip">Online：参与自动调度</sys:String>
    <sys:String x:Key="robotmanual.fact_state">状态：</sys:String>
    <sys:String x:Key="robotmanual.fact_station">站点：</sys:String>
    <sys:String x:Key="robotmanual.fact_rotation">方位：</sys:String>
    <sys:String x:Key="robotmanual.fact_travel">平移：</sys:String>
