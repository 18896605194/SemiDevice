    <!-- 菜单名：菜单写在代码里（不进数据库），显示名按菜单编码取 menu.{Code}，没配就显示编码本身。
         框架提供的菜单（含机型模块声明的 LoadPort 手动、Transfer）都配在这里；机型独有的菜单配在机型语言包。 -->
    <sys:String x:Key="menu.Main">主界面</sys:String>
    <sys:String x:Key="menu.Manual">手动</sys:String>
    <sys:String x:Key="menu.Recipe">配方</sys:String>
    <sys:String x:Key="menu.Alarm">报警</sys:String>
    <sys:String x:Key="menu.DataCenter">数据中心</sys:String>
    <sys:String x:Key="menu.Setting">设置</sys:String>
