    <sys:String x:Key="io.invalid_value">“{0}”不是有效的数值</sys:String>
    <sys:String x:Key="io.write_failed">{0} {1} 写入失败（PLC 没连上、点表里没有这个点，或写 PLC 出错）</sys:String>
