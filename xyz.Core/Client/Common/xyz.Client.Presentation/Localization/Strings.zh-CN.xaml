    <sys:String x:Key="lpmanual.present_tip">FOUP 在位（Pod Present）；灰色表示反馈不可用</sys:String>
    <sys:String x:Key="lpmanual.placed">到位</sys:String>
    <sys:String x:Key="lpmanual.placed_tip">FOUP 放置到位（Pod Placed）；灰色表示反馈不可用</sys:String>
    <sys:String x:Key="lpmanual.alarm">报警</sys:String>
    <sys:String x:Key="lpmanual.alarm_tip">设备硬件报警</sys:String>
    <sys:String x:Key="lpmanual.auto_tip">Auto：搬运车经 E84 自动交接</sys:String>
    <sys:String x:Key="lpmanual.manual_tip">Manual：人工放取</sys:String>
