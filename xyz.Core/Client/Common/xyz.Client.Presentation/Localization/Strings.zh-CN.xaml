<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- 平台语言包（简体中文）。key 与 xyz.Shared.Errors.ErrorCodes 一一对应；
         {0}{1} 为错误码 Args 占位。机型新增文案放机型项目自己的语言包，不修改本文件。 -->

    <sys:String x:Key="module.not_found">模块不存在：{0}</sys:String>
    <sys:String x:Key="module.action_rejected">{0} 动作被拒（当前状态 {1} 不允许，或已有动作在途）</sys:String>
    <sys:String x:Key="module.wait_timeout">{0} 等待结果超时（{1}ms），操作结果尚未确认，请查询设备状态</sys:String>
    <sys:String x:Key="module.action_aborted">{0} 被 Abort 顶替</sys:String>
    <sys:String x:Key="module.operation_faulted">{0} 操作异常：{1}</sys:String>

    <!-- 模块状态文字：码值见 xyz.Modules 的 ModuleState/TransferModuleState/LoadPortState -->
    <sys:String x:Key="module.state.not_init">未初始化</sys:String>
    <sys:String x:Key="module.state.initing">初始化中</sys:String>
    <sys:String x:Key="module.state.idle">空闲</sys:String>
    <sys:String x:Key="module.state.aborting">中止中</sys:String>
    <sys:String x:Key="module.state.error">报警</sys:String>
    <sys:String x:Key="module.state.pre_transfer">搬运前</sys:String>
    <sys:String x:Key="module.state.transfer_ready">待搬运</sys:String>
    <sys:String x:Key="module.state.transferring">搬运中</sys:String>
    <sys:String x:Key="module.state.transfer_complete">搬运完成</sys:String>
    <sys:String x:Key="module.state.loading">装载中</sys:String>
    <sys:String x:Key="module.state.loaded">已装载</sys:String>
    <sys:String x:Key="module.state.unloading">卸载中</sys:String>
    <sys:String x:Key="module.state.homing">回零中</sys:String>
    <sys:String x:Key="module.state.clamping">夹紧中</sys:String>
    <sys:String x:Key="module.state.unclamping">松开中</sys:String>
    <sys:String x:Key="module.state.picking">取片中</sys:String>
    <sys:String x:Key="module.state.placing">放片中</sys:String>
    <sys:String x:Key="module.state.unknown">未知状态（{0}）</sys:String>

    <sys:String x:Key="loadport.command_rejected">{0} 指令被设备拒绝（未连接或在途）</sys:String>
    <sys:String x:Key="loadport.timeout">{0} 动作超时（{1}ms）</sys:String>
    <sys:String x:Key="loadport.device_failed">{0} 设备报错：{1}</sys:String>
    <sys:String x:Key="loadport.read_carrier_id_rejected">{0} 读码没发起（没挂读头、读头未连接或上一次还没读完）</sys:String>

    <sys:String x:Key="robot.station_not_found">{0} 未配置站点：{1}</sys:String>
    <sys:String x:Key="robot.direction.north">北</sys:String>
    <sys:String x:Key="robot.direction.east">东</sys:String>
    <sys:String x:Key="robot.direction.south">南</sys:String>
    <sys:String x:Key="robot.direction.west">西</sys:String>

    <sys:String x:Key="alarm.not_installed">报警组件没装（sc.xml 没配 Alarm 节点）</sys:String>
    <sys:String x:Key="alarm.source_not_found">{0} 没报过报警，没有可复位的</sys:String>

    <sys:String x:Key="history.query_failed">查询失败：{0}</sys:String>

    <!-- ==================== 界面文字 ====================
         XAML 用 {DynamicResource key}，ViewModel 用 L10n.Get(key, 参数)。平台界面的放这里，机型的放机型自己的语言包。
         界面语言由后端 sc.xml 的 System 节点 Language 决定（客户端启动时拉一次）。 -->

    <!-- 通用 -->
    <sys:String x:Key="common.ok">确定</sys:String>
    <sys:String x:Key="common.cancel">取消</sys:String>
    <sys:String x:Key="common.create">创建</sys:String>
    <sys:String x:Key="common.delete">删除</sys:String>
    <sys:String x:Key="common.save">保存</sys:String>
    <sys:String x:Key="common.enabled">启用</sys:String>
    <sys:String x:Key="common.sort">排序</sys:String>
    <sys:String x:Key="common.none">无</sys:String>
    <sys:String x:Key="common.all">全部</sys:String>
    <sys:String x:Key="common.input">输入</sys:String>
    <sys:String x:Key="common.input_prompt">请输入内容</sys:String>
    <sys:String x:Key="common.select_prompt">请选择</sys:String>
    <sys:String x:Key="common.query">查询</sys:String>
    <sys:String x:Key="common.today">今天</sys:String>
    <sys:String x:Key="common.last_7_days">最近 7 天</sys:String>
    <sys:String x:Key="common.start_date">开始日期</sys:String>
    <sys:String x:Key="common.end_date">结束日期</sys:String>
    <sys:String x:Key="common.time">时间</sys:String>
    <sys:String x:Key="common.count">{0} 条</sys:String>
    <sys:String x:Key="common.total">共 {0} 条</sys:String>
    <sys:String x:Key="common.query_hint">选好日期后点查询</sys:String>
    <sys:String x:Key="common.query_failed">查询失败</sys:String>
    <sys:String x:Key="common.truncated">只显示最新的 {0} 条，缩短日期段或加条件再查</sys:String>
    <sys:String x:Key="common.days_duration">{0}天 {1}</sys:String>

    <!-- 主窗口、加载窗口 -->
    <sys:String x:Key="shell.loading.starting">正在启动…</sys:String>
    <sys:String x:Key="shell.loading.channel">正在初始化通讯通道…</sys:String>
    <sys:String x:Key="shell.loading.events">正在连接后端事件流…</sys:String>
    <sys:String x:Key="shell.loading.modules">正在加载机型模块…</sys:String>
    <sys:String x:Key="shell.loading.views">正在加载界面…</sys:String>
    <sys:String x:Key="shell.loading.done">加载完成</sys:String>
    <sys:String x:Key="shell.select_menu">请选择主菜单</sys:String>
    <sys:String x:Key="shell.placeholder">「{0}」模块后续实现，内容将显示在中间区域。</sys:String>
    <sys:String x:Key="shell.no_alarm">当前没有报警</sys:String>
    <sys:String x:Key="shell.logout">Logout</sys:String>
    <sys:String x:Key="shell.logout_tip">注销（登录功能接上后可用）</sys:String>
    <sys:String x:Key="shell.reset">Reset</sys:String>
