    <sys:String x:Key="shell.buzzer_off">Off</sys:String>
    <sys:String x:Key="shell.buzzer_off_tip">关闭蜂鸣器</sys:String>

    <!-- 四色灯 -->
    <sys:String x:Key="lamp.alarm">报警</sys:String>
    <sys:String x:Key="lamp.warning">警告</sys:String>
    <sys:String x:Key="lamp.running">运行</sys:String>
    <sys:String x:Key="lamp.communication">通讯</sys:String>

    <!-- 日志页 -->
    <sys:String x:Key="log.level">级别</sys:String>
    <sys:String x:Key="log.module">模块</sys:String>
    <sys:String x:Key="log.message">内容</sys:String>
    <sys:String x:Key="log.keyword_hint">关键字（模块 / 内容）</sys:String>
    <sys:String x:Key="log.pause">暂停</sys:String>
    <sys:String x:Key="log.resume">继续</sys:String>
    <sys:String x:Key="log.clear">清空</sys:String>
    <sys:String x:Key="log.paused_summary">已暂停，新到 {0} 条</sys:String>

