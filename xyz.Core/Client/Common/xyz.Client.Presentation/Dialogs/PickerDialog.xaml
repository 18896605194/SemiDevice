<Window
    x:Class="xyz.Client.Presentation.Dialogs.PickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    AllowsTransparency="True"
    Background="Transparent"
    FontSize="{DynamicResource Size14}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">

    <!--  公共选择弹窗：一个普通的模态窗口，深色卡片浮在主窗口中间。标题、列、数据由用的地方给；
          点一行选中，双击或"确定"带回，Esc 或"取消"关掉。四周留边给卡片的阴影  -->
    <materialDesign:Card Margin="24" Style="{DynamicResource DialogCardStyle}">
        <StackPanel Width="760">
            <TextBlock x:Name="TitleText" Style="{DynamicResource PanelTitleTextStyle}" />

            <Border
                Height="360"
                Margin="0,16,0,0"
                Style="{DynamicResource ListPaneBorderStyle}">
                <Grid>
                    <!--  单元格样式要直接写在 DataGrid 上：只靠表格样式里的 CellStyle，MaterialDesign 会先套上它自己的单元格样式，选中行变成灰的  -->
                    <DataGrid
                        x:Name="ItemsGrid"
                        CellStyle="{DynamicResource DefaultDataGridCellStyle}"
                        MouseDoubleClick="OnRowDoubleClick"
                        SelectionChanged="OnSelectionChanged"
                        Style="{DynamicResource ZoneDataGridStyle}" />
                    <TextBlock
                        x:Name="EmptyText"
                        Style="{DynamicResource CenterHintTextStyle}"
                        Text="{DynamicResource picker.empty}" />
                </Grid>
            </Border>

            <StackPanel
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Click="OnCancelClick"
                    Content="{DynamicResource common.cancel}"
                    IsCancel="True"
                    Style="{DynamicResource ToolbarOutlinedButtonStyle}" />
                <Button
                    x:Name="OkButton"
                    Margin="0"
                    Click="OnOkClick"
                    Content="{DynamicResource common.ok}"
                    IsDefault="True"
                    IsEnabled="False"
                    Style="{DynamicResource ToolbarButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </materialDesign:Card>
</Window>
