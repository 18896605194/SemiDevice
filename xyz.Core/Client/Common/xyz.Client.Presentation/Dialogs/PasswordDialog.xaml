<Window
    x:Class="xyz.Client.Presentation.Dialogs.PasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    AllowsTransparency="True"
    Background="Transparent"
    FontSize="{DynamicResource Size14}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">

    <!--  改密码 / 重置密码：改自己的要旧密码，管理员重置别人的不要；两次输的新密码不一样框里红字说，不发给后端  -->
    <materialDesign:Card Margin="24" Style="{DynamicResource DialogCardStyle}">
        <StackPanel Width="420">
            <TextBlock x:Name="TitleText" Style="{DynamicResource PanelTitleTextStyle}" />
            <TextBlock x:Name="SubtitleText" Style="{DynamicResource DialogMessageTextStyle}" />

            <StackPanel x:Name="OldPasswordPanel">
                <TextBlock
                    Margin="0,16,0,0"
                    Style="{DynamicResource MetaLabelTextStyle}"
                    Text="{DynamicResource account.old_password}" />
                <PasswordBox x:Name="OldPasswordInput" Style="{DynamicResource DefaultPasswordBoxStyle}" />
            </StackPanel>

            <TextBlock
                Margin="0,8,0,0"
                Style="{DynamicResource MetaLabelTextStyle}"
                Text="{DynamicResource account.new_password}" />
            <PasswordBox x:Name="NewPasswordInput" Style="{DynamicResource DefaultPasswordBoxStyle}" />

            <TextBlock
                Margin="0,8,0,0"
                Style="{DynamicResource MetaLabelTextStyle}"
                Text="{DynamicResource account.confirm_password}" />
            <PasswordBox x:Name="ConfirmPasswordInput" Style="{DynamicResource DefaultPasswordBoxStyle}" />

            <TextBlock x:Name="ErrorText" Style="{DynamicResource DialogErrorTextStyle}" />

            <StackPanel
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Click="OnCancelClick"
                    Content="{DynamicResource common.cancel}"
                    IsCancel="True"
                    Style="{DynamicResource ToolbarOutlinedButtonStyle}" />
                <Button
                    x:Name="OkButton"
                    Margin="0"
                    Click="OnOkClick"
                    Content="{DynamicResource common.ok}"
                    IsDefault="True"
                    Style="{DynamicResource ToolbarButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </materialDesign:Card>
</Window>
