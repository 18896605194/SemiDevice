<Window
    x:Class="xyz.Client.Presentation.Dialogs.LoginDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:xyz.Client.Presentation.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    AllowsTransparency="True"
    Background="Transparent"
    FontSize="{DynamicResource Size14}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">

    <!--  登录框：跟公共弹窗一个样子（深色卡片浮在主窗口中间）。登录名、密码不对在框里红字说原因，不清登录名；回车 = 登录，Esc = 取消。
          闲置太久自动退出时也弹它，标题下面黄字写为什么要重新登录  -->
    <materialDesign:Card Margin="24" Style="{DynamicResource DialogCardStyle}">
        <StackPanel Width="420">
            <TextBlock Style="{DynamicResource PanelTitleTextStyle}" Text="{DynamicResource account.login.title}" />
            <TextBlock x:Name="NoticeText" Style="{DynamicResource DialogNoticeTextStyle}" />
            <TextBlock Style="{DynamicResource DialogMessageTextStyle}" Text="{DynamicResource account.login.subtitle}" />

            <TextBlock
                Margin="0,16,0,0"
                Style="{DynamicResource MetaLabelTextStyle}"
                Text="{DynamicResource account.user_name}" />
            <controls:InputTextBox x:Name="UserNameBox" />

            <TextBlock
                Margin="0,8,0,0"
                Style="{DynamicResource MetaLabelTextStyle}"
                Text="{DynamicResource account.password}" />
            <PasswordBox x:Name="PasswordInput" Style="{DynamicResource DefaultPasswordBoxStyle}" />

            <TextBlock x:Name="ErrorText" Style="{DynamicResource DialogErrorTextStyle}" />
            <TextBlock
                x:Name="GuestHint"
                Style="{DynamicResource DialogMessageTextStyle}"
                Text="{DynamicResource account.login.guest_hint}" />

            <StackPanel
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Click="OnCancelClick"
                    Content="{DynamicResource common.cancel}"
                    IsCancel="True"
                    Style="{DynamicResource ToolbarOutlinedButtonStyle}" />
                <Button
                    x:Name="LoginButton"
                    Margin="0"
                    Click="OnLoginClick"
                    Content="{DynamicResource account.login.ok}"
                    IsDefault="True"
                    Style="{DynamicResource ToolbarButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </materialDesign:Card>
</Window>
