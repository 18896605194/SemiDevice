<Window
    x:Class="xyz.Client.Presentation.Dialogs.UserDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:xyz.Client.Presentation.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    AllowsTransparency="True"
    Background="Transparent"
    FontSize="{DynamicResource Size14}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">

    <!--  新建 / 改账号：新建填登录名、显示名、角色、初始密码；改的时候登录名不能改、没有密码（重置密码另有按钮）。后端拒了在框里红字说原因  -->
    <materialDesign:Card Margin="24" Style="{DynamicResource DialogCardStyle}">
        <StackPanel Width="460">
            <TextBlock x:Name="TitleText" Style="{DynamicResource PanelTitleTextStyle}" />

            <TextBlock
                Margin="0,16,0,0"
                Style="{DynamicResource MetaLabelTextStyle}"
                Text="{DynamicResource account.user_name}" />
            <controls:InputTextBox x:Name="UserNameBox" />
            <TextBlock
                x:Name="UserNameText"
                Margin="0,8,0,4"
                Style="{DynamicResource FormValueTextStyle}" />

            <TextBlock
                Margin="0,8,0,0"
                Style="{DynamicResource MetaLabelTextStyle}"
                Text="{DynamicResource account.display_name}" />
            <controls:InputTextBox x:Name="DisplayNameBox" />

            <TextBlock
                Margin="0,8,0,4"
                Style="{DynamicResource MetaLabelTextStyle}"
                Text="{DynamicResource account.role}" />
            <controls:PickerBox
                x:Name="RolePicker"
                PickerTitle="{DynamicResource account.role.select}"
                Placeholder="{DynamicResource account.role.select}"
                ValuePath="DisplayName">
                <controls:PickerBox.Columns>
                    <controls:PickerColumn
                        Width="180"
                        HeaderKey="account.role.name"
                        Path="DisplayName" />
                    <controls:PickerColumn HeaderKey="account.role.description" Path="Description" />
                </controls:PickerBox.Columns>
            </controls:PickerBox>

            <StackPanel x:Name="PasswordPanel">
                <TextBlock
                    Margin="0,12,0,0"
                    Style="{DynamicResource MetaLabelTextStyle}"
                    Text="{DynamicResource account.initial_password}" />
                <PasswordBox x:Name="PasswordInput" Style="{DynamicResource DefaultPasswordBoxStyle}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{DynamicResource MetaLabelTextStyle}"
                    Text="{DynamicResource account.confirm_password}" />
                <PasswordBox x:Name="ConfirmPasswordInput" Style="{DynamicResource DefaultPasswordBoxStyle}" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Style="{DynamicResource DialogErrorTextStyle}" />

            <StackPanel
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Click="OnCancelClick"
                    Content="{DynamicResource common.cancel}"
                    IsCancel="True"
                    Style="{DynamicResource ToolbarOutlinedButtonStyle}" />
                <Button
                    x:Name="OkButton"
                    Margin="0"
                    Click="OnOkClick"
                    Content="{DynamicResource common.ok}"
                    IsDefault="True"
                    Style="{DynamicResource ToolbarButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </materialDesign:Card>
</Window>
