<Window
    x:Class="xyz.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="clr-namespace:xyz.Client.Presentation.Controls;assembly=xyz.Client.Presentation"
    xmlns:local="clr-namespace:xyz.Client"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="xyz Client"
        Width="1280"
        Height="800"
        WindowState="Maximized"
    MinWidth="800"
    MinHeight="520"
    SnapsToDevicePixels="True"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource DarkWindowBackground}"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <!--  标题栏、最小化 / 最大化 / 关闭都用系统自带的（深色见代码后置）；最大化只铺满工作区，不挡任务栏  -->
    <Grid>
                <Viewbox
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Stretch="Fill"
                    StretchDirection="Both">
                    <Grid Width="1980" Height="1080">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  顶栏：通栏，贴满左右，不做成浮起的卡片  -->
        <Border
            Grid.Row="0"
            Height="96"
            Padding="16,0"
            Style="{DynamicResource ShellBarBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Column="0"
                    Grid.Row="0"
                    Margin="0,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                        Kind="MessageTextOutline" />

                    <!--  日志下拉框：后端 LogHelper 日志 + 客户端报错，从队列逐条消费  -->
                    <controls:LogBar
                        Grid.Column="1"
                        VerticalAlignment="Center" />
                </Grid>

                <Grid
                    Grid.Column="0"
                    Grid.Row="1"
                    Margin="0,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource DarkAlarmIcon}"
                        Kind="AlertOutline" />

                    <!--  报警栏：当前报警的条数和最新一条，展开看全部  -->
                    <controls:AlarmBar
                        Grid.Column="1"
                        VerticalAlignment="Center" />
                </Grid>

                <!--  右侧跟左边一样分两行、上下对齐：四色灯跨两行 | 上 = 时间、下 = 当前用户 | 三个按钮竖排（注销 / 复位 / 退出）  -->
                <Grid
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    DataContext="{Binding TopBar}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  四色灯：红 = 报警、黄 = 警告、绿 = 运行（设备总状态），蓝 = 和后端的通讯  -->
                    <controls:SignalTower
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        Height="88"
                        Margin="4,0,16,0"
                        VerticalAlignment="Center"
                        IsBlueOn="{Binding IsConnected}"
                        IsGreenOn="{Binding IsRunningOn}"
                        IsRedOn="{Binding IsAlarmOn}"
                        IsYellowOn="{Binding IsWarningOn}" />

                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,4,12,4"
                        Style="{DynamicResource TopBarInfoBorderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource DarkDisabledText}"
                                Kind="ClockOutline" />
                            <!--  时间在上、日期在下，跟任务栏时钟一样，块窄一些  -->
                            <StackPanel
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Style="{DynamicResource TopBarValueTextStyle}"
                                    Text="{Binding Now, StringFormat='{}{0:HH:mm:ss}'}" />
                                <TextBlock
                                    Style="{DynamicResource TopBarCaptionTextStyle}"
                                    Text="{Binding Now, StringFormat='{}{0:yyyy-MM-dd}'}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,4,12,4"
                        Style="{DynamicResource TopBarInfoBorderStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource DarkDisabledText}"
                                Kind="AccountCircleOutline" />
                            <TextBlock
                                Margin="8,0,0,0"
                                Style="{DynamicResource TopBarValueTextStyle}"
                                Text="Admin" />
                        </StackPanel>
                    </Border>

                    <!--  右上角三个按钮竖排：注销、整机复位、退出  -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="2"
                        VerticalAlignment="Center">
                        <!--  注销：登录功能还没做，先放着不可点，接上登录后再绑命令  -->
                        <Button
                            IsEnabled="False"
                            Style="{DynamicResource TopBarStackButtonStyle}"
                            ToolTip="注销（登录功能接上后可用）"
                            ToolTipService.ShowOnDisabled="True">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Kind="Logout" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Logout" />
                            </StackPanel>
                        </Button>

                        <!--  整机复位：复位全部有报警的来源；有报警时变红  -->
                        <Button
                            Margin="0,2"
                            Command="{Binding ResetCommand}"
                            Style="{DynamicResource TopBarStackAccentButtonStyle}"
                            Tag="{Binding IsAlarmOn}"
                            ToolTip="复位全部有报警的来源">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Kind="Restore" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Reset" />
                            </StackPanel>
                        </Button>

                        <!--  退出软件（先确认）  -->
                        <Button
                            Command="{Binding OffCommand}"
                            Style="{DynamicResource TopBarStackDangerButtonStyle}"
                            ToolTip="退出软件">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Kind="Power" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Off" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!--  中间：内容承载区，所有页面都填充到这里，铺满不留边  -->
        <Grid Grid.Row="1">
            <ContentControl
                x:Name="ContentHost"
                Content="{Binding CurrentView}" />
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource DarkSecondaryText}"
                IsHitTestVisible="False"
                Style="{DynamicResource NullContentHintTextStyle}"
                Tag="{Binding CurrentView}"
                Text="请选择主菜单" />
        </Grid>

        <!--  底部导航：通栏。左边一级菜单，光条后面是当前一级菜单下的二级页面（当前页高亮），没有二级页面就都不显示  -->
        <Border
            x:Name="PrimaryMenuBar"
            Grid.Row="2"
            Padding="12,6"
            Style="{DynamicResource ShellBarBorderStyle}">
            <StackPanel Orientation="Horizontal">
                <ListBox
                    x:Name="PrimaryMenuList"
                    ItemContainerStyle="{DynamicResource BottomNavListBoxItemStyle}"
                    ItemsPanel="{DynamicResource HorizontalListBoxItemsPanelTemplate}"
                    ItemsSource="{Binding PrimaryMenus}"
                    ItemTemplate="{DynamicResource BottomNavItemTemplate}"
                    SelectedItem="{Binding SelectedPrimaryMenu, Mode=TwoWay}"
                    Style="{DynamicResource NavigationListBoxStyle}" />

                <!--  强调色竖光条：把选中的一级菜单和后面的二级页面分开  -->
                <Border
                    Style="{DynamicResource SubNavDividerBorderStyle}"
                    Visibility="{Binding HasSecondaryMenus, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!--  二级页面托盘：分段按钮，当前页实心高亮  -->
                <Border
                    Style="{DynamicResource SubNavTrayBorderStyle}"
                    Visibility="{Binding HasSecondaryMenus, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox
                        x:Name="SecondaryMenuList"
                        ItemContainerStyle="{DynamicResource SubNavListBoxItemStyle}"
                        ItemsPanel="{DynamicResource HorizontalListBoxItemsPanelTemplate}"
                        ItemsSource="{Binding SecondaryMenus}"
                        ItemTemplate="{DynamicResource SubNavItemTemplate}"
                        SelectedItem="{Binding SelectedSecondaryMenu, Mode=TwoWay}"
                        Style="{DynamicResource NavigationListBoxStyle}" />
                </Border>
            </StackPanel>
        </Border>

                    </Grid>
                </Viewbox>
    </Grid>
</Window>
