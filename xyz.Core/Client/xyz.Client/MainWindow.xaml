<Window
    x:Class="xyz.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="clr-namespace:xyz.Client.Presentation.Controls;assembly=xyz.Client.Presentation"
    xmlns:helpers="clr-namespace:xyz.Client.Presentation.Helpers;assembly=xyz.Client.Presentation"
    xmlns:local="clr-namespace:xyz.Client"
    xmlns:permissions="clr-namespace:xyz.Shared.Permissions;assembly=xyz.Shared"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:xyz.Client.Views"
    Title="xyz Client"
        Width="1280"
        Height="800"
        WindowState="Maximized"
    MinWidth="800"
    MinHeight="520"
    SnapsToDevicePixels="True"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource DarkWindowBackground}"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <!--  标题栏、最小化 / 最大化 / 关闭都用系统自带的（深色见代码后置）；最大化只铺满工作区，不挡任务栏  -->
    <Grid>
                <Viewbox
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Stretch="Fill"
                    StretchDirection="Both">
                    <Grid Width="1980" Height="1080">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  顶栏：通栏，贴满左右，不做成浮起的卡片。三行：日志、报警、模块；右边那块只占上两行，模块行通到最右边。
              模块多到一行放不下时模块行折行，顶栏跟着变高  -->
        <Border
            Grid.Row="0"
            MinHeight="96"
            Padding="16,0"
            Style="{DynamicResource ShellBarBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition MinHeight="32" Height="Auto" />
                </Grid.RowDefinitions>

                <materialDesign:PackIcon
                    Grid.Row="0"
                    Grid.Column="0"
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                    Kind="MessageTextOutline" />

                <!--  日志下拉框：后端 LogHelper 日志 + 客户端报错，从队列逐条消费  -->
                <controls:LogBar
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center" />

                <materialDesign:PackIcon
                    Grid.Row="1"
                    Grid.Column="0"
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource DarkAlarmIcon}"
                    Kind="AlertOutline" />

                <!--  报警栏：当前报警的条数和最新一条，展开看全部  -->
                <controls:AlarmBar
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center" />

                <materialDesign:PackIcon
                    Grid.Row="2"
                    Grid.Column="0"
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource DarkDisabledText}"
                    Kind="ViewGridOutline" />

                <!--  模块行：machine.xml 装了的模块一个小框（圆点 = 状态，边框亮 = Auto），切哪一页都在  -->
                <controls:ModuleStatusBar
                    Grid.Row="2"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Center" />

                <!--  右边只占上两行：日期、时间一组，下面隔开是当前用户 | 注销 / 复位 / 关蜂鸣器竖排 | 最右边四色灯，都直接用顶栏的底色  -->
                <Grid
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    DataContext="{Binding TopBar}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Margin="8,0,0,0" Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource DarkDisabledText}"
                                Kind="ClockOutline" />
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{DynamicResource TopBarValueTextStyle}" Text="{Binding Now, StringFormat='{}{0:yyyy-MM-dd}'}" />
                                <TextBlock Style="{DynamicResource TopBarValueTextStyle}" Text="{Binding Now, StringFormat='{}{0:HH:mm:ss}'}" />
                            </StackPanel>
                        </StackPanel>

                        <!--  当前用户：名字（角色在悬停提示里）；点开小菜单：没登录是"登录"，登录着是"换人登录""改密码"。没启用登录点了没反应  -->
                        <Button
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Click="OnUserClick"
                            ContextMenuService.IsEnabled="False"
                            Style="{DynamicResource TopBarUserButtonStyle}"
                            ToolTip="{Binding RoleCaption}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem
                                        Command="{Binding LoginCommand}"
                                        Header="{DynamicResource account.menu.login}"
                                        Visibility="{Binding IsGuest, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <MenuItem
                                        Command="{Binding LoginCommand}"
                                        Header="{DynamicResource account.menu.switch}"
                                        Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <MenuItem
                                        Command="{Binding ChangePasswordCommand}"
                                        Header="{DynamicResource account.menu.change_password}"
                                        Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource DarkDisabledText}"
                                    Kind="AccountCircleOutline" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    Style="{DynamicResource TopBarUserTextStyle}"
                                    Tag="{Binding IsGuest}"
                                    Text="{Binding UserText}" />
                                <!--  小箭头：有小菜单才有（不用登录时点了没东西）  -->
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource DarkDisabledText}"
                                    Kind="ChevronDown"
                                    Visibility="{Binding IsLoginEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!--  三个按钮竖排：注销、整机复位、关闭蜂鸣器，一样宽（随最长的字）  -->
                    <StackPanel
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">
                        <!--  注销：登录着才能点，注销回访客  -->
                        <Button
                            Command="{Binding LogoutCommand}"
                            Style="{DynamicResource TopBarStackButtonStyle}"
                            ToolTip="{DynamicResource shell.logout_tip}"
                            ToolTipService.ShowOnDisabled="True">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center"
                                    Kind="Logout" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource shell.logout}" />
                            </StackPanel>
                        </Button>

                        <!--  整机复位：复位全部有报警的来源；有报警时变红。归功能项"报警复位"，当前角色不允许就灰掉  -->
                        <Button
                            Margin="0,2"
                            helpers:Permission.Function="{x:Static permissions:PermissionCodes.AlarmReset}"
                            Command="{Binding ResetCommand}"
                            Style="{DynamicResource TopBarStackAccentButtonStyle}"
                            Tag="{Binding IsAlarmOn}"
                            ToolTip="{DynamicResource shell.reset_tip}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center"
                                    Kind="Restore" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource shell.reset}" />
                            </StackPanel>
                        </Button>

                        <!--  关闭蜂鸣器的声音  -->
                        <Button
                            Command="{Binding BuzzerOffCommand}"
                            Style="{DynamicResource TopBarStackButtonStyle}"
                            ToolTip="{DynamicResource shell.buzzer_off_tip}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center"
                                    Kind="VolumeOff" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource shell.buzzer_off}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!--  四色灯在最右边：红 = 报警、黄 = 警告、绿 = 运行（设备总状态），蓝 = 和后端的通讯  -->
                    <controls:SignalTower
                        Grid.Column="2"
                        Height="64"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        IsBlueOn="{Binding IsConnected}"
                        IsGreenOn="{Binding IsRunningOn}"
                        IsRedOn="{Binding IsAlarmOn}"
                        IsYellowOn="{Binding IsWarningOn}" />
                </Grid>
            </Grid>
        </Border>

        <!--  中间：内容承载区，铺满不留边。全部页面启动时一次性挂上、一起排好版，切菜单只切可见性（见 PageHost）  -->
        <Grid Grid.Row="1">
            <views:PageHost
                Current="{Binding CurrentView}"
                Pages="{Binding Pages}" />
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource DarkSecondaryText}"
                IsHitTestVisible="False"
                Style="{DynamicResource NullContentHintTextStyle}"
                Tag="{Binding CurrentView}"
                Text="{DynamicResource shell.select_menu}" />
        </Grid>

        <!--  底部导航：通栏。左边一级菜单，光条后面是当前一级菜单下的二级页面（当前页高亮），没有二级页面就都不显示  -->
        <Border
            x:Name="PrimaryMenuBar"
            Grid.Row="2"
            Padding="12,6"
            Style="{DynamicResource ShellBarBorderStyle}">
            <DockPanel>
                <!--  最右边：当前角色对这一页只能看时显示"这一页只看 · 角色"（壳统一加，页面不用改）  -->
                <Border
                    DockPanel.Dock="Right"
                    Style="{DynamicResource ViewOnlyChipBorderStyle}"
                    Tag="{Binding IsCurrentPageViewOnly}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Kind="EyeOutline" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding ViewOnlyText}" />
                    </StackPanel>
                </Border>

            <StackPanel Orientation="Horizontal">
                <ListBox
                    x:Name="PrimaryMenuList"
                    ItemContainerStyle="{DynamicResource BottomNavListBoxItemStyle}"
                    ItemsPanel="{DynamicResource HorizontalListBoxItemsPanelTemplate}"
                    ItemsSource="{Binding PrimaryMenus}"
                    ItemTemplate="{DynamicResource BottomNavItemTemplate}"
                    SelectedItem="{Binding SelectedPrimaryMenu, Mode=TwoWay}"
                    Style="{DynamicResource NavigationListBoxStyle}" />

                <!--  强调色竖光条：把选中的一级菜单和后面的二级页面分开  -->
                <Border
                    Style="{DynamicResource SubNavDividerBorderStyle}"
                    Visibility="{Binding HasSecondaryMenus, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!--  二级页面托盘：分段按钮，当前页实心高亮  -->
                <Border
                    Style="{DynamicResource SubNavTrayBorderStyle}"
                    Visibility="{Binding HasSecondaryMenus, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox
                        x:Name="SecondaryMenuList"
                        ItemContainerStyle="{DynamicResource SubNavListBoxItemStyle}"
                        ItemsPanel="{DynamicResource HorizontalListBoxItemsPanelTemplate}"
                        ItemsSource="{Binding SecondaryMenus}"
                        ItemTemplate="{DynamicResource SubNavItemTemplate}"
                        SelectedItem="{Binding SelectedSecondaryMenu, Mode=TwoWay}"
                        Style="{DynamicResource NavigationListBoxStyle}" />
                </Border>
            </StackPanel>
            </DockPanel>
        </Border>

                    </Grid>
                </Viewbox>
    </Grid>
</Window>
