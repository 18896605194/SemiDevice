<UserControl
    x:Class="xyz.Client.Views.PlaceholderView"
    x:Name="root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="400"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource DarkSurfaceBackground}">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="{DynamicResource Size24}"
                FontWeight="Bold"
                Foreground="{DynamicResource DarkPrimaryText}"
                Text="{Binding Title, ElementName=root}" />
            <TextBlock
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                FontSize="{DynamicResource Size14}"
                Foreground="{DynamicResource DarkSecondaryText}">
                <Run Text="「" />
                <Run Text="{Binding Title, ElementName=root}" />
                <Run Text="」模块后续实现，内容将显示在中间区域。" />
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
