<Window x:Class="xyz.Client.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="xyz Client"
        Width="420"
        Height="220"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">

    <Border
        Padding="28,24"
        Background="{DynamicResource DarkWindowBackground}"
        BorderBrush="#333333"
        BorderThickness="1"
        CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                FontSize="{DynamicResource Size20}"
                FontWeight="Bold"
                Foreground="{DynamicResource DarkPrimaryText}"
                Text="xyz Client" />

            <Grid Grid.Row="1">
                <TextBlock
                    x:Name="StatusText"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource Size12}"
                    Foreground="{DynamicResource DarkSecondaryText}"
                    Text="正在启动…" />
                <TextBlock
                    x:Name="ProgressText"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource Size12}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource DarkPrimaryText}"
                    Text="0%" />
            </Grid>

            <ProgressBar
                x:Name="ProgressBar"
                Grid.Row="2"
                Height="8"
                Maximum="100"
                Minimum="0"
                Value="0" />
        </Grid>
    </Border>
</Window>
