<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\xyz.Shared\xyz.Shared.csproj" />
    <ProjectReference Include="..\Common\xyz.Client.Presentation\xyz.Client.Presentation.csproj" />
    <ProjectReference Include="..\Common\xyz.Client.DataModels\xyz.Client.DataModels.csproj" />
    <ProjectReference Include="..\Common\xyz.Client.Common\xyz.Client.Common.csproj" />
    <ProjectReference Include="..\Common\xyz.Client.Modules\xyz.Client.Modules.csproj" />
    <ProjectReference Include="..\xyz.Client.Setting\xyz.Client.Setting.csproj" />
    <ProjectReference Include="..\xyz.Client.Io\xyz.Client.Io.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="protobuf-net.Grpc" Version="1.3.14" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="Properties\DesignTimeResources.xaml">
      <ContainsDesignTimeResources>true</ContainsDesignTimeResources>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
