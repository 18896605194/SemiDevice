<UserControl
    x:Class="xyz.Client.Setting.Views.UserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="820"
    d:DesignWidth="1640"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource DarkWindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Style="{DynamicResource HeaderBarBorderStyle}">
            <TextBlock
                Style="{DynamicResource PageTitleTextStyle}"
                Text="用户管理" />
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Style="{DynamicResource ToolbarBorderStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button
                        Command="{Binding CreateUserCommand}"
                        Content="创建"
                        Style="{DynamicResource DefaultButtonStyle}" />
                    <Button
                        Command="{Binding DeleteUserCommand}"
                        Content="删除"
                        Style="{DynamicResource DangerButtonStyle}" />
                </StackPanel>
            </Border>

            <materialDesign:Card
                Grid.Row="1"
                Margin="0,16,0,0"
                Style="{DynamicResource DefaultCardStyle}">
                <DataGrid
                    ItemsSource="{Binding Users}"
                    SelectedItem="{Binding SelectedUser}"
                    Style="{DynamicResource DefaultDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding UserName}"
                            ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                            Header="用户名" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding DisplayName}"
                            ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                            Header="姓名" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding RoleName}"
                            ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                            Header="角色" />
                        <DataGridCheckBoxColumn
                            Width="100"
                            Binding="{Binding IsEnabled}"
                            Header="启用" />
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
