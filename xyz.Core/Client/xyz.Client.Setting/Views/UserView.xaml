<UserControl
    x:Class="xyz.Client.Setting.Views.UserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="920"
    d:DesignWidth="1980"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource DarkWindowBackground}">
        <!--  账号表：一个账号一个角色；内置的 admin 不能删、不能停用、不能换角色，密码能改。只有管理员进得来  -->
        <Border Margin="8" Style="{DynamicResource ZoneBorderStyle}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{DynamicResource ZoneHeaderBorderStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Command="{Binding CreateUserCommand}" Style="{DynamicResource ZoneHeaderButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Kind="AccountPlusOutline" />
                                    <TextBlock Text="{DynamicResource setting.user.create}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding EditUserCommand}" Style="{DynamicResource ZoneHeaderButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Kind="PencilOutline" />
                                    <TextBlock Text="{DynamicResource setting.user.edit}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ResetPasswordCommand}" Style="{DynamicResource ZoneHeaderButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Kind="KeyOutline" />
                                    <TextBlock Text="{DynamicResource setting.user.reset_password}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ToggleEnabledCommand}" Style="{DynamicResource ZoneHeaderButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Kind="AccountSwitchOutline" />
                                    <TextBlock Text="{Binding ToggleText}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DeleteUserCommand}" Style="{DynamicResource ZoneHeaderButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Kind="DeleteOutline" />
                                    <TextBlock Text="{DynamicResource common.delete}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{DynamicResource ZoneTitleBarBorderStyle}" />
                            <TextBlock Style="{DynamicResource ZoneTitleTextStyle}" Text="{DynamicResource setting.user.list}" />
                            <TextBlock
                                Margin="12,0,0,0"
                                Style="{DynamicResource PermissionHintTextStyle}"
                                Text="{Binding CountText}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!--  单元格样式要直接写在 DataGrid 上（见流程配方页）  -->
                <DataGrid
                    CellStyle="{DynamicResource DefaultDataGridCellStyle}"
                    ItemsSource="{Binding Users}"
                    SelectedItem="{Binding SelectedUser}"
                    Style="{DynamicResource ZoneDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="220" Header="{DynamicResource setting.user.user_name}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,0" Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding UserName, Mode=OneWay}" />
                                        <Border Style="{DynamicResource TagChipBorderStyle}" Tag="{Binding IsBuiltIn}">
                                            <TextBlock Style="{DynamicResource ChipTextStyle}" Text="{DynamicResource setting.user.builtin}" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding DisplayName, Mode=OneWay}"
                            ElementStyle="{DynamicResource EllipsisDataGridTextStyle}"
                            Header="{DynamicResource setting.user.display_name}" />
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding RoleText, Mode=OneWay}"
                            ElementStyle="{DynamicResource EllipsisDataGridTextStyle}"
                            Header="{DynamicResource setting.user.role_name}" />
                        <DataGridTemplateColumn Width="150" Header="{DynamicResource setting.user.status}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{DynamicResource EnabledDotTextStyle}" Tag="{Binding IsEnabled}" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding StatusText, Mode=OneWay}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="240"
                            Binding="{Binding LastLoginText, Mode=OneWay}"
                            ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                            Header="{DynamicResource setting.user.last_login}" />
                        <DataGridTemplateColumn Width="*" Header="{DynamicResource setting.user.note}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Margin="8,0"
                                        Style="{DynamicResource PermissionHintTextStyle}"
                                        Text="{Binding Note, Mode=OneWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
