<Window
    x:Class="xyz.Client.Setting.Views.MenuEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="菜单"
    Width="420"
    Height="340"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="14" FontWeight="SemiBold" Text="菜单名称" />
        <TextBox x:Name="NameTextBox" Grid.Row="1" Margin="0,6,0,0" Padding="4" />

        <TextBlock Grid.Row="2" Margin="0,10,0,0" FontSize="14" FontWeight="SemiBold" Text="菜单编码" />
        <TextBox x:Name="CodeTextBox" Grid.Row="3" Margin="0,6,0,0" Padding="4" />

        <TextBlock Grid.Row="4" Margin="0,10,0,0" FontSize="14" FontWeight="SemiBold" Text="父级菜单" />
        <ComboBox x:Name="ParentComboBox" Grid.Row="5" Margin="0,6,0,0" Padding="4" />

        <StackPanel Grid.Row="6" Margin="0,16,0,0" Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="排序" />
            <TextBox x:Name="SortTextBox" Width="60" Margin="8,0,0,0" Padding="4" Text="1" />
            <CheckBox x:Name="IsEnabledCheckBox" Margin="20,0,0,0" VerticalAlignment="Center"
                      Content="启用" IsChecked="True" />
        </StackPanel>

        <StackPanel Grid.Row="7" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="OkButton" Width="80" IsDefault="True" Click="OnOkClick" Content="确定" />
            <Button Width="80" Margin="8,0,0,0" IsCancel="True" Click="OnCancelClick" Content="取消" />
        </StackPanel>
    </Grid>
</Window>
