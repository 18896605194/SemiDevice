<UserControl
    x:Class="xyz.Client.DataCenter.Views.AlarmHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="820"
    d:DesignWidth="1640"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource DarkWindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource HeaderBarBorderStyle}">
            <TextBlock Style="{DynamicResource PageTitleTextStyle}" Text="报警历史" />
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  查询条件：日期段（含首尾两天）、等级、关键字；今天 / 最近 7 天直接查  -->
            <Border Grid.Row="0" Style="{DynamicResource ToolbarBorderStyle}">
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Right"
                        Style="{DynamicResource StatusLabelTextStyle}"
                        Text="{Binding Summary}" />
                    <WrapPanel Orientation="Horizontal">
                        <DatePicker
                            Width="170"
                            Margin="0,4,12,4"
                            materialDesign:HintAssist.Hint="开始日期"
                            SelectedDate="{Binding StartDate}"
                            Style="{DynamicResource DefaultDatePickerStyle}" />
                        <DatePicker
                            Width="170"
                            Margin="0,4,12,4"
                            materialDesign:HintAssist.Hint="结束日期"
                            SelectedDate="{Binding EndDate}"
                            Style="{DynamicResource DefaultDatePickerStyle}" />
                        <ComboBox
                            Width="140"
                            Margin="0,4,12,4"
                            materialDesign:HintAssist.Hint="等级"
                            ItemsSource="{Binding Levels}"
                            SelectedItem="{Binding SelectedLevel}"
                            Style="{DynamicResource DefaultComboBoxStyle}" />
                        <TextBox
                            Width="280"
                            Margin="0,4,12,4"
                            materialDesign:HintAssist.Hint="关键字（来源 / 代码 / 内容）"
                            Style="{DynamicResource DefaultTextBoxStyle}"
                            Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Command="{Binding QueryCommand}"
                            Content="查询"
                            Style="{DynamicResource DefaultButtonStyle}" />
                        <Button
                            Command="{Binding TodayCommand}"
                            Content="今天"
                            Style="{DynamicResource DefaultButtonStyle}" />
                        <Button
                            Command="{Binding LastWeekCommand}"
                            Content="最近 7 天"
                            Style="{DynamicResource DefaultButtonStyle}" />
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!--  查询结果：报出、清除各一行，最新的在最上面；清除那行带着报了多久  -->
            <materialDesign:Card
                Grid.Row="1"
                Margin="0,16,0,0"
                Style="{DynamicResource DefaultCardStyle}">
                <DataGrid ItemsSource="{Binding Records}" Style="{DynamicResource CompactDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding OccurredAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                            ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                            Header="时间" />
                        <DataGridTextColumn
                            Width="90"
                            Binding="{Binding ActionText}"
                            ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                            Header="动作" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding Level}"
                            ElementStyle="{DynamicResource AlarmLevelDataGridTextStyle}"
                            Header="等级" />
                        <DataGridTextColumn
                            Width="160"
                            Binding="{Binding Source}"
                            ElementStyle="{DynamicResource EllipsisDataGridTextStyle}"
                            Header="来源" />
                        <DataGridTextColumn
                            Width="220"
                            Binding="{Binding Code}"
                            ElementStyle="{DynamicResource EllipsisDataGridTextStyle}"
                            Header="代码" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Text}"
                            ElementStyle="{DynamicResource EllipsisDataGridTextStyle}"
                            Header="报警内容" />
                        <DataGridTextColumn
                            Width="180"
                            Binding="{Binding Category}"
                            ElementStyle="{DynamicResource EllipsisDataGridTextStyle}"
                            Header="分类" />
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding RaisedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                            ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                            Header="报出时间" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding DurationText}"
                            ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                            Header="持续" />
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
