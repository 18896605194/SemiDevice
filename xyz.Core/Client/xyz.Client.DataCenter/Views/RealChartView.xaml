<UserControl
    x:Class="xyz.Client.DataCenter.Views.RealChartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:xyz.Client.DataCenter.Views"
    d:DesignHeight="820"
    d:DesignWidth="1640"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource DarkWindowBackground}">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  显示最近几分钟；暂停 = 不跟着最新走（数据照收），继续 = 回到最新  -->
            <Border Grid.Row="0" Style="{DynamicResource ToolbarBorderStyle}">
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Right"
                        Style="{DynamicResource StatusLabelTextStyle}"
                        Text="{Binding Status}" />
                    <WrapPanel Orientation="Horizontal">
                        <ComboBox
                            Width="150"
                            Margin="0,0,10,0"
                            materialDesign:HintAssist.Hint="{DynamicResource realchart.window}"
                            ItemsSource="{Binding WindowOptions}"
                            SelectedItem="{Binding SelectedWindow}"
                            Style="{DynamicResource ToolbarComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Mode=OneWay}" />
                                        <Run Text="{DynamicResource realchart.minute_unit}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button
                            Command="{Binding ToggleFollowCommand}"
                            Content="{Binding FollowText}"
                            Style="{DynamicResource ToolbarButtonStyle}" />
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!--  左：信号勾选树；右上：曲线；右下：每条曲线的信息  -->
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" MinWidth="220" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <views:SignalTreePanel Grid.Column="0" />

                <GridSplitter
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Background="Transparent" />

                <views:ChartPanel
                    Grid.Column="2"
                    ValueHeader="{DynamicResource chart.current_value}"
                    WindowTitle="{DynamicResource menu.DataCenter.RealChart}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
