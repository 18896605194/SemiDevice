<UserControl
    x:Class="xyz.Client.DataCenter.Views.AlarmRealtimeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="820"
    d:DesignWidth="1640"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource DarkWindowBackground}">
        <!--  当前报警（只显示，没有操作按钮；条数看顶栏报警栏）：最新的在最上面；等级按颜色区分，处理建议悬停看全文  -->
        <materialDesign:Card
            Margin="16"
            Style="{DynamicResource DefaultCardStyle}">
            <DataGrid ItemsSource="{Binding Alarms}" Style="{DynamicResource CompactDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="200"
                        Binding="{Binding RaisedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                        ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                        Header="报出时间" />
                    <DataGridTextColumn
                        Width="110"
                        Binding="{Binding Level}"
                        ElementStyle="{DynamicResource AlarmLevelDataGridTextStyle}"
                        Header="等级" />
                    <DataGridTextColumn
                        Width="160"
                        Binding="{Binding Source}"
                        ElementStyle="{DynamicResource EllipsisDataGridTextStyle}"
                        Header="来源" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Text}"
                        ElementStyle="{DynamicResource EllipsisDataGridTextStyle}"
                        Header="报警内容" />
                    <DataGridTextColumn
                        Width="180"
                        Binding="{Binding Category}"
                        ElementStyle="{DynamicResource EllipsisDataGridTextStyle}"
                        Header="分类" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Solution}"
                        ElementStyle="{DynamicResource EllipsisDataGridTextStyle}"
                        Header="处理建议" />
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
