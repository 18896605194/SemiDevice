<UserControl
    x:Class="xyz.Client.DataCenter.Views.TrendInfoTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:xyz.Client.Presentation.Controls;assembly=xyz.Client.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DesignHeight="220"
    d:DesignWidth="1200"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    mc:Ignorable="d">

    <!--  曲线信息（数据曲线、实时曲线两页共用，DataContext 是页面的 ViewModel）：勾了几条曲线就几行——
          颜色、名称、偏移（填多少整条线往上挪多少）、单位、光标处（实时曲线没有光标时是最新值）、
          开着 X 基准线时 X1 / X2 那一刻的值、当前显示时间段内的最小 / 最大 / 平均（都是真实值）。
          上面一行是光标时刻和当前显示的时间段  -->
    <materialDesign:Card Padding="0" Style="{DynamicResource DefaultCardStyle}">
        <DockPanel>
            <StackPanel
                Margin="12,8"
                DockPanel.Dock="Top"
                Orientation="Horizontal">
                <TextBlock Style="{DynamicResource ItemDetailTextStyle}">
                    <Run Text="{DynamicResource chart.cursor_at}" />
                    <Run Text="{Binding CursorTime, Mode=OneWay, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}', TargetNullValue='—'}" />
                </TextBlock>
                <TextBlock Margin="24,0,0,0" Style="{DynamicResource ItemDetailTextStyle}">
                    <Run Text="{DynamicResource chart.view}" />
                    <Run Text="{Binding VisibleStart, Mode=OneWay, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}', TargetNullValue='—'}" />
                    <Run Text="~" />
                    <Run Text="{Binding VisibleEnd, Mode=OneWay, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}', TargetNullValue='—'}" />
                </TextBlock>
            </StackPanel>

            <DataGrid
                BorderThickness="0,1,0,0"
                ItemsSource="{Binding Series}"
                Style="{DynamicResource CompactDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="48">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border
                                    Width="14"
                                    Height="14"
                                    HorizontalAlignment="Center"
                                    Background="{Binding Brush}"
                                    CornerRadius="3" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="260"
                        Binding="{Binding Name}"
                        ElementStyle="{DynamicResource EllipsisDataGridTextStyle}"
                        Header="{DynamicResource chart.name}" />
                    <DataGridTemplateColumn Width="110">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="{DynamicResource chart.offset}" ToolTip="{DynamicResource chart.offset_tip}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!--  回车或离开输入框才算数（负数往下挪）；行只有 32 高，错误提示走弹出层  -->
                                <controls:InputTextBox
                                    Width="80"
                                    VerticalAlignment="Center"
                                    materialDesign:ValidationAssist.UsePopup="True"
                                    DataType="Decimal"
                                    Style="{DynamicResource CompactTextBoxStyle}"
                                    Value="{Binding Offset}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Unit}"
                        ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                        Header="{DynamicResource chart.unit}" />
                    <DataGridTextColumn
                        x:Name="ValueColumn"
                        Width="130"
                        Binding="{Binding CursorValue, StringFormat='{}{0:0.###}', TargetNullValue='—'}"
                        ElementStyle="{DynamicResource DefaultDataGridTextStyle}" />
                    <DataGridTextColumn
                        x:Name="AtX1Column"
                        Width="130"
                        Binding="{Binding ValueAtX1, StringFormat='{}{0:0.###}', TargetNullValue='—'}"
                        ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                        Header="{DynamicResource chart.at_x1}"
                        Visibility="Collapsed" />
                    <DataGridTextColumn
                        x:Name="AtX2Column"
                        Width="130"
                        Binding="{Binding ValueAtX2, StringFormat='{}{0:0.###}', TargetNullValue='—'}"
                        ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                        Header="{DynamicResource chart.at_x2}"
                        Visibility="Collapsed" />
                    <DataGridTextColumn
                        Width="130"
                        Binding="{Binding Min, StringFormat='{}{0:0.###}', TargetNullValue='—'}"
                        ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                        Header="{DynamicResource chart.min}" />
                    <DataGridTextColumn
                        Width="130"
                        Binding="{Binding Max, StringFormat='{}{0:0.###}', TargetNullValue='—'}"
                        ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                        Header="{DynamicResource chart.max}" />
                    <DataGridTextColumn
                        Width="130"
                        Binding="{Binding Avg, StringFormat='{}{0:0.###}', TargetNullValue='—'}"
                        ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                        Header="{DynamicResource chart.avg}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </materialDesign:Card>
</UserControl>
