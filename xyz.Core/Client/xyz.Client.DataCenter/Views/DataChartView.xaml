<UserControl
    x:Class="xyz.Client.DataCenter.Views.DataChartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:xyz.Client.Presentation.Controls;assembly=xyz.Client.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:xyz.Client.DataCenter.Views"
    d:DesignHeight="820"
    d:DesignWidth="1640"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource DarkWindowBackground}">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  查询条件：时间段（精确到分钟，截止那一分钟也算）；最近 1 小时 / 今天直接查  -->
            <Border Grid.Row="0" Style="{DynamicResource ToolbarBorderStyle}">
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Right"
                        Style="{DynamicResource StatusLabelTextStyle}"
                        Text="{Binding Summary}" />
                    <WrapPanel Orientation="Horizontal">
                        <controls:DateTimePicker
                            Width="300"
                            Margin="0,0,10,0"
                            Hint="{DynamicResource common.start_time}"
                            Value="{Binding StartTime}" />
                        <controls:DateTimePicker
                            Width="300"
                            Margin="0,0,10,0"
                            Hint="{DynamicResource common.end_time}"
                            Value="{Binding EndTime}" />
                        <Button
                            Command="{Binding QueryCommand}"
                            Content="{DynamicResource common.query}"
                            Style="{DynamicResource ToolbarButtonStyle}" />
                        <Button
                            Command="{Binding LastHourCommand}"
                            Content="{DynamicResource common.last_hour}"
                            Style="{DynamicResource ToolbarButtonStyle}" />
                        <Button
                            Command="{Binding TodayCommand}"
                            Content="{DynamicResource common.today}"
                            Style="{DynamicResource ToolbarButtonStyle}" />
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!--  左：信号勾选树；右上：曲线；右下：每条曲线的信息  -->
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" MinWidth="220" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <views:SignalTreePanel Grid.Column="0" />

                <GridSplitter
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Background="Transparent" />

                <views:ChartPanel
                    Grid.Column="2"
                    ValueHeader="{DynamicResource chart.cursor_value}"
                    WindowTitle="{DynamicResource menu.DataCenter.DataChart}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
