<UserControl
    x:Class="xyz.Client.DataCenter.Views.LogHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:xyz.Client.Presentation.Controls;assembly=xyz.Client.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="820"
    d:DesignWidth="1640"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource DarkWindowBackground}">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  查询条件：时间段（精确到分钟，截止那一分钟也算）、级别、关键字；今天 / 最近 7 天直接查  -->
            <Border Grid.Row="0" Style="{DynamicResource ToolbarBorderStyle}">
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Right"
                        Style="{DynamicResource StatusLabelTextStyle}"
                        Text="{Binding Summary}" />
                    <WrapPanel Orientation="Horizontal">
                        <controls:DateTimePicker
                            Width="300"
                            Margin="0,0,10,0"
                            Hint="{DynamicResource common.start_time}"
                            Value="{Binding StartTime}" />
                        <controls:DateTimePicker
                            Width="300"
                            Margin="0,0,10,0"
                            Hint="{DynamicResource common.end_time}"
                            Value="{Binding EndTime}" />
                        <ComboBox
                            Width="140"
                            Margin="0,0,10,0"
                            materialDesign:HintAssist.Hint="{DynamicResource log.level}"
                            ItemsSource="{Binding Levels}"
                            SelectedItem="{Binding SelectedLevel}"
                            Style="{DynamicResource ToolbarComboBoxStyle}" />
                        <TextBox
                            Width="280"
                            Margin="0,0,10,0"
                            materialDesign:HintAssist.Hint="{DynamicResource log.keyword_hint}"
                            Style="{DynamicResource ToolbarTextBoxStyle}"
                            Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Command="{Binding QueryCommand}"
                            Content="{DynamicResource common.query}"
                            Style="{DynamicResource ToolbarButtonStyle}" />
                        <Button
                            Command="{Binding TodayCommand}"
                            Content="{DynamicResource common.today}"
                            Style="{DynamicResource ToolbarButtonStyle}" />
                        <Button
                            Command="{Binding LastWeekCommand}"
                            Content="{DynamicResource common.last_7_days}"
                            Style="{DynamicResource ToolbarButtonStyle}" />
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!--  查询结果：最新的在最上面  -->
            <materialDesign:Card
                Grid.Row="1"
                Margin="0,8,0,0"
                Style="{DynamicResource DefaultCardStyle}">
                <DataGrid ItemsSource="{Binding Logs}" Style="{DynamicResource CompactDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="240"
                            Binding="{Binding Time, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.fff}'}"
                            ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                            Header="{DynamicResource common.time}" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding Level}"
                            ElementStyle="{DynamicResource LogLevelDataGridTextStyle}"
                            Header="{DynamicResource log.level}" />
                        <DataGridTextColumn
                            Width="180"
                            Binding="{Binding Module}"
                            ElementStyle="{DynamicResource EllipsisDataGridTextStyle}"
                            Header="{DynamicResource log.module}" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Message}"
                            ElementStyle="{DynamicResource EllipsisDataGridTextStyle}"
                            Header="{DynamicResource log.message}" />
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
