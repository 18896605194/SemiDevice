<UserControl
    x:Class="xyz.Client.DataCenter.Views.LogHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="820"
    d:DesignWidth="1640"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource DarkWindowBackground}">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  查询条件：日期段（含首尾两天）、级别、关键字；今天 / 最近 7 天直接查  -->
            <Border Grid.Row="0" Style="{DynamicResource ToolbarBorderStyle}">
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Right"
                        Style="{DynamicResource StatusLabelTextStyle}"
                        Text="{Binding Summary}" />
                    <WrapPanel Orientation="Horizontal">
                        <DatePicker
                            Width="170"
                            Margin="0,4,12,4"
                            materialDesign:HintAssist.Hint="开始日期"
                            SelectedDate="{Binding StartDate}"
                            Style="{DynamicResource DefaultDatePickerStyle}" />
                        <DatePicker
                            Width="170"
                            Margin="0,4,12,4"
                            materialDesign:HintAssist.Hint="结束日期"
                            SelectedDate="{Binding EndDate}"
                            Style="{DynamicResource DefaultDatePickerStyle}" />
                        <ComboBox
                            Width="140"
                            Margin="0,4,12,4"
                            materialDesign:HintAssist.Hint="级别"
                            ItemsSource="{Binding Levels}"
                            SelectedItem="{Binding SelectedLevel}"
                            Style="{DynamicResource DefaultComboBoxStyle}" />
                        <TextBox
                            Width="280"
                            Margin="0,4,12,4"
                            materialDesign:HintAssist.Hint="关键字（模块 / 内容）"
                            Style="{DynamicResource DefaultTextBoxStyle}"
                            Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Command="{Binding QueryCommand}"
                            Content="查询"
                            Style="{DynamicResource DefaultButtonStyle}" />
                        <Button
                            Command="{Binding TodayCommand}"
                            Content="今天"
                            Style="{DynamicResource DefaultButtonStyle}" />
                        <Button
                            Command="{Binding LastWeekCommand}"
                            Content="最近 7 天"
                            Style="{DynamicResource DefaultButtonStyle}" />
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!--  查询结果：最新的在最上面  -->
            <materialDesign:Card
                Grid.Row="1"
                Margin="0,16,0,0"
                Style="{DynamicResource DefaultCardStyle}">
                <DataGrid ItemsSource="{Binding Logs}" Style="{DynamicResource CompactDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="240"
                            Binding="{Binding Time, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.fff}'}"
                            ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                            Header="时间" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding Level}"
                            ElementStyle="{DynamicResource LogLevelDataGridTextStyle}"
                            Header="级别" />
                        <DataGridTextColumn
                            Width="180"
                            Binding="{Binding Module}"
                            ElementStyle="{DynamicResource EllipsisDataGridTextStyle}"
                            Header="模块" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Message}"
                            ElementStyle="{DynamicResource EllipsisDataGridTextStyle}"
                            Header="内容" />
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
