<UserControl
    x:Class="xyz.Client.DataCenter.Views.ChartPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:xyz.Client.Presentation.Controls;assembly=xyz.Client.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:xyz.Client.DataCenter.Views"
    d:DesignHeight="700"
    d:DesignWidth="1300"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    mc:Ignorable="d">

    <!--  曲线 + 曲线信息（数据曲线、实时曲线两页共用，DataContext 是页面的 ViewModel）。
          右上角 X、Y 两个开关出 / 收基准线（X 两条竖线量时间差、Y 两条横线量数值差，开着 X 时信息表多"X1 处 / X2 处"两列）；
          "截图"把折线图那一块存成 PNG（存到 machine.xml 配的文件夹，基准线一起截上），旁边提示几秒存到哪了；
          "放大"把整块搬到单独的窗口里全屏显示，页面这儿留一句提示和"收回"；窗口关掉整块搬回来  -->
    <Grid x:Name="Holder">
        <materialDesign:Card
            x:Name="Placeholder"
            Style="{DynamicResource DefaultCardStyle}"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Style="{DynamicResource CenterHintTextStyle}" Text="{DynamicResource chart.popped_out}" />
                <Button
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Click="OnPopInClick"
                    Content="{DynamicResource chart.popin}"
                    Style="{DynamicResource ToolbarButtonStyle}" />
            </StackPanel>
        </materialDesign:Card>

        <Grid x:Name="Body">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200" />
                <RowDefinition Height="8" />
                <RowDefinition Height="230" MinHeight="120" />
            </Grid.RowDefinitions>

            <materialDesign:Card
                x:Name="ChartCard"
                Grid.Row="0"
                Padding="4"
                Style="{DynamicResource DefaultCardStyle}">
                <Grid>
                    <controls:TrendChart
                        x:Name="Chart"
                        CursorTime="{Binding CursorTime}"
                        FollowRange="{Binding FollowRange}"
                        RangeEnd="{Binding RangeEnd}"
                        RangeStart="{Binding RangeStart}"
                        Series="{Binding Series}"
                        VisibleEnd="{Binding VisibleEnd}"
                        VisibleStart="{Binding VisibleStart}" />
                    <StackPanel
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                        <ToggleButton
                            x:Name="XLinesButton"
                            Style="{DynamicResource ChartCornerToggleButtonStyle}"
                            ToolTip="{DynamicResource chart.ref_x}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="ArrowExpandHorizontal" />
                                <TextBlock
                                    Margin="3,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="X" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            x:Name="YLinesButton"
                            Style="{DynamicResource ChartCornerToggleButtonStyle}"
                            ToolTip="{DynamicResource chart.ref_y}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="ArrowExpandVertical" />
                                <TextBlock
                                    Margin="3,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Y" />
                            </StackPanel>
                        </ToggleButton>
                        <Border Style="{DynamicResource ToolbarSeparatorBorderStyle}" />
                        <Border
                            x:Name="ScreenshotHint"
                            MaxWidth="560"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Style="{DynamicResource ChartHoverCardBorderStyle}"
                            Visibility="Collapsed">
                            <TextBlock x:Name="ScreenshotHintText" TextWrapping="Wrap" />
                        </Border>
                        <Button
                            Click="OnScreenshotClick"
                            Style="{DynamicResource ChartCornerButtonStyle}"
                            ToolTip="{DynamicResource chart.screenshot}">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Kind="CameraOutline" />
                        </Button>
                        <Button
                            x:Name="PopOutButton"
                            Click="OnPopOutClick"
                            Style="{DynamicResource ChartCornerButtonStyle}"
                            ToolTip="{DynamicResource chart.popout}">
                            <materialDesign:PackIcon
                                x:Name="PopOutIcon"
                                Width="20"
                                Height="20"
                                Kind="Fullscreen" />
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <GridSplitter
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent" />

            <views:TrendInfoTable x:Name="InfoTable" Grid.Row="2" />
        </Grid>
    </Grid>
</UserControl>
