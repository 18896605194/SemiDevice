<UserControl
    x:Class="xyz.Client.Io.Views.IoTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    mc:Ignorable="d">

    <!--  一类点（DI/DO/AI/AO）的表。四个区共用这一个控件，点表里加了类型也照样能摆上去。  -->
    <materialDesign:Card Style="{DynamicResource DefaultCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="10,6,10,4">
                <TextBlock
                    DockPanel.Dock="Right"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource DarkSecondaryText}"
                    Text="{Binding Points.Count, ElementName=Root}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource DarkPrimaryText}"
                    Text="{Binding Title, ElementName=Root}" />
            </DockPanel>

            <DataGrid
                Grid.Row="1"
                AutoGenerateColumns="False"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding Points, ElementName=Root}"
                Style="{DynamicResource CompactDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Binding="{Binding Index}"
                        Header="{DynamicResource io.index}"
                        Width="52" />
                    <DataGridTextColumn
                        Binding="{Binding Name}"
                        Header="{DynamicResource io.name}"
                        Width="170" />
                    <DataGridTextColumn
                        Binding="{Binding Description}"
                        Header="{DynamicResource io.description}"
                        Width="*" />
                    <DataGridTemplateColumn Header="{DynamicResource io.value}" Width="104">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!--  读不到和读到 0 要一眼分得开：灯灰着、值显示成破折号  -->
                                    <Ellipse
                                        Width="9"
                                        Height="9"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource DarkDisabledText}" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsValid}" Value="True" />
                                                            <Condition Binding="{Binding IsOn}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Fill" Value="{DynamicResource DarkRunningStatus}" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Value}" />
                                                <Setter Property="Foreground" Value="{DynamicResource DarkPrimaryText}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                        <Setter Property="Text" Value="—" />
                                                        <Setter Property="Foreground" Value="{DynamicResource DarkDisabledText}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource DarkSecondaryText}"
                                        Text="{Binding Unit}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!--  这一类点表里一个都没有时，别留一片空白让人以为是没加载出来  -->
            <TextBlock
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource DarkDisabledText}"
                Text="{DynamicResource io.empty}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Points.Count, ElementName=Root}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </materialDesign:Card>
</UserControl>
