<UserControl
    x:Class="xyz.Client.Io.Views.IoTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:xyz.Client.Io.Views"
    xmlns:presentation="clr-namespace:xyz.Client.Presentation.Controls;assembly=xyz.Client.Presentation"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    mc:Ignorable="d">

    <!--  一类点（DI/DO/AI/AO）的表。四个区共用这一个控件，点表里加了类型也照样能摆上去。  -->
    <materialDesign:Card Style="{DynamicResource DefaultCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="10,6,10,4">
                <TextBlock
                    DockPanel.Dock="Right"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource DarkSecondaryText}"
                    Text="{Binding Points.Count, ElementName=Root}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource DarkPrimaryText}"
                    Text="{Binding Title, ElementName=Root}" />
            </DockPanel>

            <DataGrid
                Grid.Row="1"
                AutoGenerateColumns="False"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding Points, ElementName=Root}"
                Style="{DynamicResource CompactDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Binding="{Binding Index}"
                        ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                        Header="{DynamicResource io.index}"
                        Width="80" />
                    <DataGridTextColumn
                        Binding="{Binding Name}"
                        ElementStyle="{DynamicResource EllipsisDataGridTextStyle}"
                        Header="{DynamicResource io.name}"
                        Width="210" />
                    <DataGridTextColumn
                        Binding="{Binding Description}"
                        ElementStyle="{DynamicResource EllipsisDataGridTextStyle}"
                        Header="{DynamicResource io.description}"
                        Width="*" />
                    <DataGridTemplateColumn Header="{DynamicResource io.value}" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!--  数字量 True / False（True 标绿），模拟量是工程值 + 单位。
                                      读不到和读到 False / 0 要一眼分得开：读不到显示破折号并压暗  -->
                                <StackPanel Margin="8,0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Value}" />
                                                <Setter Property="Foreground" Value="{DynamicResource DarkPrimaryText}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DarkRunningStatus}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                        <Setter Property="Text" Value="—" />
                                                        <Setter Property="Foreground" Value="{DynamicResource DarkDisabledText}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource DarkSecondaryText}"
                                        Text="{Binding Unit}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--  操作列：外面给了写命令才显示（代码后置按命令切可见性）——DO / AO 表有，DI / AI 表没有。
                          PLC 读不到时按钮灰掉：连回读都没有，写下去也确认不了  -->
                    <DataGridTemplateColumn
                        x:Name="ActionColumn"
                        Header="{DynamicResource io.action}"
                        Width="Auto"
                        Visibility="Collapsed">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <!--  DO：开 / 关  -->
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TurnOnCommand, RelativeSource={RelativeSource AncestorType=local:IoTable}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button
                                            Command="{Binding TurnOnCommand, RelativeSource={RelativeSource AncestorType=local:IoTable}}"
                                            CommandParameter="{Binding}"
                                            Content="{DynamicResource io.turn_on}"
                                            IsEnabled="{Binding IsValid}"
                                            Style="{DynamicResource MiniButtonStyle}" />
                                        <Button
                                            Command="{Binding TurnOffCommand, RelativeSource={RelativeSource AncestorType=local:IoTable}}"
                                            CommandParameter="{Binding}"
                                            Content="{DynamicResource io.turn_off}"
                                            IsEnabled="{Binding IsValid}"
                                            Style="{DynamicResource MiniButtonStyle}" />
                                    </StackPanel>

                                    <!--  AO：输入设定值 → 下发  -->
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SendCommand, RelativeSource={RelativeSource AncestorType=local:IoTable}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <!--  设定值用通用输入框：按点表标定范围卡，错着的时候不交出去，下发按钮也灰掉。
                                              行只有 32 高，错误提示走弹出层，放在框下面会被行裁掉  -->
                                        <presentation:InputTextBox
                                            x:Name="SetpointBox"
                                            Width="90"
                                            VerticalAlignment="Center"
                                            materialDesign:HintAssist.Hint="{DynamicResource io.setpoint}"
                                            materialDesign:ValidationAssist.UsePopup="True"
                                            DataType="Decimal"
                                            HasError="{Binding HasInputError, Mode=OneWayToSource}"
                                            Maximum="{Binding Max}"
                                            Minimum="{Binding Min}"
                                            Style="{DynamicResource CompactTextBoxStyle}"
                                            Unit="{Binding Unit}"
                                            Value="{Binding PendingValue}" />
                                        <Button
                                            Command="{Binding SendCommand, RelativeSource={RelativeSource AncestorType=local:IoTable}}"
                                            CommandParameter="{Binding}"
                                            Content="{DynamicResource io.send}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource MiniButtonStyle}" TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasError, ElementName=SetpointBox}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!--  这一类点表里一个都没有时，别留一片空白让人以为是没加载出来  -->
            <TextBlock
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource DarkDisabledText}"
                Text="{DynamicResource io.empty}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Points.Count, ElementName=Root}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </materialDesign:Card>
</UserControl>
