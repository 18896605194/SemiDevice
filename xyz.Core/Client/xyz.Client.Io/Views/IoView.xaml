<UserControl
    x:Class="xyz.Client.Io.Views.IoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:xyz.Client.Io.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="820"
    d:DesignWidth="1640"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    mc:Ignorable="d">

    <!--  界面通用：模块、点、类型全来自后端推的点表，点表改了这儿一行不用动。  -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶栏：搜点、看采集活没活着。看哪个模块由菜单决定（Io 下的二级项），这儿不用再选一遍  -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBox
                Width="260"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                materialDesign:HintAssist.Hint="{DynamicResource io.search}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Ellipse
                    Width="9"
                    Height="9"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource DarkDisabledText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCollecting}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource DarkRunningStatus}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{DynamicResource io.stopped}" />
                            <Setter Property="Foreground" Value="{DynamicResource DarkDisabledText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCollecting}" Value="True">
                                    <Setter Property="Text" Value="{DynamicResource io.collecting}" />
                                    <Setter Property="Foreground" Value="{DynamicResource DarkSecondaryText}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!--  四象限：输入在左、输出在右，数字量在上、模拟量在下  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <local:IoTable
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,6,6"
                Points="{Binding DiView}"
                Title="{DynamicResource io.di}" />
            <local:IoTable
                Grid.Row="0"
                Grid.Column="1"
                Margin="6,0,0,6"
                Points="{Binding DoView}"
                Title="{DynamicResource io.do}" />
            <local:IoTable
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,6,6,0"
                Points="{Binding AiView}"
                Title="{DynamicResource io.ai}" />
            <local:IoTable
                Grid.Row="1"
                Grid.Column="1"
                Margin="6,6,0,0"
                Points="{Binding AoView}"
                Title="{DynamicResource io.ao}" />
        </Grid>
    </Grid>
</UserControl>
