<UserControl
    x:Class="xyz.Client.Io.Views.IoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="820"
    d:DesignWidth="1640"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!--  左：平台 + IO 点位值  -->
        <materialDesign:Card
            Grid.Column="0"
            Style="{DynamicResource DefaultCardStyle}">
            <Grid>
                <Border
                    Margin="30"
                    Background="#1E3A5F"
                    BorderBrush="#3E5C7F"
                    BorderThickness="2"
                    CornerRadius="24">
                    <Grid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="#6699CC"
                            Text="PLATFORM" />

                        <ItemsControl ItemsSource="{Binding Points}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="640" Height="340" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel
                                        Canvas.Left="{Binding X}"
                                        Canvas.Top="{Binding Y}"
                                        Width="100">
                                        <Ellipse
                                            Width="16"
                                            Height="16"
                                            HorizontalAlignment="Left">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#EF5350" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                            <Setter Property="Fill" Value="#66BB6A" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            FontSize="11"
                                            Foreground="#CCCCCC"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="{Binding Value}" />
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="#B0BEC5"
                                            Text="{Binding Unit}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </materialDesign:Card>

        <!--  右：IO 点位列表  -->
        <materialDesign:Card
            Grid.Column="1"
            Margin="12,0,0,0"
            Style="{DynamicResource DefaultCardStyle}">
            <DataGrid
                ItemsSource="{Binding Points}"
                SelectedItem="{Binding SelectedPoint}"
                Style="{DynamicResource DefaultDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Name}"
                        ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                        Header="点位" />
                    <DataGridTextColumn
                        Width="60"
                        Binding="{Binding Value}"
                        ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                        Header="值" />
                    <DataGridTextColumn
                        Width="60"
                        Binding="{Binding Unit}"
                        ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                        Header="单位" />
                    <DataGridTextColumn
                        Width="60"
                        Binding="{Binding IsOutput}"
                        ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                        Header="类型" />
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
