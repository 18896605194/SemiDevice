<UserControl x:Class="xyz.Client.Manual.Views.ChamberManualControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:presentationControls="clr-namespace:xyz.Client.Presentation.Controls;assembly=xyz.Client.Presentation"
             xmlns:threeD="clr-namespace:xyz.Client.Presentation.Controls.ThreeD;assembly=xyz.Client.Presentation">

    <!--  一个腔体一整张卡：左边三维图 + 部件操作，右栏腔体状态 + 工艺 + Home / Abort / Reset，中间一条细线（整体一块，不拆成多张卡）  -->
    <!--  DataContext 由代码后置设在这个根节点上（不设控件自身的 DataContext，避免模板绑定二次求值）  -->
    <materialDesign:Card
        x:Name="Root"
        Margin="8"
        Style="{DynamicResource DefaultCardStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!--  ① 左：腔体三维图（部件按 sc.xml 搭、状态跟推送走，盘上的片来自晶圆账）+ 部件操作  -->
            <Grid Grid.Column="0" Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Background="{DynamicResource DarkControlBackground}"
                    BorderBrush="{DynamicResource DarkBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <threeD:ChamberScene Parts="{Binding Parts}" Wafer="{Binding Model.Wafer}" />
                </Border>

                <!--  部件操作：sc 里配了哪些部件就有哪些组，组名照 sc 路径；一个动作在途时所有部件按钮都不可用  -->
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock
                        FontSize="{DynamicResource Size13}"
                        Foreground="{DynamicResource DarkDisabledText}"
                        Text="{DynamicResource chambermanual.parts}" />
                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Parts.Groups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,10,10" Style="{DynamicResource ReadoutBorderStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            Margin="3,0,0,2"
                                            Style="{DynamicResource MetaLabelTextStyle}"
                                            Text="{Binding Title}" />
                                        <ItemsControl ItemsSource="{Binding Actions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button
                                                        MinWidth="72"
                                                        Command="{Binding DataContext.PartActionCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"
                                                        Content="{Binding Text}"
                                                        Style="{DynamicResource CompactButtonStyle}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <!--  ② 右栏：模块名 + 状态色条 → 参数框（启用 / 模式 / 报错 / 当前配方）→ 工艺（配方 · 选择 · Start）→ Home / Abort / Reset  -->
            <Border
                Grid.Column="1"
                BorderBrush="{DynamicResource DarkBorderBrush}"
                BorderThickness="1,0,0,0">
                <StackPanel>

                    <!--  模块名  -->
                    <TextBlock
                        Margin="14,12,14,0"
                        FontSize="{DynamicResource Size22}"
                        FontWeight="Bold"
                        Foreground="{DynamicResource DarkPrimaryText}"
                        Text="{Binding ModuleName}" />

                    <!--  状态徽标：一眼看出腔体能不能用  -->
                    <presentationControls:ModuleStateBadge
                        Margin="14,8,14,0"
                        Text="{Binding Model.StateText}"
                        Tone="{Binding Model.StateTone}" />

                    <!--  参数框：启用 / 模式 / 报错 一行一盏灯（模式行带 Online / Offline 小按钮，报错行写报错内容），当前配方显示配方名  -->
                    <Border Margin="14,10,14,0" Style="{DynamicResource ReadoutBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  启用：sc.xml 的 IsEnable，停用时动作一律发不出去  -->
                            <TextBlock
                                Grid.Row="0"
                                Margin="0,4"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource Size14}"
                                Foreground="{DynamicResource DarkSecondaryText}"
                                Text="{DynamicResource chambermanual.enable}"
                                ToolTip="{DynamicResource chambermanual.enable_tip}" />
                            <Ellipse
                                Grid.Row="0"
                                Grid.Column="2"
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource DarkInactiveStatus}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Model.IsEnable}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource GreenHealthy}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!--  模式：上线 / 下线的小按钮 + 灯（Online 亮）  -->
                            <TextBlock
                                Grid.Row="1"
                                Margin="0,4"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource Size14}"
                                Foreground="{DynamicResource DarkSecondaryText}"
                                Text="{DynamicResource chambermanual.mode}"
                                ToolTip="{DynamicResource chambermanual.mode_tip}" />
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    Command="{Binding OnlineCommand}"
                                    Content="{DynamicResource action.online}"
                                    Style="{DynamicResource MiniButtonStyle}" />
                                <Button
                                    Command="{Binding OfflineCommand}"
                                    Content="{DynamicResource action.offline}"
                                    Style="{DynamicResource MiniButtonStyle}" />
                            </StackPanel>
                            <Ellipse
                                Grid.Row="1"
                                Grid.Column="2"
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource DarkInactiveStatus}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Model.IsOnline}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource GreenHealthy}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!--  报错：有报错灯亮，报错内容（错误码#内容）写在灯左边  -->
                            <TextBlock
                                Grid.Row="2"
                                Margin="0,4"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource Size14}"
                                Foreground="{DynamicResource DarkSecondaryText}"
                                Text="{DynamicResource chambermanual.device_error}"
                                ToolTip="{DynamicResource chambermanual.device_error_tip}" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="12,0,8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="{DynamicResource Size13}"
                                Foreground="{DynamicResource DarkPrimaryText}"
                                Text="{Binding Model.DeviceError}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding Model.DeviceError}" />
                            <Ellipse
                                Grid.Row="2"
                                Grid.Column="2"
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource DarkInactiveStatus}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Model.HasDeviceError}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource DarkAlarmStatus}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!--  当前配方：最近一次起的工艺  -->
                            <TextBlock
                                Grid.Row="3"
                                Margin="0,4"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource Size14}"
                                Foreground="{DynamicResource DarkSecondaryText}"
                                Text="{DynamicResource chambermanual.current_recipe}" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Margin="12,0,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource Size14}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource DarkPrimaryText}"
                                Text="{Binding Model.RecipeText}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding Model.RecipeText}" />
                        </Grid>
                    </Border>

                    <Border Margin="14,12" Style="{DynamicResource SectionDividerBorderStyle}" />

                    <!--  工艺：配方框 → 选择（配方库做好之前先不可用，配方名手填）→ Start（按配方起工艺，只在空闲时允许，做完才回包；要停按 Abort）  -->
                    <StackPanel Margin="14,0,14,0">
                        <TextBlock
                            FontSize="{DynamicResource Size13}"
                            Foreground="{DynamicResource DarkDisabledText}"
                            Text="{DynamicResource chambermanual.process}" />

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource Size13}"
                                Foreground="{DynamicResource DarkSecondaryText}"
                                Text="{DynamicResource chambermanual.recipe}" />
                            <presentationControls:InputTextBox
                                Grid.Column="1"
                                DataType="Text"
                                Style="{DynamicResource CompactTextBoxStyle}"
                                Value="{Binding Recipe}" />
                            <Button
                                Grid.Column="2"
                                Height="28"
                                MinWidth="56"
                                Margin="6,0,0,0"
                                Content="{DynamicResource action.select}"
                                IsEnabled="False"
                                Style="{DynamicResource CompactButtonStyle}"
                                ToolTip="{DynamicResource chambermanual.select_tip}"
                                ToolTipService.ShowOnDisabled="True" />
                            <Button
                                Grid.Column="3"
                                Height="28"
                                MinWidth="56"
                                Margin="6,0,0,0"
                                Command="{Binding ProcessCommand}"
                                Content="{DynamicResource action.start}"
                                Style="{DynamicResource CompactSuccessButtonStyle}" />
                        </Grid>
                    </StackPanel>

                    <Border Margin="14,12" Style="{DynamicResource SectionDividerBorderStyle}" />

                    <!--  Home / Abort / Reset：Abort 是急停，用红色  -->
                    <UniformGrid Margin="14,0,14,14" Columns="3">
                        <Button
                            Command="{Binding HomeCommand}"
                            Content="{DynamicResource action.home}"
                            Style="{DynamicResource CompactButtonStyle}" />
                        <Button
                            Command="{Binding AbortCommand}"
                            Content="{DynamicResource action.abort}"
                            Style="{DynamicResource CompactDangerButtonStyle}" />
                        <Button
                            Command="{Binding ResetCommand}"
                            Content="{DynamicResource action.reset}"
                            Style="{DynamicResource CompactButtonStyle}" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </materialDesign:Card>
</UserControl>
