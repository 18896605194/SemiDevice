<UserControl x:Class="xyz.Client.Manual.Views.ChamberManualControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:presentationControls="clr-namespace:xyz.Client.Presentation.Controls;assembly=xyz.Client.Presentation">

    <!--  一个腔体一整张卡，布局跟 Robot 手动页一致：左腔体俯视图 + 右栏（腔体状态 + 操作盘），中间一条细线（整体一块，不拆成多张卡）  -->
    <!--  DataContext 由代码后置设在这个根节点上（不设控件自身的 DataContext，避免模板绑定二次求值）  -->
    <materialDesign:Card
        x:Name="Root"
        Margin="8"
        Style="{DynamicResource DefaultCardStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!--  ① 腔体俯视图：片位数按 sc.xml 的 SlotCount，片来自晶圆账（颜色 = 工艺状态，中间写片号）  -->
            <Grid Grid.Column="0" Margin="14">
                <Border
                    Background="{DynamicResource DarkControlBackground}"
                    BorderBrush="{DynamicResource DarkBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <presentationControls:Chamber
                        MaxWidth="560"
                        MaxHeight="560"
                        Margin="24"
                        SlotCount="{Binding Model.SlotCount}"
                        Wafers="{Binding Model.Wafers}" />
                </Border>
            </Grid>

            <!--  ② 右栏：模块名 + 状态色条 → 参数框（启用 / 模式 / 报错 / 当前配方）→ 工艺（配方 · 选择 · Start）→ Home / Abort / Reset  -->
            <Border
                Grid.Column="1"
                BorderBrush="{DynamicResource DarkBorderBrush}"
                BorderThickness="1,0,0,0">
                <StackPanel>

                    <!--  模块名  -->
                    <TextBlock
                        Margin="14,12,14,0"
                        FontSize="{DynamicResource Size22}"
                        FontWeight="Bold"
                        Foreground="{DynamicResource DarkPrimaryText}"
                        Text="{Binding ModuleName}" />

                    <!--  状态色条：按状态整条上底色（空闲绿 / 报警红 / 回零·工艺·搬运中蓝 / 中止中黄 / 未初始化灰），一眼看出腔体能不能用  -->
                    <Border
                        Height="40"
                        Margin="14,8,14,0"
                        CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource DarkInactiveStatus}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Model.State}" Value="20">
                                        <Setter Property="Background" Value="{DynamicResource DarkCommunicationStatus}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Model.State}" Value="30">
                                        <Setter Property="Background" Value="{DynamicResource DarkRunningStatus}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Model.State}" Value="35">
                                        <Setter Property="Background" Value="{DynamicResource DarkWarningStatus}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Model.State}" Value="40">
                                        <Setter Property="Background" Value="{DynamicResource DarkAlarmStatus}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Model.State}" Value="50">
                                        <Setter Property="Background" Value="{DynamicResource DarkCommunicationStatus}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Model.State}" Value="60">
                                        <Setter Property="Background" Value="{DynamicResource DarkCommunicationStatus}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Model.State}" Value="70">
                                        <Setter Property="Background" Value="{DynamicResource DarkCommunicationStatus}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Model.State}" Value="80">
                                        <Setter Property="Background" Value="{DynamicResource DarkCommunicationStatus}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Model.State}" Value="100">
                                        <Setter Property="Background" Value="{DynamicResource DarkCommunicationStatus}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Model.State}" Value="110">
                                        <Setter Property="Background" Value="{DynamicResource DarkCommunicationStatus}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource Size18}"
                            FontWeight="Bold"
                            Text="{Binding Model.StateText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White" />
                                    <Style.Triggers>
                                        <!--  黄底配深色字  -->
                                        <DataTrigger Binding="{Binding Model.State}" Value="35">
                                            <Setter Property="Foreground" Value="{DynamicResource DarkSurfaceBackground}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!--  参数框：启用 / 模式 / 报错 一行一盏灯（模式行带 Online / Offline 小按钮，报错行写报错内容），当前配方显示配方名  -->
                    <Border Margin="14,10,14,0" Style="{DynamicResource ReadoutBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  启用：sc.xml 的 IsEnable，停用时动作一律发不出去  -->
                            <TextBlock
                                Grid.Row="0"
                                Margin="0,4"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource Size14}"
                                Foreground="{DynamicResource DarkSecondaryText}"
                                Text="{DynamicResource chambermanual.enable}"
                                ToolTip="{DynamicResource chambermanual.enable_tip}" />
                            <Ellipse
                                Grid.Row="0"
                                Grid.Column="2"
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#555" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Model.IsEnable}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource GreenHealthy}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!--  模式：上线 / 下线的小按钮 + 灯（Online 亮）  -->
                            <TextBlock
                                Grid.Row="1"
                                Margin="0,4"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource Size14}"
                                Foreground="{DynamicResource DarkSecondaryText}"
                                Text="{DynamicResource chambermanual.mode}"
                                ToolTip="{DynamicResource chambermanual.mode_tip}" />
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    Command="{Binding OnlineCommand}"
                                    Content="{DynamicResource action.online}"
                                    Style="{DynamicResource MiniButtonStyle}" />
                                <Button
                                    Command="{Binding OfflineCommand}"
                                    Content="{DynamicResource action.offline}"
                                    Style="{DynamicResource MiniButtonStyle}" />
                            </StackPanel>
                            <Ellipse
                                Grid.Row="1"
                                Grid.Column="2"
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#555" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Model.IsOnline}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource GreenHealthy}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!--  报错：有报错灯亮，报错内容（错误码#内容）写在灯左边  -->
                            <TextBlock
                                Grid.Row="2"
                                Margin="0,4"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource Size14}"
                                Foreground="{DynamicResource DarkSecondaryText}"
                                Text="{DynamicResource chambermanual.device_error}"
                                ToolTip="{DynamicResource chambermanual.device_error_tip}" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="12,0,8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="{DynamicResource Size13}"
                                Foreground="{DynamicResource DarkPrimaryText}"
                                Text="{Binding Model.DeviceError}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding Model.DeviceError}" />
                            <Ellipse
                                Grid.Row="2"
                                Grid.Column="2"
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#555" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Model.HasDeviceError}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource DarkAlarmStatus}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!--  当前配方：最近一次起的工艺  -->
                            <TextBlock
                                Grid.Row="3"
                                Margin="0,4"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource Size14}"
                                Foreground="{DynamicResource DarkSecondaryText}"
                                Text="{DynamicResource chambermanual.current_recipe}" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Margin="12,0,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource Size14}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource DarkPrimaryText}"
                                Text="{Binding Model.RecipeText}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding Model.RecipeText}" />
                        </Grid>
                    </Border>

                    <Border Margin="14,12" Style="{DynamicResource SectionDividerBorderStyle}" />

                    <!--  工艺：配方框 → 选择（配方库做好之前先不可用，配方名手填）→ Start（按配方起工艺，只在空闲时允许，做完才回包；要停按 Abort）  -->
                    <StackPanel Margin="14,0,14,0">
                        <TextBlock
                            FontSize="{DynamicResource Size13}"
                            Foreground="{DynamicResource DarkDisabledText}"
                            Text="{DynamicResource chambermanual.process}" />

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource Size13}"
                                Foreground="{DynamicResource DarkSecondaryText}"
                                Text="{DynamicResource chambermanual.recipe}" />
                            <TextBox
                                Grid.Column="1"
                                Style="{DynamicResource CompactTextBoxStyle}"
                                Text="{Binding Recipe, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="2"
                                Height="28"
                                MinWidth="56"
                                Margin="6,0,0,0"
                                Content="{DynamicResource action.select}"
                                IsEnabled="False"
                                Style="{DynamicResource CompactButtonStyle}"
                                ToolTip="{DynamicResource chambermanual.select_tip}"
                                ToolTipService.ShowOnDisabled="True" />
                            <Button
                                Grid.Column="3"
                                Height="28"
                                MinWidth="56"
                                Margin="6,0,0,0"
                                Command="{Binding ProcessCommand}"
                                Content="{DynamicResource action.start}"
                                Style="{DynamicResource CompactSuccessButtonStyle}" />
                        </Grid>
                    </StackPanel>

                    <Border Margin="14,12" Style="{DynamicResource SectionDividerBorderStyle}" />

                    <!--  Home / Abort / Reset：Abort 是急停，用红色  -->
                    <UniformGrid Margin="14,0,14,14" Columns="3">
                        <Button
                            Command="{Binding HomeCommand}"
                            Content="{DynamicResource action.home}"
                            Style="{DynamicResource CompactButtonStyle}" />
                        <Button
                            Command="{Binding AbortCommand}"
                            Content="{DynamicResource action.abort}"
                            Style="{DynamicResource CompactDangerButtonStyle}" />
                        <Button
                            Command="{Binding ResetCommand}"
                            Content="{DynamicResource action.reset}"
                            Style="{DynamicResource CompactButtonStyle}" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </materialDesign:Card>
</UserControl>
