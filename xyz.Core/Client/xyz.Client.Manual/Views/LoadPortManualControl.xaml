<UserControl x:Class="xyz.Client.Manual.Views.LoadPortManualControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:xyz.Client.Presentation.Helpers;assembly=xyz.Client.Presentation"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:presentationControls="clr-namespace:xyz.Client.Presentation.Controls;assembly=xyz.Client.Presentation"
             xmlns:threeD="clr-namespace:xyz.Client.Presentation.Controls.ThreeD;assembly=xyz.Client.Presentation">

    <!--  一个 LoadPort 一整张卡：状态信号 / 三维设备视图 / 操作三段上下相连，段与段之间一条细线分开（三块是一个整体，不拆成三张卡）  -->
    <!--  DataContext 由代码后置设在这个根节点上（不设控件自身的 DataContext，避免模板绑定二次求值）  -->
    <materialDesign:Card
        x:Name="Root"
        Margin="8"
        Style="{DynamicResource DefaultCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ① 状态信号：竖排四行 —— 模块名（右边带模式灯） / 状态徽标 / 信号灯（整行铺开） / 载具 ID  -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="26" />
                </Grid.RowDefinitions>

                <!--  模块名（LoadPort1 / LoadPort2），最右边一盏模式灯：生产绿、维护灰，由下面的生产 / 维护按钮切换  -->
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        ToolTip="{DynamicResource lpmanual.mode_tip}">
                        <Ellipse Width="14" Height="14" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#555" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Model.Mode}" Value="Production">
                                            <Setter Property="Fill" Value="{DynamicResource GreenHealthy}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource Size14}"
                            Foreground="{DynamicResource DarkSecondaryText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{DynamicResource lpmanual.maintenance}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Model.Mode}" Value="Production">
                                            <Setter Property="Text" Value="{DynamicResource lpmanual.production}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource Size22}"
                        FontWeight="Bold"
                        Foreground="{DynamicResource DarkPrimaryText}"
                        Text="{Binding ModuleName}" />
                </DockPanel>

                <!--  状态徽标：一眼看出 LoadPort 能不能用  -->
                <presentationControls:ModuleStateBadge
                    Grid.Row="1"
                    Margin="0,2,0,4"
                    Text="{Binding Model.StateText}"
                    Tone="{Binding Model.StateTone}" />

                <!--  信号灯：6 等分，窄格子也不会挤出去  -->
                <UniformGrid
                    Grid.Row="2"
                    Columns="6"
                    Rows="1"
                    VerticalAlignment="Center">
                    <!--  通讯  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        ToolTip="{DynamicResource lpmanual.comm_tip}">
                        <Ellipse Width="12" Height="12" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#555" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Model.IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource GreenHealthy}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource Size13}"
                            Foreground="{DynamicResource DarkSecondaryText}"
                            Text="{DynamicResource lpmanual.comm}" />
                    </StackPanel>

                    <!--  在位（放上来了）  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        ToolTip="{DynamicResource lpmanual.present_tip}">
                        <Ellipse Width="12" Height="12" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#555" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Model.IsPresent}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource PrimaryAccent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource Size13}"
                            Foreground="{DynamicResource DarkSecondaryText}"
                            Text="{DynamicResource lpmanual.present}" />
                    </StackPanel>

                    <!--  到位（放平贴紧）  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        ToolTip="{DynamicResource lpmanual.placed_tip}">
                        <Ellipse Width="12" Height="12" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#555" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Model.IsPlaced}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource GreenHealthy}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource Size13}"
                            Foreground="{DynamicResource DarkSecondaryText}"
                            Text="{DynamicResource lpmanual.placed}" />
                    </StackPanel>

                    <!--  报警  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        ToolTip="{DynamicResource lpmanual.alarm_tip}">
                        <Ellipse Width="12" Height="12" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#555" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Model.IsDeviceAlarm}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource DarkAlarmStatus}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource Size13}"
                            Foreground="{DynamicResource DarkSecondaryText}"
                            Text="{DynamicResource lpmanual.alarm}" />
                    </StackPanel>

                    <!--  AUTO：LoadPort Access Mode = Auto（Auto/Manual 按钮切换，与生产 / 维护模式无关）  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        ToolTip="{DynamicResource lpmanual.auto_tip}">
                        <Ellipse Width="12" Height="12" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#555" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Model.AutoMode}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource GreenHealthy}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource Size13}"
                            Foreground="{DynamicResource DarkSecondaryText}"
                            Text="{DynamicResource lpmanual.auto}" />
                    </StackPanel>

                    <!--  MANUAL：LoadPort Access Mode = Manual  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        ToolTip="{DynamicResource lpmanual.manual_tip}">
                        <Ellipse Width="12" Height="12" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#555" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Model.AutoMode}" Value="False">
                                            <Setter Property="Fill" Value="{DynamicResource DarkWarningStatus}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource Size13}"
                            Foreground="{DynamicResource DarkSecondaryText}"
                            Text="{DynamicResource lpmanual.manual}" />
                    </StackPanel>
                </UniformGrid>

                <!--  载具 ID（读 RFID 得到，没读到为空）  -->
                <StackPanel
                    Grid.Row="3"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="{DynamicResource Size14}"
                        Foreground="{DynamicResource DarkSecondaryText}"
                        Text="{DynamicResource lpmanual.carrier_id}" />
                    <TextBlock
                        FontSize="{DynamicResource Size14}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource DarkPrimaryText}"
                        Text="{Binding Model.CarrierId}" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Style="{DynamicResource SectionDividerBorderStyle}" />

            <!--  ② 三维设备视图：LoadPort + 托板上的花篮，占满中间这一段。花篮跟在位、到位两盏灯走（都亮才画）；门跟开到位 / 关到位反馈走，
                 对接按状态和门推（见 LoadPortModel）；槽数按后端 machine.xml 的 LoadPort 节点 SlotCount，片以晶圆账为准  -->
            <threeD:LoadPortScene
                Grid.Row="2"
                IsAutoMode="{Binding Model.AutoMode}"
                IsDocked="{Binding Model.IsDocked}"
                IsDoorOpen="{Binding Model.IsDoorShownOpen}"
                IsDoorUnknown="{Binding Model.IsDoorUnknown}"
                IsPlaced="{Binding Model.IsPlaced}"
                IsPresent="{Binding Model.IsPresent}"
                SlotCount="{Binding Model.SlotCount}"
                Wafers="{Binding Model.Wafers}" />

            <Border Grid.Row="3" Style="{DynamicResource SectionDividerBorderStyle}" />

            <!--  ③ 操作：五行按钮，每行 3 列等宽，按钮同宽同高，不满一行的位置留空；这一页只看时整块灰掉  -->
            <Grid Grid.Row="4" helpers:Permission.Operate="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  生产 / 维护：模块模式（交不交给调度用），刷新模块名右边的模式灯  -->
                <UniformGrid Grid.Row="0" Columns="3">
                    <Button
                        Command="{Binding ProductionCommand}"
                        Content="{DynamicResource action.production}"
                        Style="{DynamicResource CompactSuccessButtonStyle}" />
                    <Button
                        Command="{Binding MaintenanceCommand}"
                        Content="{DynamicResource action.maintenance}"
                        Style="{DynamicResource CompactButtonStyle}" />
                </UniformGrid>

                <!--  Auto/Manual：LoadPort 的 Access Mode，E84 按它决定跟不跟搬运车交接，刷新 AUTO/MANUAL 灯  -->
                <UniformGrid Grid.Row="1" Columns="3">
                    <Button
                        Command="{Binding AutoCommand}"
                        Content="{DynamicResource action.auto}"
                        Style="{DynamicResource CompactSuccessButtonStyle}" />
                    <Button
                        Command="{Binding ManualCommand}"
                        Content="{DynamicResource action.manual}"
                        Style="{DynamicResource CompactButtonStyle}" />
                </UniformGrid>

                <!--  读载具 ID（读 RFID）：只发起，读到的 ID 随状态推送刷新到状态卡  -->
                <UniformGrid Grid.Row="2" Columns="3">
                    <Button
                        Command="{Binding ReadCarrierIdCommand}"
                        Content="{DynamicResource action.read_id}"
                        Style="{DynamicResource CompactButtonStyle}" />
                </UniformGrid>

                <UniformGrid Grid.Row="3" Columns="3">
                    <Button
                        Command="{Binding HomeCommand}"
                        Content="{DynamicResource action.home}"
                        Style="{DynamicResource CompactButtonStyle}" />
                    <Button
                        Command="{Binding LoadCommand}"
                        Content="{DynamicResource action.load}"
                        Style="{DynamicResource CompactSuccessButtonStyle}" />
                    <Button
                        Command="{Binding UnloadCommand}"
                        Content="{DynamicResource action.unload}"
                        Style="{DynamicResource CompactButtonStyle}" />
                </UniformGrid>

                <UniformGrid Grid.Row="4" Columns="3">
                    <Button
                        Command="{Binding ResetCommand}"
                        Content="{DynamicResource action.reset}"
                        Style="{DynamicResource CompactButtonStyle}" />
                    <Button
                        Command="{Binding AbortCommand}"
                        Content="{DynamicResource action.abort}"
                        Style="{DynamicResource CompactDangerButtonStyle}" />
                </UniformGrid>
            </Grid>
        </Grid>
    </materialDesign:Card>
</UserControl>
