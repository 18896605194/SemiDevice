<UserControl x:Class="xyz.Client.Manual.Views.LoadPortManualControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:presentationControls="clr-namespace:xyz.Client.Presentation.Controls;assembly=xyz.Client.Presentation">

    <!--  一个 LoadPort 一整张卡：状态信号 / 花篮 / 操作三段上下相连，段与段之间一条细线分开（三块是一个整体，不拆成三张卡）  -->
    <!--  DataContext 由代码后置设在这个根节点上（不设控件自身的 DataContext，避免模板绑定二次求值）  -->
    <materialDesign:Card
        x:Name="Root"
        Margin="8"
        Style="{DynamicResource DefaultCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ① 状态信号：竖排五行 —— 模块名 / 信号灯（整行铺开） / 状态 / 在线模式 / 载具 ID  -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="26" />
                    <RowDefinition Height="26" />
                    <RowDefinition Height="26" />
                </Grid.RowDefinitions>

                <!--  模块名（LoadPort1 / LoadPort2）  -->
                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,6"
                    FontSize="{DynamicResource Size22}"
                    FontWeight="Bold"
                    Foreground="{DynamicResource DarkPrimaryText}"
                    Text="{Binding ModuleName}" />

                <!--  信号灯：6 等分，窄格子也不会挤出去  -->
                <UniformGrid
                    Grid.Row="1"
                    Columns="6"
                    Rows="1"
                    VerticalAlignment="Center">
                    <!--  通讯  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        ToolTip="{DynamicResource lpmanual.comm_tip}">
                        <Ellipse Width="12" Height="12" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#555" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Model.IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource GreenHealthy}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource Size13}"
                            Foreground="{DynamicResource DarkSecondaryText}"
                            Text="{DynamicResource lpmanual.comm}" />
                    </StackPanel>

                    <!--  在位（放上来了）  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        ToolTip="{DynamicResource lpmanual.present_tip}">
                        <Ellipse Width="12" Height="12" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#555" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Model.PodPresent}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource PrimaryAccent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource Size13}"
                            Foreground="{DynamicResource DarkSecondaryText}"
                            Text="{DynamicResource lpmanual.present}" />
                    </StackPanel>

                    <!--  到位（放平贴紧）  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        ToolTip="{DynamicResource lpmanual.placed_tip}">
                        <Ellipse Width="12" Height="12" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#555" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Model.PodPlaced}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource GreenHealthy}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource Size13}"
                            Foreground="{DynamicResource DarkSecondaryText}"
                            Text="{DynamicResource lpmanual.placed}" />
                    </StackPanel>

                    <!--  报警  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        ToolTip="{DynamicResource lpmanual.alarm_tip}">
                        <Ellipse Width="12" Height="12" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#555" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Model.DeviceAlarm}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource DarkAlarmStatus}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource Size13}"
                            Foreground="{DynamicResource DarkSecondaryText}"
                            Text="{DynamicResource lpmanual.alarm}" />
                    </StackPanel>

                    <!--  AUTO：LoadPort Access Mode = Auto（Auto/Manual 按钮切换，与在线模式无关）  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        ToolTip="{DynamicResource lpmanual.auto_tip}">
                        <Ellipse Width="12" Height="12" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#555" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Model.AutoMode}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource GreenHealthy}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource Size13}"
                            Foreground="{DynamicResource DarkSecondaryText}"
                            Text="AUTO" />
                    </StackPanel>

                    <!--  MANUAL：LoadPort Access Mode = Manual  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        ToolTip="{DynamicResource lpmanual.manual_tip}">
                        <Ellipse Width="12" Height="12" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#555" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Model.AutoMode}" Value="False">
                                            <Setter Property="Fill" Value="{DynamicResource DarkWarningStatus}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource Size13}"
                            Foreground="{DynamicResource DarkSecondaryText}"
                            Text="MANUAL" />
                    </StackPanel>
                </UniformGrid>

                <!--  状态文本  -->
                <StackPanel
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="{DynamicResource Size14}"
                        Foreground="{DynamicResource DarkSecondaryText}"
                        Text="{DynamicResource lpmanual.state}" />
                    <TextBlock
                        FontSize="{DynamicResource Size14}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource DarkPrimaryText}"
                        Text="{Binding Model.StateText}" />
                </StackPanel>

                <!--  在线模式  -->
                <StackPanel
                    Grid.Row="3"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="{DynamicResource Size14}"
                        Foreground="{DynamicResource DarkSecondaryText}"
                        Text="{DynamicResource lpmanual.online_mode}" />
                    <TextBlock FontSize="{DynamicResource Size14}" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{DynamicResource lpmanual.offline}" />
                                <Setter Property="Foreground" Value="{DynamicResource DarkSecondaryText}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Model.Mode}" Value="Online">
                                        <Setter Property="Text" Value="{DynamicResource lpmanual.online}" />
                                        <Setter Property="Foreground" Value="{DynamicResource GreenHealthy}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!--  载具 ID（读 RFID 得到，没读到为空）  -->
                <StackPanel
                    Grid.Row="4"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="{DynamicResource Size14}"
                        Foreground="{DynamicResource DarkSecondaryText}"
                        Text="{DynamicResource lpmanual.carrier_id}" />
                    <TextBlock
                        FontSize="{DynamicResource Size14}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource DarkPrimaryText}"
                        Text="{Binding Model.CarrierId}" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Style="{DynamicResource SectionDividerBorderStyle}" />

            <!--  ② 花篮：槽数按后端 sc.xml 的 LoadPort 节点 SlotCount；控件内部 Viewbox 等比缩放，占满中间这一段；载具 ID 只在状态段显示  -->
            <presentationControls:LoadPort
                Grid.Row="2"
                SlotCount="{Binding Model.SlotCount}"
                StatusText="{Binding Model.StateText}"
                Wafers="{Binding Model.Wafers}" />

            <Border Grid.Row="3" Style="{DynamicResource SectionDividerBorderStyle}" />

            <!--  ③ 操作：五行按钮，每行 3 列等宽，按钮同宽同高，不满一行的位置留空  -->
            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Online/Offline：模块模式（是否参与自动调度），刷新状态卡的在线模式  -->
                <UniformGrid Grid.Row="0" Columns="3">
                    <Button
                        Command="{Binding OnlineCommand}"
                        Content="Online"
                        Style="{DynamicResource CompactSuccessButtonStyle}" />
                    <Button
                        Command="{Binding OfflineCommand}"
                        Content="Offline"
                        Style="{DynamicResource CompactButtonStyle}" />
                </UniformGrid>

                <!--  Auto/Manual：LoadPort 的 Access Mode，E84 按它决定跟不跟搬运车交接，刷新 AUTO/MANUAL 灯  -->
                <UniformGrid Grid.Row="1" Columns="3">
                    <Button
                        Command="{Binding AutoCommand}"
                        Content="Auto"
                        Style="{DynamicResource CompactSuccessButtonStyle}" />
                    <Button
                        Command="{Binding ManualCommand}"
                        Content="Manual"
                        Style="{DynamicResource CompactButtonStyle}" />
                </UniformGrid>

                <!--  读载具 ID（读 RFID）：只发起，读到的 ID 随状态推送刷新到状态卡  -->
                <UniformGrid Grid.Row="2" Columns="3">
                    <Button
                        Command="{Binding ReadCarrierIdCommand}"
                        Content="Read ID"
                        Style="{DynamicResource CompactButtonStyle}" />
                </UniformGrid>

                <UniformGrid Grid.Row="3" Columns="3">
                    <Button
                        Command="{Binding HomeCommand}"
                        Content="Home"
                        Style="{DynamicResource CompactButtonStyle}" />
                    <Button
                        Command="{Binding LoadCommand}"
                        Content="Load"
                        Style="{DynamicResource CompactSuccessButtonStyle}" />
                    <Button
                        Command="{Binding UnloadCommand}"
                        Content="Unload"
                        Style="{DynamicResource CompactButtonStyle}" />
                </UniformGrid>

                <UniformGrid Grid.Row="4" Columns="3">
                    <Button
                        Command="{Binding ResetCommand}"
                        Content="Reset"
                        Style="{DynamicResource CompactButtonStyle}" />
                    <Button
                        Command="{Binding AbortCommand}"
                        Content="Abort"
                        Style="{DynamicResource CompactDangerButtonStyle}" />
                </UniformGrid>
            </Grid>
        </Grid>
    </materialDesign:Card>
</UserControl>
