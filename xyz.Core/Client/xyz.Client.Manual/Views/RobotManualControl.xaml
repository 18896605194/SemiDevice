<UserControl x:Class="xyz.Client.Manual.Views.RobotManualControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:presentationControls="clr-namespace:xyz.Client.Presentation.Controls;assembly=xyz.Client.Presentation">

    <!--  一个 Robot 一整张卡：左调度图（占满整高）+ 右栏（机械手状态 + 操作盘），中间一条细线（整体一块，不拆成多张卡）  -->
    <!--  DataContext 由代码后置设在这个根节点上（不设控件自身的 DataContext，避免模板绑定二次求值）  -->
    <materialDesign:Card
        x:Name="Root"
        Margin="8"
        Style="{DynamicResource DefaultCardStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!--  ① 调度图：北排腔体卡（最多四张）/ 中间 Robot 控件 / 南排 LoadPort 卡（两张），卡片近方形 280×233、居中排；
                 片在哪都是同一个大小：卡片圆片直径（DiskSize）= 机械手叉上的片直径  -->
            <Grid Grid.Column="0" Margin="14">
                <Border
                    Background="{DynamicResource DarkControlBackground}"
                    BorderBrush="{DynamicResource DarkBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  北：腔体 ChamberInfoCard  -->
                        <ItemsControl
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Center"
                            ItemsSource="{Binding Model.NorthStations}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <presentationControls:ChamberInfoCard
                                        Width="280"
                                        Height="233"
                                        Margin="6,0"
                                        DiskSize="76"
                                        Number="{Binding NumberText}"
                                        CreateEnable="False"
                                        DeleteEnable="False"
                                        IsOnline=""
                                        Recipe=""
                                        RecipeState=""
                                        RotationSpeed="0"
                                        ShutterState=""
                                        StateText="{Binding StateText}"
                                        StateTone="{Binding StateTone}"
                                        StatusOn="False"
                                        Step=""
                                        StepTime=""
                                        RecipeTime=""
                                        Title="{Binding Title}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  机械手画 360 高：Robot 控件按 400 设计，叉上的片直径 84，放到 360 约 76，跟卡片圆片一样大  -->
                        <Viewbox
                            Grid.Row="1"
                            Grid.Column="1"
                            Height="360"
                            Stretch="Uniform">
                            <presentationControls:Robot
                                ArmCount="{Binding Model.ArmCount}"
                                ArmType="Linear"
                                Arms="{Binding Model.Arms}"
                                Rotation="{Binding Model.Direction}"
                                Travel="{Binding Model.Y}" />
                        </Viewbox>

                        <!--  南：LoadPort 用 LoadPortInfoCard  -->
                        <ItemsControl
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            ItemsSource="{Binding Model.SouthStations}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <presentationControls:LoadPortInfoCard
                                        Width="280"
                                        Height="233"
                                        Margin="6,0"
                                        DiskSize="76"
                                        Number="{Binding NumberText}"
                                        Alarm="False"
                                        AutoMode="True"
                                        CreateEnable="False"
                                        DeleteEnable="False"
                                        IsConnected="False"
                                        IsOnline=""
                                        Placed="False"
                                        Present="False"
                                        RotationSpeed="0"
                                        SlotCount="{Binding SlotCount}"
                                        StateText="{Binding StateText}"
                                        StateTone="{Binding StateTone}"
                                        Title="{Binding Title}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>

            <!--  ② 右栏：模块名 + 状态色条 → 参数框（通讯 / 使能 / 报错 / 速度）→ 轴位 → 取放（源 / 目标 的站点·手臂·槽位 → Pick · Place）→ Home / Abort / Reset  -->
            <Border
                Grid.Column="1"
                BorderBrush="{DynamicResource DarkBorderBrush}"
                BorderThickness="1,0,0,0">
                <StackPanel>

                    <!--  模块名  -->
                    <TextBlock
                        Margin="14,12,14,0"
                        FontSize="{DynamicResource Size22}"
                        FontWeight="Bold"
                        Foreground="{DynamicResource DarkPrimaryText}"
                        Text="{Binding ModuleName}" />

                    <!--  状态徽标：一眼看出机械手能不能动  -->
                    <presentationControls:ModuleStateBadge
                        Margin="14,8,14,0"
                        Text="{Binding Model.StateText}"
                        Tone="{Binding Model.StateTone}" />

                    <!--  参数框：通讯 / 使能 / 报错 一行一盏灯（使能行带 ON / OFF 小按钮，报错行写报错内容），速度显示数值  -->
                    <Border Margin="14,10,14,0" Style="{DynamicResource ReadoutBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  通讯  -->
                            <TextBlock
                                Grid.Row="0"
                                Margin="0,4"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource Size14}"
                                Foreground="{DynamicResource DarkSecondaryText}"
                                Text="{DynamicResource robotmanual.comm}"
                                ToolTip="{DynamicResource robotmanual.comm_tip}" />
                            <Ellipse
                                Grid.Row="0"
                                Grid.Column="2"
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#555" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Model.IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource GreenHealthy}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!--  使能：伺服上 / 下使能的小按钮 + 灯  -->
                            <TextBlock
                                Grid.Row="1"
                                Margin="0,4"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource Size14}"
                                Foreground="{DynamicResource DarkSecondaryText}"
                                Text="{DynamicResource robotmanual.enable}"
                                ToolTip="{DynamicResource robotmanual.servo_tip}" />
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    Command="{Binding PowerOnCommand}"
                                    Content="{DynamicResource robotmanual.servo_on}"
                                    Style="{DynamicResource MiniButtonStyle}" />
                                <Button
                                    Command="{Binding PowerOffCommand}"
                                    Content="{DynamicResource robotmanual.servo_off}"
                                    Style="{DynamicResource MiniButtonStyle}" />
                            </StackPanel>
                            <Ellipse
                                Grid.Row="1"
                                Grid.Column="2"
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#555" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Model.IsServoOn}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource GreenHealthy}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!--  报错：有报错灯亮，报错内容（错误码#内容）写在灯左边  -->
                            <TextBlock
                                Grid.Row="2"
                                Margin="0,4"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource Size14}"
                                Foreground="{DynamicResource DarkSecondaryText}"
                                Text="{DynamicResource robotmanual.device_error}"
                                ToolTip="{DynamicResource robotmanual.alarm_tip}" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="12,0,8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="{DynamicResource Size13}"
                                Foreground="{DynamicResource DarkPrimaryText}"
                                Text="{Binding Model.DeviceError}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding Model.DeviceError}" />
                            <Ellipse
                                Grid.Row="2"
                                Grid.Column="2"
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#555" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Model.HasDeviceError}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource DarkAlarmStatus}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!--  速度：全局速度百分比  -->
                            <TextBlock
                                Grid.Row="3"
                                Margin="0,4"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource Size14}"
                                Foreground="{DynamicResource DarkSecondaryText}"
                                Text="{DynamicResource robotmanual.speed}" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="{DynamicResource Size14}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource DarkPrimaryText}"
                                Text="{Binding Model.SpeedText}" />
                        </Grid>
                    </Border>

                    <!--  轴位：按 sc.xml 轴表（Driver 的 Axes）整表列出，坐标扫描查询刷新；还没查到或没连上显示"—"  -->
                    <StackPanel Margin="14,10,14,0">
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="{DynamicResource Size13}"
                            Foreground="{DynamicResource DarkDisabledText}"
                            Text="{DynamicResource robotmanual.axis}" />
                        <Border Style="{DynamicResource ReadoutBorderStyle}">
                            <ItemsControl ItemsSource="{Binding Model.AxisPositions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                FontSize="{DynamicResource Size13}"
                                                Foreground="{DynamicResource DarkSecondaryText}"
                                                Text="{Binding Name}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                FontFamily="Consolas"
                                                FontSize="{DynamicResource Size13}"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource DarkPrimaryText}"
                                                Text="{Binding PositionText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <Border Margin="14,12" Style="{DynamicResource SectionDividerBorderStyle}" />

                    <!--  取放：源 / 目标 各一行 站点·手臂·槽位，手臂和槽位都跟着选中的站点走
                         （手臂取 sc.xml 机械手站点节点的 Arms，槽位取站点的槽数：LoadPort 1~25、腔体 1）；
                         Pick 用源手臂从源取片、Place 用目标手臂往目标放片  -->
                    <StackPanel Margin="14,0,14,0">
                        <TextBlock
                            FontSize="{DynamicResource Size13}"
                            Foreground="{DynamicResource DarkDisabledText}"
                            Text="{DynamicResource robotmanual.pick_place}" />

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  列头：站点 / 手臂 / 槽位  -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="2,6,0,2"
                                FontSize="{DynamicResource Size12}"
                                Foreground="{DynamicResource DarkDisabledText}"
                                Text="{DynamicResource robotmanual.field_station}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="3"
                                Margin="2,6,0,2"
                                FontSize="{DynamicResource Size12}"
                                Foreground="{DynamicResource DarkDisabledText}"
                                Text="{DynamicResource robotmanual.field_arm}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="5"
                                Margin="2,6,0,2"
                                FontSize="{DynamicResource Size12}"
                                Foreground="{DynamicResource DarkDisabledText}"
                                Text="{DynamicResource robotmanual.field_slot}" />

                            <!--  源：Pick 用源手臂从这儿取片  -->
                            <TextBlock
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource Size13}"
                                Foreground="{DynamicResource DarkSecondaryText}"
                                Text="{DynamicResource robotmanual.source}" />
                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,2"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding Model.StationMarks}"
                                SelectedValue="{Binding SourceStation}"
                                SelectedValuePath="Name"
                                Style="{DynamicResource CompactComboBoxStyle}" />
                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="3"
                                Margin="0,2"
                                ItemsSource="{Binding SourceArmOptions}"
                                SelectedItem="{Binding SourceArm}"
                                Style="{DynamicResource CompactComboBoxStyle}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat=Arm{0}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="5"
                                Margin="0,2"
                                ItemsSource="{Binding SourceSlotOptions}"
                                SelectedItem="{Binding SourceSlot}"
                                Style="{DynamicResource CompactComboBoxStyle}" />

                            <!--  目标：Place 用目标手臂往这儿放片  -->
                            <TextBlock
                                Grid.Row="2"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource Size13}"
                                Foreground="{DynamicResource DarkSecondaryText}"
                                Text="{DynamicResource robotmanual.target}" />
                            <ComboBox
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,2"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding Model.StationMarks}"
                                SelectedValue="{Binding TargetStation}"
                                SelectedValuePath="Name"
                                Style="{DynamicResource CompactComboBoxStyle}" />
                            <ComboBox
                                Grid.Row="2"
                                Grid.Column="3"
                                Margin="0,2"
                                ItemsSource="{Binding TargetArmOptions}"
                                SelectedItem="{Binding TargetArm}"
                                Style="{DynamicResource CompactComboBoxStyle}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat=Arm{0}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox
                                Grid.Row="2"
                                Grid.Column="5"
                                Margin="0,2"
                                ItemsSource="{Binding TargetSlotOptions}"
                                SelectedItem="{Binding TargetSlot}"
                                Style="{DynamicResource CompactComboBoxStyle}" />
                        </Grid>

                        <UniformGrid Margin="0,10,0,0" Columns="2">
                            <Button
                                Height="36"
                                Command="{Binding PickCommand}"
                                Content="{DynamicResource action.pick}"
                                Style="{DynamicResource CompactButtonStyle}" />
                            <Button
                                Height="36"
                                Command="{Binding PlaceCommand}"
                                Content="{DynamicResource action.place}"
                                Style="{DynamicResource CompactButtonStyle}" />
                        </UniformGrid>
                    </StackPanel>

                    <Border Margin="14,12" Style="{DynamicResource SectionDividerBorderStyle}" />

                    <!--  Home / Abort / Reset：Abort 是急停，用红色  -->
                    <UniformGrid Margin="14,0,14,14" Columns="3">
                        <Button
                            Command="{Binding HomeCommand}"
                            Content="{DynamicResource action.home}"
                            Style="{DynamicResource CompactButtonStyle}" />
                        <Button
                            Command="{Binding AbortCommand}"
                            Content="{DynamicResource action.abort}"
                            Style="{DynamicResource CompactDangerButtonStyle}" />
                        <Button
                            Command="{Binding ResetCommand}"
                            Content="{DynamicResource action.reset}"
                            Style="{DynamicResource CompactButtonStyle}" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </materialDesign:Card>
</UserControl>
