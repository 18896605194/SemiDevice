<UserControl
    x:Class="xyz.Client.Recipe.Views.ProcessRecipeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:xyz.Client.Presentation.Controls;assembly=xyz.Client.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="920"
    d:DesignWidth="1980"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    mc:Ignorable="d">

    <!--  Esc 关掉确认框  -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding DialogCancelCommand}" />
    </UserControl.InputBindings>

    <Grid Background="{DynamicResource DarkWindowBackground}">
        <!--  左边工艺配方列表（编号 1~N，个数由后端给），右边两块：配方头、工艺步骤。每块带标题条，按钮放在各自的标题条上  -->
        <Grid
            Margin="8"
            Style="{DynamicResource ShowWhenTagTrueStyle}"
            Tag="{Binding IsReady}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  工艺配方列表：只有编号、名称两列；新建 / 重命名 / 删除马上生效  -->
            <Border Style="{DynamicResource ZoneBorderStyle}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{DynamicResource ZoneHeaderBorderStyle}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Command="{Binding CreateCommand}" Style="{DynamicResource ZoneHeaderButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Kind="Plus" />
                                        <TextBlock Text="{DynamicResource recipe.process.create}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RenameCommand}" Style="{DynamicResource ZoneHeaderButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Kind="PencilOutline" />
                                        <TextBlock Text="{DynamicResource recipe.process.rename}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding DeleteCommand}" Style="{DynamicResource ZoneHeaderButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Kind="DeleteOutline" />
                                        <TextBlock Text="{DynamicResource recipe.process.delete}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{DynamicResource ZoneTitleBarBorderStyle}" />
                                <TextBlock Style="{DynamicResource ZoneTitleTextStyle}" Text="{DynamicResource recipe.process.list}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!--  单元格样式要直接写在 DataGrid 上：只靠表格样式里的 CellStyle，MaterialDesign 会先套上它自己的单元格样式，选中行变成灰的  -->
                    <DataGrid
                        CellStyle="{DynamicResource DefaultDataGridCellStyle}"
                        ItemsSource="{Binding Slots}"
                        SelectedItem="{Binding SelectedSlot}"
                        Style="{DynamicResource ZoneDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="84"
                                Binding="{Binding IndexText, Mode=OneWay}"
                                ElementStyle="{DynamicResource SlotIndexDataGridTextStyle}"
                                Header="{DynamicResource recipe.process.index}" />
                            <DataGridTemplateColumn Width="*" Header="{DynamicResource recipe.process.name}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,0" Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{Binding Name, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <!--  正在编辑、改了还没保存  -->
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource DarkWarningStatus}"
                                                Style="{DynamicResource ShowWhenTagTrueStyle}"
                                                Tag="{Binding IsDirty}"
                                                Text="●" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  配方头：按后端的配方头字段表（sc.xml ProcessRecipe → Head）一项一项摆，左边名字、右边值，一行排几项（文本项三项宽）。
                      程序算的（编号、名称、创建 / 修改记录、版本）只显示；能填的（Type、超时时间、说明、自己加的项）跟步骤的格子一样是输入框、下拉框、勾选框，
                      跟步骤一起用工艺步骤标题条上的"保存"存。改名走列表的重命名。Type 换了，下面步骤里的下拉跟着换成那一套选项  -->
                <Border Grid.Row="0" Style="{DynamicResource ZoneBorderStyle}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{DynamicResource ZoneHeaderBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{DynamicResource ZoneTitleBarBorderStyle}" />
                                <TextBlock Style="{DynamicResource ZoneTitleTextStyle}" Text="{DynamicResource recipe.process.info}" />
                            </StackPanel>
                        </Border>

                        <Grid>
                            <ItemsControl
                                Margin="14,10,14,12"
                                ItemsSource="{Binding HeadItems}"
                                Style="{DynamicResource ShowWhenTagTrueStyle}"
                                Tag="{Binding HasRecipe}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel
                                            Width="{Binding Width}"
                                            Margin="0,4"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Width="{Binding LabelColumnWidth}"
                                                VerticalAlignment="Center"
                                                Style="{DynamicResource MetaLabelTextStyle}"
                                                Text="{Binding Field.Header}"
                                                TextTrimming="CharacterEllipsis" />
                                            <!--  值：程序算的是文字；能填的按类型三选一，跟步骤的格子一样  -->
                                            <Grid Width="{Binding ControlWidth}">
                                                <Border Style="{DynamicResource ShowWhenTagTrueStyle}" Tag="{Binding IsAuto}">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Style="{DynamicResource MetaValueTextStyle}"
                                                        Text="{Binding AutoText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Border>
                                                <Border Style="{DynamicResource ShowWhenTagTrueStyle}" Tag="{Binding IsInput}">
                                                    <controls:InputTextBox
                                                        materialDesign:ValidationAssist.UsePopup="True"
                                                        DataType="{Binding Cell.Field.DataType}"
                                                        HasError="{Binding Cell.HasInputError, Mode=OneWayToSource}"
                                                        Maximum="{Binding Cell.Field.Max}"
                                                        Minimum="{Binding Cell.Field.Min}"
                                                        Style="{DynamicResource ToolbarTextBoxStyle}"
                                                        Unit="{Binding Cell.Field.Unit}"
                                                        Value="{Binding Cell.Value}" />
                                                </Border>
                                                <Border Style="{DynamicResource ShowWhenTagTrueStyle}" Tag="{Binding IsChoice}">
                                                    <ComboBox
                                                        DisplayMemberPath="Text"
                                                        ItemsSource="{Binding Cell.Choices}"
                                                        SelectedValue="{Binding Cell.Value}"
                                                        SelectedValuePath="Value"
                                                        Style="{DynamicResource StepComboBoxStyle}"
                                                        Tag="{Binding Cell.HasError}" />
                                                </Border>
                                                <Border Style="{DynamicResource ShowWhenTagTrueStyle}" Tag="{Binding IsBool}">
                                                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding Cell.IsChecked}" />
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--  选中空编号  -->
                            <TextBlock
                                Margin="16,18"
                                Foreground="{DynamicResource DarkDisabledText}"
                                Style="{DynamicResource NullContentHintTextStyle}"
                                Tag="{Binding Current}"
                                Text="{Binding EmptyText}" />
                        </Grid>
                    </DockPanel>
                </Border>

                <!--  工艺步骤：步号就是普通数字。每一步有哪些列按后端的字段表（sc.xml ProcessRecipe → Fields）生成，不写死：
                      整数、小数、文本是输入框，下拉是下拉框（选项按配方头选的 Type 取那一套），开关是勾选框。
                      点一行（或点进这一行的输入框、下拉框）选中：添加插在它后面，删除删它。
                      标题条最右：[合计] [有没保存的修改] [添加] [删除] [保存]——保存存的是整个工艺配方（配方头能填的项 + 全部步骤）  -->
                <Border Grid.Row="2" Style="{DynamicResource ZoneBorderStyle}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{DynamicResource ZoneHeaderBorderStyle}">
                            <DockPanel>
                                <StackPanel
                                    DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    Style="{DynamicResource ShowWhenTagTrueStyle}"
                                    Tag="{Binding HasRecipe}">
                                    <TextBlock Style="{DynamicResource ZoneStatTextStyle}" Text="{Binding TotalText}" />
                                    <Border Style="{DynamicResource DirtyChipBorderStyle}" Tag="{Binding IsDirty}">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource Size12}"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource recipe.process.dirty}" />
                                    </Border>
                                    <Button Command="{Binding AddStepCommand}" Style="{DynamicResource ZoneHeaderButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Kind="Plus" />
                                            <TextBlock Text="{DynamicResource recipe.process.add_step}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DeleteStepCommand}" Style="{DynamicResource ZoneHeaderButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Kind="DeleteOutline" />
                                            <TextBlock Text="{DynamicResource recipe.process.delete_step}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SaveCommand}" Style="{DynamicResource ZoneHeaderPrimaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Kind="ContentSaveOutline" />
                                            <TextBlock Text="{DynamicResource recipe.process.save}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{DynamicResource ZoneTitleBarBorderStyle}" />
                                    <TextBlock Style="{DynamicResource ZoneTitleTextStyle}" Text="{DynamicResource recipe.process.steps}" />
                                </StackPanel>
                                <TextBlock Style="{DynamicResource ZoneErrorTextStyle}" Text="{Binding ValidationText}" />
                            </DockPanel>
                        </Border>

                        <Grid>
                            <DockPanel Style="{DynamicResource ShowWhenTagTrueStyle}" Tag="{Binding HasRecipe}">
                                <Border DockPanel.Dock="Top" Style="{DynamicResource StepHeaderBorderStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Width="70"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource recipe.process.step}" />
                                        <ItemsControl ItemsSource="{Binding Fields}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        Width="{Binding Width}"
                                                        VerticalAlignment="Center"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Header}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <ListBox
                                    x:Name="StepList"
                                    ItemContainerStyle="{DynamicResource StepListBoxItemStyle}"
                                    ItemsSource="{Binding Steps}"
                                    SelectedItem="{Binding SelectedStep}"
                                    Style="{DynamicResource PickListBoxStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    Width="70"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding Number}" />
                                                <ItemsControl ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <!--  一格：按这一列的类型三选一显示；输入框自己按类型、上下限查，错着把 HasError 报给这一格  -->
                                                            <Grid Width="{Binding Field.Width}">
                                                                <Border Style="{DynamicResource ShowWhenTagTrueStyle}" Tag="{Binding Field.IsInput}">
                                                                    <controls:InputTextBox
                                                                        Width="{Binding Field.ControlWidth}"
                                                                        HorizontalAlignment="Left"
                                                                        materialDesign:ValidationAssist.UsePopup="True"
                                                                        DataType="{Binding Field.DataType}"
                                                                        HasError="{Binding HasInputError, Mode=OneWayToSource}"
                                                                        Maximum="{Binding Field.Max}"
                                                                        Minimum="{Binding Field.Min}"
                                                                        Style="{DynamicResource ToolbarTextBoxStyle}"
                                                                        Unit="{Binding Field.Unit}"
                                                                        Value="{Binding Value}" />
                                                                </Border>
                                                                <Border Style="{DynamicResource ShowWhenTagTrueStyle}" Tag="{Binding Field.IsChoice}">
                                                                    <ComboBox
                                                                        Width="{Binding Field.ControlWidth}"
                                                                        HorizontalAlignment="Left"
                                                                        DisplayMemberPath="Text"
                                                                        ItemsSource="{Binding Choices}"
                                                                        SelectedValue="{Binding Value}"
                                                                        SelectedValuePath="Value"
                                                                        Style="{DynamicResource StepComboBoxStyle}"
                                                                        Tag="{Binding HasError}" />
                                                                </Border>
                                                                <Border Style="{DynamicResource ShowWhenTagTrueStyle}" Tag="{Binding Field.IsBool}">
                                                                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsChecked}" />
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <TextBlock
                                Style="{DynamicResource CenterNullHintTextStyle}"
                                Tag="{Binding Current}"
                                Text="{DynamicResource recipe.process.empty_steps}" />
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!--  没连上后端、没装工艺配方库时正中的一句  -->
        <TextBlock
            Style="{DynamicResource CenterTagHintTextStyle}"
            Tag="{Binding IsPageHintVisible}"
            Text="{Binding PageHint}" />

        <!--  确认框：新建、重命名填名称；删除、放弃修改确认。后端拒了的原因写在框里，框不关；Esc 或"取消"关掉  -->
        <Border Style="{DynamicResource PageOverlayBorderStyle}" Tag="{Binding IsDialogOpen}">
            <Border Style="{DynamicResource DialogCardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource PanelTitleTextStyle}" Text="{Binding DialogTitle}" />
                    <!--  删除、放弃修改：大字写要动的是哪一个；新建、重命名不显示（编号在标题里，名称就在下面的输入框，不重复）  -->
                    <Grid Style="{DynamicResource ShowWhenTagTrueStyle}" Tag="{Binding HasDialogSubject}">
                        <Border Style="{DynamicResource DialogSummaryBorderStyle}">
                            <TextBlock Style="{DynamicResource DialogSubjectTextStyle}" Text="{Binding DialogSubject}" />
                        </Border>
                    </Grid>

                    <!--  新建、重命名：名称  -->
                    <StackPanel Style="{DynamicResource ShowWhenTagTrueStyle}" Tag="{Binding IsNaming}">
                        <controls:InputTextBox
                            x:Name="NameBox"
                            Margin="0,18,0,0"
                            materialDesign:HintAssist.Hint="{DynamicResource recipe.process.name_hint}"
                            DataType="Text"
                            Value="{Binding DialogName}" />
                    </StackPanel>

                    <TextBlock Style="{DynamicResource DialogMessageTextStyle}" Text="{Binding DialogMessage}" />
                    <TextBlock Style="{DynamicResource DialogErrorTextStyle}" Text="{Binding DialogError}" />

                    <StackPanel
                        Margin="0,20,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Command="{Binding DialogCancelCommand}"
                            Content="{Binding CancelText}"
                            Style="{DynamicResource ToolbarOutlinedButtonStyle}" />
                        <Button
                            Command="{Binding DialogConfirmCommand}"
                            Content="{Binding ConfirmText}"
                            Style="{DynamicResource DialogConfirmButtonStyle}"
                            Tag="{Binding IsDangerConfirm}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
