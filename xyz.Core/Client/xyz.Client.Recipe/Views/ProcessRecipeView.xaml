<UserControl
    x:Class="xyz.Client.Recipe.Views.ProcessRecipeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:xyz.Client.Presentation.Controls;assembly=xyz.Client.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="920"
    d:DesignWidth="1980"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    mc:Ignorable="d">

    <!--  Esc 关掉确认框  -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding DialogCancelCommand}" />
    </UserControl.InputBindings>

    <Grid Background="{DynamicResource DarkWindowBackground}">
        <!--  左边工艺配方列表（编号 1~N，个数由后端给），右边两块：基本信息、工艺步骤。每块带标题条，按钮放在各自的标题条上  -->
        <Grid
            Margin="8"
            Style="{DynamicResource ShowWhenTagTrueStyle}"
            Tag="{Binding IsReady}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  工艺配方列表：只有编号、名称两列；新建 / 重命名 / 删除马上生效  -->
            <Border Style="{DynamicResource ZoneBorderStyle}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{DynamicResource ZoneHeaderBorderStyle}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Command="{Binding CreateCommand}" Style="{DynamicResource ZoneHeaderButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Kind="Plus" />
                                        <TextBlock Text="{DynamicResource recipe.process.create}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RenameCommand}" Style="{DynamicResource ZoneHeaderButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Kind="PencilOutline" />
                                        <TextBlock Text="{DynamicResource recipe.process.rename}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding DeleteCommand}" Style="{DynamicResource ZoneHeaderButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Kind="DeleteOutline" />
                                        <TextBlock Text="{DynamicResource recipe.process.delete}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{DynamicResource ZoneTitleBarBorderStyle}" />
                                <TextBlock Style="{DynamicResource ZoneTitleTextStyle}" Text="{DynamicResource recipe.process.list}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!--  单元格样式要直接写在 DataGrid 上：只靠表格样式里的 CellStyle，MaterialDesign 会先套上它自己的单元格样式，选中行变成灰的  -->
                    <DataGrid
                        CellStyle="{DynamicResource DefaultDataGridCellStyle}"
                        ItemsSource="{Binding Slots}"
                        SelectedItem="{Binding SelectedSlot}"
                        Style="{DynamicResource ZoneDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="84"
                                Binding="{Binding IndexText, Mode=OneWay}"
                                ElementStyle="{DynamicResource SlotIndexDataGridTextStyle}"
                                Header="{DynamicResource recipe.process.index}" />
                            <DataGridTemplateColumn Width="*" Header="{DynamicResource recipe.process.name}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,0" Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{Binding Name, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <!--  正在编辑、改了还没保存  -->
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource DarkWarningStatus}"
                                                Style="{DynamicResource ShowWhenTagTrueStyle}"
                                                Tag="{Binding IsDirty}"
                                                Text="●" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  基本信息：编号、名称（改名走列表的重命名）、创建 / 修改记录、版本只读，说明可改（跟步骤一起，用工艺步骤标题条上的"保存"存）  -->
                <Border Grid.Row="0" Style="{DynamicResource ZoneBorderStyle}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{DynamicResource ZoneHeaderBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{DynamicResource ZoneTitleBarBorderStyle}" />
                                <TextBlock Style="{DynamicResource ZoneTitleTextStyle}" Text="{DynamicResource recipe.process.info}" />
                            </StackPanel>
                        </Border>

                        <Grid>
                            <StackPanel
                                Margin="14,12,14,14"
                                Style="{DynamicResource ShowWhenTagTrueStyle}"
                                Tag="{Binding HasRecipe}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{DynamicResource MetaLabelTextStyle}" Text="{DynamicResource recipe.process.index}" />
                                        <TextBlock Style="{DynamicResource MetaValueTextStyle}" Text="{Binding IndexText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{DynamicResource MetaLabelTextStyle}" Text="{DynamicResource recipe.process.name}" />
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Style="{DynamicResource MetaValueTextStyle}"
                                            Text="{Binding NameText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{DynamicResource MetaLabelTextStyle}" Text="{DynamicResource recipe.process.created_by}" />
                                        <TextBlock Style="{DynamicResource MetaValueTextStyle}" Text="{Binding CreatedBy}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Style="{DynamicResource MetaLabelTextStyle}" Text="{DynamicResource recipe.process.created_at}" />
                                        <TextBlock Style="{DynamicResource MetaValueTextStyle}" Text="{Binding CreatedAtText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Style="{DynamicResource MetaLabelTextStyle}" Text="{DynamicResource recipe.process.modified_by}" />
                                        <TextBlock Style="{DynamicResource MetaValueTextStyle}" Text="{Binding ModifiedBy}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="5">
                                        <TextBlock Style="{DynamicResource MetaLabelTextStyle}" Text="{DynamicResource recipe.process.modified_at}" />
                                        <TextBlock Style="{DynamicResource MetaValueTextStyle}" Text="{Binding ModifiedAtText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Style="{DynamicResource MetaLabelTextStyle}" Text="{DynamicResource recipe.process.revision}" />
                                        <TextBlock Style="{DynamicResource MetaValueTextStyle}" Text="{Binding RevisionText}" />
                                    </StackPanel>
                                </Grid>
                                <controls:InputTextBox
                                    Margin="0,14,0,0"
                                    materialDesign:HintAssist.Hint="{DynamicResource recipe.process.description}"
                                    DataType="Text"
                                    Value="{Binding Description}" />
                            </StackPanel>

                            <!--  选中空编号  -->
                            <TextBlock
                                Margin="16,18"
                                Foreground="{DynamicResource DarkDisabledText}"
                                Style="{DynamicResource NullContentHintTextStyle}"
                                Tag="{Binding Current}"
                                Text="{Binding EmptyText}" />
                        </Grid>
                    </DockPanel>
                </Border>

                <!--  工艺步骤：步号就是普通数字。每一步：时间、转速，然后摆臂 → 这条摆臂上的药液 → 流量 → 方式（Time / Scan）→ 位置；
                      摆臂选"不出液"时后面几格不用填，摆臂在 Home。摆臂、药液照 sc.xml 原样显示，各项范围由后端给。
                      点一行（或点进这一行的输入框、下拉框）选中：添加插在它后面，删除删它。
                      标题条最右：[合计] [有没保存的修改] [添加] [删除] [保存]——保存存的是整个工艺配方（说明 + 全部步骤）  -->
                <Border Grid.Row="2" Style="{DynamicResource ZoneBorderStyle}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{DynamicResource ZoneHeaderBorderStyle}">
                            <DockPanel>
                                <StackPanel
                                    DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    Style="{DynamicResource ShowWhenTagTrueStyle}"
                                    Tag="{Binding HasRecipe}">
                                    <TextBlock Style="{DynamicResource ZoneStatTextStyle}" Text="{Binding TotalText}" />
                                    <Border Style="{DynamicResource DirtyChipBorderStyle}" Tag="{Binding IsDirty}">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource Size12}"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource recipe.process.dirty}" />
                                    </Border>
                                    <Button Command="{Binding AddStepCommand}" Style="{DynamicResource ZoneHeaderButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Kind="Plus" />
                                            <TextBlock Text="{DynamicResource recipe.process.add_step}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DeleteStepCommand}" Style="{DynamicResource ZoneHeaderButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Kind="DeleteOutline" />
                                            <TextBlock Text="{DynamicResource recipe.process.delete_step}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SaveCommand}" Style="{DynamicResource ZoneHeaderPrimaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Kind="ContentSaveOutline" />
                                            <TextBlock Text="{DynamicResource recipe.process.save}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{DynamicResource ZoneTitleBarBorderStyle}" />
                                    <TextBlock Style="{DynamicResource ZoneTitleTextStyle}" Text="{DynamicResource recipe.process.steps}" />
                                </StackPanel>
                                <TextBlock Style="{DynamicResource ZoneErrorTextStyle}" Text="{Binding ValidationText}" />
                            </DockPanel>
                        </Border>

                        <Grid>
                            <DockPanel Style="{DynamicResource ShowWhenTagTrueStyle}" Tag="{Binding HasRecipe}">
                                <Border DockPanel.Dock="Top" Style="{DynamicResource StepHeaderBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource recipe.process.step}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource recipe.process.time}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource recipe.process.rpm}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource recipe.process.arm}" />
                                        <TextBlock
                                            Grid.Column="4"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource recipe.process.chemical}" />
                                        <TextBlock
                                            Grid.Column="5"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource recipe.process.flow}" />
                                        <TextBlock
                                            Grid.Column="6"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource recipe.process.mode}" />
                                        <StackPanel Grid.Column="7" Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="{DynamicResource recipe.process.position}" />
                                            <TextBlock Style="{DynamicResource ItemDetailTextStyle}" Text="{Binding PositionTip}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ListBox
                                    x:Name="StepList"
                                    ItemContainerStyle="{DynamicResource StepListBoxItemStyle}"
                                    ItemsSource="{Binding Steps}"
                                    SelectedItem="{Binding SelectedStep}"
                                    Style="{DynamicResource PickListBoxStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Number}" />

                                                <!--  时间、转速：输入框自己查格式和范围（范围由后端给），错着把 HasError 报给这一行  -->
                                                <controls:InputTextBox
                                                    Grid.Column="1"
                                                    Width="104"
                                                    HorizontalAlignment="Left"
                                                    materialDesign:ValidationAssist.UsePopup="True"
                                                    DataType="Decimal"
                                                    HasError="{Binding HasSecondsError, Mode=OneWayToSource}"
                                                    Maximum="{Binding Limits.MaxSeconds}"
                                                    Minimum="{Binding Limits.MinSeconds}"
                                                    Style="{DynamicResource ToolbarTextBoxStyle}"
                                                    Unit="{DynamicResource recipe.process.unit_seconds}"
                                                    Value="{Binding SecondsText}" />
                                                <controls:InputTextBox
                                                    Grid.Column="2"
                                                    Width="104"
                                                    HorizontalAlignment="Left"
                                                    materialDesign:ValidationAssist.UsePopup="True"
                                                    DataType="Integer"
                                                    HasError="{Binding HasRpmError, Mode=OneWayToSource}"
                                                    Maximum="{Binding Limits.MaxRpm}"
                                                    Minimum="{Binding Limits.MinRpm}"
                                                    Style="{DynamicResource ToolbarTextBoxStyle}"
                                                    Unit="{DynamicResource recipe.process.unit_rpm}"
                                                    Value="{Binding RpmText}" />

                                                <!--  摆臂："不出液" + sc.xml 里的摆臂轴  -->
                                                <ComboBox
                                                    Grid.Column="3"
                                                    Width="140"
                                                    HorizontalAlignment="Left"
                                                    DisplayMemberPath="Text"
                                                    ItemsSource="{Binding DataContext.ArmChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    SelectedValue="{Binding Arm}"
                                                    SelectedValuePath="Value"
                                                    Style="{DynamicResource StepComboBoxStyle}" />

                                                <!--  药液：只列这条摆臂上的喷嘴；不出液写"—"  -->
                                                <Grid Grid.Column="4">
                                                    <Border Style="{DynamicResource ShowWhenTagTrueStyle}" Tag="{Binding IsDispensing}">
                                                        <ComboBox
                                                            Width="130"
                                                            HorizontalAlignment="Left"
                                                            materialDesign:HintAssist.Hint="{DynamicResource recipe.process.chemical_hint}"
                                                            ItemsSource="{Binding ChemicalOptions}"
                                                            SelectedItem="{Binding Chemical}"
                                                            Style="{DynamicResource StepComboBoxStyle}"
                                                            Tag="{Binding HasChemicalError}" />
                                                    </Border>
                                                    <Border Style="{DynamicResource ShowWhenTagTrueStyle}" Tag="{Binding IsIdle}">
                                                        <TextBlock Style="{DynamicResource StepPlaceholderTextStyle}" Text="{DynamicResource recipe.process.none}" />
                                                    </Border>
                                                </Grid>

                                                <!--  流量：选了药液才填；没选写"—"  -->
                                                <Grid Grid.Column="5">
                                                    <Border Style="{DynamicResource ShowWhenTagTrueStyle}" Tag="{Binding HasChemical}">
                                                        <controls:InputTextBox
                                                            Width="90"
                                                            HorizontalAlignment="Left"
                                                            materialDesign:ValidationAssist.UsePopup="True"
                                                            DataType="Decimal"
                                                            HasError="{Binding HasFlowError, Mode=OneWayToSource}"
                                                            Maximum="{Binding Limits.MaxFlow}"
                                                            Minimum="{Binding Limits.MinFlow}"
                                                            Style="{DynamicResource ToolbarTextBoxStyle}"
                                                            Unit="{DynamicResource recipe.process.unit_flow}"
                                                            Value="{Binding FlowText}" />
                                                    </Border>
                                                    <Border Style="{DynamicResource ShowWhenTagTrueStyle}" Tag="{Binding NoChemical}">
                                                        <TextBlock Style="{DynamicResource StepPlaceholderTextStyle}" Text="{DynamicResource recipe.process.none}" />
                                                    </Border>
                                                </Grid>

                                                <!--  方式：Time / Scan；不出液写"—"  -->
                                                <Grid Grid.Column="6">
                                                    <Border Style="{DynamicResource ShowWhenTagTrueStyle}" Tag="{Binding IsDispensing}">
                                                        <ComboBox
                                                            Width="120"
                                                            HorizontalAlignment="Left"
                                                            DisplayMemberPath="Text"
                                                            ItemsSource="{Binding DataContext.ModeChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            SelectedValue="{Binding Mode}"
                                                            SelectedValuePath="Value"
                                                            Style="{DynamicResource StepComboBoxStyle}" />
                                                    </Border>
                                                    <Border Style="{DynamicResource ShowWhenTagTrueStyle}" Tag="{Binding IsIdle}">
                                                        <TextBlock Style="{DynamicResource StepPlaceholderTextStyle}" Text="{DynamicResource recipe.process.none}" />
                                                    </Border>
                                                </Grid>

                                                <!--  位置：Time 一个数；Scan 再加"到 … 速度 … mm/s"（在两个位置之间来回扫，扫到这一步时间到）；不出液写 Home  -->
                                                <Grid Grid.Column="7">
                                                    <StackPanel
                                                        Orientation="Horizontal"
                                                        Style="{DynamicResource ShowWhenTagTrueStyle}"
                                                        Tag="{Binding IsDispensing}">
                                                        <controls:InputTextBox
                                                            Width="80"
                                                            materialDesign:ValidationAssist.UsePopup="True"
                                                            DataType="Decimal"
                                                            HasError="{Binding HasPositionError, Mode=OneWayToSource}"
                                                            Maximum="{Binding Limits.MaxPosition}"
                                                            Minimum="{Binding Limits.MinPosition}"
                                                            Style="{DynamicResource ToolbarTextBoxStyle}"
                                                            Value="{Binding PositionText}" />
                                                        <StackPanel
                                                            Orientation="Horizontal"
                                                            Style="{DynamicResource ShowWhenTagTrueStyle}"
                                                            Tag="{Binding IsScan}">
                                                            <TextBlock
                                                                Margin="10,0"
                                                                Style="{DynamicResource StepPlaceholderTextStyle}"
                                                                Text="{DynamicResource recipe.process.scan_to}" />
                                                            <controls:InputTextBox
                                                                Width="80"
                                                                materialDesign:ValidationAssist.UsePopup="True"
                                                                DataType="Decimal"
                                                                HasError="{Binding HasScanToError, Mode=OneWayToSource}"
                                                                Maximum="{Binding Limits.MaxPosition}"
                                                                Minimum="{Binding Limits.MinPosition}"
                                                                Style="{DynamicResource ToolbarTextBoxStyle}"
                                                                Value="{Binding ScanToText}" />
                                                            <TextBlock
                                                                Margin="18,0,10,0"
                                                                Style="{DynamicResource StepPlaceholderTextStyle}"
                                                                Text="{DynamicResource recipe.process.scan_speed}" />
                                                            <controls:InputTextBox
                                                                Width="80"
                                                                materialDesign:ValidationAssist.UsePopup="True"
                                                                DataType="Decimal"
                                                                HasError="{Binding HasScanSpeedError, Mode=OneWayToSource}"
                                                                Maximum="{Binding Limits.MaxScanSpeed}"
                                                                Minimum="{Binding Limits.MinScanSpeed}"
                                                                Style="{DynamicResource ToolbarTextBoxStyle}"
                                                                Unit="{DynamicResource recipe.process.unit_speed}"
                                                                Value="{Binding ScanSpeedText}" />
                                                            <TextBlock
                                                                Margin="10,0,0,0"
                                                                Style="{DynamicResource StepPlaceholderTextStyle}"
                                                                Text="{DynamicResource recipe.process.unit_speed}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border Style="{DynamicResource ShowWhenTagTrueStyle}" Tag="{Binding IsIdle}">
                                                        <TextBlock Style="{DynamicResource StepPlaceholderTextStyle}" Text="{DynamicResource recipe.process.home}" />
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <TextBlock
                                Style="{DynamicResource CenterNullHintTextStyle}"
                                Tag="{Binding Current}"
                                Text="{DynamicResource recipe.process.empty_steps}" />
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!--  没连上后端、没装工艺配方库时正中的一句  -->
        <TextBlock
            Style="{DynamicResource CenterTagHintTextStyle}"
            Tag="{Binding IsPageHintVisible}"
            Text="{Binding PageHint}" />

        <!--  确认框：新建、重命名填名称；删除、放弃修改确认。后端拒了的原因写在框里，框不关；Esc 或"取消"关掉  -->
        <Border Style="{DynamicResource PageOverlayBorderStyle}" Tag="{Binding IsDialogOpen}">
            <Border Style="{DynamicResource DialogCardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource PanelTitleTextStyle}" Text="{Binding DialogTitle}" />
                    <!--  删除、放弃修改：大字写要动的是哪一个；新建、重命名不显示（编号在标题里，名称就在下面的输入框，不重复）  -->
                    <Grid Style="{DynamicResource ShowWhenTagTrueStyle}" Tag="{Binding HasDialogSubject}">
                        <Border Style="{DynamicResource DialogSummaryBorderStyle}">
                            <TextBlock Style="{DynamicResource DialogSubjectTextStyle}" Text="{Binding DialogSubject}" />
                        </Border>
                    </Grid>

                    <!--  新建、重命名：名称  -->
                    <StackPanel Style="{DynamicResource ShowWhenTagTrueStyle}" Tag="{Binding IsNaming}">
                        <controls:InputTextBox
                            x:Name="NameBox"
                            Margin="0,18,0,0"
                            materialDesign:HintAssist.Hint="{DynamicResource recipe.process.name_hint}"
                            DataType="Text"
                            Value="{Binding DialogName}" />
                    </StackPanel>

                    <TextBlock Style="{DynamicResource DialogMessageTextStyle}" Text="{Binding DialogMessage}" />
                    <TextBlock Style="{DynamicResource DialogErrorTextStyle}" Text="{Binding DialogError}" />

                    <StackPanel
                        Margin="0,20,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Command="{Binding DialogCancelCommand}"
                            Content="{Binding CancelText}"
                            Style="{DynamicResource ToolbarOutlinedButtonStyle}" />
                        <Button
                            Command="{Binding DialogConfirmCommand}"
                            Content="{Binding ConfirmText}"
                            Style="{DynamicResource DialogConfirmButtonStyle}"
                            Tag="{Binding IsDangerConfirm}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
