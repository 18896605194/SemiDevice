<UserControl
    x:Class="xyz.Client.Alarm.Views.AlarmHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="820"
    d:DesignWidth="1640"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource DarkWindowBackground}">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  查询条件：日期段（含首尾两天）、等级、关键字；今天 / 最近 7 天直接查  -->
            <Border Grid.Row="0" Style="{DynamicResource ToolbarBorderStyle}">
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Right"
                        Style="{DynamicResource StatusLabelTextStyle}"
                        Text="{Binding Summary}" />
                    <WrapPanel Orientation="Horizontal">
                        <DatePicker
                            Width="170"
                            Margin="0,4,12,4"
                            materialDesign:HintAssist.Hint="{DynamicResource common.start_date}"
                            SelectedDate="{Binding StartDate}"
                            Style="{DynamicResource DefaultDatePickerStyle}" />
                        <DatePicker
                            Width="170"
                            Margin="0,4,12,4"
                            materialDesign:HintAssist.Hint="{DynamicResource common.end_date}"
                            SelectedDate="{Binding EndDate}"
                            Style="{DynamicResource DefaultDatePickerStyle}" />
                        <ComboBox
                            Width="140"
                            Margin="0,4,12,4"
                            materialDesign:HintAssist.Hint="{DynamicResource alarmview.level}"
                            ItemsSource="{Binding Levels}"
                            SelectedItem="{Binding SelectedLevel}"
                            Style="{DynamicResource DefaultComboBoxStyle}" />
                        <TextBox
                            Width="280"
                            Margin="0,4,12,4"
                            materialDesign:HintAssist.Hint="{DynamicResource alarmview.keyword_hint}"
                            Style="{DynamicResource DefaultTextBoxStyle}"
                            Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Command="{Binding QueryCommand}"
                            Content="{DynamicResource common.query}"
                            Style="{DynamicResource DefaultButtonStyle}" />
                        <Button
                            Command="{Binding TodayCommand}"
                            Content="{DynamicResource common.today}"
                            Style="{DynamicResource DefaultButtonStyle}" />
                        <Button
                            Command="{Binding LastWeekCommand}"
                            Content="{DynamicResource common.last_7_days}"
                            Style="{DynamicResource DefaultButtonStyle}" />
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!--  查询结果：报出、清除各一行，最新的在最上面；清除那行带着报了多久  -->
            <materialDesign:Card
                Grid.Row="1"
                Margin="0,8,0,0"
                Style="{DynamicResource DefaultCardStyle}">
                <DataGrid ItemsSource="{Binding Records}" Style="{DynamicResource CompactDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding OccurredAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                            ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                            Header="{DynamicResource common.time}" />
                        <DataGridTextColumn
                            Width="90"
                            Binding="{Binding ActionText}"
                            ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                            Header="{DynamicResource alarmview.action}" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding Level}"
                            ElementStyle="{DynamicResource AlarmLevelDataGridTextStyle}"
                            Header="{DynamicResource alarmview.level}" />
                        <DataGridTextColumn
                            Width="160"
                            Binding="{Binding Source}"
                            ElementStyle="{DynamicResource EllipsisDataGridTextStyle}"
                            Header="{DynamicResource alarmview.source}" />
                        <DataGridTextColumn
                            Width="220"
                            Binding="{Binding Code}"
                            ElementStyle="{DynamicResource EllipsisDataGridTextStyle}"
                            Header="{DynamicResource alarmview.code}" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Text}"
                            ElementStyle="{DynamicResource EllipsisDataGridTextStyle}"
                            Header="{DynamicResource alarmview.text}" />
                        <DataGridTextColumn
                            Width="180"
                            Binding="{Binding Category}"
                            ElementStyle="{DynamicResource EllipsisDataGridTextStyle}"
                            Header="{DynamicResource alarmview.category}" />
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding RaisedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                            ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                            Header="{DynamicResource alarmview.raised_at}" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding DurationText}"
                            ElementStyle="{DynamicResource DefaultDataGridTextStyle}"
                            Header="{DynamicResource alarmview.duration}" />
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
