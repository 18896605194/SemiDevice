<?xml version="1.0" encoding="utf-8"?>
<!--
  后端日志：主日志 xyz-日期.log（运行、操作、动作指令收发原文）、轮询文件 poll-日期.log（状态轮询的一问一答），一天一个、超 100MB 拆。
  异步写：调用线程只放进队列就返回，设备线程不碰磁盘；队列满了丢弃新来的，不让设备线程等日志。
  保留天数不在这里配：日志元件开机时按 machine.xml 的 KeepDays 设（所以 autoReload 关着，热加载会把它冲掉）。
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="false"
      throwExceptions="false"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/Log/internal-nlog.txt">

  <targets async="true">
    <target xsi:type="File"
            name="file"
            fileName="${basedir}/Log/xyz-${shortdate}.log"
            layout="${message}"
            encoding="utf-8"
            archiveAboveSize="104857600" />

    <target xsi:type="File"
            name="loop"
            fileName="${basedir}/Log/poll-${shortdate}.log"
            layout="${message}"
            encoding="utf-8"
            archiveAboveSize="104857600" />
  </targets>

  <rules>
    <logger name="Loop" minlevel="Debug" writeTo="loop" final="true" />
    <logger name="*" minlevel="Debug" writeTo="file" />
  </rules>
</nlog>
