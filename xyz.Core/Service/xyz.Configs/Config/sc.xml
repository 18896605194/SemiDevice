		<!-- PJ 命令名称按 EAP 约定配置；默认名称（含 STARTPROCESS）保留兜底，名称不能重复或占用其他命令的默认名称 -->
		<Setting Name="E40" Type="xyz.Components.Components.E40Component">
			<Value Name="StartCommandName" Value="START" />
			<Value Name="PauseCommandName" Value="PAUSE" />
			<Value Name="ResumeCommandName" Value="RESUME" />
			<Value Name="StopCommandName" Value="STOP" />
			<Value Name="AbortCommandName" Value="ABORT" />
			<Value Name="CancelCommandName" Value="CANCEL" />
		</Setting>
