<?xml version="1.0" encoding="utf-8"?>
<ArrayOfSetting>
	<!-- 系统设置：界面语言（zh-CN 简体中文 / en-US 英文），客户端启动时按它显示，改了重启客户端生效 -->
	<Setting Name="System" Type="xyz.Components.Components.SystemComponent">
		<Value Name="Language" Value="zh-CN" />
	</Setting>
	<!-- 对前端壳的 gRPC 服务端点：客户端壳连这个地址，默认 localhost:5000。
	     端口规划注意：HSMS（EAP 链路）惯例端口也是 5000，接 EAP 时把其中一边挪开；
	     改这里要同步改客户端 exe 旁的 client.json（GrpcAddress），没配 client.json 时客户端按 localhost:5000 连 -->
	<Setting Name="Rpc" Type="xyz.Components.Components.RpcComponent">
		<Value Name="Host" Value="localhost" />
		<Value Name="Port" Value="5000" />
	</Setting>
	<!-- EC：全系统一本在线可调参数（ec.xml，跟 sc.xml 同目录），各组件的 EC 属性经它读写。
	     ec.xml 不用手建：后端启动时照本文件的组件层级自动生成，层级、先后都跟这里一样；已经有了就只补新的，改过的值不动。
	     界面上在 设置 → EC 设置 里改，改完立即生效。
	     放最前面：后面的组件装配时就能读到 ec.xml 里的值 -->
	<Setting Name="EC" Type="xyz.Components.Components.EcComponent" />
	<!-- 数据库连接：只分两个。业务数据（含晶圆流水）走 Default；
	     Io 单独一个，专门装设备采上来的点位数据——那是唯一一路秒级不停写的，跟业务分开免得互相拖慢 -->
	<Setting Name="Database">
		<Setting Name="Default" Type="xyz.Components.Components.DataBaseComponent">
			<Value Name="ConnectionString" Value="DataSource=xyz.db" />
			<Value Name="DbType" Value="Sqlite" />
		</Setting>
		<Setting Name="Io" Type="xyz.Components.Components.DataBaseComponent">
			<Value Name="ConnectionString" Value="DataSource=io.db" />
			<Value Name="DbType" Value="Sqlite" />
		</Setting>
	</Setting>
	<!-- 报警：全系统一本。组件经基类 RaiseAlarm/CheckAlarm 自己报，只能人工 Reset 清；报出、清除都入库 -->
	<Setting Name="Alarm" Type="xyz.Components.Components.AlarmComponent">
		<Value Name="EnableHistory" Value="True" />
		<Value Name="HistoryDatabase" Value="Default" />
		<Value Name="HistoryKeepDays" Value="90" />
		<Value Name="HistoryQueryMaxCount" Value="1000" />
	</Setting>
	<!-- 日志：历史页一次最多返回多少条、后端保留最近多少条（客户端连上时补拉）、实时日志页和顶部日志栏最多显示多少条 -->
	<Setting Name="Log" Type="xyz.Components.Components.LogComponent">
		<Value Name="HistoryQueryMaxCount" Value="1000" />
		<Value Name="RecentLogCount" Value="200" />
		<Value Name="RealtimeDisplayMaxCount" Value="2000" />
		<Value Name="LogBarDisplayMaxCount" Value="500" />
	</Setting>
	<!-- 晶圆账：全系统一本，事件驱动不参与扫描。IsPersistent：当前账存盘，开机放回腔体、机械手上的片（LoadPort 以开机 Mapping 为准） -->
	<Setting Name="WaferManager" Type="xyz.Components.Components.WaferManagerComponent">
		<Value Name="IsEnable" Value="True" />
		<Value Name="EnableHistory" Value="True" />
		<Value Name="IsPersistent" Value="True" />
		<Value Name="HistoryDatabase" Value="Default" />
		<Value Name="HistoryKeepDays" Value="90" />
	</Setting>
	<!-- PLC：全机 IO 底座——气缸的 DI/DO 点、轴的数据块都从它读写，每拍整块读回缓存。
	     排在模块前面：模块装配时要向它登记自己的数据块。
	     Host 留空 = 装机没接 PLC，组件空转不报警；Host 填 Local = 连本机的倍福运行时或仿真器（D:\仿真 统一仿真器，Start-35021.cmd）。
	     本机要有 ADS 路由才连得上：真机由 TwinCAT 提供；开发机没装 TwinCAT 就装 tools\AdsRouter 服务（开机自启）。
	     没有路由时填 Local，每次连接会卡 6 秒多再失败 -->
	<Setting Name="Plc" Type="xyz.Components.Components.BeckhoffPlcComponent">
		<Value Name="Brand" Value="Beckhoff" />
		<Value Name="Host" Value="Local" />
		<Value Name="Port" Value="851" />
		<!-- 四个块在 PLC 里的变量名：倍福用全局别名那一套（GVL 全名写法是 IO_CSharp.DigIn，两种读写同一份过程映像） -->
		<Value Name="DiDataPath" Value=".DigIn" />
		<Value Name="DoDataPath" Value=".DigOut" />
		<Value Name="AiDataPath" Value=".AnaIn" />
		<Value Name="AoDataPath" Value=".AnaOut" />
		<Value Name="IoPointCount" Value="1000" />
	</Setting>
	<!-- IO 表：全机点位的唯一出口。点表（DI/DO/AI/AO.csv）是机型的东西，源文件在 xyz.35021\Service\xyz.35021.Module\Config\IO，
	     编译时由机型项目部署到宿主输出目录里本文件同目录的 IO\ 下；仿真器 Machines\35021\IO 里是同一份，改了两边一起改。Module 列就是模块名（LoadPort1、Chamber1……），IO 界面按它分页；
	     点位分段：Safety（整机安全信号）DI 从 0 起、AI 从 0 起；LoadPort1/2 从 32/48 起（E84 + 光幕），Robot1 从 64 起，
	     Chamber1~4 的 DI/DO 从 100/140/180/220 起、每段 40 点，AI 从 100/120/140/160 起、每段 20 点；同一部件的 DO 与 DI 偏移对齐。
	     每拍从 PLC 缓存刷一遍；上层按索引取点，界面订阅后端推来的整包 -->
	<Setting Name="Io" Type="xyz.Components.Components.IoComponent">
		<Value Name="PointTableDirectory" Value="IO" />
	</Setting>
	<!-- 安全：整机的安全信号（急停、维修门、漏液、烟感、厂务气源/排风……），不归哪个模块管，一个信号一个子节点。
	     DI 用 DiSensorComponent：DiIndex 点号，TriggerLevel 触发电平（true = 高电平触发，false = 低电平触发），AlarmEnabled 是否报警；
	     AI 用 AiSensorComponent：AiIndex 点号，上下限、预警带、防抖在 ec.xml（都为 0 = 没标定不判）。
	     开机后自己一条扫描线程监控。点位在点表的 Safety 段。
	     绑在这儿的点才进数据曲线（库里记、勾选树里有）；IO 页里 Safety 单独一页。
	     报警先都关着（AlarmEnabled=False）：要报哪个，把它的 AlarmEnabled 改成 True -->
	<Setting Name="Safety" Type="xyz.Components.Components.SafetyComponent">
		<!-- 急停回路：1 = 正常，按下急停为 0 -->
		<Setting Name="Emo" Type="xyz.Components.Components.DiSensorComponent">
			<Value Name="DiIndex" Value="0" />
			<Value Name="TriggerLevel" Value="false" />
			<Value Name="AlarmEnabled" Value="False" />
		</Setting>
		<!-- 维修门：1 = 关好，门开为 0 -->
		<Setting Name="FrontDoor" Type="xyz.Components.Components.DiSensorComponent">
			<Value Name="DiIndex" Value="1" />
			<Value Name="TriggerLevel" Value="false" />
			<Value Name="AlarmEnabled" Value="False" />
		</Setting>
		<Setting Name="RearDoor" Type="xyz.Components.Components.DiSensorComponent">
			<Value Name="DiIndex" Value="2" />
			<Value Name="TriggerLevel" Value="false" />
			<Value Name="AlarmEnabled" Value="False" />
		</Setting>
		<Setting Name="LeftDoor" Type="xyz.Components.Components.DiSensorComponent">
			<Value Name="DiIndex" Value="3" />
			<Value Name="TriggerLevel" Value="false" />
			<Value Name="AlarmEnabled" Value="False" />
		</Setting>
		<Setting Name="RightDoor" Type="xyz.Components.Components.DiSensorComponent">
			<Value Name="DiIndex" Value="4" />
			<Value Name="TriggerLevel" Value="false" />
			<Value Name="AlarmEnabled" Value="False" />
		</Setting>
		<!-- 漏液、烟感：1 = 有漏液 / 有烟 -->
		<Setting Name="LeakTray" Type="xyz.Components.Components.DiSensorComponent">
			<Value Name="DiIndex" Value="5" />
			<Value Name="TriggerLevel" Value="true" />
			<Value Name="AlarmEnabled" Value="False" />
		</Setting>
		<Setting Name="LeakCabinet" Type="xyz.Components.Components.DiSensorComponent">
			<Value Name="DiIndex" Value="6" />
			<Value Name="TriggerLevel" Value="true" />
			<Value Name="AlarmEnabled" Value="False" />
		</Setting>
		<Setting Name="Smoke" Type="xyz.Components.Components.DiSensorComponent">
			<Value Name="DiIndex" Value="7" />
			<Value Name="TriggerLevel" Value="true" />
			<Value Name="AlarmEnabled" Value="False" />
		</Setting>
		<!-- 厂务开关量：1 = 正常 -->
		<Setting Name="CdaOk" Type="xyz.Components.Components.DiSensorComponent">
			<Value Name="DiIndex" Value="8" />
			<Value Name="TriggerLevel" Value="false" />
			<Value Name="AlarmEnabled" Value="False" />
		</Setting>
		<Setting Name="ExhaustOk" Type="xyz.Components.Components.DiSensorComponent">
			<Value Name="DiIndex" Value="9" />
			<Value Name="TriggerLevel" Value="false" />
			<Value Name="AlarmEnabled" Value="False" />
		</Setting>
		<!-- 整机模拟量：气源压力、厂务排风压力、真空压力、电控柜温度 -->
		<Setting Name="CdaPressure" Type="xyz.Components.Components.AiSensorComponent">
			<Value Name="AiIndex" Value="0" />
			<Value Name="AlarmEnabled" Value="False" />
		</Setting>
		<Setting Name="ExhaustPressure" Type="xyz.Components.Components.AiSensorComponent">
			<Value Name="AiIndex" Value="1" />
			<Value Name="AlarmEnabled" Value="False" />
		</Setting>
		<Setting Name="VacuumPressure" Type="xyz.Components.Components.AiSensorComponent">
			<Value Name="AiIndex" Value="2" />
			<Value Name="AlarmEnabled" Value="False" />
		</Setting>
		<Setting Name="CabinetTemperature" Type="xyz.Components.Components.AiSensorComponent">
			<Value Name="AiIndex" Value="3" />
			<Value Name="AlarmEnabled" Value="False" />
		</Setting>
	</Setting>
	<!-- 数据曲线：每个采样周期采一整行，值没变也记，读不到的存空不存 0。
	     只记本文件里配置了的：组件上能画成曲线的 SV，加上组件绑的 IO（DiXxxIndex / DoXxxIndex / AiXxxIndex / AoXxxIndex 这类配置项，-1 不算）。
	     点表里有、但没绑到组件上的点不记——想看哪个点，就把它绑到组件上（整机信号绑在上面的 Safety 里），重启后开始记。
	     入 Io 库，按天一张宽表 DataRecord_yyyyMMdd：Time（UTC 毫秒）+ 每个信号一列，列名全部由本文件生成、跟这里的层级一一对应：
	     SV = 组件全路径.属性名；IO = 组件全路径.配置项名去掉 Index（Chamber1.Door.DiOpened、Safety.LeakTray.Di）。开关量存 1/0。
	     数据曲线、实时曲线页的勾选树列的就是这些，所以看得到的一定查得到。
	     Exclude 写不记的信号，逗号分隔，可写上级路径整枝去掉（如 LoadPort1.E84）；
	     入库批量、积压告警是 EC（RecordBatchSeconds / RecordBacklogWarning），在 ec.xml -->
	<Setting Name="DataChart" Type="xyz.Components.Components.DataChartComponent">
		<Value Name="EnableRecord" Value="True" />
		<Value Name="Database" Value="Io" />
		<Value Name="KeepDays" Value="30" />
		<Value Name="SampleIntervalMs" Value="1000" />
		<Value Name="Exclude" Value="" />
		<Value Name="QueryMaxPoints" Value="4000" />
		<Value Name="QueryMaxSignals" Value="20" />
	</Setting>
	<!-- 实时曲线：专管推送，自己不采样——订阅数据曲线的每一行推给实时曲线页，内存里留最近 WindowSeconds 秒，
	     页面打开、新勾曲线时先补这一段 -->
	<Setting Name="RealChart" Type="xyz.Components.Components.RealChartComponent">
		<Value Name="WindowSeconds" Value="600" />
	</Setting>
	<Setting Name="LoadPort">
		<Setting Name="LoadPort1" Type="xyz._35021.Module.Loadport.LoadPortModule">
			<Value Name="SlotCount" Value="25" />
			<!-- 品牌驱动组件：换 Type 即换品牌（FcdLoadPortComponent / 其他品牌壳），机型代码不动 -->
			<Setting Name="Driver" Type="xyz.Components.Components.FcdLoadPortComponent">
				<Value Name="CommType" Value="Serial" />
				<Value Name="PortName" Value="COM2" />
				<Value Name="BaudRate" Value="9600" />
				<Value Name="Parity" Value="None" />
				<Value Name="DataBits" Value="8" />
				<Value Name="StopBits" Value="One" />
				<Value Name="Host" Value="192.168.1.100" />
				<Value Name="NetPort" Value="4004" />
			</Setting>
			<!-- RFID 读头：品牌壳，换 Type 即换品牌 -->
			<Setting Name="RFID" Type="xyz.Components.Components.FcdRfidComponent">
				<Value Name="CommType" Value="Serial" />
				<Value Name="PortName" Value="COM6" />
				<Value Name="BaudRate" Value="9600" />
				<Value Name="Parity" Value="None" />
				<Value Name="DataBits" Value="8" />
				<Value Name="StopBits" Value="One" />
				<Value Name="IdStart" Value="0" />
				<Value Name="IdLength" Value="16" />
			</Setting>
			<!-- 载具（FOUP）：端口上这一盒的到达、读码、Host 核对进度、槽图和取放状态，向 E87 上报；每个 LoadPort 必须有一个，
			     写在 RFID 后面（同一拍里读头先出读码结果，载具紧跟着取）。
			     PresenceSource：载具在位以什么为准（二选一）：Query = 状态查询（在位、到位两位都亮算放好，都灭算拿走，一亮一灭不算变化；开机已在端口上的盒子也认得）；
			     Event = 设备主动上报（PODON 放上 / PODOF 拿走）。AutoReadCarrierId：载具到位后自动读码（默认 True，False 只由上层 / EAP 显式触发） -->
			<Setting Name="Carrier" Type="xyz.Modules.CarrierComponent">
				<Value Name="PresenceSource" Value="Query" />
			</Setting>
			<!-- E84：搬运车 PIO 信号走 IO 板，每个 LoadPort 一组，点表里 Module=LoadPortN、Component=E84。
			     IsEnable：装没装（False = 本机没接搬运车，端口当没有 E84，不打开、不扫、不读写 IO；真机装了改 True，重启生效）；
			     装了以后跟不跟搬运车交接走 EC E84Enabled（默认关，在线改） -->
			<Setting Name="E84" Type="xyz.Modules.E84Component">
				<Value Name="IsEnable" Value="False" />
				<Value Name="DiValidIndex" Value="34" />
				<Value Name="DiCs0Index" Value="32" />
				<Value Name="DiCs1Index" Value="33" />
				<Value Name="DiAmAvblIndex" Value="35" />
				<Value Name="DiTrReqIndex" Value="36" />
				<Value Name="DiBusyIndex" Value="37" />
				<Value Name="DiComptIndex" Value="38" />
				<Value Name="DiContIndex" Value="39" />
				<Value Name="DiLightCurtainIndex" Value="40" />
				<Value Name="LightCurtainReverse" Value="False" />
				<Value Name="DoLReqIndex" Value="32" />
				<Value Name="DoUReqIndex" Value="33" />
				<Value Name="DoReadyIndex" Value="34" />
				<Value Name="DoHoAvblIndex" Value="35" />
				<Value Name="DoEsIndex" Value="36" />
			</Setting>
		</Setting>
		<Setting Name="LoadPort2" Type="xyz._35021.Module.Loadport.LoadPortModule">
			<Value Name="SlotCount" Value="25" />
			<!-- 品牌驱动组件：换 Type 即换品牌（FcdLoadPortComponent / 其他品牌壳），机型代码不动 -->
			<Setting Name="Driver" Type="xyz.Components.Components.FcdLoadPortComponent">
				<Value Name="CommType" Value="Serial" />
				<Value Name="PortName" Value="COM4" />
				<Value Name="BaudRate" Value="9600" />
				<Value Name="Parity" Value="None" />
				<Value Name="DataBits" Value="8" />
				<Value Name="StopBits" Value="One" />
				<Value Name="Host" Value="192.168.1.101" />
				<Value Name="NetPort" Value="4004" />
			</Setting>
			<!-- RFID 读头：品牌壳，换 Type 即换品牌 -->
			<Setting Name="RFID" Type="xyz.Components.Components.FcdRfidComponent">
				<Value Name="CommType" Value="Serial" />
				<Value Name="PortName" Value="COM8" />
				<Value Name="BaudRate" Value="9600" />
				<Value Name="Parity" Value="None" />
				<Value Name="DataBits" Value="8" />
				<Value Name="StopBits" Value="One" />
				<Value Name="IdStart" Value="0" />
				<Value Name="IdLength" Value="16" />
			</Setting>
			<!-- 载具（FOUP）：同 LoadPort1 -->
			<Setting Name="Carrier" Type="xyz.Modules.CarrierComponent">
				<Value Name="PresenceSource" Value="Query" />
			</Setting>
			<!-- E84：搬运车 PIO 信号走 IO 板，每个 LoadPort 一组，点表里 Module=LoadPortN、Component=E84。
			     IsEnable：装没装（False = 本机没接搬运车，端口当没有 E84，不打开、不扫、不读写 IO；真机装了改 True，重启生效）；
			     装了以后跟不跟搬运车交接走 EC E84Enabled（默认关，在线改） -->
			<Setting Name="E84" Type="xyz.Modules.E84Component">
				<Value Name="IsEnable" Value="False" />
				<Value Name="DiValidIndex" Value="50" />
				<Value Name="DiCs0Index" Value="48" />
				<Value Name="DiCs1Index" Value="49" />
				<Value Name="DiAmAvblIndex" Value="51" />
				<Value Name="DiTrReqIndex" Value="52" />
				<Value Name="DiBusyIndex" Value="53" />
				<Value Name="DiComptIndex" Value="54" />
				<Value Name="DiContIndex" Value="55" />
				<Value Name="DiLightCurtainIndex" Value="56" />
				<Value Name="LightCurtainReverse" Value="False" />
				<Value Name="DoLReqIndex" Value="48" />
				<Value Name="DoUReqIndex" Value="49" />
				<Value Name="DoReadyIndex" Value="50" />
				<Value Name="DoHoAvblIndex" Value="51" />
				<Value Name="DoEsIndex" Value="52" />
			</Setting>
		</Setting>
	</Setting>
	<Setting Name="Robot">
		<Setting Type="xyz._35021.Module.Robot.RobotModule" Name="Robot1">
			<!-- 品牌驱动组件：换 Type 即换品牌（RejeRobotComponent / 其他品牌壳），机型代码不动。
			     Axes 轴表决定手指数（Arm* 个数）：2 指机型 Arm1,Arm2，4 指再加 Arm3,Arm4 -->
			<Setting Name="Driver" Type="xyz.Components.Components.RejeRobotComponent">
				<Value Name="Host" Value="127.0.0.1" />
				<Value Name="NetPort" Value="9000" />
				<Value Name="Axes" Value="X,Z,Theta,Arm1,Arm2" />
			</Setting>
			<!-- 站点表：每个站点一个子节点（LoadPort / 腔体各编站点号）。
			     Number 设备站点号（正整数）；Y 机械手伸出距离（数值）；Direction 伸出方向（RobotDirection 枚举：North/East/South/West）；
			     Arms 这个站点允许用哪几只手取放（手指号，逗号分隔，如 1,2；不配 = 所有手指都能用）——手动页选了站点，手臂下拉只列这几只，别的手发过来一律拒 -->
			<Setting Name="Stations">
				<Setting Name="LoadPort1">
					<Value Name="Number" Value="1" />
					<Value Name="Y" Value="20" />
					<Value Name="Direction" Value="South" />
					<Value Name="Arms" Value="1,2" />
				</Setting>
				<Setting Name="LoadPort2">
					<Value Name="Number" Value="2" />
					<Value Name="Y" Value="0" />
					<Value Name="Direction" Value="South" />
					<Value Name="Arms" Value="1,2" />
				</Setting>
				<Setting Name="Chamber1">
					<Value Name="Number" Value="3" />
					<Value Name="Y" Value="0" />
					<Value Name="Direction" Value="North" />
					<Value Name="Arms" Value="1,2" />
				</Setting>
				<Setting Name="Chamber2">
					<Value Name="Number" Value="4" />
					<Value Name="Y" Value="0" />
					<Value Name="Direction" Value="North" />
					<Value Name="Arms" Value="1,2" />
				</Setting>
				<Setting Name="Chamber3">
					<Value Name="Number" Value="5" />
					<Value Name="Y" Value="0" />
					<Value Name="Direction" Value="North" />
					<Value Name="Arms" Value="1,2" />
				</Setting>
				<Setting Name="Chamber4">
					<Value Name="Number" Value="6" />
					<Value Name="Y" Value="0" />
					<Value Name="Direction" Value="North" />
					<Value Name="Arms" Value="1,2" />
				</Setting>
			</Setting>
		</Setting>
	</Setting>
	<!-- 搬运：全系统唯一一个"把片从 A 搬到 B"的执行口。手动传片和自动任务启动的是同一种搬运操作，
	     都完整走站点交互环（准备→取放→收尾）；设备点动不走这儿。
	     模块表在装配全部完成后统一绑，跟本节点在 sc.xml 里的位置无关 -->
	<Setting Name="Transfer" Type="xyz.Modules.TransferManager">
		<Value Name="IsEnable" Value="True" />
	</Setting>
	<!-- 流程配方库（配方 → 流程配方页）：编号 1~Capacity，一个编号一个文件（Folder 下 001.xml、002.xml……），Folder 相对宿主运行目录。
	     可选站点不在这儿配：按本文件的分组节点（LoadPort、Chamber……）和下面装的模块生成，只留机械手 Stations 里有的；
	     模块全起来后统一绑，跟本节点在 sc.xml 里的位置无关 -->
	<Setting Name="Sequence" Type="xyz.Modules.SequenceComponent">
