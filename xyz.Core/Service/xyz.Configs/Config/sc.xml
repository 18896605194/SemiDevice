		<Setting Name="E94" Type="xyz.Components.Components.E94Component">
			<Value Name="StartCommandName" Value="CJSTART" />
			<Value Name="PauseCommandName" Value="CJPAUSE" />
			<Value Name="ResumeCommandName" Value="CJRESUME" />
			<Value Name="CancelCommandName" Value="CJCANCEL" />
			<Value Name="DeselectCommandName" Value="CJDESELECT" />
			<Value Name="StopCommandName" Value="CJSTOP" />
			<Value Name="AbortCommandName" Value="CJABORT" />
			<Value Name="HeadOfQueueCommandName" Value="CJHOQ" />
		</Setting>
	</Setting>
