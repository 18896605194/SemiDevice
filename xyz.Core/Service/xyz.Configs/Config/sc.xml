<?xml version="1.0" encoding="utf-8"?>
<ArrayOfSetting>
	<!-- 系统设置：界面语言（zh-CN 简体中文 / en-US 英文），客户端启动时按它显示，改了重启客户端生效 -->
	<Setting Name="System" Type="xyz.Components.Components.SystemComponent">
		<Value Name="Language" Value="zh-CN" />
	</Setting>
	<!-- EC：全系统一本在线可调参数（ec.xml，跟 sc.xml 同目录），各组件的 EC 属性经它读写。
	     放最前面：后面的组件装配时就能读到 ec.xml 里的值 -->
	<Setting Name="EC" Type="xyz.Components.Components.EcComponent" />
	<!-- 数据库连接：只分两个。业务数据（含晶圆流水）走 Default；
	     Io 单独一个，专门装设备采上来的点位数据——那是唯一一路秒级不停写的，跟业务分开免得互相拖慢 -->
	<Setting Name="Database">
		<Setting Name="Default" Type="xyz.Components.Components.DataBaseComponent">
			<Value Name="ConnectionString" Value="DataSource=xyz.db" />
			<Value Name="DbType" Value="Sqlite" />
		</Setting>
		<Setting Name="Io" Type="xyz.Components.Components.DataBaseComponent">
			<Value Name="ConnectionString" Value="DataSource=io.db" />
			<Value Name="DbType" Value="Sqlite" />
		</Setting>
	</Setting>
	<!-- 报警：全系统一本。组件经基类 RaiseAlarm/CheckAlarm 自己报，只能人工 Reset 清；报出、清除都入库 -->
	<Setting Name="Alarm" Type="xyz.Components.Components.AlarmComponent">
		<Value Name="EnableHistory" Value="True" />
		<Value Name="HistoryDatabase" Value="Default" />
		<Value Name="HistoryKeepDays" Value="90" />
		<Value Name="HistoryQueryMaxCount" Value="1000" />
	</Setting>
	<!-- 日志：历史页一次最多返回多少条、后端保留最近多少条（客户端连上时补拉）、实时日志页和顶部日志栏最多显示多少条 -->
	<Setting Name="Log" Type="xyz.Components.Components.LogComponent">
		<Value Name="HistoryQueryMaxCount" Value="1000" />
		<Value Name="RecentLogCount" Value="200" />
		<Value Name="RealtimeDisplayMaxCount" Value="2000" />
		<Value Name="LogBarDisplayMaxCount" Value="500" />
	</Setting>
	<!-- 晶圆账：全系统一本，事件驱动不参与扫描 -->
	<Setting Name="WaferManager" Type="xyz.Components.Components.WaferManager">
		<Value Name="IsEnable" Value="True" />
		<Value Name="EnableHistory" Value="True" />
		<Value Name="HistoryDatabase" Value="Default" />
		<Value Name="HistoryKeepDays" Value="90" />
	</Setting>
	<!-- PLC：全机 IO 底座——气缸的 DI/DO 点、轴的数据块都从它读写，每拍整块读回缓存。
	     排在模块前面：模块装配时要向它登记自己的数据块。
	     Host 留空 = 装机没接 PLC，组件空转不报警；接了 PLC 时 Type 换成品牌子类 -->
	<Setting Name="Plc" Type="xyz.Components.Components.PlcComponent">
		<Value Name="Brand" Value="" />
		<Value Name="Host" Value="" />
		<Value Name="Port" Value="851" />
		<!-- 四个块在 PLC 里的变量名：倍福用全局别名那一套（GVL 全名写法是 IO_CSharp.DigIn，两种读写同一份过程映像） -->
		<Value Name="DiDataPath" Value=".DigIn" />
		<Value Name="DoDataPath" Value=".DigOut" />
		<Value Name="AiDataPath" Value=".AnaIn" />
		<Value Name="AoDataPath" Value=".AnaOut" />
		<Value Name="IoPointCount" Value="1000" />
	</Setting>
	<!-- IO 表：全机点位的唯一出口。点表（DI/DO/AI/AO.csv，跟仿真器共用同一份）放在本文件同目录的 IO\ 下，
	     每拍从 PLC 缓存刷一遍；上层按索引取点，界面订阅后端推来的整包 -->
	<Setting Name="Io" Type="xyz.Components.Components.IoComponent">
		<Value Name="PointTableDirectory" Value="IO" />
	</Setting>
	<Setting Name="LoadPort">
		<Setting Name="LoadPort1" Type="xyz._35021.Module.Loadport.LoadPortModule">
			<Value Name="Brand" Value="" />
			<Value Name="CommType" Value="Serial" />
			<Value Name="SlotCount" Value="25" />
			<Value Name="PortName" Value="COM2" />
			<Value Name="BaudRate" Value="9600" />
			<Value Name="Parity" Value="None" />
			<Value Name="DataBits" Value="8" />
			<Value Name="StopBits" Value="One" />
			<Value Name="Host" Value="192.168.1.100" />
			<Value Name="NetPort" Value="4004" />
			<Setting Name="RFID" Type="xyz._35021.Module.Rfid.RfidReaderComponent">
				<Value Name="Brand" Value="FCD" />
				<Value Name="CommType" Value="Serial" />
				<Value Name="PortName" Value="COM6" />
				<Value Name="BaudRate" Value="9600" />
				<Value Name="Parity" Value="None" />
				<Value Name="DataBits" Value="8" />
				<Value Name="StopBits" Value="One" />
				<Value Name="IdStart" Value="0" />
				<Value Name="IdLength" Value="16" />
			</Setting>
			<!-- E84：搬运车 PIO 信号走 IO 板。IO 读写还没接，DI/DO 索引先填 -1，接线后按实际改；是否启用走 EC E84Enabled（默认关） -->
			<Setting Name="E84" Type="xyz.Modules.E84Component">
				<Value Name="DiValidIndex" Value="-1" />
				<Value Name="DiCs0Index" Value="-1" />
				<Value Name="DiCs1Index" Value="-1" />
				<Value Name="DiAmAvblIndex" Value="-1" />
				<Value Name="DiTrReqIndex" Value="-1" />
				<Value Name="DiBusyIndex" Value="-1" />
				<Value Name="DiComptIndex" Value="-1" />
				<Value Name="DiContIndex" Value="-1" />
				<Value Name="DiLightCurtainIndex" Value="-1" />
				<Value Name="LightCurtainReverse" Value="False" />
				<Value Name="DoLReqIndex" Value="-1" />
				<Value Name="DoUReqIndex" Value="-1" />
				<Value Name="DoReadyIndex" Value="-1" />
				<Value Name="DoHoAvblIndex" Value="-1" />
				<Value Name="DoEsIndex" Value="-1" />
			</Setting>
		</Setting>
		<Setting Name="LoadPort2" Type="xyz._35021.Module.Loadport.LoadPortModule">
			<Value Name="Brand" Value="" />
			<Value Name="CommType" Value="Serial" />
			<Value Name="SlotCount" Value="25" />
			<Value Name="PortName" Value="COM4" />
			<Value Name="BaudRate" Value="9600" />
			<Value Name="Parity" Value="None" />
			<Value Name="DataBits" Value="8" />
			<Value Name="StopBits" Value="One" />
			<Value Name="Host" Value="192.168.1.101" />
			<Value Name="NetPort" Value="4004" />
			<Setting Name="RFID" Type="xyz._35021.Module.Rfid.RfidReaderComponent">
				<Value Name="Brand" Value="FCD" />
				<Value Name="CommType" Value="Serial" />
				<Value Name="PortName" Value="COM8" />
				<Value Name="BaudRate" Value="9600" />
				<Value Name="Parity" Value="None" />
				<Value Name="DataBits" Value="8" />
				<Value Name="StopBits" Value="One" />
				<Value Name="IdStart" Value="0" />
				<Value Name="IdLength" Value="16" />
			</Setting>
			<!-- E84：搬运车 PIO 信号走 IO 板。IO 读写还没接，DI/DO 索引先填 -1，接线后按实际改；是否启用走 EC E84Enabled（默认关） -->
			<Setting Name="E84" Type="xyz.Modules.E84Component">
				<Value Name="DiValidIndex" Value="-1" />
				<Value Name="DiCs0Index" Value="-1" />
				<Value Name="DiCs1Index" Value="-1" />
				<Value Name="DiAmAvblIndex" Value="-1" />
				<Value Name="DiTrReqIndex" Value="-1" />
				<Value Name="DiBusyIndex" Value="-1" />
				<Value Name="DiComptIndex" Value="-1" />
				<Value Name="DiContIndex" Value="-1" />
				<Value Name="DiLightCurtainIndex" Value="-1" />
				<Value Name="LightCurtainReverse" Value="False" />
				<Value Name="DoLReqIndex" Value="-1" />
				<Value Name="DoUReqIndex" Value="-1" />
				<Value Name="DoReadyIndex" Value="-1" />
				<Value Name="DoHoAvblIndex" Value="-1" />
				<Value Name="DoEsIndex" Value="-1" />
			</Setting>
		</Setting>
	</Setting>
	<Setting Name="Robot">
		<Setting Name="Robot1" Type="xyz._35021.Module.Robot.RobotModule">
			<Value Name="Brand" Value="Reje" />
			<Value Name="Host" Value="127.0.0.1" />
			<Value Name="NetPort" Value="9000" />
			<Value Name="ArmCount" Value="2" />
			<!-- 站点表：每个站点一个子节点。Number 设备站点号；Rotation 转台方位（North/East/South/West）；Travel 平移距离 -->
			<Setting Name="Stations">
				<Setting Name="LoadPort1">
					<Value Name="Number" Value="1" />
					<Value Name="Rotation" Value="South" />
					<Value Name="Travel" Value="20" />
				</Setting>
				<Setting Name="LoadPort2">
					<Value Name="Number" Value="2" />
					<Value Name="Rotation" Value="South" />
					<Value Name="Travel" Value="0" />
				</Setting>
				<Setting Name="Chamber1">
					<Value Name="Number" Value="3" />
					<Value Name="Rotation" Value="North" />
					<Value Name="Travel" Value="0" />
				</Setting>
				<Setting Name="Chamber2">
					<Value Name="Number" Value="4" />
					<Value Name="Rotation" Value="North" />
					<Value Name="Travel" Value="0" />
				</Setting>
			</Setting>
		</Setting>
	</Setting>
	<!-- 搬运：全系统唯一一个"把片从 A 搬到 B"的执行口。手动传片和自动派单下的是同一种搬运单，
	     都完整走站点交互环（准备→取放→收尾）；设备点动不走这儿。
	     模块表在装配全部完成后统一绑，跟本节点在 sc.xml 里的位置无关 -->
	<Setting Name="Transfer" Type="xyz.Modules.TransferManager">
		<Value Name="IsEnable" Value="True" />
	</Setting>
	<!-- 清洗腔：驱动还没接，四个动作在机型代码里按常量计时假装完成。
	     站点号/转台方位/平移距离不在这儿，在 Robot 的 Stations 里配。
	     子组件层级按物理装配走：升降气缸和喷嘴装在摆臂上，就挂摆臂节点下面——
	     配置上一眼看出哪路喷嘴在哪条臂，报警也按路径自动算到摆臂、再算到腔体。
	     控制上它们跟轴是平级的，谁也不调谁，协调在工艺配方里。
	     IO 索引全填 -1 = 接线未定；轴的速度/标定是 EC，在 ec.xml 里配，不在这儿。
	     Bowl 层数、摆臂条数、喷嘴路数按实际增减，下面只是骨架 -->
	<Setting Name="Chamber">
		<Setting Name="Chamber1" Type="xyz._35021.Module.Clean.ChamberModule">
			<Value Name="IsEnable" Value="True" />
			<Value Name="SlotCount" Value="1" />
			<!-- 腔体门：归站点交互环管（开门放行机械手、关门收尾），不归工艺 -->
			<Setting Name="Door" Type="xyz.Components.Components.CylinderComponent">
				<Value Name="DoOpenIndex" Value="-1" />
				<Value Name="DoCloseIndex" Value="-1" />
				<Value Name="DiOpenedIndex" Value="-1" />
				<Value Name="DiClosedIndex" Value="-1" />
			</Setting>
			<!-- Bowl 各层：每层一个气缸。本节点不带 Type，只是分组，运行时气缸直接挂在腔体下。
			     层位选哪几层是配方参数，不配在这儿 -->
			<Setting Name="Bowl">
				<Setting Name="Bowl1" Type="xyz.Components.Components.CylinderComponent">
					<Value Name="DoOpenIndex" Value="-1" />
					<Value Name="DoCloseIndex" Value="-1" />
					<Value Name="DiOpenedIndex" Value="-1" />
					<Value Name="DiClosedIndex" Value="-1" />
				</Setting>
				<Setting Name="Bowl2" Type="xyz.Components.Components.CylinderComponent">
					<Value Name="DoOpenIndex" Value="-1" />
					<Value Name="DoCloseIndex" Value="-1" />
					<Value Name="DiOpenedIndex" Value="-1" />
					<Value Name="DiClosedIndex" Value="-1" />
				</Setting>
				<Setting Name="Bowl3" Type="xyz.Components.Components.CylinderComponent">
					<Value Name="DoOpenIndex" Value="-1" />
					<Value Name="DoCloseIndex" Value="-1" />
					<Value Name="DiOpenedIndex" Value="-1" />
					<Value Name="DiClosedIndex" Value="-1" />
				</Setting>
			</Setting>
			<!-- 轴不按轴号绑硬件，按 PLC 数据块的数组名绑：SendPlcDataPath 下发、ReceivePlcDataPath 回读。
			     空 = 数据块还没定；速度/标定是 EC，在 ec.xml -->
			<Setting Name="SpinMotor" Type="xyz.Components.Components.SpinMotorComponent">
				<Value Name="SendPlcDataPath" Value="" />
				<Value Name="ReceivePlcDataPath" Value="" />
			</Setting>
			<!-- 摆臂：升降气缸与各路喷嘴都装在它上面 -->
			<Setting Name="Arm1" Type="xyz.Components.Components.ArmAxisComponent">
				<Value Name="SendPlcDataPath" Value="" />
				<Value Name="ReceivePlcDataPath" Value="" />
				<Setting Name="Lift" Type="xyz.Components.Components.CylinderComponent">
					<Value Name="DoOpenIndex" Value="-1" />
					<Value Name="DoCloseIndex" Value="-1" />
					<Value Name="DiOpenedIndex" Value="-1" />
					<Value Name="DiClosedIndex" Value="-1" />
				</Setting>
				<Setting Name="Nozzle_DIW" Type="xyz.Components.Components.NozzleComponent">
					<Value Name="DoIndex" Value="-1" />
					<Value Name="DiIndex" Value="-1" />
					<Value Name="Chemical" Value="DIW" />
				</Setting>
				<Setting Name="Nozzle_SC1" Type="xyz.Components.Components.NozzleComponent">
					<Value Name="DoIndex" Value="-1" />
					<Value Name="DiIndex" Value="-1" />
					<Value Name="Chemical" Value="SC1" />
				</Setting>
			</Setting>
			<!-- 片在位检测：只给状态不报警，有没有片以晶圆账为准 -->
			<Setting Name="WaferSensor" Type="xyz.Components.Components.DiSensorComponent">
				<Value Name="DiIndex" Value="-1" />
				<Value Name="AlarmEnabled" Value="False" />
			</Setting>
		</Setting>
		<Setting Name="Chamber2" Type="xyz._35021.Module.Clean.ChamberModule">
			<Value Name="IsEnable" Value="True" />
			<Value Name="SlotCount" Value="1" />
			<Setting Name="Door" Type="xyz.Components.Components.CylinderComponent">
				<Value Name="DoOpenIndex" Value="-1" />
				<Value Name="DoCloseIndex" Value="-1" />
				<Value Name="DiOpenedIndex" Value="-1" />
				<Value Name="DiClosedIndex" Value="-1" />
			</Setting>
			<Setting Name="Bowl">
				<Setting Name="Bowl1" Type="xyz.Components.Components.CylinderComponent">
					<Value Name="DoOpenIndex" Value="-1" />
					<Value Name="DoCloseIndex" Value="-1" />
					<Value Name="DiOpenedIndex" Value="-1" />
					<Value Name="DiClosedIndex" Value="-1" />
				</Setting>
				<Setting Name="Bowl2" Type="xyz.Components.Components.CylinderComponent">
					<Value Name="DoOpenIndex" Value="-1" />
					<Value Name="DoCloseIndex" Value="-1" />
					<Value Name="DiOpenedIndex" Value="-1" />
					<Value Name="DiClosedIndex" Value="-1" />
				</Setting>
				<Setting Name="Bowl3" Type="xyz.Components.Components.CylinderComponent">
					<Value Name="DoOpenIndex" Value="-1" />
					<Value Name="DoCloseIndex" Value="-1" />
					<Value Name="DiOpenedIndex" Value="-1" />
					<Value Name="DiClosedIndex" Value="-1" />
				</Setting>
			</Setting>
			<Setting Name="SpinMotor" Type="xyz.Components.Components.SpinMotorComponent">
				<Value Name="SendPlcDataPath" Value="" />
				<Value Name="ReceivePlcDataPath" Value="" />
			</Setting>
			<Setting Name="Arm1" Type="xyz.Components.Components.ArmAxisComponent">
				<Value Name="SendPlcDataPath" Value="" />
				<Value Name="ReceivePlcDataPath" Value="" />
				<Setting Name="Lift" Type="xyz.Components.Components.CylinderComponent">
					<Value Name="DoOpenIndex" Value="-1" />
					<Value Name="DoCloseIndex" Value="-1" />
					<Value Name="DiOpenedIndex" Value="-1" />
					<Value Name="DiClosedIndex" Value="-1" />
				</Setting>
				<Setting Name="Nozzle_DIW" Type="xyz.Components.Components.NozzleComponent">
					<Value Name="DoIndex" Value="-1" />
					<Value Name="DiIndex" Value="-1" />
					<Value Name="Chemical" Value="DIW" />
				</Setting>
				<Setting Name="Nozzle_SC1" Type="xyz.Components.Components.NozzleComponent">
					<Value Name="DoIndex" Value="-1" />
					<Value Name="DiIndex" Value="-1" />
					<Value Name="Chemical" Value="SC1" />
				</Setting>
			</Setting>
			<Setting Name="WaferSensor" Type="xyz.Components.Components.DiSensorComponent">
				<Value Name="DiIndex" Value="-1" />
				<Value Name="AlarmEnabled" Value="False" />
			</Setting>
		</Setting>
	</Setting>
    <Setting Name="CDS" />
    <Setting Name="Supply" />
</ArrayOfSetting>
