<?xml version="1.0" encoding="utf-8"?>
<ArrayOfSetting>
    <Setting Name="System" />
	<!-- 数据库连接：只分两个。业务数据（含晶圆流水）走 Default；
	     Io 单独一个，专门装设备采上来的点位数据——那是唯一一路秒级不停写的，跟业务分开免得互相拖慢 -->
	<Setting Name="Database">
		<Setting Name="Default" Type="xyz.Components.Components.DataBaseComponent">
			<Value Name="ConnectionString" Value="DataSource=xyz.db" />
			<Value Name="DbType" Value="Sqlite" />
		</Setting>
		<Setting Name="Io" Type="xyz.Components.Components.DataBaseComponent">
			<Value Name="ConnectionString" Value="DataSource=io.db" />
			<Value Name="DbType" Value="Sqlite" />
		</Setting>
	</Setting>
	<!-- 晶圆账：全系统一本，事件驱动不参与扫描 -->
	<Setting Name="WaferManager" Type="xyz.Components.Components.WaferManager">
		<Value Name="IsEnable" Value="True" />
		<Value Name="EnableHistory" Value="True" />
		<Value Name="HistoryDatabase" Value="Default" />
		<Value Name="HistoryKeepDays" Value="90" />
	</Setting>
	<Setting Name="LoadPort">
		<Setting Name="LoadPort1" Type="xyz._35021.Module.Loadport.LoadPortModule">
			<Value Name="Brand" Value="" />
			<Value Name="CommType" Value="Serial" />
			<Value Name="SlotCount" Value="25" />
			<Value Name="PortName" Value="COM2" />
			<Value Name="BaudRate" Value="9600" />
			<Value Name="Parity" Value="None" />
			<Value Name="DataBits" Value="8" />
			<Value Name="StopBits" Value="One" />
			<Value Name="Host" Value="192.168.1.100" />
			<Value Name="NetPort" Value="4004" />
			<Setting Name="RFID">
				<Value Name="Brand" Value="" />
				<Value Name="PortName" Value="COM6" />
				<Value Name="BaudRate" Value="9600" />
				<Value Name="Parity" Value="None" />
				<Value Name="DataBits" Value="8" />
				<Value Name="StopBits" Value="One" />
			</Setting>
		</Setting>
		<Setting Name="LoadPort2" Type="xyz._35021.Module.Loadport.LoadPortModule">
			<Value Name="Brand" Value="" />
			<Value Name="CommType" Value="Serial" />
			<Value Name="SlotCount" Value="25" />
			<Value Name="PortName" Value="COM4" />
			<Value Name="BaudRate" Value="9600" />
			<Value Name="Parity" Value="None" />
			<Value Name="DataBits" Value="8" />
			<Value Name="StopBits" Value="One" />
			<Value Name="Host" Value="192.168.1.101" />
			<Value Name="NetPort" Value="4004" />
			<Setting Name="RFID">
				<Value Name="Brand" Value="" />
				<Value Name="PortName" Value="COM8" />
				<Value Name="BaudRate" Value="9600" />
				<Value Name="Parity" Value="None" />
				<Value Name="DataBits" Value="8" />
				<Value Name="StopBits" Value="One" />
			</Setting>
		</Setting>
	</Setting>
	<Setting Name="Robot">
		<Setting Name="Robot1" Type="xyz._35021.Module.Robot.RobotModule">
			<Value Name="Brand" Value="Reje" />
			<Value Name="Host" Value="127.0.0.1" />
			<Value Name="NetPort" Value="9000" />
			<!-- 站点表：每个站点一个子节点。Number 设备站点号；Rotation 转台方位（North/East/South/West）；Travel 平移距离 -->
			<Setting Name="Stations">
				<Setting Name="LoadPort1">
					<Value Name="Number" Value="1" />
					<Value Name="Rotation" Value="South" />
					<Value Name="Travel" Value="20" />
				</Setting>
				<Setting Name="LoadPort2">
					<Value Name="Number" Value="2" />
					<Value Name="Rotation" Value="South" />
					<Value Name="Travel" Value="0" />
				</Setting>
				<Setting Name="Chamber1">
					<Value Name="Number" Value="3" />
					<Value Name="Rotation" Value="North" />
					<Value Name="Travel" Value="0" />
				</Setting>
				<Setting Name="Chamber2">
					<Value Name="Number" Value="4" />
					<Value Name="Rotation" Value="North" />
					<Value Name="Travel" Value="0" />
				</Setting>
			</Setting>
		</Setting>
	</Setting>
	<Setting Name="Chamber" />
    <Setting Name="CDS" />
    <Setting Name="Supply" />
</ArrayOfSetting>
