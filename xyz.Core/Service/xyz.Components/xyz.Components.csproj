<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\xyz.Configs\xyz.Configs.csproj" />
    <ProjectReference Include="..\xyz.Database\xyz.Database.csproj" />
    <!-- 品牌驱动组件（RobotDriverComponent/RejeRobotComponent）按薄壳模式关品牌指令；
         Drivers 保持纯协议不回引 Components，引用单向。 -->
    <ProjectReference Include="..\xyz.Drivers\xyz.Drivers.csproj" />
    <PackageReference Include="SqlSugarCore" Version="5.1.4.217" />
    <!-- TwinCAT.Ads 的传递依赖。DLL 走 Libs 本地引用，NuGet 不知道它依赖谁，所以这几个得自己列出来：
         漏了在 ASP.NET 宿主里看不出来（框架自带），换成普通控制台就 FileNotFoundException。
         版本也得跟 TwinCAT 编译时的 10.0 对齐，项目里别的包带的是 8.0，不顶上去运行时 MissingMethodException。 -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.3" />
    <PackageReference Include="System.ComponentModel.Composition" Version="10.0.3" />
    <PackageReference Include="System.Reactive" Version="6.1.0" />
  </ItemGroup>

  <!-- 倍福 ADS（7.0.172 net10.0）：DLL 放在仓库根的 Libs，不走 NuGet 源——
       现场机器没网也能编译，版本也不会被还原悄悄换掉。 -->
  <ItemGroup>
    <Reference Include="TwinCAT.Ads">
      <HintPath>..\..\..\Libs\TwinCAT.Ads.dll</HintPath>
    </Reference>
    <Reference Include="TwinCAT.Ads.Abstractions">
      <HintPath>..\..\..\Libs\TwinCAT.Ads.Abstractions.dll</HintPath>
    </Reference>
    <Reference Include="TwinCAT.Ads.Server">
      <HintPath>..\..\..\Libs\TwinCAT.Ads.Server.dll</HintPath>
    </Reference>
    <Reference Include="TwinCAT.Ads.ConfigurationProviders">
      <HintPath>..\..\..\Libs\TwinCAT.Ads.ConfigurationProviders.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
