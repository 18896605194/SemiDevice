<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-xyz.GrpcHost-f4e57ef7-7ddb-4cda-a7cd-c23487d297ba</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
    <PackageReference Include="protobuf-net.Grpc.AspNetCore" Version="1.3.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\xyz.Shared\xyz.Shared.csproj" />
    <ProjectReference Include="..\xyz.Service\xyz.Service.csproj" />
    <!-- 平台宿主不引用任何机型项目：机型模块 DLL 由 tools\deploy-module.ps1 部署到
         输出目录的 Modules\<机型>\，ComponentLoader 启动时扫目录发现。 -->
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\xyz.Configs\Config\sc.xml" Link="sc.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\xyz.Configs\Config\ec.xml" Link="Config\ec.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\xyz.Configs\Paths.json" Link="Paths.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\xyz.Common\Log\NLog.config" Link="Log\NLog.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
