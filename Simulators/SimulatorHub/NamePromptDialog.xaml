<Window
    x:Class="SimulatorHub.NamePromptDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="输入名称"
    Width="380"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Background="{DynamicResource DarkWindowBackground}"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    TextElement.FontSize="13"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <Window.Resources>
        <Style
            x:Key="ToolBtn"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="ToolBtnSuccess"
            BasedOn="{StaticResource SuccessButtonStyle}"
            TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16,14">
        <TextBlock x:Name="LabelText" Margin="0,0,0,6" />
        <TextBox
            x:Name="InputBox"
            Height="32"
            MinHeight="32"
            Padding="8,0"
            VerticalContentAlignment="Center"
            Style="{StaticResource DefaultTextBoxStyle}" />
        <StackPanel Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button
                Click="BtnOk_Click"
                IsDefault="True"
                Style="{StaticResource ToolBtnSuccess}"
                Content="确定" />
            <Button IsCancel="True" Style="{StaticResource ToolBtn}" Content="取消" />
        </StackPanel>
    </StackPanel>

</Window>
