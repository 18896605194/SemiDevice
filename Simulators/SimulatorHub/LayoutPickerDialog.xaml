<Window
    x:Class="SimulatorHub.LayoutPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="载入预设"
    Width="580"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Background="{DynamicResource DarkWindowBackground}"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    TextElement.FontSize="13"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="DlgTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DarkPrimaryText}" />
        </Style>
        <Style x:Key="DlgHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource DarkDisabledText}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style
            x:Key="ToolBtn"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="ToolBtnSuccess"
            BasedOn="{StaticResource SuccessButtonStyle}"
            TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="ToolBtnDanger"
            BasedOn="{StaticResource DangerButtonStyle}"
            TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16,14">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TitleText" Style="{StaticResource DlgTitle}" />
            <TextBlock
                Style="{StaticResource DlgHint}"
                Text="勾选要启用的实例 (会先关掉当前全部页签再重建); 端口列可直接修改 — 机械手是 TCP 端口号, LoadPort 是串口名。" />
        </StackPanel>

        <Border
            DockPanel.Dock="Bottom"
            Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="BtnAll_Click" Style="{StaticResource ToolBtn}" Content="全选" />
                <Button Click="BtnNone_Click" Style="{StaticResource ToolBtn}" Content="全不选" />
                <Button
                    x:Name="BtnDelete"
                    Click="BtnDelete_Click"
                    Style="{StaticResource ToolBtnDanger}"
                    ToolTip="删除该预设文件 (profiles 目录)"
                    Content="删除该预设" />
                <Button
                    Click="BtnApply_Click"
                    Style="{StaticResource ToolBtnSuccess}"
                    Content="启用" />
                <Button IsCancel="True" Style="{StaticResource ToolBtn}" Content="取消" />
            </StackPanel>
        </Border>

        <DataGrid
            x:Name="Grid"
            Margin="0,12,0,0"
            MinHeight="120"
            MaxHeight="360"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            CanUserSortColumns="False"
            HeadersVisibility="Column"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="启用" Width="56">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    Width="86"
                    Binding="{Binding Type}"
                    Header="类型"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Width="110"
                    Binding="{Binding Instance}"
                    Header="实例"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                    Header="端口" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>

</Window>
