<UserControl
    x:Class="RejeRobotSimulator.RobotPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Background="{DynamicResource DarkWindowBackground}"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    TextElement.FontSize="13"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <!-- ═══════════════════════════════════════════════════════════════
         紧凑覆盖样式: Presentation 的文本/按钮样式是给 xyz.Client 触屏
         HMI 设计的 (标签 22px / 按钮高 44 / 卡片内边距 18), 放进本工具的
         密集调试面板会把固定宽度全部撑爆。此处按 1920×1080 桌面窗口
         重定尺寸, 配色/控件模板仍引用 Presentation 资源。
         ═══════════════════════════════════════════════════════════════ -->
    <UserControl.Resources>

        <!-- ── 文本 ── -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DarkPrimaryText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SecTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DarkPrimaryText}" />
            <Setter Property="Margin" Value="2,2,2,6" />
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource DarkSecondaryText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource DarkDisabledText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="2,4,2,2" />
        </Style>
        <Style x:Key="HeaderTxt" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DarkSecondaryText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatusTxt" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DarkPrimaryText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatusDim" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource DarkDisabledText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ── 快照键值对 ── -->
        <Style x:Key="SnapLbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource DarkSecondaryText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,10,2" />
        </Style>
        <Style x:Key="SnapVal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource DarkPrimaryText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,24,2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- ── 输入框 ── -->
        <Style
            x:Key="NumBox"
            BasedOn="{StaticResource DefaultTextBoxStyle}"
            TargetType="TextBox">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="AxisBox"
            BasedOn="{StaticResource DefaultTextBoxStyle}"
            TargetType="TextBox">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="ManualBox"
            BasedOn="{StaticResource DefaultTextBoxStyle}"
            TargetType="TextBox">
            <Setter Property="Width" Value="320" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="CboMode"
            BasedOn="{StaticResource DefaultComboBoxStyle}"
            TargetType="ComboBox">
            <Setter Property="Width" Value="132" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ── 按钮 ── -->
        <Style
            x:Key="ToolBtn"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="ToolBtnDanger"
            BasedOn="{StaticResource DangerButtonStyle}"
            TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="ToolBtnSuccess"
            BasedOn="{StaticResource SuccessButtonStyle}"
            TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ── 其它 ── -->
        <Style
            x:Key="Card"
            BasedOn="{StaticResource DefaultCardStyle}"
            TargetType="materialDesign:Card">
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="Chk" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource DarkPrimaryText}" />
            <Setter Property="Margin" Value="0,3,12,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AxisName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource DarkSecondaryText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToolSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Fill" Value="{DynamicResource DarkBorderBrush}" />
            <Setter Property="Margin" Value="12,4" />
            <Setter Property="RadiusX" Value="0.5" />
            <Setter Property="RadiusY" Value="0.5" />
        </Style>

        <!-- ── 日志条目 ── -->
        <Style x:Key="LogTime" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource DarkDisabledText}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="LogTag" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Width" Value="56" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="LogMsg" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource DarkPrimaryText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <!-- ═══ 顶栏: 标题 + 监听状态 ═══ -->
        <Border DockPanel.Dock="Top" Padding="16,8" Style="{DynamicResource HeaderBarBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="RejeRobot 机械手仿真器" />
                    <Border
                        Margin="14,0,0,0"
                        Padding="8,2"
                        Background="{DynamicResource DarkSurfaceVariantBackground}"
                        CornerRadius="3"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="InstanceTag"
                            FontSize="11"
                            Foreground="{DynamicResource DarkSecondaryText}" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse
                        x:Name="HeaderDot"
                        Width="9"
                        Height="9"
                        Fill="{DynamicResource DarkAlarmStatus}" />
                    <TextBlock
                        x:Name="HeaderText"
                        Margin="8,0,0,0"
                        Style="{StaticResource HeaderTxt}"
                        Text="未监听" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ 底部状态栏 ═══ -->
        <Border
            DockPanel.Dock="Bottom"
            BorderBrush="{DynamicResource DarkBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,5">
            <StackPanel Orientation="Horizontal">
                <Ellipse
                    x:Name="StatusDot"
                    Width="9"
                    Height="9"
                    Fill="{DynamicResource DarkAlarmStatus}"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="StatusText"
                    Margin="8,0,0,0"
                    Style="{StaticResource StatusTxt}"
                    Text="未监听" />
                <TextBlock
                    x:Name="StatusParam"
                    Margin="24,0,0,0"
                    Style="{StaticResource StatusTxt}" />
                <TextBlock
                    x:Name="StatusDataDir"
                    Margin="24,0,0,0"
                    Style="{StaticResource StatusDim}" />
            </StackPanel>
        </Border>

        <!-- ═══ 工具栏: 监听 + 延迟/失败率 (WrapPanel 防窄窗截断) ═══ -->
        <Border
            DockPanel.Dock="Top"
            Margin="12,10,12,0"
            Padding="10,6"
            Background="{DynamicResource DarkSurfaceBackground}"
            BorderBrush="{DynamicResource DarkBorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <WrapPanel>
                <TextBlock
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Lbl}"
                    Text="监听端口" />
                <TextBox
                    x:Name="PortText"
                    Width="80"
                    Style="{StaticResource NumBox}"
                    Text="9000"
                    TextChanged="OnToolParamChanged" />
                <Button
                    x:Name="BtnStart"
                    Click="BtnStart_Click"
                    Content="启动监听"
                    Style="{StaticResource ToolBtnSuccess}" />
                <Button
                    x:Name="BtnStop"
                    Click="BtnStop_Click"
                    Content="停止监听"
                    IsEnabled="False"
                    Style="{StaticResource ToolBtnDanger}" />

                <Rectangle Style="{StaticResource ToolSeparator}" />

                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource Lbl}"
                    Text="ACK 延迟" />
                <TextBox
                    x:Name="AckDelayText"
                    Style="{StaticResource NumBox}"
                    Text="50"
                    TextChanged="OnToolParamChanged" />
                <TextBlock
                    Margin="4,0,16,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Lbl}"
                    Text="ms" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource Lbl}"
                    Text="结果延迟" />
                <TextBox
                    x:Name="RspDelayText"
                    Style="{StaticResource NumBox}"
                    Text="50"
                    TextChanged="OnToolParamChanged" />
                <TextBlock
                    Margin="4,0,16,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Lbl}"
                    Text="ms" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource Lbl}"
                    Text="动作耗时" />
                <TextBox
                    x:Name="MotionDelayText"
                    Width="64"
                    Style="{StaticResource NumBox}"
                    Text="3000"
                    TextChanged="OnToolParamChanged" />
                <TextBlock
                    Margin="4,0,16,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Lbl}"
                    Text="ms" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource Lbl}"
                    Text="失败率" />
                <TextBox
                    x:Name="FailRateText"
                    Width="52"
                    Style="{StaticResource NumBox}"
                    Text="0"
                    TextChanged="OnToolParamChanged" />
                <TextBlock
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Lbl}"
                    Text="%" />

                <Rectangle Style="{StaticResource ToolSeparator}" />

                <Button
                    x:Name="BtnSaveConfig"
                    Click="BtnSaveConfig_Click"
                    Content="保存配置"
                    Style="{StaticResource ToolBtn}"
                    ToolTip="把端口/延迟/失败率写入 config.json" />
                <Button
                    x:Name="BtnProtocolTest"
                    Click="BtnProtocolTest_Click"
                    Content="协议自测"
                    Style="{StaticResource ToolBtn}"
                    ToolTip="不依赖 TCP, 校验解析/路由/回帧 (结果进日志)" />
                <CheckBox
                    x:Name="ChkQuiet"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Checked="OnQuietChanged"
                    Content="静默日志 (跑批用)"
                    Style="{StaticResource Chk}"
                    Unchecked="OnQuietChanged" />
            </WrapPanel>
        </Border>

        <!-- ═══ 主体: 左状态拨动 | 右 快照+日志 ═══ -->
        <Grid Margin="12,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="560" />
            </Grid.ColumnDefinitions>

            <!-- 左: 状态拨动区 (可滚动) -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- 伺服 / 模式 -->
                    <materialDesign:Card Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SecTitle}" Text="伺服 / 模式" />
                            <CheckBox
                                x:Name="ChkEnable"
                                Checked="OnEnableChanged"
                                Content="伺服使能 (PowerOn/Off)"
                                Style="{StaticResource Chk}"
                                Unchecked="OnEnableChanged" />
                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Lbl}" Text="操作模式" />
                                <ComboBox
                                    x:Name="CboMode"
                                    Style="{StaticResource CboMode}"
                                    SelectionChanged="OnModeChanged">
                                    <ComboBoxItem Content="1 - 示教" />
                                    <ComboBoxItem Content="2 - 自动" />
                                    <ComboBoxItem Content="3 - 远程" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,6,0,2" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Lbl}" Text="全局速度 %" />
                                <TextBox
                                    x:Name="NumSpeed"
                                    Width="72"
                                    Style="{StaticResource AxisBox}"
                                    Text="50"
                                    TextAlignment="Center"
                                    TextChanged="OnSpeedChanged" />
                            </StackPanel>
                            <WrapPanel Margin="0,8,0,2">
                                <Button
                                    x:Name="BtnInjectError"
                                    Click="BtnInjectError_Click"
                                    Content="注入错误"
                                    Style="{StaticResource ToolBtnDanger}"
                                    ToolTip="置位模拟错误码, 主动报错开启时向所有客户端广播 Error 帧" />
                                <Button
                                    x:Name="BtnClearError"
                                    Click="BtnClearError_Click"
                                    Content="清除错误"
                                    Style="{StaticResource ToolBtnSuccess}" />
                                <Button
                                    x:Name="BtnResetState"
                                    Click="BtnResetState_Click"
                                    Content="重置状态"
                                    Style="{StaticResource ToolBtn}"
                                    ToolTip="清除错误并结束执行中标志 (等价 @Reset;)" />
                            </WrapPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- 手臂 / 手指 -->
                    <materialDesign:Card Margin="0,10,0,0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SecTitle}" Text="手臂 / 手指" />
                            <Grid Margin="2,0,2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Style="{StaticResource Lbl}" Text="手指有片" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Lbl}" Text="压力信号" />
                            </Grid>
                            <Grid Margin="2,0,2,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource AxisName}" Text="Arm 1" />
                                <CheckBox
                                    Grid.Column="1"
                                    x:Name="ChkW1"
                                    Checked="OnArmWaferToggled"
                                    Style="{StaticResource Chk}"
                                    Tag="1"
                                    Unchecked="OnArmWaferToggled" />
                                <CheckBox
                                    Grid.Column="2"
                                    x:Name="ChkP1"
                                    Checked="OnArmPressureChanged"
                                    IsChecked="True"
                                    Style="{StaticResource Chk}"
                                    Tag="1"
                                    Unchecked="OnArmPressureChanged" />
                            </Grid>
                            <Grid Margin="2,0,2,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource AxisName}" Text="Arm 2" />
                                <CheckBox
                                    Grid.Column="1"
                                    x:Name="ChkW2"
                                    Checked="OnArmWaferToggled"
                                    Style="{StaticResource Chk}"
                                    Tag="2"
                                    Unchecked="OnArmWaferToggled" />
                                <CheckBox
                                    Grid.Column="2"
                                    x:Name="ChkP2"
                                    Checked="OnArmPressureChanged"
                                    IsChecked="True"
                                    Style="{StaticResource Chk}"
                                    Tag="2"
                                    Unchecked="OnArmPressureChanged" />
                            </Grid>
                            <Grid Margin="2,0,2,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource AxisName}" Text="Arm 3" />
                                <CheckBox
                                    Grid.Column="1"
                                    x:Name="ChkW3"
                                    Checked="OnArmWaferToggled"
                                    Style="{StaticResource Chk}"
                                    Tag="3"
                                    Unchecked="OnArmWaferToggled" />
                                <CheckBox
                                    Grid.Column="2"
                                    x:Name="ChkP3"
                                    Checked="OnArmPressureChanged"
                                    IsChecked="True"
                                    Style="{StaticResource Chk}"
                                    Tag="3"
                                    Unchecked="OnArmPressureChanged" />
                            </Grid>
                            <Grid Margin="2,0,2,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource AxisName}" Text="Arm 4" />
                                <CheckBox
                                    Grid.Column="1"
                                    x:Name="ChkW4"
                                    Checked="OnArmWaferToggled"
                                    Style="{StaticResource Chk}"
                                    Tag="4"
                                    Unchecked="OnArmWaferToggled" />
                                <CheckBox
                                    Grid.Column="2"
                                    x:Name="ChkP4"
                                    Checked="OnArmPressureChanged"
                                    IsChecked="True"
                                    Style="{StaticResource Chk}"
                                    Tag="4"
                                    Unchecked="OnArmPressureChanged" />
                            </Grid>
                            <TextBlock
                                Style="{StaticResource Hint}"
                                Text="勾选实时改写状态; 订阅开启时在位变化自动推送 SubWaferEx 事件" />
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- 轴位置 -->
                    <materialDesign:Card Margin="0,10,0,0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SecTitle}" Text="轴位置 (mm / °)" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource AxisName}" Text="X" />
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    x:Name="NumX"
                                    Style="{StaticResource AxisBox}"
                                    Tag="X"
                                    Text="0"
                                    TextChanged="OnAxisPosChanged" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Margin="16,0,0,0" Style="{StaticResource AxisName}" Text="Z" />
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    x:Name="NumZ"
                                    Style="{StaticResource AxisBox}"
                                    Tag="Z"
                                    Text="0"
                                    TextChanged="OnAxisPosChanged" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource AxisName}" Text="Theta" />
                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    x:Name="NumTheta"
                                    Style="{StaticResource AxisBox}"
                                    Tag="Theta"
                                    Text="0"
                                    TextChanged="OnAxisPosChanged" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Margin="16,0,0,0" Style="{StaticResource AxisName}" Text="Aux" />
                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    x:Name="NumAux"
                                    Style="{StaticResource AxisBox}"
                                    Tag="Aux"
                                    Text="0"
                                    TextChanged="OnAxisPosChanged" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource AxisName}" Text="Arm1" />
                                <TextBox
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    x:Name="NumArm1"
                                    Style="{StaticResource AxisBox}"
                                    Tag="Arm1"
                                    Text="0"
                                    TextChanged="OnAxisPosChanged" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Margin="16,0,0,0" Style="{StaticResource AxisName}" Text="Arm2" />
                                <TextBox
                                    Grid.Row="2"
                                    Grid.Column="3"
                                    x:Name="NumArm2"
                                    Style="{StaticResource AxisBox}"
                                    Tag="Arm2"
                                    Text="0"
                                    TextChanged="OnAxisPosChanged" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource AxisName}" Text="Arm3" />
                                <TextBox
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    x:Name="NumArm3"
                                    Style="{StaticResource AxisBox}"
                                    Tag="Arm3"
                                    Text="0"
                                    TextChanged="OnAxisPosChanged" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Margin="16,0,0,0" Style="{StaticResource AxisName}" Text="Arm4" />
                                <TextBox
                                    Grid.Row="3"
                                    Grid.Column="3"
                                    x:Name="NumArm4"
                                    Style="{StaticResource AxisBox}"
                                    Tag="Arm4"
                                    Text="0"
                                    TextChanged="OnAxisPosChanged" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource AxisName}" Text="Flip1" />
                                <TextBox
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    x:Name="NumFlip1"
                                    Style="{StaticResource AxisBox}"
                                    Tag="Flip1"
                                    Text="0"
                                    TextChanged="OnAxisPosChanged" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Margin="16,0,0,0" Style="{StaticResource AxisName}" Text="Flip2" />
                                <TextBox
                                    Grid.Row="4"
                                    Grid.Column="3"
                                    x:Name="NumFlip2"
                                    Style="{StaticResource AxisBox}"
                                    Tag="Flip2"
                                    Text="0"
                                    TextChanged="OnAxisPosChanged" />
                            </Grid>
                            <TextBlock
                                Style="{StaticResource Hint}"
                                Text="改完即写状态, 上位机下一拍 &lt;轴&gt;Pos 轮询即可查到" />
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- 功能开关 -->
                    <materialDesign:Card Margin="0,10,0,0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SecTitle}" Text="功能开关" />
                            <CheckBox
                                x:Name="ChkSubscribe"
                                Checked="OnSubscribeChanged"
                                Content="Wafer 在位事件订阅 (SubWafer)"
                                Style="{StaticResource Chk}"
                                Unchecked="OnSubscribeChanged" />
                            <CheckBox
                                x:Name="ChkActiveError"
                                Checked="OnToggleSwitchChanged"
                                Content="主动报错 (AEO/AEC)"
                                IsChecked="True"
                                Style="{StaticResource Chk}"
                                Tag="ActiveError"
                                Unchecked="OnToggleSwitchChanged" />
                            <CheckBox
                                x:Name="ChkDeadMan"
                                Checked="OnToggleSwitchChanged"
                                Content="DeadMan 报错 (DMO/DMC)"
                                IsChecked="True"
                                Style="{StaticResource Chk}"
                                Tag="DeadMan"
                                Unchecked="OnToggleSwitchChanged" />
                            <CheckBox
                                x:Name="ChkSlideDetect"
                                Checked="OnToggleSwitchChanged"
                                Content="滑片检测 (SWO/SWC)"
                                Style="{StaticResource Chk}"
                                Tag="SlideDetect"
                                Unchecked="OnToggleSwitchChanged" />
                            <TextBlock
                                Style="{StaticResource Hint}"
                                Text="心跳由 @OpenStartHeart; / @CloseStartHeart; 控制, 间隔 @HeartTime&lt;ms&gt;;" />
                        </StackPanel>
                    </materialDesign:Card>

                </StackPanel>
            </ScrollViewer>

            <!-- 左右分栏拖条: 必须可见(原先透明, 误拖会把左列拖没且无从察觉) -->
            <GridSplitter
                Grid.Column="1"
                Width="6"
                Margin="0,4"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource DarkBorderBrush}"
                ShowsPreview="False" />

            <!-- 右: 上状态快照 / 下收发日志 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 状态快照: 键值对表格, 不再手拼等宽文本 (中文宽度不定永远对不齐) -->
                <materialDesign:Card Grid.Row="0" Padding="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <Border
                            BorderBrush="{DynamicResource DarkBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,5">
                            <TextBlock Style="{StaticResource SecTitle}" Text="当前状态快照" />
                        </Border>
                        <Grid Margin="14,6,14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SnapLbl}" Text="错误码" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SnapError" Style="{StaticResource SnapVal}" Text="-" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource SnapLbl}" Text="执行中" />
                            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="SnapExec" Style="{StaticResource SnapVal}" Text="-" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SnapLbl}" Text="伺服使能" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SnapEnable" Style="{StaticResource SnapVal}" Text="-" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource SnapLbl}" Text="操作模式" />
                            <TextBlock Grid.Row="1" Grid.Column="3" x:Name="SnapMode" Style="{StaticResource SnapVal}" Text="-" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource SnapLbl}" Text="全局速度" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SnapSpeed" Style="{StaticResource SnapVal}" Text="-" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource SnapLbl}" Text="臂间距" />
                            <TextBlock Grid.Row="2" Grid.Column="3" x:Name="SnapDistance" Style="{StaticResource SnapVal}" Text="-" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource SnapLbl}" Text="项目 / 程序" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SnapProject" Style="{StaticResource SnapVal}" Text="-" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource SnapLbl}" Text="心跳" />
                            <TextBlock Grid.Row="3" Grid.Column="3" x:Name="SnapHeart" Style="{StaticResource SnapVal}" Text="-" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource SnapLbl}" Text="手指在位" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SnapWafer" Style="{StaticResource SnapVal}" Text="-" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource SnapLbl}" Text="压力信号" />
                            <TextBlock Grid.Row="4" Grid.Column="3" x:Name="SnapPressure" Style="{StaticResource SnapVal}" Text="-" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource SnapLbl}" Text="真空 EMV" />
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="SnapEmv" Style="{StaticResource SnapVal}" Text="-" />
                            <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource SnapLbl}" Text="事件订阅" />
                            <TextBlock Grid.Row="5" Grid.Column="3" x:Name="SnapSub" Style="{StaticResource SnapVal}" Text="-" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource SnapLbl}" Text="报错开关" />
                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="SnapAeo" Style="{StaticResource SnapVal}" Text="-" />
                            <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource SnapLbl}" Text="Z 速比" />
                            <TextBlock Grid.Row="6" Grid.Column="3" x:Name="SnapZRatio" Style="{StaticResource SnapVal}" Text="-" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource SnapLbl}" Text="X" />
                            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="SnapPosX" Style="{StaticResource SnapVal}" Text="-" />
                            <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource SnapLbl}" Text="Z" />
                            <TextBlock Grid.Row="7" Grid.Column="3" x:Name="SnapPosZ" Style="{StaticResource SnapVal}" Text="-" />

                            <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource SnapLbl}" Text="Theta" />
                            <TextBlock Grid.Row="8" Grid.Column="1" x:Name="SnapPosTheta" Style="{StaticResource SnapVal}" Text="-" />
                            <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource SnapLbl}" Text="Aux" />
                            <TextBlock Grid.Row="8" Grid.Column="3" x:Name="SnapPosAux" Style="{StaticResource SnapVal}" Text="-" />

                            <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource SnapLbl}" Text="Arm 1 / 2" />
                            <TextBlock Grid.Row="9" Grid.Column="1" x:Name="SnapPosArm12" Style="{StaticResource SnapVal}" Text="-" />
                            <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource SnapLbl}" Text="Arm 3 / 4" />
                            <TextBlock Grid.Row="9" Grid.Column="3" x:Name="SnapPosArm34" Style="{StaticResource SnapVal}" Text="-" />

                            <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource SnapLbl}" Text="Flip 1 / 2" />
                            <TextBlock Grid.Row="10" Grid.Column="1" x:Name="SnapPosFlip" Style="{StaticResource SnapVal}" Text="-" />
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 快照/日志上下分栏拖条: 同上, 可见才不易误拖 -->
                <GridSplitter
                    Grid.Row="1"
                    Height="6"
                    Margin="0,4"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource DarkBorderBrush}"
                    ShowsPreview="False" />

                <!-- 收发日志 -->
                <materialDesign:Card Grid.Row="2" Padding="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <Border
                            DockPanel.Dock="Top"
                            BorderBrush="{DynamicResource DarkBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecTitle}"
                                    Text="收发日志" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Hint}"
                                    Text="接收=绿 发送=蓝 推送=紫 系统=灰 错误=红 自测=黄" />
                                <TextBlock Width="16" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Lbl}"
                                    Text="主动广播帧" />
                                <TextBox
                                    x:Name="ManualFrameText"
                                    Style="{StaticResource ManualBox}"
                                    Text="&gt;00000000#SubWaferEx,1,0@Event;"
                                    ToolTip="向所有已连接客户端广播完整帧, 如 &gt;00000000#SubWaferEx,1,0@Event;" />
                                <Button
                                    x:Name="BtnManualSend"
                                    Click="BtnManualSend_Click"
                                    Content="广播"
                                    Style="{StaticResource ToolBtn}" />
                            </StackPanel>
                        </Border>
                        <ListBox
                            x:Name="LogList"
                            BorderThickness="0"
                            Background="Transparent"
                            ItemContainerStyle="{x:Null}"
                            ItemsSource="{Binding Logs}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="14,2" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource LogTime}" Text="{Binding Time}" />
                                        <TextBlock
                                            Foreground="{Binding TagBrush}"
                                            Style="{StaticResource LogTag}"
                                            Text="{Binding Tag}" />
                                        <TextBlock
                                            Style="{StaticResource LogMsg}"
                                            Text="{Binding Message}"
                                            TextTrimming="None" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
