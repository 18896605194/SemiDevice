<Window
    x:Class="FcdLoadPortSimulator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FcdLoadPort (富创得 LP300) 仿真器"
    Width="1280"
    Height="720"
    MinWidth="960"
    MinHeight="600"
    Background="{DynamicResource DarkWindowBackground}"
    TextElement.Foreground="{DynamicResource DarkPrimaryText}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    WindowStartupLocation="CenterScreen">

    <!-- 薄窗口: 面板逻辑全在 LoadPortPanel (与 SimulatorHub 页签共用同一实现) -->
    <Grid x:Name="RootGrid" />

</Window>
